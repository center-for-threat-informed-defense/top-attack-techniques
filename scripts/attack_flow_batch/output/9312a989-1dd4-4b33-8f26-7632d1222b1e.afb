{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","attack-action--13","attack-action--14","attack-action--15","attack-operator--1","software--octobercms","software--log4j","file--stage1-bootpatch","instance--beded0a2-2a22-5ad3-8577-1fbf7717b179","file--stage2-downloader","instance--7b564deb-f836-5e49-9476-56513e4ea111","url--discord-server","file--stage3-reversed-dll","instance--80a4bcee-f0bc-5d90-99b9-f16a5a7fd8ed","file--nmddfrqqrbyjeygggda-vbs","instance--6e8d1bc3-eab2-5d45-8ade-44a5383b113f","instance--1bb77e34-a5b8-5110-8063-f060b27f84eb","instance--4f347b75-154e-5eb7-a83b-04b738d18095","instance--de95253e-3f2d-5486-a3d1-3a29e04cc374","instance--316f558b-e1fe-5d56-ae9f-863c38e4420b","artifact--resource-78c855a088924e92a7f60d661c3d1845","artifact--resource-advancedrun","instance--4fc48051-93ad-5a49-a44a-6afa880f0cdf","instance--c5ebaa88-21e8-5a8b-93c1-f1ac147620ca","instance--c4f1c33a-760e-55dc-97a7-e2bb36e644aa","instance--e2217af0-5c2c-5a67-bc9f-5794806997b8","instance--4d6269a4-d457-5264-8815-83895869403e","instance--3acdf14d-62c5-504f-8c7d-70f9cd43e6c6","software--sc-exe","user-account--trustedinstaller","instance--b5a7ce6a-09a3-5303-8c95-dd5f6bbcd01f","instance--d1b68e12-c682-5a9b-b31b-489029e56df2","instance--2dd6c569-7bee-5bf0-94cb-848826443dcf","instance--6fefc1da-b6ac-5e81-b23d-d2ab167ff429","directory--windows-defender-programdata","instance--befe717e-9599-53f7-ac10-642545323782","instance--75fa182e-cccd-5df7-9da1-c375dfa3ffbe","instance--33344873-9443-5dcf-a673-882511a1fe26","instance--1f086ab6-f63f-5a11-bb2e-465828863d73","instance--f00bd57d-de66-5079-b649-eb048f07d0b1","process--installutil-suspended","instance--730f0f7d-1ccd-5b91-bd17-6e98c4888689","instance--b902006b-e077-59d7-b687-3d25bfa1f9d2","directory--homedrive-windows","software--ping","instance--2e9769ca-57eb-52fd-9fec-d0780b23554c","instance--c7ccbaba-251b-5117-920d-161722fd14e2","file--bash-history","software--wmiexec","software--smbexec","software--impacket","instance--f825654a-7f81-50f7-a4e3-715efc45ad7a","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--be99ba49-e121-58a8-ba7b-dd3de316cfcf","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--c075f5c6-95e8-5553-8f7e-b432b96021c7","instance--3b404379-7d7e-5278-b499-6ac12ee4e90f","instance--3e0f78a3-bb54-55bd-8490-3453d5e06d04","instance--d23a7e3b-28ba-5c82-b661-c8eb109d42d1","instance--d5a23265-4785-57d9-9543-c8f65c513977","instance--4d3545ff-cd93-5264-9853-7751a2c76023","instance--2229228a-1e5b-5aa6-8110-c4da9fc16091","instance--28b2ce59-72a9-5fda-9189-f268b695ef47","instance--24d85f28-8f85-5d8c-83ea-fc30cfd85b81","instance--7a588c85-65cb-5d0b-8f4e-7894ddd76e1d","instance--9e935359-17a1-524a-bc9b-3af2ef3707cd","instance--f2703911-c231-5216-b306-8cb88abd54df","instance--52e5e9df-9ca8-5617-8afc-51be7e4de0e4","instance--80d99de6-77aa-5320-9b46-683bd51e3f4f","instance--32fad251-0466-5490-b04c-15dc756667eb","instance--35211a8f-b88b-5784-9063-601559106064","instance--7887d847-643e-5ffc-8da5-ffc6afb3bbb8","instance--6d519018-0ae8-5adb-bc7a-cfa6e650b81b","instance--1f999b31-d672-5d66-a870-7b8e11b085eb","instance--d450d6b4-ed5d-5484-b25f-7ddd96535351","instance--222f7eeb-8961-54ee-a65e-31c36211fff2","instance--8caf7ea3-3171-5cfa-8c38-5d67b5e68428","instance--45bdea41-28c8-50c9-960a-19d4210c2ff2","instance--594faa21-d1a4-52b2-b0f3-4d482fdf8afd","instance--9107184d-64db-5edb-bc1f-4ecca3f3d695","instance--5490981d-e4c2-50b9-9e18-0dfd2c3a2cfb","instance--d2b2a331-6bce-5538-ad05-e144482c0735","instance--5c831013-e170-5fb9-b2f4-e3e2b3349c2f","instance--d4139128-8660-5eec-9f04-d834e548dad9","instance--e5974c6c-f8e0-5133-9f71-fa8583b12744","instance--16486744-20cd-55d4-945b-84e6a6a8c9d0","instance--f1c726a9-a36a-53c8-92ad-ee4c716ec54f","instance--19a728fd-8a3f-54b0-976b-5333b2f0841d","instance--a94a2ae6-6b74-5261-9f4d-0a99a54aed70","instance--7a398888-c1e7-5a61-9e09-65d92a9e66c2","instance--76a5ae76-15ee-5ce7-bcaf-5d3c8d245fb2","instance--5ab22373-115f-5f87-894f-4d8802be1b0d","instance--f0eecd49-8ad3-5ab7-98ef-9bbaf1de82e3","instance--64e3e2cb-d375-5ea0-a73d-e469f7e60222","instance--45cc2b9e-ec5c-5e1c-b41b-0211a2f245cd","instance--dd26c350-2c9f-5cbe-af37-a2f7325c1972","instance--c8fbc827-e6aa-57e6-83c8-04089265e42c","instance--1b69c1b2-258e-583f-8e80-5eafa65c0ede","instance--f9679d1e-90ed-5661-baa3-793e4f5c3a5a","instance--530dae66-8dd7-5de0-b81e-5540016dade0","instance--17cb6eaf-9d21-51fe-8526-32fca5dc797b","instance--73711969-16ad-50f3-9d45-a51b6a4e376b","instance--6878bf05-bd28-52ae-a600-12172563b3fc","instance--2f2aeb87-a1d3-511c-bd05-38c2f892e0e2","instance--93a2c443-bc14-5487-98c2-190f33a54b37"],"properties":[["name","Ukraine Campaign Delivers Defacement and Wipers, in Continued Escalation"],["description","Cisco Talos analysis of the WhisperGate multi-stage infection chain and related unauthorized account behavior and network proliferation activity against Ukrainian entities."],["scope","incident"],["author",[["name","Cisco Talos"]]],["external_references",[["item-1",[["source_name","blog.talosintelligence.com"],["url","https://blog.talosintelligence.com/2022/01/ukraine-campaign-delivers-defacement.html"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Compromise supply chain or exploit public-facing apps"],["description","\"The most likely vector for a cyber attack is the compromise of the supply chain, which has made it possible to use existing trust links to disable related information and telecommunications and automated systems. At the same time, two other possible attack vectors are not ruled out, namely the exploitation of OctoberCMS and Log4j vulnerabilities.\""],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1195"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Wipe MBR and C partition"],["description","The first payload in this infection is responsible for the initial attempt at wiping the systems. The malware executable wipes the master boot record (MBR) and replaces it with the code responsible for displaying the ransom note. Similar to the notorious NotPetya wiper that masqueraded as ransomware during its 2017 campaign, WhisperGate is not intended to be an actual ransom attempt, since the MBR is completely overwritten and has no recovery options. This wiper also tries to destroy the C:\\ partition by overwriting it with fixed data."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1561.001"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Delay and download second-stage payload"],["description","The second stage of the infection chain is a downloader that retrieves a third stage from a Discord server URL that's hard-coded in the downloader. The downloader starts by executing a base64-encoded PowerShell command twice to make the endpoint sleep for 20 seconds.\n\n// Start-Sleep -s 10\n\nAfter that, it downloads a file from Discord. The downloaded file is in reverse byte order."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Restore and execute third-stage DLL"],["description","The downloader restores the downloaded file by reversing the bytes within the file.\n\nThe restored file is a DLL and serves as the third stage of the infection chain. After restoration, it loads the third-stage DLL and proceeds to retrieve all of its public methods to search for a method with the name \"Ylfwdwgmpilzyaph\". If the method is found, the downloader will execute it by calling \".Invoke(null, null)\", transferring the execution flow over to the third-stage DLL."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1218.011"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Drop and run VBScript to exclude C drive"],["description","The third-stage DLL starts off by dropping a VBScript named \"Nmddfrqqrbyjeygggda.vbs\" into the %TEMP% directory and executes it. The script modifies Windows Defender settings to exclude the target logical drive it is going to wipe from scheduled and real-time scanning.\n\nObject(\"WScript.Shell\").Run \"powershell Set-MpPreference -ExclusionPath 'C:\\'\""],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Decrypt embedded DLL resources"],["description","Next, the DLL loads an embedded resource named \"78c855a088924e92a7f60d661c3d1845\" into memory and decrypts it using multiple XOR operations.\n\nThe decrypted resource is a DLL file embedded with two resources named \"AdvancedRun\" and \"Waqybg\" that are compressed with GZip."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1027"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Drop AdvancedRun.exe"],["description","The third-stage DLL proceeds by loading the \"AdvancedRun\" resource into memory, decompressing it and dropping it as \"AdvancedRun.exe\" into the %TEMP% directory."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Run commands as TrustedInstaller to disable Defender"],["description","\"AdvancedRun.exe\" is a tool provided by Nirsoft to execute a program with different settings. Once the tool is dropped, the third stage DLL will leverage it to execute two commands in the context of the Windows TrustedInstaller group. The TrustedInstaller group was an addition to Windows beginning in Windows 7 with the goal of preventing accidental damage to critical system files. AdvanceRun is one of the tools that can be used to execute commands in the context of the TrustedInstaller user. This functionality is only available via CLI and requires the flag of \"/RunAs 8\", which is shown in the commands below. The tool will be deleted from the %TEMP% directory after executing both commands. The first command leverages the Windows service control application (sc.exe) to disable Windows Defender."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Delete Windows Defender files"],["description","The second command leverages Windows PowerShell to execute a Windows utility called \"rmdir\" to delete all the files and directories that are related to Windows Defender, such as scan results, quarantined files and definition updates.\n\n\"%TEMP%\\AdvancedRun.exe\" /EXEFilename \"C:\\Windows\\System32 \\WindowsPowerShell\\v1.0\\powershell.exe\" /WindowState 0 /CommandLine \"rmdir 'C:\\Progra mData\\Microsoft\\Windows Defender' -Recurse\" /StartDirectory \"\" /RunAs 8 /Run"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Inject fourth-stage wiper into InstallUtil"],["description","Next, the third-stage DLL will load the \"Waqybg\" resource into memory. As the resource is stored in reverse byte order, the third-stage DLL will restore it by reversing the bytes and then proceed to decompress it. The decompressed data is the fourth stage wiper payload. After decompressing the data, the third-stage DLL copies a legitimate Windows utility \"InstallUtil.exe\" into the %TEMP% directory, creates a suspended process with it and injects the fourth-stage wiper into the process. Finally, it resumes the process and transfers the execution flow to the fourth-stage wiper."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1055"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Enumerate logical drives"],["description","The fourth-stage wiper starts off by enumerating from A to Z, looking for fixed and remote logical drives in the system."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1120"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Wipe targeted files across drives"],["description","For each enumeration, it performs a breadth-first search to wipe the files in the logical drive while ignoring files located in the \"%HOMEDRIVE%\\Windows\" directory.\n\nIt also only wipes files that have specific file extensions:\n\n.HTML .HTM .SHTML .XHTML .PHTML .PHP .JSP .ASP .PHPS .PHP5 .ASPX .PHP4 .PHP6 .PHP7 .PHP3 .DOC .DOCX .XLS .XLSX .PPT .PPTX .PST .OST .MSG .EML .VSD .VSDX .TXT .CSV .RTF .WKS .WK1 .PDF .DWG .ONETOC2 .SNT .JPEG .JPG .DOCB .DOCM .DOT .DOTM .DOTX .XLSM .XLSB .XLW .XLT .XLM .XLC .XLTX .XLTM .PPTM .POT .PPS .PPSM .PPSX .PPAM .POTX .POTM .EDB .HWP .602 .SXI .STI .SLDX .SLDM .BMP .PNG .GIF .RAW .CGM .SLN .TIF .TIFF .NEF .PSD .AI .SVG .DJVU .SH .CLASS .JAR .BRD .SCH .DCH .DIP .PL .VB .VBS .PS1 .BAT .CMD .JS .ASM .H .PAS .CPP .C .CS .SUO .ASC .LAY6 .LAY .MML .SXM .OTG .ODG .UOP .STD .SXD .OTP .ODP .WB2 .SLK .DIF .STC .SXC .OTS .ODS .3DM .MAX .3DS .UOT .STW .SXW .OTT .ODT .PEM .P12 .CSR .CRT .KEY .PFX .DER .OGG .RB .GO .JAVA .INC .WAR .PY .KDBX .INI .YML .PPK .LOG .VDI .VMDK .VHD .HDD .NVRAM .VMSD .VMSN .VMSS .VMTM .VMX .VMXF .VSWP .VMTX .VMEM .MDF .IBD .MYI .MYD .FRM .SAV .ODB .DBF .DB .MDB .ACCDB .SQL .SQLITEDB .SQLITE3 .LDF .SQ3 .ARC .PAQ .BZ2 .TBK .BAK .TAR .TGZ .GZ .7Z .RAR .ZIP .BACKUP .ISO .VCD .BZ .CONFIG\n\nThe wiper will overwrite the content of each file with 1MB worth of 0xCC bytes and rename them by appending each filename with a random four-byte extension."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1485"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Delete InstallUtil and shut down system"],["description","After the wiping process completes, it performs a delayed command execution using Ping to delete \"InstallerUtil.exe\" from the %TEMP% directory.\n\nFinally, it attempts to flush all file buffers to disk and stop all running processes (including itself) by calling ExitWindowsEx Windows API with EWX_SHUTDOWN flag."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1529"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Create privileged user and download file"],["description","During the investigation, CERT-UA observed unauthorized behaviour by legitimate accounts. As seen in the .bash history file shown below, the attacker added a new user, added it to a privileged group, and downloaded a file."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1136.001"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Move laterally with wmiexec and smbexec"],["description","As stated by CERT-UA, it is likely that the attackers utilized the Impacket tools \"wmiexec\" and \"smbexec\" to proliferate across networks. Below is a screenshot from their advisory, showing Sysmon logs that may indicate the use of these tools."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1047"}]]},{"anchors":{"0":"instance--36aad375-d405-5e3b-9a7d-4346c75c9f45","120":"instance--acc72955-e581-59b3-80b5-35fb047df4b8","150":"instance--d5d0ec7c-da1b-5d39-86e4-8de8792ab05d","180":"instance--047e7862-d9c4-5716-b778-899a86595b48","210":"instance--650a6d3c-5cb0-5f82-83ec-c5d828e2502b","240":"instance--3f08654d-fd5e-59cb-af47-8bbcee29de39","270":"instance--e175549d-38ff-5527-bdb8-de5e1a12f356","30":"instance--c6e60459-b005-50cd-9e68-66ef210b5456","300":"instance--f90b34f0-8620-5a56-9e11-4db2b889aac4","330":"instance--93872aee-cf81-52fa-aa93-f7a84a833dbd","60":"instance--5a877a06-3649-5bba-9461-5faee75ea842","90":"instance--68af6616-0e27-5395-b4ff-5d95b55a2405"},"id":"OR_operator","instance":"attack-operator--1","properties":[["operator","OR"]]},{"anchors":{"0":"instance--ac328bc7-bdf5-5266-aa4a-c951f5409493","120":"instance--e638b5b7-6de8-5fbc-bed6-521df16311bd","150":"instance--8eef9bea-6f14-55ad-9b9e-72b5de9b6082","180":"instance--1c2e149d-417c-5c15-a418-8917729c4865","210":"instance--c66c7c70-0401-5553-a33d-2925d441a577","240":"instance--1465f328-9d7a-5846-807d-7fced9ab2ae3","270":"instance--7bbfbbe6-d1ef-5389-8ed3-8f9e94c44658","30":"instance--37d1ab8c-5ccf-52b2-80e9-cdd427b73d4e","300":"instance--8b5e6d4a-5b0c-52e6-a022-514b7cef2284","330":"instance--f218baaa-2d1f-5cb4-aa8e-caf9becc2db7","60":"instance--e305a209-bf90-5620-9e99-af9a57251330","90":"instance--2c57517d-f80d-5366-b900-d2772630643b"},"id":"software","instance":"software--octobercms","properties":[["evidence",[["item-1",{"excerpt":"the exploitation of OctoberCMS and Log4j vulnerabilities","source":"https://blog.talosintelligence.com/2022/01/ukraine-campaign-delivers-defacement.html"}]]],["display_name","OctoberCMS"],["name","OctoberCMS"]]},{"anchors":{"0":"instance--78247291-376d-5b9a-aaa0-1099d0b0765d","120":"instance--6419887b-86e2-5c08-a191-ad447b0c3365","150":"instance--52a2c00d-9f36-578d-b417-acc97990b745","180":"instance--4cfc2ae6-cd6c-505f-9117-62be090234fb","210":"instance--3452e6bb-231d-5b30-84ed-b0740abc1979","240":"instance--c917caef-b24c-527e-b64e-9c4dbd55b5c6","270":"instance--c10afc97-e543-5d0d-83f9-b9e586d4a29a","30":"instance--fd4ba5ae-1600-5416-a7fe-106538cb7574","300":"instance--bd0c525b-faeb-5852-9f6b-7805123a61d7","330":"instance--a1da1cb2-72dc-52b4-8d8c-4d6ab35bcc5c","60":"instance--cb1671ff-3f16-57eb-9c27-e6798978afc7","90":"instance--1d731fb5-630d-5128-b996-ddc39be293f4"},"id":"software","instance":"software--log4j","properties":[["evidence",[["item-1",{"excerpt":"the exploitation of OctoberCMS and Log4j