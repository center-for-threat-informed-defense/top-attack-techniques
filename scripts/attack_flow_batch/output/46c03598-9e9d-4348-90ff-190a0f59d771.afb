{"objects":[{"id":"flow","instance":"instance--dbfff0fe-42ca-5561-bfe5-60f482fafe60","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-operator--1","instance--6891f227-cf69-52a9-8cf1-64e97fff933d","process--sshd-operns","file--etc-shadow","file--etc-passwd","file--authorized-keys","software--tcpdump","software--tpacap","software--epc","url--ftp-server","software--jumbledpath","software--go","file--elf-binary","instance--5e370b52-4b67-505f-ba06-f8bb4dac0bd7","software--cisco-nexus","software--ssh","file--bash-history","file--auth-log","file--lastlog","file--wtmp","file--btmp","instance--fdcc060b-7b3c-5bee-a08c-8b005bfe5a13","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--d8c1ac68-9d53-5126-80b0-7decc34c9563","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--e28c61d0-be08-595d-b694-80935ffe4433","instance--d190f90c-4784-50da-ad09-085edc636fbd","instance--61ea653c-97af-5c55-8770-8b020b21d5a8","instance--099f9f64-0f02-513d-a055-5495b8786d5a","instance--cded327f-4415-54da-8d76-0ba1fa95523a","instance--03040e21-82b2-521c-a4e7-abc82a302630","instance--fc46bf12-e7cf-509a-9bc5-59d066bf49a9","instance--33726ef3-2f6f-55e1-b983-577cc3616f0a","instance--d6e139b2-55e5-55b5-a6a1-20e16d5d1a2c","instance--d8ac55af-7470-582f-b0bc-2910feff7bfb","instance--351d1542-13f7-5933-a41c-287749867cfe","instance--79430e52-5107-5827-924a-20ade865034d","instance--bf80140d-8fa9-5601-9dac-afa43b5142f8","instance--ec83b2d7-fea8-539c-bafd-adba2a13692b","instance--1cf84348-7562-5598-bd8c-7f36ae913e74","instance--515a7a38-2285-5709-9200-6d1ea86d0f55","instance--23d30ea3-aec4-5991-97ce-478daf01869a","instance--77327564-29e1-592d-a4aa-3ec894897ebe","instance--3649b8fa-f0d4-5d0d-a871-1fc6049c6568","instance--70ee21ae-6dd0-5cfb-b610-43beb5328caf","instance--8e7b574e-de18-59d1-acfc-5c7cf8d731b5","instance--795dda70-5365-57db-a06a-a60b45e4ba03","instance--c63cb7f8-d795-5771-bf0d-1bb415f8c5f4"],"properties":[["name","Salt Typhoon campaign activity against telecommunications infrastructure"],["description","Cisco Talos observations of Salt Typhoon intrusion activity against major U.S. telecommunications companies."],["scope","campaign"],["author",[["name","Cisco Talos"]]],["external_references",[["item-1",[["source_name","blog.talosintelligence.com"],["url","https://blog.talosintelligence.com/salt-typhoon-analysis/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Use stolen credentials"],["description","In all the other incidents we have investigated to date, the initial access to Cisco devices was determined to be gained through the threat actor obtaining legitimate victim login credentials."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1078"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Exfiltrate device configurations"],["description","In numerous instances, the threat actor exfiltrated device configurations, often over TFTP and/or FTP. These configurations often contained sensitive authentication material, such as SNMP Read/Write (R/W) community strings and local accounts with weak password encryption types in use. The weak encryption password type would allow an attacker to trivially decrypt the password itself offline. In addition to the sensitive authentication material, configurations often contain named interfaces, which might allow an attacker to better understand the upstream and downstream network segments and use this information for additional reconnaissance and subsequent lateral movement within the network."],["confidence",0.0],["ttp",{"tactic":"TA0009","technique":"T1602.001"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Capture authentication traffic"],["description","In addition, we have observed the threat actor capturing SNMP, TACACS, and RADIUS traffic, including the secret keys used between network devices and TACACS/RADIUS servers. The intent of this traffic capture is almost certainly to enumerate additional credential details for follow-on use."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1040"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Pivot through compromised infrastructure"],["description","The threat actor also pivoted from a compromised device operated by one telecom to target a device in another telecom. We believe that the device associated with the initial telecom was merely used as a hop point and not the intended final target in several instances. Some of these hop points were also used as a first hop for outbound data exfiltration operations. Much of this pivoting included the use of network equipment from a variety of different manufacturers."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1210"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Modify device and shell configurations"],["description","We observed that the threat actor had modified devices\u2019 running configurations as well as the subsystems associated with both Bash and Guest Shell. (Guest Shell is a Linux-based virtual environment that runs on Cisco devices and allows users to execute Linux commands and utilities, including Bash.)\n\nAAA/TACACS+ server modification (server IP address change)\n\nLoopback interface IP address modifications\n\nGRE tunnel creation and use\n\nCreation of unexpected local accounts\n\nACL modifications\n\nSNMP community string modifications\n\nHTTP/HTTPS server modifications on both standard and non-standard ports\n\nGuest Shell enable and disable commands\n\nStarted SSH alternate servers on high ports for persistent access, such as sshd_operns (on port 57722) on underlying Linux Shell or Guest Shell /usr/bin/sshd -p X\n\nCreated Linux-level users (modification of \u201c/etc/shadow\u201d and \u201c/etc/passwd\u201d)\n\nAdded SSH \u201cauthorized_keys\u201d under root or other users at Linux level"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1098"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Capture packets with built-in tools"],["description","The threat actor used a variety of tools and techniques to capture packet data throughout the course of the campaign, listed below:\n\nTcpdump \u2013 Portable command-line utility used to capture packet data at the underlying operating system level. Tcpdump \u2013i\n\nTpacap \u2013 Cisco IOS XR command line utility used to capture packets being sent to or from a given interface via netio at the underlying operating system level. Tpacap \u2013i\n\nEmbedded Packet Capture (EPC) - Cisco IOS feature that allows the capture and export of packet capture data. Monitor capture CAP export ftp://<ftp_server>\n\nMonitor capture CAP start\n\nMonitor capture CAP clear"],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1040"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Use JumbledPath for remote packet capture"],["description","The threat actor used a custom-built utility, dubbed JumbledPath, which allowed them to execute a packet capture on a remote Cisco device through an actor-defined jump-host. This tool also attempted to clear logs and impair logging along the jump-path and return the resultant compressed, encrypted capture via another unique series of actor-defined connections or jumps. This allowed the threat actor to create a chain of connections and perform the capture on a remote device. The use of this utility would help to obfuscate the original source, and ultimate destination, of the request and would also allow its operator to move through potentially otherwise non-publicly-reachable (or routable) devices or infrastructure.\n\nThis utility was written in GO and compiled as an ELF binary using an x86-64 architecture. Compiling the utility using this architecture makes it widely useable across Linux operating systems, which also includes a variety of multi-vendor network devices. This utility was found in actor configured Guestshell instances on Cisco Nexus devices."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1040"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Change loopback source for SSH pivoting"],["description","The threat actor repeatedly modified the address of the loopback interface on a compromised switch and used that interface as the source of SSH connections to additional devices within the target environment, allowing them to effectively bypass access control lists (ACLs) in place on those devices (see \"Infrastructure pivoting\" section)."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021.004"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Clear logs and disable Guestshell"],["description","The threat actor routinely cleared relevant logs, including .bash_history, auth.log, lastlog, wtmp, and btmp, where applicable, to obfuscate their activities. Shell access was restored to a normal state in many cases through the use of the \u201cguestshell disable\u201d command."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1070.003"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Modify AAA server settings"],["description","The threat actor modified authentication, authorization, and accounting (AAA) server settings with supplemental addresses under their control to bypass access control systems."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1556.005"}]]},{"anchors":{"0":"instance--36aad375-d405-5e3b-9a7d-4346c75c9f45","120":"instance--acc72955-e581-59b3-80b5-35fb047df4b8","150":"instance--d5d0ec7c-da1b-5d39-86e4-8de8792ab05d","180":"instance--047e7862-d9c4-5716-b778-899a86595b48","210":"instance--650a6d3c-5cb0-5f82-83ec-c5d828e2502b","240":"instance--3f08654d-fd5e-59cb-af47-8bbcee29de39","270":"instance--e175549d-38ff-5527-bdb8-de5e1a12f356","30":"instance--c6e60459-b005-50cd-9e68-66ef210b5456","300":"instance--f90b34f0-8620-5a56-9e11-4db2b889aac4","330":"instance--93872aee-cf81-52fa-aa93-f7a84a833dbd","60":"instance--5a877a06-3649-5bba-9461-5faee75ea842","90":"instance--68af6616-0e27-5395-b4ff-5d95b55a2405"},"id":"AND_operator","instance":"attack-operator--1","properties":[["operator","AND"]]},{"anchors":{"0":"instance--4e9b79c7-4d85-5e94-a72a-5270575c7f7b","120":"instance--3eb767e3-554a-54c8-b472-788ae5d5c2b5","150":"instance--1495c884-db7d-5d83-8e26-9db28f0486bf","180":"instance--01a2f01f-5770-527a-a14f-8a87a7fe9c04","210":"instance--062c6e03-31fd-5c92-80c4-0001517d46c0","240":"instance--8078180f-aa5c-526a-804a-30088b7510b1","270":"instance--e4ae464b-943d-5a52-9cb4-0fe65b884920","30":"instance--809615e0-7e12-58e8-ac98-553fe217498f","300":"instance--7aafe560-307b-568c-8eb8-5a47dad803f5","330":"instance--757bb2ac-a223-56be-908e-8c4c0ba34bb5","60":"instance--65f84a6e-d58e-57f8-aab5-2d218dc075a6","90":"instance--335c22a7-b89d-5eff-99ff-d0d69d382a58"},"id":"software","instance":"instance--6891f227-cf69-52a9-8cf1-64e97fff933d","properties":[["evidence",[["item-1",{"excerpt":"Guest Shell is a Linux-based virtual environment that runs on Cisco devices and allows users to execute Linux commands and utilities, including Bash.","source":"https://blog.talosintelligence.com/salt-typhoon-analysis/"}]]],["display_name","Guest Shell"],["name","Guest Shell"],["diagram_instance","instance--6891f227-cf69-52a9-8cf1-64e97fff933d"]]},{"anchors":{"0":"instance--081b4937-4232-5528-b719-fc3f7f1da1da","120":"instance--ae118810-c166-5263-9f86-1d8d284f4ab9","150":"instance--e0e4d43f-9dcd-5d29-b4ec-5f5fdad2b02b","180":"instance--43555ecc-d699-526b-b643-cbfe3469decc","210":"instance--81e8a056-a984-5d41-a551-5626b7b7e9ab","240":"instance--03395c96-2311-51ae-9fae-48467383b62b","270":"instance--4ee17392-3033-5c80-b13f-933d796453e1","30":"instance--8c78577f-7d42-52ee-b96b-264014e67c93","300":"instance--5f2381ff-64e9-55d2-8cd1-0eeceac4ca52","330":"instance--932f2afe-6ff9-5bd3-a231-1da1f55cb06f","60":"instance--18e7b530-8d50-57dc-ba76-424e6265123a","90":"instance--ed0956c1-e51c-5cd0-b2c8-652e34820d32"},"id":"process","instance":"process--sshd-operns","properties":[["command_line","/usr/bin/sshd -p X"],["evidence",[["item-1",{"excerpt":"Started SSH alternate servers on high ports for persistent access, such as sshd_operns (on port 57722) on underlying Linux Shell or Guest Shell /usr/bin/sshd -p X","source":"https://blog.talosintelligence.com/salt-typhoon-analysis/"}]]],["display_name","sshd_operns"]]},{"anchors":{"0":"instance--c4de7165-e96f-5d84-b8c3-b0d687fbf832","120":"instance--98a11425-9ae9-56d3-b123-8ba790313ff0","150":"instance--b3c8c6c0-1371-5841-bccf-fa1157a5bb97","180":"instance--4704c163-8ea6-58cb-a975-6938b6cc58d3","210":"instance--29c7f4c2-170e-58fd-8d23-f1f27a170982","240":"instance--495bd3c8-6bc8-584f-9b33-569884301761","270":"instance--228be91b-8cca-527f-9c62-63271c58f216","30":"instance--cd4220d6-a31b-5b3d-acd