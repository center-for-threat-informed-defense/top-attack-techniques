1-46f10bcc32ea","instance--5c300dcf-812f-5cd2-a47d-53d2e5ba5bfc","instance--bbfb8efd-7c2c-5e82-a005-71d950ac566c","instance--20dd0581-fd35-53eb-a5d1-82c8b7df0c30","instance--515ababa-fbcc-572a-b21c-2b66db59558b","instance--f4c4dd3f-ebd7-5cf1-9ee2-1c982dbae93f","instance--e1e01f0f-6134-566c-8105-655ccf6a7f8f","instance--c64a49f0-e33c-53b4-94cb-94d210acaa41","instance--f4d08a4e-524e-583b-b5dd-8e8ed0ecd887","instance--0448942c-7ca4-5fa6-bba9-3178460d1043","instance--6de416e1-2f67-5f74-b9bc-d20cf1bf2983","instance--2850d926-f82c-5cfe-b9c2-7a67afc1979b","instance--02c6d3dd-6c37-5f7a-86d6-61ee0a8b009f","instance--2f52285b-8a29-5f56-86b7-3191b2ed4fd8","instance--afabf052-bf5e-51cf-8c93-56e3d032abd9","instance--970fda2d-53b1-5a85-ac32-b40479021255","instance--f32e4b9f-4ee8-516a-95f7-808c8772f849","instance--b9e641b2-3d57-5d79-84ea-3063cbc42808","instance--20b5c305-8f91-53bf-a366-f01262fc51f6","instance--36669816-75f8-5621-b1a1-96499043e59e","instance--7861db40-c40b-5303-833a-777d992a97a7","instance--02466228-5b95-5028-b112-f181c3fec0aa","instance--73827ee8-32c8-51b6-9e80-69b8292ace4b","instance--f295da6f-aa31-55b7-ba92-17be3b417c4e","instance--3d4917bc-af27-5207-9f96-5f63eb66fecf","instance--69d49b6c-350e-5175-8537-d5fdb688bd87","instance--310f70b0-2128-5278-a0d5-4de7174e710c","instance--fc62f1a7-1d8b-599d-b87e-397e2f36e132","instance--31eb8554-245f-5464-ad26-edb39e40faa6","instance--e78e731a-ba1e-53fb-b25b-178d29b442ac","instance--ee8f35fa-a3eb-5423-be5f-9a14f814c6a4","instance--ccb3703c-df26-5265-ada3-bb17881d4e35","instance--6f86ae95-6a30-56e0-92c9-213c4b512482","instance--5c9a6129-c476-514a-a977-47514ac4ab46","instance--5c99a991-3e7a-5c9c-9fb1-7de44deda1f4","instance--6c46f13d-8e03-58ad-a4ed-bc3a7ea55b9a","instance--6735667b-9bbd-5bf6-aa66-80684e945825","instance--1b24168e-1847-5b65-a3b8-a71d3f065c7e"],"properties":[["name","DarkGate malware campaign attack flow"],["description","Enter The DarkGate - New Cryptocurrency Mining and Ransomware Campaign"],["scope","campaign"],["author",[["name","Adi Zeligson"]]],["external_references",[["item-1",[["source_name","www.fortinet.com"],["url","https://www.fortinet.com/blog/threat-research/enter-the-darkgate-new-cryptocurrency-mining-and-ransomware-campaign"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Distribute malicious torrent/VBScript lure"],["description","We identified two distinct infection methods employed by the author of DarkGate, as well as the author of Golroted. Both infection methods are spread through Torrent files posing as a popular movie and a television series that then execute VBscript on the victim."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1204.002"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Drop unpacking files and run AutoIt"],["description","One of the unique techniques used by the DarkGate malware lies within its multi-stage unpacking method. The first file executed is an obfuscated VBScript file, which functions as a dropper and performs several actions. In the first stage, several files are dropped into a hidden folder . The files are autoit3.exe, which in some versions is disguised with a random name: test.au3, pe.bin and shell.txt. Next, test.au3 AutoIt script is executed using the dropped instance of autoit3.exe."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.005"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Create startup shortcut persistence"],["description","In the second phase, the AutoIt code creates a shortcut of itself with the name \u201cbill.ink\u201d under the startup folder."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.009"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Decrypt shellcode and execute via CallWindowProc"],["description","Once completed, it triggers a third stage in which the binary code stored in the file \u201cC:\\{computername}\\shell.txt\u201d is decrypted and then executed. The AutoIt script uses a rather unusual technique for executing the binary code. The steps involved in the technique are:\n\nLoads the binary code from shell.txt into the process memory\n\nCopies the data into an executable memory space (DLLStructCreate and DllStructSetData)\n\nInvokes CallWindowProc with reference to our binary code as the lpPrevWndFunc parameter"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1620"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Search Kaspersky executable and decrypt pe.bin"],["description","Finally, in the fourth and final stage of the unpacking technique, the binary code originally loaded from shell.txt performs the followings actions:\n\nSearches for the executable file, which is also the name of an executable found in Kaspersky AV.\n\nReads the dropped file \u201cpe.bin\u201d and decrypts it."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1518.001"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Load malware from shellcode if Kaspersky present"],["description","We discovered that if DarkGate detects the presence of Kaspersky AV, it loads the malware as part of the shellcode rather than using the process hollowing method."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1620"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Use process hollowing on vbc.exe"],["description","As shown in Figure 1, both malware variants perform the process hollowing method on the process vbc.exe."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1055.012"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Copy files to Program Data"],["description","The final binary copies all files from \u201cC:\\{computer_name} \u201c to a new folder under \u201cC:\\Program data\u201d with the name derived from the first eight digits of the user generated id (ID2 - explained later on)."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1574.001"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Create Run key persistence"],["description","The final binary installs a key in the registry designed to help it maintain persistency under the key: \u201c\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\u201d.\n\nThe key name is the first eight digits of the user-generated id, and the value is the AutoIt script that was copied from C:\\{computer_name} to the \u201cprogram data\u201d folder"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.001"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Connect to C2 to get miner payload"],["description","The first connection the malware makes to the C&C server is to get the file it needs to start the cryptocurrency mining process."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Start miner and hollow systeminfo.exe"],["description","As shown in Figure 9, the command \u201cstartminer\u201d is sent as part of the response in order to tell the malware to start mining and to separate the different parts of the message. The first part is encrypted into config.bin - that is the miner command line. The second part is written in cpu.bin, and when decrypted is the miner executable. The mining itself is done through the process \u201csysteminfo.exe\u201d by using process hollowing."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1055.012"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Monitor wallet window names and notify server"],["description","Another capability of the malware is that it can search for, and steal, credentials for crypto wallets. The malware looks for specific strings in the names of windows in the foreground that are related to different kinds of crypto wallets, and if a matching string is found, sends the server an appropriate message."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1010"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Communicate with hard-coded disguised domains"],["description","The malware contains six hard-coded domains, shown below, which it attempts to communicate with upon infection. It looks like the domains are chosen carefully to disguise the C&C server as a known legitimate service, such as Akamai CDN or AWS, and avoids looking suspicious to anyone who may be monitoring the network traffic.\n\nakamai.la\n\nhardwarenet.cc\n\nec2-14-122-45-127.compute-1.amazonaws.cdnprivate.tel\n\nawsamazon.cc\n\nbattlenet.la\n\na40-77-229-13.deploy.static.akamaitechnologies.pw"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1071.001"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Check disk and RAM for VM"],["description","In Figure 10, we can see the use of Delphi\u2019s Sysutils::DiskSize and GlobalMemoryStatusEx for collecting both disk size and physical memory. If the machine contains less than 101GB of disk space, or has an amount of RAM less than or equal to 4GB, it will be considered as a VM and the malware will automatically terminate."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1497.001"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Terminate IObit AV processes"],["description","IOBit: If the path \u201cC:\\\\Program Files (x86)\\\\IObit\u201d exists, the malware is going to try and tackle a process named \u201cmonitor.exe\u201d by terminating it. Additionally, it will spawn a new thread that repeatedly looks for the process \u201csmBootTime.exe\u201d and terminate the process if it exists."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Detect recovery tools and reallocate files"],["description","If such a process is found, the malware will initiate a new thread that will reallocate the malware files every 20 seconds, making sure that if the files were deleted during the lifetime of a recovery tool they will be recreated and relocated somewhere else."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1070.004"}]]},{"anchors":{"0":"instance--dbfe6415-cd2c-55f2-9509-06b6668ef23a","120":"instance--79ca45e2-afd7-51fa-9574-5085c7de4c84","150":"instance--39171cfe-3bf6-5200-b6f5-e97e3b047db7","180":"instance--8cda146b-7259-56b2-b337-56038a1f52d3","210":"instance--a662f8bf-2723-58c0-a1a8-9af9497cf428","240":"instance--a9b75b15-3be0-5e64-8132-40b87e7ae405","270":"instance--31896ecd-322b-5a41-bd1e-0b7a30b9d9d1","30":"instance--60868276-2726-597d-8f57-8aa7fc9c0738","300":"instance--4f5668fa-b6ef-57cc-93da-5cd1e1727a22","330":"instance--b022a562-9020-587c-a5be-97d254cc8f11","60":"instance--cf452b0f-192e-5357-ba8c-fbae1a6e4ae0","90":"instance--012cc6fc-0a37-5e6e-b9b7-07f3bcd2d02c"},"id":"action","instance":"attack-action--17","properties":[["name","Bypass ntdll with direct syscalls"],["description","The Darkgate malware avoids loading the ntdll.dll functions the proper way, and instead creates its own \u201cKiFastSystemCall\u201d function that will make the syscall.\n\nThe DarkGate malware will pass to the assigned function the ntdll requested function syscall number and the needed parameters. This way, a kernel function is called without the need to call the function from within ntdll.dll. To conclude, the DarkGate malware creates its own \u201cKiFastSystemCall\u201d to bypass ntdll.dll."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1106"}]]},{"anchors":{"0":"instance--a73f63ad-1c10-59c2-82aa-bef4ae8f64e0","120":"instance--62757838-a58e-5d41-b7e3-1ccc64e8cdbf","150":"instance--3462202b-a91d-5325-abfe-876a63049484","180":"instance--72959cd4-5e05-5d69-a145-8b6f35720646","210":"instance--d3b85082-8de6-5ffd-8abe-c9e1ec43f533","240":"instance--0a22ffab-8bbc-55b1-85ec-df74e4a120f6","270":"instance--548b3ba1-955f-5e04-b6e8-064cc259e7a6","30":"instance--6f0a37c5-db81-5459-92c1-bc8ab8cd1fd3","300":"instance--e81be898-f7c2-56a0-a705-d2aba8831f75","330":"instance--8f207ed6-cb63-551c-9a40-583fac14fe80","60":"instance--8b44546f-f8e4-5d12-b172-99f9507395eb","90":"instance--f61db455-1665-504d-85b4-5fd5d40fbcc2"},"id":"action","instance":"attack-action--18","properties":[["name","UAC bypass via DiskCleanup"],["description","The first UAC bypass technique exploits a scheduled task called DiskCleanup. This scheduled task uses the path to execute the actual binary. Therefore, the malware overrides the environment variable with the registry key: with an alternative command, which will execute the AutoIt script."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1548.002"}]]},{"anchors":{"0":"instance--223a73a7-07a6-5688-bc70-e7fbf2c8afd4","120":"instance--2184e59f-b6bd-5ca7-8254-3872e152a964","150":"instance--eed82efc-7573-5ccf-97d8-e3f88a2337bb","180":"instance--453ded0c-8246-59f2-a14f-beca9e751cd6","210":"instance--143e4619-312d-5cbc-acc5-efed5f6c0164","240":"instance--659cf4a8-ca80-5204-8b8d-3240f6f370da","270":"instance--2dac3e32-a8df-582e-845a-3a7b1d510c1d","30":"instance--6ab42faa-5ba5-5c44-b387-40b1d021e500","300":"instance--96e5ad82-e4af-5995-8b69-6df7d7ce2490","330":"instance--a960fdd4-4889-5426-a406-4761d11be5ab","60":"instance--42df375f-d3e2-5d47-9faa-324aecbbf064","90":"instance--51395417-94d2-5b5a-881c-7b6cc63ade4e"},"id":"action","instance":"attack-action--19","properties":[["name","UAC bypass via eventvwr registry hijack"],["description","Another UAC bypass exploits the fact that eventvwr.exe, by default, runs in high integrity, and will execute the mmc.exe binary (Microsoft Management Console). The mmc.exe command is taken from the registry key \u201cHKCU\\Software\\Classes\\mscfile\\shell\\open\\command\u201d. This registry key is also writable from a lower integrity level, which enables it to execute an AutoIt script in a higher integrity."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1548.002"}]]},{"anchors":{"0":"instance--25dacfeb-3a3d-51fc-91b7-64ee405fe041","120":"instance--5a984174-ce49-510d-b6b6-d4f0e0ee332f","150":"instance--f2167f56-1cf9-5fea-a726-d003a591d391","180":"instance--70c47af3-1817-5ae2-9f6e-38421d85f808","210":"instance--cfd506cd-f673-5f4f-a5ff-5854ad8a39d5","240":"instance--b78e4cb3-2b2b-5706-8d59-d252dd134505","270":"instance--73410cfd-8533-5545-94b7-c06859fcd4a8","30":"instance--760fe684-ea1e-52a0-87e8-fa0bc5d62d70","300":"instance--fa30f213-64f3-55b5-85cd-9dbf46e0e8dc","330":"instance--0dbe5c9b-c2db-5139-a300-8054f3a8e205","60":"instance--a78137f8-a78e-563e-ad44-749594629166","90":"instance--626b6c26-479d-5895-a619-ee3dbb14136d"},"id":"action","instance":"attack-action--20","properties":[["name","Start keylogging thread"],["description","A thread is started that is responsible for capturing all keyboard events and then logging them to a predefined log file. Other than logging the key logs, it also logs the foreground windows and the clipboard. The log is saved with the name \u201ccurrent date.log\u201d in the following directory listed below:\n\n\u201cC:\\users\\ {username}\\appdata\\roaming\\{ID1}\u201d."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1056.001"}]]},{"anchors":{"0":"instance--93ee4f51-8321-58fb-b05f-3a6fd3a6a8ab","120":"instance--02ee2d77-fc8c-55cc-8958-e3d0b5ead581","150":"instance--15aaf9f3-3996-5f9b-bee4-47f2963a0df4","180":"instance--1ae13e0a-be4e-5658-ba6d-c941c0d5cafb","210":"instance--87590098-5adb-5af7-aa75-039447d58b2b","240":"instance--87dee187-bf66-5b52-81e0-15b789ab6a7c","270":"instance--25c474c1-a795-5124-95ce-3e6163b067d2","30":"instance--ae371f09-8eae-53a7-a14c-34f9e72904fd","300":"instance--9ecc9c80-603d-5760-b2b6-f850dfd3eddf","330":"instance--b9543d3c-a7f9-50a6-b8a1-3fd4c6dddd56","60":"instance--cba1b44c-d7c9-5ebb-8433-b63b0b91427c","90":"instance--1c5f2ea2-c075-51ba-9f13-69b716c352cf"},"id":"action","instance":"attack-action--21","properties":[["name","Hollow vbc.exe or regasm.exe with NirSoft tools"],["description","DarkGate uses some of the NirSoft tools in order to steal credentials or information from infected machines. The toolset that is used enables it to steal user credentials, browser cookies, browser history, and Skype chats. All tools are executed using the process hollowing technique into a newly created instance of vbc.exe or regasm.exe.\n\nDarkGate uses the following applications to steal credentials:\n\nMail PassView\n\nWebBrowserPassView\n\nChromeCookiesView\n\nIECookiesView\n\nMZCookiesView\n\nBrowsingHistoryView\n\nSkypeLogView"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1055.012"}]]},{"anchors":{"0":"instance--da12a10e-e9d8-58e0-9dda-e871f0fcaf7c","120":"instance--6e98f91f-940c-5b7d-8e4e-950f2c88b044","150":"instance--02b3e90f-a9f8-5908-b936-c779b2c570d8","180":"instance--5c256240-99ff-5907-aca7-0f81639a7419","210":"instance--e42c995a-6770-583f-9a60-afcdf41d5501","240":"instance--eee0e52c-22be-5b9b-819e-097b65b643d8","270":"instance--d4973194-aaba-5ce5-99ba-7d7c8bca7b50","30":"instance--91b449e9-d343-56d1-9376-8a2655b8032b","300":"instance--23579e20-df5a-5dad-9088-26b612c3c5aa","330":"instance--2ed64056-576c-519d-b8c7-4e1f2c06b6e9","60":"instance--c59d1168-f011-5687-803d-27aa797d72e2","90":"instance--321449b3-3e1e-5b4b-aab6-507e5ad1c36c"},"id":"action","instance":"attack-action--22","properties":[["name","Extract stolen data from hollowed process memory"],["description","The resulting data collected from the tools is extracted from the hosting process memory. DarkGate malware first looks for the tool\u2019s window by using The FindWindow API function. It then uses the SysListView32 control and the sendMessage API function in order to retrieve the information needed from the tool. The retrieval works by first allocating a memory buffer in the hollowed process, as shown in Figure 17.\n\nIt will then use the \u201cGetItem\u201d function to make it write the item to the allocated buffer. The \u201cGetItem\u201d function is used by calling the API function \u201cSendMessage\u201d with the message \u201cLVM_GETITEMA\u201d and the allocated buffer as a parameter:\n\nAfter the item is written to the allocated buffer, it will then read this memory region to retreive stolen information."],["confidence",0.0],["ttp",{"tactic":"TA0009","technique":"T1005"}]]},{"anchors":{"0":"instance--9f68185c-8d0f-5e34-b869-da9c17407e5d","120":"instance--99f65057-0748-5b22-b7a8-859b8cb9d46c","150":"instance--1c6c577b-3682-579f-9d80-c1a4c9632dd5","180":"instance--0372a821-a640-58c2-a8f9-f391b8fb0045","210":"instance--bd12903c-f92d-5416-a20f-eedd38d108f9","240":"instance--a221d4df-2c16-5e25-a121-f7cfbb303fb7","270":"instance--550d9be5-209a-50fa-99b8-4dfe7669b693","30":"instance--042db59c-d5d0-5002-ac74-85e947cc6579","300":"instance--2ce3cd55-fc34-5aac-8112-e6cc8fcd707a","330":"instance--55903f51-17c6-554e-8180-6f2511efa2b6","60":"instance--2b4af278-cf58-556d-9fa5-254ca76fcb98","90":"instance--a84c2c43-a2a5-5904-906d-da6a186887bd"},"id":"action","instance":"attack-action--23","properties":[["name","Delete shadow copies"],["description","The malware has the ability to delete all restore points, including \u201ccmd.exe /c vssadmin delete shadows /for=c: /all /quiet\u201d"],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1490"}]]},{"anchors":{"0":"instance--08881caf-1468-53e2-baa3-c9da43e73b47","120":"instance--5344d679-b2e1-5528-bed5-6fe3fbc90036","150":"instance--f1a3ca80-d761-5917-981a-9d35e6a5161e","180":"instance--bb22e51a-29ce-531e-b80e-4a1d5343b453","210":"instance--380340c8-8f15-5075-a390-ac1b2706e43f","240":"instance--b8ca794c-8bea-5f4c-a746-ad3b31fd2d36","270":"instance--fb5c8b1f-7cc5-58a3-a457-0edfdefa168c","30":"instance--a124cc0a-728c-5b30-8b8b-2171584014e7","300":"instance--7d09cfe0-ac57-5093-a7ce-7c31042d3449","330":"instance--829e634f-5069-5370-8381-e0687a22b00e","60":"instance--0fbffc26-a516-5fcd-9fff-e9aee12c6467","90":"instance--96917b9c-4649-5345-82ac-b4e793881bfe"},"id":"action","instance":"attack-action--24","properties":[["name","Install RDP tool and create admin user"],["description","This command will decrypt and execute the received file, which is probably an rdp connection tool, using the process hollowing method. The hollowed process in this case is a copy of systeminfo.exe in the %temp% directory.\n\nIn addition, the following commands will be executed using cmd.exe:\n\nexe /c net user /add SafeMode Darkgate0!\n\nexe /c net localgroup administrators SafeMode /add\n\nexe /c net localgroup administradores SafeMode /add\n\nexe /c net localgroup administrateurs SafeMode /add"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1136.001"}]]},{"anchors":{"0":"instance--6e9515e3-2497-5444-80ce-9466679d2504","120":"instance--25d30ffe-4a4f-53ec-a34d-de6cc58a2fb0","150":"instance--43abd457-ad7e-5db6-b146-d159a2936c52","180":"instance--f22410a7-1bbd-5943-9121-cf9edb5a0991","210":"instance--4a2a2f86-5543-5514-866c-4d5f4f5bcb3b","240":"instance--f2011b06-5138-5056-a1f2-0a96e9738966","270":"instance--a9d1b1c1-44f0-5281-b6b0-9133e0a433dd","30":"instance--c9339355-ad0b-5e98-9f42-ef0c11d380dd","300":"instance--dec744bc-b6ae-5258-bcb1-83f01a7bb747","330":"instance--54f63fd7-f831-5401-a04f-600f5e780c31","60":"instance--1dd30294-3434-540a-8b5f-d8bc1e3de794","90":"instance--e414165a-d829-5c22-ab74-6aa5e50c83d3"},"id":"action","instance":"attack-action--25","properties":[["name","Collect host profiling data and write Install.txt"],["description","The server can request the following details about the victim:\n\nLocale\n\nUser name\n\nComputer name\n\nWindow name\n\nTime, representing the period of time that passed since the last input on the host\n\nProcessor type\n\nDisplay adapter description\n\nRAM amount\n\nOS type and version\n\nIs user admin\n\nThe encrypted content of config.bin\n\nEpoch time\n\nAV type \u2013 search by process name. If not found, this field will contain the text \u201cUnknown\u201d.\n\nIn some versions it will also look for the folder \u201cc:\\Program Files\\e-Carte Bleue\u201d (we think that might be the folder where DarkGate saves its screenshots). The data is then encrypted and sent to the server. In addition, it creates the file Install.txt under the %appdata% path and writes the Epoch time in it."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1082"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","We discovered that if DarkGate detects the presence of Kaspersky AV, it loads the malware as part of the shellcode rather than using the process hollowing method."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","We discovered that if DarkGate detects the presence of Kaspersky AV, it loads the malware as part of the shellcode rather than using the process hollowing method."]]},{"anchors":{"0":"instance--64fa8274-9976-53b9-811c-a0e7e805b799","120":"instance--ce384754-4013-5515-ac17-4456e1d80bbb","150":"instance--99275651-db0d-57ec-a13c-6e557a4b9c7c","180":"instance--cbaa25ac-4f14-51f0-9962-f76fe36e7cd6","210":"instance--1c4fda5b-4605-5040-a88a-48f1df4144aa","30":"instance--39743932-1858-5655-a859-b27c0902b87a","330":"instance--c116df79-3c10-5931-96ec-25b4174ae13a","60":"instance--75b926aa-d189-5cd6-bc7b-5a947c88de41","90":"instance--4931e63d-9e52-5183-bbd8-7db1814b0f21","branch:False":"instance--fc00a7ae-0a9a-58b7-b24a-5def4ea9feab","branch:True":"instance--e3424864-637f-5b96-b87c-a8dcc22d8b9e"},"id":"condition","instance":"attack-condition--3","properties":[["description","In Figure 10, we can see the use of Delphi\u2019s Sysutils::DiskSize and GlobalMemoryStatusEx for collecting both disk size and physical memory. If the machine contains less than 101GB of disk space, or has an amount of RAM less than or equal to 4GB, it will be considered as a VM and the malware will automatically terminate."]]},{"anchors":{"0":"instance--36aad375-d405-5e3b-9a7d-4346c75c9f45","120":"instance--acc72955-e581-59b3-80b5-35fb047df4b8","150":"instance--d5d0ec7c-da1b-5d39-86e4-8de8792ab05d","180":"instance--047e7862-d9c4-5716-b778-899a86595b48","210":"instance--650a6d3c-5cb0-5f82-83ec-c5d828e2502b","240":"instance--3f08654d-fd5e-59cb-af47-8bbcee29de39","270":"instance--e175549d-38ff-5527-bdb8-de5e1a12f356","30":"instance--c6e60459-b005-50cd-9e68-66ef210b5456","300":"instance--f90b34f0-8620-5a56-9e11-4db2b889aac4","330":"instance--93872aee-cf81-52fa-aa93-f7a84a833dbd","60":"instance--5a877a06-3649-5bba-9461-5faee75ea842","90":"instance--68af6616-0e27-5395-b4ff-5d95b55a2405"},"id":"OR_operator","instance":"attack-operator--1","properties":[["operator","OR"]]},{"anchors":{"0":"instance--9e5939ac-0560-5dca-ad25-c9607e86dc4b","120":"instance--c060bad1-9923-5621-b2d7-b38fc696bba8","150":"instance--03cd5849-6c41-57f6-80ba-ccc261016db3","180":"instance--e346621f-c72e-5e63-b6a7-4b4782809c4d","210":"instance--ac89e20d-d181-5c21-9665-b6d0be6d9c25","240":"instance--71dfb27c-fc87-5337-a1dd-d4ce53ed3818","270":"instance--c31cc4cc-4bba-5869-beec-559e442abb36","30":"instance--f0e0fc32-8a6d-5005-a859-3149732ce565","300":"instance--200887fb-a1bb-5bb2-b203-53b87a22a190","330":"instance--8b65f31d-4181-5d9a-9075-fdcff38b710b","60":"instance--4dfaea41-7b88-510b-8a2c-bf066ac578b2","90":"instance--a0f05d11-26cc-59ff-a09e-d73374e31c7c"},"id":"file","instance":"file--torrent-vbe","properties":[["value","the-walking-dead-9-5-hdtv-720p.torrent.vbe"],["evidence",[["item-1",{"excerpt":"The second file, the-walking-dead-9-5-hdtv-720p.torrent.vbe, uses a more trivial approach to infecting victims.","source":"https://www.fortinet.com/blog/threat-research/enter-the-darkgate-new-cryptocurrency-mining-and-ransomware-campaign","source_field":"normalized_text"}]]],["display_name","the-walking-dead-9-5-hdtv-720p.torrent.vbe"],["name","the-walking-dead-9-5-hdtv-720p.torrent.vbe"]]},{"anchors":{"0":"instance--4ce7b70d-ae6b-55bf-bf80-cc2cbd3e8e2e","120":"instance--53db682e-2e07-5310-84e1-33b4d4346317","150":"instance--c78be635-83bf-56e0-b7c4-6900e952bbc6","180":"instance--22a740e3-de2a-5ecd-b0b0-5ef269f27181","210":"instance--6c74c0c6-7321-5dc7-85be-d5dd9f0c83ed","240":"instance--6be6f04f-a21d-5cc8-a9b3-f2f7f5ed74de","270":"instance--eb11bd09-0a68-5a83-9d4e-6c33bb1bcb9a","30":"instance--202f672c-49de-5a0c-9ae4-aaedb571f6ef","300":"instance--d24409bf-7087-5b0d-88a4-6cafeaa918f7","330":"instance--213cda02-2e09-5211-8f33-b914718558f1","60":"instance--516f88bf-dd3f-5de5-8d39-be860596f394","90":"instance--6b7ad1f4-d449-5b4a-968a-ee00d0d7eeb3"},"id":"malware","instance":"malware--vbs-dropper","properties":[["is_family","false"],["evidence",[["item-1",{"excerpt":"The first file executed is an obfuscated VBScript file, which functions as a dropper","source":"https://www.fortinet.com/blog/threat-research/enter-the-darkgate-new-cryptocurrency-mining-and-ransomware-campaign","source_field":"normalized_text"}]]],["display_name","obfuscated VBScript file"]]},{"anchors":{"0":"instance--9c107b1b-53d3-5b51-b098-fa73435268f0","120":"instance--9d5502ad-52fd-5f3b-9c03-f39cefbe4f54","150":"instance--b740a8b3-82f2-5d43-99d4-68abe868d0f5","180":"instance--0abbd710-26b3-507c-b54b-63c52f58ea8f","210":"instance--452d375b-542a-5f5a-bda0-ac588d165cab","240":"instance--ccc68a12-7c12-5e7e-85c2-3df8f4208c3b","270":"instance--48cad67c-6743-5af3-ac7c-5e18873b1c52","30":"instance--615b9dc6-b661-50e1-9450-b92c47509e1b","300":"instance--14c975f0-f35c-54ed-a1f8-3566ea3e4055","330":"instance--95e4c009-0c86-5539-aea2-71a5bb809588","60":"instance--1f2e89d9-e1b6-5517-9563-2380ef209cce","90":"instance--518526c6-9912-57d7-b1c4-fb24fc5abc92"},"id":"software","instance":"software--autoit3","properties":[["vendor","AutoIt"],["evidence",[["item-1",{"excerpt":"The files are autoit3.exe","source":"https://www.fortinet.com/blog/threat-research/enter-the-darkgate-new-cryptocurrency-mining-and-ransomware-campaign","source_field":"normalized_text"}]]],["display_name","autoit3.exe"],["name","autoit3.exe"]]},{"anchors":{"0":"instance--93378b93-1