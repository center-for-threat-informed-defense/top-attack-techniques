{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-condition--1","attack-condition--2","attack-operator--1","email-message--1","file--1","url--1","software--1","instance--f5abc6ee-5e42-5b31-bf5f-1f6c6f6fd16e","instance--e4f1265c-0d37-5abf-962e-f3c62b611a74","instance--f749e06d-1659-5572-b731-b60ef8fd4b2d","instance--ad1f125b-7701-5e9d-b869-79f40471648d","instance--dba76cba-ac10-53fc-8651-9c93dbcacdf3","instance--447a27ab-1541-5ade-b50d-bd1caecded2d","instance--56da8838-1109-5fce-9d89-7b3ec32d7010","instance--714f6cb9-bdb0-5e83-914a-3c8158d9f2de","instance--e1fdbfcc-98c5-5401-a510-7f70aaad43ca","instance--d110b130-8c28-5cb4-98a0-76aaa8233093","instance--e28c61d0-be08-595d-b694-80935ffe4433","instance--f73cb290-6345-5dc5-af08-9677f9bb8434","instance--5c474795-7a46-5c6c-af4d-203928d704a3","instance--03a46723-5271-5abc-85a3-2206cd087765","instance--bb170793-a0b8-5a22-b9f9-5dff26468abb","instance--be236689-232e-5160-8f58-e357acd63845","instance--f72c1729-3e7b-5c89-a3d7-54a4bd254178","instance--5313ad17-377c-53ac-a7eb-3ebc6a52c3a9"],"properties":[["name","Token Bingo: Don\u2019t Let Your Code be the Winner"],["description","Arctic Wolf recently observed a large scale device code phishing campaign leveraging the Kali365 phishing\u2011as\u2011a\u2011service platform to obtain initial access and conduct follow-on activity."],["scope","campaign"],["author",[["name","Arctic Wolf"]]],["external_references",[["item-1",[["source_name","arcticwolf.com"],["url","https://arcticwolf.com/resources/blog/token-bingo-dont-let-your-code-be-the-winner/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Deliver phishing lure"],["description","While the lure themes varied across victims, the underlying mechanics remained consistent. The threat actor delivered the lure via email containing a malicious attachment or hyperlink that redirected the victim to Microsoft\u2019s legitimate device authorization page."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Redirect victim to device login"],["description","In device code mode, victims are redirected to an obfuscated landing page that is designed to only render in a real browser session. Upon page load, the Kali365 backend dynamically generates a legitimate Microsoft OAuth device code and displays it to the victim alongside instructions to authenticate at ."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1646"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Capture OAuth tokens"],["description","Captured OAuth access and refresh tokens enabled immediate mailbox access and post\u2011compromise activity."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1528"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Access mailbox"],["description","Captured OAuth access and refresh tokens enabled immediate mailbox access and post\u2011compromise activity."],["confidence",0.0],["ttp",{"tactic":"TA0009","technique":"T1114"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Create malicious inbox rules"],["description","Following initial access, Arctic Wolf observed cases in which the threat actor created malicious inbox rules within Microsoft 365. The threat actor configured rules that automatically moved emails containing keywords such as \u201cspam,\u201d \u201cphish,\u201d \u201cclick,\u201d \u201clink,\u201d and \u201cSharePoint\u201d to a separate folder and marked them as read. This behavior effectively suppressed security-related notifications and user warnings, enabling the threat actor to maintain access while reducing the likelihood of detection."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1114.003"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Register additional device"],["description","In some cases, following token acquisition, the threat actor would use the authenticated session to register an additional device within the victim\u2019s Microsoft environment. This step extended access beyond the initial token by establishing a trusted device association tied to the compromised account."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1098"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","redirected the victim to Microsoft\u2019s legitimate device authorization page."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","Upon page load, the Kali365 backend dynamically generates a legitimate Microsoft OAuth device code and displays it to the victim"]]},{"anchors":{"0":"instance--36aad375-d405-5e3b-9a7d-4346c75c9f45","120":"instance--acc72955-e581-59b3-80b5-35fb047df4b8","150":"instance--d5d0ec7c-da1b-5d39-86e4-8de8792ab05d","180":"instance--047e7862-d9c4-5716-b778-899a86595b48","210":"instance--650a6d3c-5cb0-5f82-83ec-c5d828e2502b","240":"instance--3f08654d-fd5e-59cb-af47-8bbcee29de39","270":"instance--e175549d-38ff-5527-bdb8-de5e1a12f356","30":"instance--c6e60459-b005-50cd-9e68-66ef210b5456","300":"instance--f90b34f0-8620-5a56-9e11-4db2b889aac4","330":"instance--93872aee-cf81-52fa-aa93-f7a84a833dbd","60":"instance--5a877a06-3649-5bba-9461-5faee75ea842","90":"instance--68af6616-0e27-5395-b4ff-5d95b55a2405"},"id":"OR_operator","instance":"attack-operator--1","properties":[["operator","OR"]]},{"anchors":{"0":"instance--20bbe9f2-ac00-5017-9562-e92ae507e48d","120":"instance--2e844599-4e31-5871-a7c7-04a9c6ce5691","150":"instance--af5a54f1-2b8c-545d-ab59-74cfcebc16f4","180":"instance--c5b59f65-14ce-5c4a-a55a-13ec896deba8","210":"instance--4eb49c2e-b94f-5fdb-a122-d3d8ef90a239","240":"instance--f44660ee-8226-5061-bd29-40feb73e9125","270":"instance--e53b4d9e-5807-50d1-8720-771760b10cc8","30":"instance--730673ac-abcd-57b3-beb5-b2a2dc74a310","300":"instance--1f38467e-7168-5f0b-afe0-9b6769dfade6","330":"instance--d12be42a-ab98-5684-af05-3cad546477bb","60":"instance--96b259a7-f838-5604-a32e-dff12cea472e","90":"instance--01fc9195-8db0-5e99-9765-45e395d2a35a"},"id":"email_message","instance":"email-message--1","properties":[["evidence",[["item-1",{"excerpt":"The threat actor delivered the lure via email containing a malicious attachment or hyperlink","source":"https://arcticwolf.com/resources/blog/token-bingo-dont-let-your-code-be-the-winner/"}]]],["display_name","phishing lure email"],["is_multipart","false"]]},{"anchors":{"0":"instance--8cf549a5-7e7d-51cf-9368-9b5e0744592a","120":"instance--06d4fda8-e0bf-574e-b3d8-a62c4