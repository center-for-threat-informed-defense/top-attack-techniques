{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-condition--1","attack-condition--2","attack-condition--3","attack-condition--4","attack-operator--1","instance--7797ff9e-6685-5e18-adfb-c4d44716e06f","instance--aaa15696-eba1-5630-abe7-6eeb65da1682","instance--becc7795-37fe-5653-834c-15b423ef23c9","instance--f5abc6ee-5e42-5b31-bf5f-1f6c6f6fd16e","instance--97e574a5-92d4-5163-ac78-745f57a910e4","user-account--1","file--1","instance--cd8e2e12-554c-5e0b-9908-bf5d0aaae299","instance--e4f1265c-0d37-5abf-962e-f3c62b611a74","instance--83ef7deb-c0da-554d-9571-60d519b4f83b","instance--ff8882dc-12bb-5d7f-a769-b6d7c321c8c7","file--3","instance--75bd3552-9387-5001-9510-8bba3a3bc0c6","instance--f749e06d-1659-5572-b731-b60ef8fd4b2d","instance--2845534b-6c43-591d-afe7-16ae71eb4cf3","instance--fbe5dafa-8864-524c-b765-e813b0a87575","file--4","instance--ad1f125b-7701-5e9d-b869-79f40471648d","instance--dba76cba-ac10-53fc-8651-9c93dbcacdf3","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--07366c05-010c-55f4-b2f6-81ccbe62b684","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--68b2abb9-9316-5753-906b-3b549b6a5232","instance--4a5ea725-c4a7-5df9-9998-686e551226c2","instance--bf92daee-b543-510b-8cc5-ba4de9746694","instance--afab344e-9d8c-5f53-9094-3c4e35082ca0","instance--d23a7e3b-28ba-5c82-b661-c8eb109d42d1","instance--b6301b03-e1db-5d07-8b01-10b9d63abc5a","instance--1fa3126a-bb58-563e-a616-464bda46b52f","instance--458b9052-de4d-5b30-bc79-d8e8797debaf","instance--d67df2e3-f239-5084-b92d-d2446dc8f121","instance--be236689-232e-5160-8f58-e357acd63845","instance--2a72f600-f7dc-5393-ac3a-68a1d9e35644","instance--98eb7e72-c8b6-527a-b66d-8ebdcc852fa5","instance--57744d96-f386-5ec7-aeae-ca8155ad2e09","instance--399a759f-97f7-528c-90c7-de3363f46907","instance--f72c1729-3e7b-5c89-a3d7-54a4bd254178","instance--8b2d22b3-0926-5c8b-b33c-11aa887f5387","instance--a16e1ef6-00fd-5f84-9d14-12c26b402614","instance--a9cbb70f-e5da-5463-9bd4-f7b119736a04","instance--6298e0ca-8198-59e9-b0c0-9ae0e17c9601","instance--5313ad17-377c-53ac-a7eb-3ebc6a52c3a9","instance--fd519b8d-7f83-59ee-bd61-363db65ca388","instance--286ae2b5-dd65-59c2-808e-f0dd99d4271c","instance--9fe04e91-e3e9-5f29-bad4-5d44b8bb533a"],"properties":[["name","MailSniper Exchange OWA and EWS attack procedures"],["description","Blog text describing use of MailSniper modules against externally facing Exchange OWA or EWS portals to enumerate the Global Address List and perform password spraying."],["scope","incident"],["author",[["name","Unknown"]]],["external_references",[["item-1",[["source_name","www.blackhillsinfosec.com"],["url","https://www.blackhillsinfosec.com/attacking-exchange-with-mailsniper/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Collect email addresses or usernames"],["description","Very often on external penetration tests we perform a reconnaissance phase that might yield us some email addresses or usernames of an organization."],["confidence",0.0],["ttp",{"tactic":"TA0043","technique":"T1589.003"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Download the Global Address List from OWA"],["description","There is a function called FindPeople that will allow you to pull back the entire GAL with a single request. Unfortunately, this function is only implemented in Exchange version 2013. In testing, Get-GlobalAddressList that utilizes the FindPeople function was able to pull 4282 email addresses from a remote OWA portal in 10 seconds."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1087.004"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Enumerate GAL from EWS"],["description","For cases where the Exchange version is less than 2013 Get-GlobalAddressList fails back to enumerating the GAL from Exchange Web Services. This method can take a bit longer due to the fact that EWS will only let you search 100 results at a time. To get around this restriction I basically search AA through ZZ then sort/uniq the results."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1087.004"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Run Get-GlobalAddressList with credentials"],["description","To use it import the module into a PowerShell version 3 session then run something like this:\n\nGet-GlobalAddressList -ExchHostname mail.domain.com -UserName\n\ndomain\\username -Password Fall2016 -OutFile global-address-list.txt"],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.001"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Password spray user accounts over OWA"],["description","To use Invoke-PasswordSprayOWA import the module into a PowerShell version 3 session then run something like this:\n\nInvoke-PasswordSprayOWA -ExchHostname mail.domain.com -UserList\n\n.\\userlist.txt -Password Fall2016 -Threads 15 -OutFile owa-sprayed-creds.txt"],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1110.003"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Password spray user accounts over EWS"],["description","To use Invoke-PasswordSprayEWS import the module into a PowerShell session then run something like this:\n\nInvoke-PasswordSprayEWS -ExchHostname mail.domain.com -UserList\n\n.\\userlist.txt -Password Fall2016 -Threads 15 -OutFile ews-sprayed-creds.txt"],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1110.003"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","If we can successfully find valid credentials for any one of them, and the organization has an Outlook Web Access or Exchange Web Services portal it is possible to download the entire Global Address List from the Exchange server."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","Unfortunately, this function is only implemented in Exchange version 2013. For cases where the Exchange version is less than 2013 Get-GlobalAddressList fails back to enumerating the GAL from Exchange Web Services."]]},{"anchors":{"0":"instance--64fa8274-9976-53b9-811c-a0e7e805b799","120":"instance--ce384754-4013-5515-ac17-4456e1d80bbb","150":"instance--99275651-db0d-57ec-a13c-6e557a4b9c7c","180":"instance--cbaa25ac-4f14-51f0-9962-f76fe36e7cd6","210":"instance--1c4fda5b-4605-5040-a88a-48f1df4144aa","30":"instance--39743932-1858-5655-a859-b27c0902b87a","330":"instance--c116df79-3c10-5931-96ec-25b4174ae13a","60":"instance--75b926aa-d189-5cd6-bc7b-5a947c88de41","90":"instance--4931e63d-9e52-5183-bbd8-7db1814b0f21","branch:False":"instance--fc00a7ae-0a9a-58b7-b24a-5def4ea9feab","branch:True":"instance--e3424864-637f-5b96-b87c-a8dcc22d8b9e"},"id":"condition","instance":"attack-condition--3","properties":[["description","After obtaining the full email list you can then feed that back into password spraying attacks where you will likely gain more valid credentials."]]},{"anchors":{"0":"instance--1a1159e3-7134-5cb2-b831-1c9e4cadc724","120":"instance--267651df-0a90-5013-a3f3-6a84f327fdce","150":"instance--ff657c73-da26-5719-b71e-26c6d439031b","180":"instance--57de1597-7c4d-5cea-858a-0c984a9a171c","210":"instance--4e82ed67-17c4-52f1-909c-1dcc5361a3a3","30":"instance--a8f9c850-7ea4-5848-8bf2-8fcc9e5d1187","330":"instance--b9c275ec-317e-5c35-ad9b-15ea68ddb80f","60":"instance--72f37cb0-dd26-5fa0-ac8f-323618da5271","90":"instance--834e4696-439e-5c16-8a92-b41255545c1d","branch:False":"instance--3a265f8f-b632-5d4a-b23f-b7db066758c0","branch:True":"instance--2dae2452-f4f4-5245-88fb-66b07135437e"},"id":"condition","instance":"attack-condition--4","properties":[["description","You should start to see credentials populate in the terminal as MailSniper finds valid creds:"]]},{"anchors":{"0":"instance--36aad375-d405-5e3b-9a7d-4346c75c9f45","120":"instance--acc72955-e581-59b3-80b5-35fb047df4b8","150":"instance--d5d0ec7c-da1b-5d39-86e4-8de8792ab05d","180":"instance--047e7862-d9c4-5716-b778-899a86595b48","210":"instance--650a6d3c-5cb0-5f82-83ec-c5d828e2502b","240":"instance--3f08654d-fd5e-59cb-af47-8bbcee29de39","270":"instance--e175549d-38ff-5527-bdb8-de5e1a12f356","30":"instance--c6e60459-b005-50cd-9e68-66ef210b5456","300":"instance--f90b34f0-8620-5a56-9e11-4db2b889aac4","330":"instance--93872aee-cf81-52fa-aa93-f7a84a833dbd","60":"instance--5a877a06-3649-5bba-9461-5faee75ea842","90":"instance--68af6616-0e27-5395-b4ff-5d95b55a2405"},"id":"OR_operator","instance":"attack-operator--1","properties":[["operator","OR"]]},{"anchors":{"0":"instance--c8ea9394-8b2f-5e6b-8c5e-5e9d01610dfe","120":"instance--b3bd39f2-90