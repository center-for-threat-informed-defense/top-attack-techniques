nce",0.0],["ttp",{"tactic":"TA0001","technique":"T1566"}]]},{"anchors":{"0":"instance--79f4544c-32a8-595f-961c-4d14885eed2c","120":"instance--bcc435f3-0240-5f00-964d-7624cc2ae313","150":"instance--92744b98-f8cb-5a7f-9b9a-e9fb9e789655","180":"instance--c7e6d2fb-b160-5a91-860b-c75a36968359","210":"instance--765808ff-cd7f-5da5-9810-05d77da66fe0","240":"instance--fdec71c9-ac3b-50c9-af82-4b53283e51cd","270":"instance--5b9190a5-c391-552a-9ad5-ff869827531b","30":"instance--f05f2498-e21b-579f-b8c5-4ce10d088ae5","300":"instance--6b82863f-f78d-5362-b84c-d7cbfbf6c9c5","330":"instance--5f98ab06-781f-5f37-9501-c97ddb7ec5cb","60":"instance--d5bee32d-74b6-589c-8832-c247580e8a8d","90":"instance--6c82ae26-54d0-535d-8504-9724761fe1ec"},"id":"action","instance":"attack-action--002","properties":[["name","Deliver Google Drive VBS link"],["description","These emails would appear to contain an attached PDF file that was a link to a .vbs file hosted on Google Drive."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.002"}]]},{"anchors":{"0":"instance--39c69150-0576-5bdb-9d38-7829620cb957","120":"instance--f4a29d31-c3a3-56b5-9d65-2f9b6e9a3de0","150":"instance--c3791a94-4573-5126-bbc8-3c2c5f3d489b","180":"instance--bf0b1480-8ab0-53fa-a4ee-690a6b9bc69f","210":"instance--68aa3d01-b717-5538-9bb0-4ac9feaf471c","240":"instance--e1d7d56d-36f1-52a1-bc75-c3a2a3a48058","270":"instance--4e69e528-402f-56d6-9aa2-57250958b5c2","30":"instance--f68abdfd-967c-5c5c-ab98-537d9ac61773","300":"instance--ae76f11f-db2d-565b-9b89-8c08b8a76a5f","330":"instance--56552a22-c524-541f-8bd4-f65253ebf8d6","60":"instance--5d7b7351-0243-5cdc-8872-8b0681ae4016","90":"instance--b7dc92cf-7aa6-5e77-9237-8e9ecc398233"},"id":"action","instance":"attack-action--003","properties":[["name","Drop AsyncRAT via VBS"],["description","During the recent campaigns, this domain was being used as a C2 for AsyncRAT, which the attackers dropped via a VBS file hosted on Google Drive."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.005"}]]},{"anchors":{"0":"instance--bb492b1f-10cb-588b-bf5e-dbe8d06d86b4","120":"instance--5fae5bd2-998a-5c75-b0ab-862f5b8f3f23","150":"instance--01ddf8c7-497f-5667-80a6-0dd6a9e8981e","180":"instance--93ac31b4-860f-546e-b963-bc3ba2164382","210":"instance--31c99b3d-8205-53ca-9a68-bf0e5ae87143","240":"instance--d2e889da-dca4-593c-bf73-64e43037cbea","270":"instance--be234258-aab5-5c75-8599-369e28a702f4","30":"instance--937da6fb-2591-51d8-a859-ffc37672c860","300":"instance--7805e669-e93c-5697-b85b-56949cf225a9","330":"instance--3b078feb-a00b-5b36-bf09-2d8bb95f5fe5","60":"instance--3545e9a3-1148-5e3c-9fba-89c7c840890b","90":"instance--d92ddb32-35f1-5134-b15d-a489c6127d24"},"id":"action","instance":"attack-action--004","properties":[["name","Encrypt C2 with TLS"],["description","This server was using TLS to encrypt the C2 communications"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1573"}]]},{"anchors":{"0":"instance--b44e2806-755e-584f-9755-e623d02e219c","120":"instance--59703521-96df-51b5-b6e2-5a44a06e5d19","150":"instance--7a5d0ee4-da06-5df6-b55a-096fa46e0d6e","180":"instance--ce6cd061-30be-5bf9-bec9-bc31d73d0bae","210":"instance--15fcd4d0-cb5c-5768-bd87-b29307a19df8","240":"instance--3e8ece17-ea8f-5dee-af35-c39b711577ab","270":"instance--e0ae5ff9-478d-53b5-851b-914d89cf4618","30":"instance--8c1c784c-a3dc-5bab-a071-0da9635ff233","300":"instance--930d8023-3c22-5c88-b685-1717a41959fd","330":"instance--879fd030-8e93-50c9-aeb3-55124966f717","60":"instance--eada9ecc-a805-5bab-8362-8c17425663e6","90":"instance--5176418b-3c4b-5601-b0ac-5a2d72294737"},"id":"action","instance":"attack-action--005","properties":[["name","Batch file downloads malware"],["description","The oldest malware sample referring to this hostname was first seen on Sept. 24, 2016 and was a simple batch file that is part of a malware chain that drops multiple files. The batch file will download and execute another malware, obfuscated with a Delphi packer."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.003"}]]},{"anchors":{"0":"instance--8ae0597c-c552-5c6d-8e54-658c8d480748","120":"instance--0f5ae824-0dd9-585c-b26e-fa4f37859833","150":"instance--e6edfd10-c392-53da-9427-729cc0a9741e","180":"instance--6404d989-8fbc-5bf2-9a9a-124f3f8f2f10","210":"instance--6e70eb08-405a-5c92-94e2-6b042e4ba2e1","240":"instance--221b0ffc-f329-57f3-b336-35ef7c614223","270":"instance--bd4872ff-7f40-51d8-a09f-aad326a4f4fb","30":"instance--4429d82e-f4ce-55a8-9fba-7322c229994c","300":"instance--b4c9ab50-e507-54ee-a9a8-d5f7c36fa0f0","330":"instance--cc712bab-8e8b-50bd-8455-fe6060cb4359","60":"instance--a4ed3a3c-f6f3-5881-93ea-e6517e769553","90":"instance--26591bd8-c0ed-5a29-b1d1-266f5fea85bb"},"id":"action","instance":"attack-action--006","properties":[["name","Macro extracts embedded form data"],["description","In both cases, the macro extracts data from the Microsoft Form object embedded in the malicious document."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.005"}]]},{"anchors":{"0":"instance--821fbbd3-26d7-5da5-b50b-45719b2e678d","120":"instance--68a0d868-a90e-59ef-985c-b5f544477727","150":"instance--7982c4cd-3182-5ae7-a01a-07283a3ec6fe","180":"instance--03bf97b2-ecba-5a9c-ab3c-da5d29f5df1b","210":"instance--2a1eba99-e7ea-5ab5-801e-2b82476398df","240":"instance--d129b8ec-c8e2-5431-98df-d5eb00a7a8bc","270":"instance--1378930b-cddd-52ae-9acd-3c34786f54c2","30":"instance--c75225b2-14da-55e1-bf9d-393fd73e4151","300":"instance--54c1754c-be16-5169-b66a-1fc07589eabb","330":"instance--9269bc3f-5076-5fd8-a33e-b1c086e614b7","60":"instance--4f4591ab-cc6a-5270-93a4-cc28c40d3852","90":"instance--3dca1e7b-0a37-52e4-a195-ef2e7b4abfde"},"id":"action","instance":"attack-action--007","properties":[["name","Download HTML and invoke mshta"],["description","This macro downloads an HTML document from the C2 and uses the mshta, as can be seen on the image above on the right."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1218.005"}]]},{"anchors":{"0":"instance--98ecf88c-a55f-51e1-88da-cd124beb560a","120":"instance--9746b502-1e4d-5710-af5c-5c9eae790860","150":"instance--39404d10-76c1-597c-b368-291173aa68bb","180":"instance--cf07a18c-e0ae-57ce-bf18-94ca4a7f2838","210":"instance--7a062973-1808-50da-bccd-14596e5c9ce7","240":"instance--ed646236-1f86-57c9-a8e1-4063efbce80c","270":"instance--8b37c6c6-d41b-5e97-819c-8a3fe017a66a","30":"instance--3d5360a5-92e0-51cf-aade-4a44d293bed4","300":"instance--0d692c64-cf6b-5103-8e86-51a87ae9b074","330":"instance--51c68807-89b9-5fbc-a99c-762a681d0505","60":"instance--ce07b235-f08e-5aa0-b0a8-e12e08ba638f","90":"instance--47a390ee-c192-59cc-9b6b-d12143774992"},"id":"action","instance":"attack-action--008","properties":[["name","Execute VBScript and PowerShell"],["description","The second stage is an HTML page that contains a VBScript that the mshta executes. This code contains a PowerShell script which, after deobfuscation, looks like the image below."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.001"}]]},{"anchors":{"0":"instance--97799b35-17e8-5bf3-ada9-2b06e23f8843","120":"instance--1ffd3dc4-fc7c-57d1-848d-b0236b0fdf1d","150":"instance--2bbd40b4-27e1-584c-8c40-2ddc6a968912","180":"instance--98469675-ffa1-5787-92fb-571c4b2a194f","210":"instance--41d63a8f-9318-5fd7-89e7-7f583253e1fa","240":"instance--a28dd7ef-6d1e-5410-b8d9-cf406cba31d1","270":"instance--0c94a552-78de-5d56-984b-8eb79b5a9282","30":"instance--ec86d03e-4997-531e-ad29-bcc57ed95b17","300":"instance--3af94e04-7cfc-53c1-8329-88744ecd21b5","330":"instance--c83a122c-0a2c-51dd-b86d-c8591b9f8479","60":"instance--34043f22-5c80-505c-a2f5-c53529905db6","90":"instance--4063702b-c25a-5ff0-96b1-a6962bb1b4a9"},"id":"action","instance":"attack-action--009","properties":[["name","Ping CNN for connectivity test"],["description","This script will ping us.cnn.com as an internet connection test and, afterward, it will proceed to download the third stage from the GitHub page hxxps://satlahlk[.]git