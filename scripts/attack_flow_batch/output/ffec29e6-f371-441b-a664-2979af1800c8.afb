nd"]]},{"anchors":{"0":"instance--40e46d25-7b84-5e26-9e7c-45f432f91f16","120":"instance--86c1be80-0d58-5ed3-99f1-2829415b0217","150":"instance--4807cc5d-29c5-5dc2-9898-82786545a220","180":"instance--0f25cc5b-026d-52b6-bf4a-2f12fddaf4ee","210":"instance--2b546fed-5b17-54fb-80e1-34faf6aa5751","240":"instance--1b21ef77-3316-50a3-a39f-c119ce21fa14","270":"instance--2add11b7-5e05-585f-81e1-52cc05ea82fe","30":"instance--61bdda8b-5e75-51e1-adda-e7430d8e5ad1","300":"instance--e3beb7ef-2adb-5319-8fd3-4e034d5fee22","330":"instance--2e6fe473-94bc-5f81-a904-5eb4c9b2ef83","60":"instance--8e3ac4fb-af64-5e07-a6eb-095b06b6595d","90":"instance--56722643-30e6-5ba5-a051-6528578d5b19"},"id":"mutex","instance":"instance--fffef788-f806-5217-bba1-64cd8ad7b527","properties":[["value","hard-coded mutex"],["evidence",[["item-1",{"excerpt":"Once delivered and executed, Black Basta will check for the presence of a hard-coded mutex (\u201c \u201d) and, if not found, will create it and proceed to delete shadow copies present on the victim\u2019s system in order to inhibit recovery:","source":"https://www.deepinstinct.com/blog/black-basta-ransomware-threat-emergence"}]]],["display_name","hard-coded mutex"],["name","hard-coded mutex"],["diagram_instance","instance--fffef788-f806-5217-bba1-64cd8ad7b527"]]},{"anchors":{"0":"instance--2c30fab4-a26f-5810-ae38-44824dc9b61c","120":"instance--4df826ff-e401-5a20-8dab-f19dde4bba39","150":"instance--dc7ece3a-0c10-58da-b42c-14f6b43fde32","180":"instance--c4ebc6c6-4029-5ecd-953a-9940f588b39b","210":"instance--d0958ddc-438e-54d9-a44f-981787f2a3c2","240":"instance--af11be82-da25-5c24-a5a0-085da5fa2e2a","270":"instance--558f702c-35d1-53d3-b1a8-dda8e5df06c8","30":"instance--dffb55d2-56c4-51e2-91f7-ef1810bf7668","300":"instance--ad6481ac-fd16-5fd0-b736-45f704737979","330":"instance--a65e583c-53f1-54f6-bd42-0cc56e8eb95e","60":"instance--542b5927-c287-52c1-9837-658aef398dc1","90":"instance--bcb479c8-5c3c-55e0-824f-d958c7028ec6"},"id":"process","instance":"process--4