{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-condition--1","attack-operator--1","attack-asset--1","instance--763adce8-107c-58c1-9b65-18fefd501b17","identity--1","identity--2","instance--7797ff9e-6685-5e18-adfb-c4d44716e06f","software--2","software--3","software--4","software--5","software--6","software--7","software--8","software--9","instance--a74fe700-d27a-51b7-b7b1-cbb5d99634b2","instance--ad1f125b-7701-5e9d-b869-79f40471648d","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--d8c1ac68-9d53-5126-80b0-7decc34c9563","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--56da8838-1109-5fce-9d89-7b3ec32d7010","instance--e28c61d0-be08-595d-b694-80935ffe4433","instance--aaed1ef6-6978-5a66-983b-51be56c74b70","instance--e5e1f9aa-9fe9-5106-95bc-0f29bb985397","instance--3db85ae9-9841-5804-b292-91088230ad52","instance--2da3f2f9-4a0b-5904-a9ac-e5ce5af207a3","instance--1fa3126a-bb58-563e-a616-464bda46b52f","instance--0e0aefbc-132c-5535-9d21-08a6439d6b20","instance--2c15d2a3-b722-5fc5-a814-f5df26ef48d5","instance--c30c76fd-9ea2-5690-adb6-09a7091654ed","instance--dfb7a737-9df7-59df-be59-4c3b093cfccf","instance--d747c22b-6ccc-53f6-8321-ea305eeeeeac","instance--7e6785ba-0b01-545c-835f-2d1e7af36212","instance--d4dc471a-d3c8-5125-ab42-123a01375605","instance--4d12b42a-3e06-5048-9c83-b3170515c494"],"properties":[["name","FIN7 BadUSB campaign targeting US companies"],["description","FBI: FIN7 hackers target US companies with BadUSB devices to install ransomware"],["scope","campaign"],["author",[["name","Catalin Cimpanu"]]],["external_references",[["item-1",[["source_name","therecord.media"],["url","https://therecord.media/fbi-fin7-hackers-target-us-companies-with-badusb-devices-to-install-ransomware/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Mail malicious USB devices"],["description","\"Since August 2021, the FBI has received reports of several packages containing these USB devices, sent to US businesses in the transportation, insurance, and defense industries,\" the Bureau said in a security alert sent yesterday to US organizations.\n\n\"The packages were sent using the United States Postal Service and United Parcel Service,\" the agency added.\n\n\"There are two variations of packages\u2014those imitating HHS [US Department of Health and Human Services ] are often accompanied by letters referencing COVID-19 guidelines enclosed with a USB; and those imitating Amazon arrived in a decorative gift box containing a fraudulent thank you letter, counterfeit gift card, and a USB.\"\n\nIn both cases, the packages contained LilyGO-branded USB devices."],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1656"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Register USB as keyboard and send keystrokes"],["description","But the FBI says that if recipients plugged the USB thumb drives into their computers, the devices would execute a , where the USB drive would register itself as a keyboard instead and send a series of preconfigured automated keystrokes to the user's PC."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1056.001"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Run PowerShell to download and install malware"],["description","These keystrokes would run PowerShell commands that downloaded and installed various malware strains that acted as backdoors for the attackers into the victims' networks."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.001"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Obtain administrative access"],["description","In cases investigated by the FBI, the agency said it has seen the group obtain administrative access and then move laterally to other local systems."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1078"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Move laterally to local systems"],["description","In cases investigated by the FBI, the agency said it has seen the group obtain administrative access and then move laterally to other local systems."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6