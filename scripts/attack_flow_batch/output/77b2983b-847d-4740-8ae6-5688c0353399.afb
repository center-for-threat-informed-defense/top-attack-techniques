{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","attack-action--13","attack-action--14","attack-action--15","attack-action--16","attack-condition--1","attack-condition--2","attack-condition--3","attack-condition--4","attack-condition--5","attack-operator--1","attack-operator--2","instance--5d3ebad1-222e-56ce-a044-be09de62739d","instance--e7d915dc-7b62-552c-bba8-11ef37c1fbd3","instance--18acb1e8-0dbc-5fdc-aa7a-664a37ff2675","instance--d56a57e1-38ee-5115-bcad-e7817668513c","instance--33d457be-25c6-5663-82ef-1321ce9b6639","instance--db0beeef-7a6d-5300-a4f5-0d87a3a707c7","instance--183f0ea4-2466-5bd9-b5e6-654dbd28e66d","instance--b03f7f6c-1596-53a3-9508-69157de01fbe","instance--aaa15696-eba1-5630-abe7-6eeb65da1682","instance--becc7795-37fe-5653-834c-15b423ef23c9","instance--cd8e2e12-554c-5e0b-9908-bf5d0aaae299","ipv4-addr--1","file--4","user-account--1","instance--2d542218-4789-56e2-b31b-9360de05d8e0","file--5","instance--a0c5b9c7-fd56-5cb4-b737-7dd5ef72584f","instance--d29fe347-523f-593c-be8c-9ea4bbe328e7","instance--ea3a0fc9-4a59-5659-af92-2a015bf5b0c1","ipv4-addr--2","url--1","instance--3c0ce638-c49e-5541-b938-6bfe31488a75","directory--1","instance--d29dc6b3-f49e-57b9-ba2e-be6053ff3568","instance--520fa1cc-cf7f-5c58-a3ff-0f16ade30657","process--1","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--fe58d3c1-faa4-512f-a0c3-fa75b622e227","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--3d75b4ae-3541-5ff2-b4f5-0d67b8bb9252","instance--062a5768-ed14-59f8-a9a3-570a10abc627","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--91ae4d5c-580a-5833-bdd9-0bcf3921c872","instance--f30f6eca-10ca-50ce-b77e-755c3dfb7a3a","instance--ee78d0fa-3fd9-55dc-a142-c7343707d3ce","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--dd8a24ad-b36a-5832-9b5d-4c4e6666ada2","instance--c075f5c6-95e8-5553-8f7e-b432b96021c7","instance--356de7e1-bde7-52bb-8e12-fb85995633e5","instance--3e0f78a3-bb54-55bd-8490-3453d5e06d04","instance--a37796a0-93b2-51bb-be4b-2a9a9e7e35e1","instance--b879673b-0c82-5a65-8ee4-4f18f90200fb","instance--c080a4ca-bd39-5747-b7cf-d95838e75c4f","instance--0c4a2a97-2cc6-519d-aadf-6ba2ac4a6fd3","instance--cb330fef-e470-56d8-87b6-1993299471bb","instance--008a8bdb-0822-57ea-a0b5-1faf6147030f","instance--d6e18896-02c8-5f5d-9dd0-a5c3d1330815","instance--e068d9a7-f059-5caf-a739-84e8d92f7141","instance--13a1d2ce-b971-5f8d-952e-3b059edcaebb","instance--87fa4a6b-4596-5860-918e-e16f74da32fa","instance--d3cd91c5-fb45-5a59-b4e0-4bb5609961ab","instance--4fbde158-28da-551a-89d1-9a78d69d8882","instance--b98b21c5-4e8c-51e8-af90-665bb9d3abcd","instance--3dbdf34c-21b5-5621-b0ac-cd96aea7ab09","instance--458b9052-de4d-5b30-bc79-d8e8797debaf","instance--d67df2e3-f239-5084-b92d-d2446dc8f121","instance--399a759f-97f7-528c-90c7-de3363f46907","instance--736ae7ff-b813-5d30-9209-b43069181bfc","instance--6880c708-08fe-5260-94a0-6655b74ae391","instance--74d1624f-6c43-5c5e-ae5f-2b7c4215ca74","instance--363b9c17-c2db-54db-8776-47919c5b6330","instance--36b0fdd6-18f8-55e7-a616-925b3c4adffa","instance--1425e9b2-9c15-5ae8-a9c8-544c2d526f1e","instance--4b31541f-5b0e-53ba-b20b-beb8f03862d0","instance--f981f35f-7a54-578d-a9f8-382951ad2c33","instance--49c43c58-29d4-5275-b85e-e711b87d6d83","instance--6e9c34ea-bdb0-5417-a6a8-349698e46ba9","instance--7d1b567d-aaf9-5b82-b477-fcea15341e7d","instance--7000eab1-9f8c-5b50-9434-d2308ba8e688","instance--e1598276-7554-5ab1-993a-9cd0cfa8abcb","instance--86e7dfaf-91e2-5fb3-874e-894e1175ee71","instance--ad00136e-ca43-5413-a70e-f3bdc96cd83b"],"properties":[["name","Emotet Wi-Fi spreader and service loader flow"],["description","Binary Defense analysis of Emotet Wi-Fi spreader behavior using worm.exe and service.exe."],["scope","malware"],["author",[["name","James Quinn"]]],["external_references",[["item-1",[["source_name","www.binarydefense.com"],["url","https://www.binarydefense.com/resources/blog/emotet-evolves-with-new-wi-fi-spreader/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Deliver initial Wi-Fi spreader archive"],["description","The initial binary for the Wi-Fi spreader arrives on a system with module ID: 5079 and executeFlag: 1, which means it will be dropped into before executing, like loader updates or other malware, like . This initial binary is a self-extracting RAR file which contains the 2 binaries used for Wi-Fi spreading."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Auto-execute worm.exe from self-extracting RAR"],["description","The self-extracting RAR contains 2 files: service.exe and\nworm.exe. Worm.exe is configured as the setup file, as seen in Figure 2, for\nthe self-extracting RAR, which means worm.exe will execute automatically once\nthe RAR file has unpacked itself."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1204.002"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Profile wireless networks with wlanAPI"],["description","Upon startup of Worm.exe, the first action it takes is to\ncopy the service.exe string to a variable that will be used during file\nspreading. Next, it steps into the main loop and immediately begins profiling\nthe wireless network using wlanAPI.dll calls in order to spread to any networks\nit can access, as seen in Figure 3."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1016"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Enumerate Wi-Fi interfaces and networks"],["description","As seen in Figure 3, once a handle has been obtained,\nWlanEnumInterfaces is called. This function enumerates all Wi-Fi devices\ncurrently enabled on the local computer, which it returns in a series of\nstructures. These structures contain all the information relating to the Wi-Fi\ndevice, including the device\u2019s GUID and description.\n\nUsing the first available Wi-Fi device,\nWlanGetAvailableNetworkList is called to obtain a list of all available\nnetworks."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1016"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Gather network details and register notifications"],["description","Next, the malware begins profiling the network, saving the following information to a buffer:\n\nThis information is gathered for every available network in\nthe list of networks. Then, a massive switch case used to handle connection\nnotifications is passed to the Wi-Fi device using WlanRegisterNotification.\nFinally, the network authentication method is obtained and encryption is parsed\nagain."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1016"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Brute-force Wi-Fi connection passwords"],["description","As seen in Figure 4, once each the information for each network has been obtained, the malware moves into the connection, brute-forcing loops. The first step is to zero out two important flags and then to use the data obtained to fill in the below template that will be used to create the Network Profiles:\n\nIn the keyMaterial field, a password obtained from one of two\ninternal password lists is used. Next, the profile is set and a connection is\nattempted."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1110"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Notify C2 after successful Wi-Fi connection"],["description","If the connection is successful, the malware sleeps for 14 seconds before sending an HTTP POST to its Command and Control (C2) server at 87.106.37[.]146 on port 8080. The resource requested is a static, hard-coded value:\n\nThe data contained in the POST is:"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1071.001"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Enumerate network shares and users"],["description","With the infected victim now connected to a new network, the\nmalware begins enumerating all non-hidden shares on the network, as seen in\nFigure 5. Once shares have been discovered, the malware attempts to connect to\nthe IPC$ share for the network resources. Using IPC$, it attempts to enumerate\nall users connected to the network resource."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1135"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Brute-force enumerated user accounts"],["description","Using the second password list\ncontained in the malware, the malware attempts to then brute-force its way into\nall users enumerated, saving each successful attempt to 2 buffers: one for the\nusername and one for the password."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1110"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Brute-force Administrator account"],["description","If it is unable to guess passwords for any users, it pivots\nto attempting to brute-force the \u201cAdministrator\u201d account for the network\nresource."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1110"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Copy service.exe and create remote service"],["description","The malware first attempts to gain access to the C$\\ share\nfor the connected network resource. This gives it access to the C drive of the\nspecified username. From there, it drops service.exe as my.exe in C:\\, as seen\nin Figure 6. Additionally, it adds a new service with the following information\nusing the recently dropped my.exe."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021.002"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Start remote service"],["description","It then starts this service, executing service.exe as my.exe\non a remote system."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1569.002"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Start service thread"],["description","Service.exe\u2019s startup is simple. It has a ServiceMain setup, which calls StartServiceCtrlDispatcher to connect the main thread of the service process to the service control manager, meaning the main thread is run when the service is executed.\n\nIn the main thread, service.exe starts a new thread, which\nserves two purposes:\n\nCommunicate back to a new C2 when the service is\ninstalled.\n\nDrop and execute the Emotet binary embedded in\nservice.exe."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1053.005"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Beacon to installed-service C2"],["description","The first action service.exe takes is to open a connection to\n45.79.223[.]161:443 and send a request to /09FGR20HEU738LDF007E848F715BVE.php.\nAlthough the connection to the server uses port 443, which is normally used for\nTransport Layer Security (TLS) encrypted communications, the connection is unencrypted\nHTTP. When opening this connection, service.exe sets the following flags:\n\n0x80000000 - INTERNET_FLAG_RELOAD\n\n0x04000000 - INTERNET_FLAG_NO_CACHE_WRITE\n\n0x00040000 - INTERNET_FLAG_NO_AUTH\n\n0x00008000 -\nINTERNET_FLAG_IGNORE_REDIRECT_TO_HTTP\n\n0x00004000 - INTERNET_FLAG_IGNORE_REDIRECT_TO_HTTPS\n\n0x00002000 -\nINTERNET_FLAG_IGNORE_CERT_DATE_INVALID\n\n0x00001000 -\nINTERNET_FLAG_IGNORE_CERT_CN_INVALID\n\n0x00000400 - INTERNET_FLAG_HYPERLINK\n\n0x00000200 - INTERNET_FLAG_NO_UI\n\n0x00000100 - CACHE_ENTRY_ACCTIME_FC\n\nThe resource requested\nis hardcoded and static. This IP is currently an active Emotet Command and\nControl server (C2). The data contained in the request is:\n\nThis notifies the server that service.exe has been properly\ninstalled."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1071.001"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Drop embedded Emotet executable"],["description","After service.exe has installed itself and communicated back\nto the C2, it begins dropping the embedded Emotet executable. First, it obtains\nthe path to %TEMP%, and concatenates \u201csetup.exe\u201d to the end of it. Next, it enters\na function which locates the embedded executable by specifying a hard-coded\nbuffer offset. Once the embedded executable is located, it creates a new file\nat %Temp%\\setup.exe and writes the embedded executable to this file."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1027.009"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Execute dropped setup.exe"],["description","It then\ncalls CreateProcess in order to create a new process running the Emotet\nExecutable as seen in Figure 7."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","worm.exe will execute automatically once\nthe RAR file has unpacked itself."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","If the connection results in\n\u201cwlan_notification_msm_connected\u201d, NetworkAvailableFlag and\nNetworkConnectedFlag are both set to 1."]]},{"anchors":{"0":"instance--64fa8274-9976-53b9-811c-a0e7e805b799","120":"instance--ce384754-4013-5515-ac17-4456e1d80bbb","150":"instance--99275651-db0d-57ec-a13c-6e557a4b9c7c","180":"instance--cbaa25ac-4f14-51f0-9962-f76fe36e7cd6","210":"instance--1c4fda5b-4605-5040-a88a-48f1df4144aa","30":"instance--39743932-1858-5655-a859-b27c0902b87a","330":"instance--c116df79-3c10-5931-96ec-25b4174ae13a","60":"instance--75b926aa-d189-5cd6-bc7b-5a947c88de41","90":"instance--4931e63d-9e52-5183-bbd8-7db1814b0f21","branch:False":"instance--fc00a7ae-0a9a-58b7-b24a-5def4ea9feab","branch:True":"instance--e3424864-637f-5b96-b87c-a8dcc22d8b9e"},"id":"condition","instance":"attack-condition--3","properties":[["description","Once a connection is established with the Wi-Fi network,\nworm.exe begins enumerating users and attempting to brute-force passwords for\nall users on the network."]]},{"anchors":{"0":"instance--1a1159e3-7134-5cb2-b831-1c9e4cadc724","120":"instance--267651df-0a90-5013-a3f3-6a84f327fdce","150":"instance--ff657c73-da26-5719-b71e-26c6d439031b","180":"instance--57de1597-7c4d-5cea-858a-0c984a9a171c","210":"instance--4e82ed67-17c4-52f1-909c-1dcc5361a3a3","30":"instance--a8f9c850-7ea4-5848-8bf2-8fcc9e5d1187","330":"instance--b9c275ec-317e-5c35-ad9b-15ea68ddb80f","60":"instance--72f37cb0-dd26-5fa0-ac8f-323618da5271","90":"instance--834e4696-439e-5c16-8a92-b41255545c1d","branch:False":"instance--3a265f8f-b632-5d4a-b23f-b7db066758c0","branch:True":"instance--2dae2452-f4f4-5245-88fb-66b07135437e"},"id":"condition","instance":"attack-condition--4","properties":[["description","If it is unable to guess passwords for any users, it pivots\nto attempting to brute-force the \u201cAdministrator\u201d account for the network\nresource."]]},{"anchors":{"0":"instance--4ff91cf1-8a17-5613-b655-c6515d79a753","120":"instance--e92dae7b-1c37-549b-976b-4f0d2d86b60a","150":"instance--d0af9272-f633-5f0a-848c-334aa752a7eb","180":"instance--9b04821f-9694-57ff-864e-fc2c2a343006","210":"instance--129d2182-8a7b-5b40-982f-808a44fde75b","30":"instance--08be65d0-b145-5e5e-b51d-87aa3a549063","330":"instance--d1435d0a-a1f5-5e72-a23b-52f4fb8ac7f1","60":"instance--d91cc1ea-0c5b-52bd-9b2e-edea43692a11","90":"instance--7958db49-1756-5544-be4a-b567b033cb7e","branch:False":"instance--804df8d6-cf83-5c99-95ad-d3065279b18b","branch:True":"instance--947c6d40-bce1-56ed-9af1-0a1ede672492"},"id":"condition","instance":"attack-condition--5","properties":[["description","If either of these brute-force attempts are successful