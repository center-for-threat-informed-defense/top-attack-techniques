nce--08881caf-1468-53e2-baa3-c9da43e73b47","120":"instance--5344d679-b2e1-5528-bed5-6fe3fbc90036","150":"instance--f1a3ca80-d761-5917-981a-9d35e6a5161e","180":"instance--bb22e51a-29ce-531e-b80e-4a1d5343b453","210":"instance--380340c8-8f15-5075-a390-ac1b2706e43f","240":"instance--b8ca794c-8bea-5f4c-a746-ad3b31fd2d36","270":"instance--fb5c8b1f-7cc5-58a3-a457-0edfdefa168c","30":"instance--a124cc0a-728c-5b30-8b8b-2171584014e7","300":"instance--7d09cfe0-ac57-5093-a7ce-7c31042d3449","330":"instance--829e634f-5069-5370-8381-e0687a22b00e","60":"instance--0fbffc26-a516-5fcd-9fff-e9aee12c6467","90":"instance--96917b9c-4649-5345-82ac-b4e793881bfe"},"id":"action","instance":"attack-action--24","properties":[["name","Run Carbanak"],["description","\u2014 run Carbanak ( ). The IP address and port of the server and admin panel are set via the configuration file (Fig. 11)."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--6e9515e3-2497-5444-80ce-9466679d2504","120":"instance--25d30ffe-4a4f-53ec-a34d-de6cc58a2fb0","150":"instance--43abd457-ad7e-5db6-b146-d159a2936c52","180":"instance--f22410a7-1bbd-5943-9121-cf9edb5a0991","210":"instance--4a2a2f86-5543-5514-866c-4d5f4f5bcb3b","240":"instance--f2011b06-5138-5056-a1f2-0a96e9738966","270":"instance--a9d1b1c1-44f0-5281-b6b0-9133e0a433dd","30":"instance--c9339355-ad0b-5e98-9f42-ef0c11d380dd","300":"instance--dec744bc-b6ae-5258-bcb1-83f01a7bb747","330":"instance--54f63fd7-f831-5401-a04f-600f5e780c31","60":"instance--1dd30294-3434-540a-8b5f-d8bc1e3de794","90":"instance--e414165a-d829-5c22-ab74-6aa5e50c83d3"},"id":"action","instance":"attack-action--25","properties":[["name","Run EXE PowerShell DLL or shellcode"],["description","Executer32.dll/Executer64.dll\n\n/ launches additional components specified in the Lizar client application interface.\n\nThe plugin can run the following components:\n\nEXE file from the directory;\n\nPowerShell script from the directory, which is run using the following command: ;\n\nDLL in memory;\n\nshellcode."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.001"}]]},{"anchors":{"0":"instance--ce3f20b8-daf0-5682-a74a-dd9eb1251abb","120":"instance--08418575-7199-5323-8082-8e1d88a1ec11","150":"instance--15627176-59a5-5797-816e-a6cab3ea9da9","180":"instance--242a8d77-274b-5d18-ba35-771f6e0de836","210":"instance--d01bb126-419a-5d3b-a9cf-7b8df1d59112","240":"instance--0b76a14d-f362-5d5a-995f-2e318539789f","270":"instance--d534a23c-ea17-5a19-96f9-740e77b559a2","30":"instance--9b134899-2cf4-5fcd-9412-5363985ac68c","300":"instance--1bb6a59f-c750-5aca-a7c7-cecaf9c9f1f7","330":"instance--a346b253-e85b-53ff-8e33-33aaa8c928da","60":"instance--0c9baf75-2ba0-51ff-b084-c1044ff899fa","90":"instance--b86b5b84-3a18-51f2-b888-17161b8c5d47"},"id":"action","instance":"attack-action--26","properties":[["name","Inject into process by PID or created process"],["description","From the pseudocode above we see that the loader can migrate to the address space of the specified process in three ways:\n\nby performing an injection into the process with a certain PID;\n\nby creating a process with a certain name and performing an injection into it;\n\nby creating a process with the same name as the current one and performing an injection into it."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1055"}]]},{"anchors":{"0":"instance--804d7975-bdc1-5371-a95e-4cff0aa0b8b1","120":"instance--aab4410b-5835-54c6-bc0f-d93b86440850","150":"instance--ad5c3f2a-3c32-5af5-9b9c-489a81eead21","180":"instance--3ff51605-dadf-546e-a273-07184c6549e2","210":"instance--9337c97e-ad0d-5d35-8b01-21c1e3f80296","240":"instance--49c4f7e6-8fe8-5919-bda8-039a2aaf3a61","270":"instance--4e395b92-9587-53cc-a957-cad25cc53df8","30":"instance--b917f3cb-7197-5ba7-8a3e-cbfda092d01a","300":"instance--ab650c26-b6f9-59ed-b26e-6f6ca03758dd","330":"instance--36c16e65-d9d7-519a-a8ae-a6dd521ddceb","60":"instance--0b7fc2fd-f6ca-532d-9f2b-ca34c65a881a","90":"instance--ff765750-9ba6-53a3-b366-8a863df1a603"},"id":"action","instance":"attack-action--27","properties":[["name","Enumerate active network sessions"],["description","NetSession32.dll/NetSession64.dll\n\nThe plugin is designed to retrieve information about all active network sessions on the infected server. For each session, the host address from which the connection is made can be retrieved, along with the name of the user initiating the connection."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1049"}]]},{"anchors":{"0":"instance--5788127e-30a2-5d63-8064-8a764c79ef88","120":"instance--50a9fb8c-a32c-508b-9ff8-6fbad48bdc18","150":"instance--fb5120ee-d53c-50d4-8806-fb538b7ace76","180":"instance--8c9e9207-faff-59a9-9ac0-4db98f799c06","210":"instance--17f4c1e8-e3de-51ca-a9b4-9407a08ef1f5","240":"instance--72709ae2-9e69-5094-89f4-3bb373306fff","270":"instance--4d10667a-8f14-5176-8d94-a90057c253eb","30":"instance--b7f4854d-0cc9-50b4-aae7-a9728bb18935","300":"instance--bb03752f-dd5c-5086-862e-11a1b554f970","330":"instance--ce6fbeb3-82f7-525d-94ba-6314c642da8e","60":"instance--5e319f8b-f917-5aca-9a32-bd424efd643f","90":"instance--923612bb-e746-52ea-b7f5-39eb0184150e"},"id":"action","instance":"attack-action--28","properties":[["name","Generate Active Directory reports"],["description","ADRecon\n\nThe file is a tool for generating reports that contain information from Active Directory. Read more about . Note that this plugin is not developed by FIN7, however, it is actively used by the group in its attacks."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1069.002"}]]},{"anchors":{"0":"instance--421e596f-663b-56b5-aacb-5c51f44887fb","120":"instance--54341936-f58d-5d7b-9140-0b8f37379212","150":"instance--6ca5d726-fab5-5c69-8490-e3c1002a1e49","180":"instance--00c7f913-8a5c-5e23-a21a-23f0b21c0795","210":"instance--c181f118-448c-5e8f-b83c-d03f6d177344","240":"instance--394b4c0e-56d4-5d48-8d37-2f9f3d5ea7f4","270":"instance--d6c97d2a-eacc-5edb-a7c6-1c3f45f4d771","30":"