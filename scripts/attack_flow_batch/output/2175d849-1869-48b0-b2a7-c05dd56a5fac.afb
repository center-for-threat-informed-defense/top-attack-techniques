{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","attack-condition--1","attack-condition--2","attack-asset--2","attack-asset--3","instance--90f87dca-76ff-580f-bcb9-39a3ddd37d78","instance--5d3ebad1-222e-56ce-a044-be09de62739d","instance--763adce8-107c-58c1-9b65-18fefd501b17","directory--1","instance--7797ff9e-6685-5e18-adfb-c4d44716e06f","instance--aaa15696-eba1-5630-abe7-6eeb65da1682","directory--2","directory--3","windows-registry-key--1","software--2","software--3","software--4","software--5","software--6","software--7","instance--707692bc-7cc5-549f-9306-40c5d52a0c78","instance--cd8e2e12-554c-5e0b-9908-bf5d0aaae299","instance--75bd3552-9387-5001-9510-8bba3a3bc0c6","instance--4a50d9bf-6440-5b99-9fc2-99f4e8252f3e","instance--a1bb82f1-6edd-58fa-89ee-0993e97a8be0","software--9","instance--02d84517-953a-5f36-9f4d-d00e61950f4c","attack-asset-object--2","instance--cc97f7a0-2d44-5384-9615-43b014cfb526","instance--8a8dcc29-b7c1-54cc-99ad-52aa35286e9c","instance--436d8a46-af60-5ff1-bcea-35c381dc9970","instance--907e763a-a617-55e3-98dc-cba9f96f12fa","instance--ca298bd2-9761-5fef-80ad-6b85c754df36","instance--5e11d31d-b69b-56fb-82cd-aa96018aff74","attack-asset-object--3","instance--cc6d4da2-b8fb-52bc-8217-2ce7836698a9","instance--be55c1a1-f948-5d91-a2f9-66cdd1b05961","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--2f5f12b9-232b-5150-b961-5d66845f48f5","instance--d7b0d86e-7a37-55a1-a793-a32a114ba4f3","instance--f32db68b-ebd4-5750-8f1c-060b8054b94b","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--b385e0ce-1ac4-5022-bd7b-3d3ca8cbdf54","instance--ee78d0fa-3fd9-55dc-a142-c7343707d3ce","instance--238a3fae-6e4a-55fd-a0e2-9cb3981cfbed","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--1ab38c9d-8f20-58a2-96be-f667e7766879","instance--82fdbfd2-ff49-532c-9c0a-a6f286cfae0e","instance--e5e1f9aa-9fe9-5106-95bc-0f29bb985397","instance--17751d4f-a8b7-530c-ab85-07dce983b3ef","instance--1fa3126a-bb58-563e-a616-464bda46b52f","instance--458b9052-de4d-5b30-bc79-d8e8797debaf","instance--9c75fe46-0b34-5824-b382-c269be1aaab1","instance--6c41d498-a008-5100-a7f2-4275267195a7","instance--5a8835f0-3fd1-5b6d-8f9d-3d54d3977906","instance--471cd0ba-bcd7-5a60-bf2e-a2594276cafe","instance--477f512f-9970-5e9c-b5e8-e08afc5b8c09","instance--e590a058-7053-5d1e-b0fb-e5249ff0e5cc","instance--09a00c86-4c4f-5d78-9ed9-37d5f7ba6d0d","instance--ae428ad8-f71c-555a-aab7-960860dc2fc9","instance--254f4b42-daef-598d-976a-5807df828494","instance--3bca2cf5-aca6-574d-a3e1-fbdd0ccfdcd9","instance--399a759f-97f7-528c-90c7-de3363f46907","instance--6298e0ca-8198-59e9-b0c0-9ae0e17c9601","instance--e39b03c3-e7b0-594d-b567-0835d8e002e5","instance--443055f8-a3d4-5405-b7bd-61f8835a3c36","instance--e0d26f3f-b757-5ff0-8959-12b6c500a5ce","instance--8517a788-f4f0-5b4f-be27-da91a5841de1","instance--9d6a0c68-19ae-5f6a-b0c9-32971f69fe3a","instance--90550158-df8d-54a0-8e0c-023b52e9c86b","instance--2d1c2f52-bf75-589b-be9d-458e486f7057","instance--bceaa548-f6e9-521c-9fa1-baa6f4f8bd40","instance--323718cc-4d88-5286-b089-01b112541c05","instance--a781d391-c3f1-5b60-99e9-7eeb2c35b3a6","instance--6990db70-e474-5d0e-91e2-ae230413b7e1","instance--3de2851e-62ff-5c0e-a1bd-d7c409c40de9","instance--05a6c3f1-85d8-5a9c-b7ee-77d1baf925ad","instance--06a90012-2520-5f64-bf0e-d4de74173cd8"],"properties":[["name","GRIM SPIDER big game hunting timeline"],["description","This blog uses the MITRE ATT&CK\u2122 Framework to map WIZARD SPIDER and GRIM SPIDER tactics, techniques and procedures (TTPs) observed across several CrowdStrike Services engagements, illustrating how an attack unfolds and the different stages involved."],["scope","incident"],["author",[["name","CrowdStrike"]]],["external_references",[["item-1",[["source_name","www.crowdstrike.com"],["url","https://www.crowdstrike.com/blog/timelining-grim-spiders-big-game-hunting-tactics/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Install TrickBot scheduled task"],["description","Trickbot is installed as a scheduled task, using names like \u201cWinDotNet,\u201d \u201cGoogleTask,\u201d or \u201cSysnetsf\u201d to masquerade as legitimate-appearing processes. These point to various copies of TrickBot installed in the system, usually within the user profile under or a subdirectory. The subdirectories also use similarly misleading names like \u201cWinDefrag\u201d or \u201cNetSocket\u201d to appear innocuous."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1053.005"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Install TrickBot service"],["description","TrickBot may also be installed as a service with names like \u201cControlServiceA\u201d that points to a copy in the system drive root."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1543.003"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Enable WDigest cleartext credentials"],["description","As with all modules launched by the TrickBot core, is installed into a subfolder, usually named either \u201cmodules\u201d or \u201cdata,\u201d and modified the following registry value: Setting the \u201cUseLogonCredential\u201d value to \u201c1\u201d configures the Windows operating system to store credentials as cleartext in memory, where they can then be retrieved via the use of credential dumping tools."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1112"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Harvest credentials with pwgrab"],["description","Older versions of the pwgrab module has a limited scope that targets mail clients, web browsers, FileZilla and WinSCP. Newer versions also dump passwords for applications such as PuTTY, VNC and RDP."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1555"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Collect system and network information"],["description","TrickBot downloads modules for collecting local system information and scouting the network, primarily part of the module. This module has a battery of command line, WMI and LDAP queries to gather information, and then exfiltrate the data to GRIM SPIDER for review."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1018"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Search for financial and POS indicators"],["description","The module has a similar purpose but specifically searches for financial and point-of-sales indicators."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1087"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Use RDP with harvested credentials"],["description","Following initial access, GRIM SPIDER focuses on collecting credentials from the compromised hosts and uses existing RDP in an attempt to get a domain administrator account and access to the Windows Domain Controller. This process can take several iterations of harvesting credentials, connecting to new systems and establishing persistence."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021.001"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Stage PSTools and execute PsExec"],["description","GRIM SPIDER also has been observed selecting a server to be the primary staging point. Subsequently, the adversary copies the Microsoft SysInternals PSTools archive to this system, and executes , a utility that allows them to move laterally and execute commands on other Windows systems within the infrastructure."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1570"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Remotely install TrickBot on new targets"],["description","Using this common administrator tool, GRIM SPIDER can traverse the network, remotely installing TrickBot and adding persistence to new targets."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1569.002"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Propagate with active user credentials"],["description","TrickBot also has the module for propagating to other hosts using the current, active user credentials."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Stage Ryuk on management system"],["description","Once GRIM SPIDER has gained access to credentials and a Domain Controller, or other host management server, they would then stage the on that system and deploy to targets via PsExec."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1486"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Deploy and execute Ryuk via PsExec"],["description","Being the \u201cnoisiest\u201d part of the operation, it is usually accomplished as quickly as possible to minimize chances of detection, as all of the necessary preliminary work has already been completed. In observed instances, the deployment and execution of Ryuk occurred in one session, typically lasting 3 to 8 hours."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1486"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","3