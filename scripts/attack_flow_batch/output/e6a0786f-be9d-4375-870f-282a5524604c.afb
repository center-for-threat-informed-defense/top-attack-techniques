om/blog/hidden-administrative-accounts-bloodhound-to-the-rescue/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Dump credentials during lateral movement"],["description","During the lateral movement and credential dumping phase of the test, we came across two different service accounts."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1003"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Leverage SAN maintenance service account"],["description","One was a service account that performed storage area network (SAN) maintenance and also had local administrative access to a large portion of the environment."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1078"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Use golden key service account on domain controllers"],["description","It was a service account that had been created to pull security information from all the domain controllers. It was not in the \u201cDomain Administrators\u201d AD group, so it was not monitored and its sessions were not managed. This golden key account had local administrator access to every domain controller in the network, essentially making it a hidden domain administrator account."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1078.002"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Move between domains"],["description","In another adversary emulation engagement, we moved between domains throughout the environment to compromise two geographic regions of the company."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1078.002"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Search for misconfigured cross-domain service accounts"],["description","Once we fully compromised one domain, we began looking for misconfigured and instances of service accounts used in both domains."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1087"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Discover shared monitoring service account"],["description","We discovered a service account that was being used for network performance monitoring, which had local administrator access to multiple systems. This account was used in both domains and had the same password in each one \u2014 a configuration that made it easy for our red team to jump from one domain to another."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1078.002"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Jump from one domain to another"],["description","This account was used in both domains and had the same password in each one \u2014 a configuration that made it easy for our red team to jump from one domain to another."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1078.002"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Fully compromise organization"],["description","This dynamic eventually allowed us to fully compromise a geographically dispersed organization."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1078"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Set up Neo4j database"],["description","To use BloodHound, you must set up the Neo4j community edition database."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1580"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Connect BloodHound web application to Neo4j"],["description","You will then need to connect the BloodHound web application to the Neo4j database."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1213"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Pull AD data with PowerShell ingestor"],["description","Once you have set up the database and logged into the BloodHound web application, you need to pull AD data from your environment using the BloodHound PowerShell ingestor."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1069.002"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Upload BloodHound CSV files"],["description","Once the ingestor completes, you will see three CSV files that can be uploaded into BloodHound, as shown in Figure 2:\n\ngroup_membership.csv\n\nlocal_admins.csv\n\nSessions.csv"],["confidence",0.0],["ttp",{"tactic":"TA0009","technique":"T1560.001"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Run pre-built queries"],["description","After uploading these files, take advantage of the pre-built queries within BloodHound. These queries are a great way to start obtaining important information about your environment. Queries include: viewing all domain administrators; viewing users with the most local administrator rights; or viewing computers with the most administrative user access. One of these queries gives you the ability to map domain trusts, as shown in Figure 3."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1482"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Use top local admin rights and domain trust queries"],["description","When looking for hidden administrator accounts and trust misconfigurations, we will commonly use the pre-built queries \u201cFind Top 10 Users with Most Local Admin Rights\u201d and \u201cMap Domain Trusts.\u201d These queries will provide some quick wins and show you which accounts have access to the most systems, and whether there are two-way trusts between foreign domains that could allow for greater access to the environment."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1482"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Investigate nodes directly"],["description","Another great way to find hidden administrator accounts is to view system, group or user node information directly. You investigate any user, group, or system name in the environment by simply typing in the first few characters of the name \u2013 the tool will autocomplete. Once you select a node, the \u201cNode Info\u201d field in the left panel populates. You can also right-click a node and choose the sub-option \u201cExpand\u201d to see the members of that node, as shown in Figure 4."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1087"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Search Domain Controllers group"],["description","Another way we have been able to easily discover hidden administrator accounts is to search for a sensitive system such as a domain controller. This can be done by simply searching for the \u201cDomain Controllers\u201d group and left-clicking the group node. The \u201cNode Info\u201d field on the left will populate. Next, left-click the number next to \u201cDirect Members\u201d under the \u201cGroup Members\u201d section. You will now see all the domain controller system nodes under that group, as shown in Figure 5."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1018"}]]},{"anchors":{"0":"instance--dbfe6415-cd2c-55f2-9509-06b6668ef23a","120":"instance--79ca45e2-afd7-51fa-9574-5085c7de4c84","150":"instance--39171cfe-3bf6-5200-b6f5-e97e3b047db7","180":"instance--8cda146b-7259-56b2-b337-56038a1f52d3","210":"instance--a662f8bf-2723-58c0-a1a8-9af9497cf428","240":"instance--a9b75b15-3be0-5e64-8132-40b87e7ae405","270":"instance--31896ecd-322b-5a41-bd1e-0b7a30b9d9d1","30":"instance--60868276-2726-597d-8f57-8aa7fc9c0738","300":"instance--4f5668fa-b6ef-57cc-93da-5cd1e1727a22","330":"instance--b022a562-9020-587c-a5be-97d254cc8f11","60":"instance--cf452b0f-192e-5357-ba8c-fbae1a6e4ae0","90":"instance--012cc6fc-0a37-5e6e-b9b7-07f3bcd2d02c"},"id":"action","instance":"attack-action--17","properties":[["name","Inspect derivative local admins on GOAT-DC"],["description","Next, left-click on one of the system nodes (example: \u201cGOAT-DC\u201d) and left-click the number next to \u201cDerivative Local Admins\u201d under the \u201cLocal Admins\u201d section, shown in Figure 6."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1069.002"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","Once we fully compromised one domain, we began looking for misconfigured and instances of service accounts used in both domains."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","Once you have set up the database and logged into the BloodHound web application, you need to pull AD data from your environment using the BloodHound PowerShell ingestor."]]},{"anchors":{"0":"instance--64fa8274-9976-53b9-811c-a0e7e805b799","120":"instance--ce384754-4013-5515-ac17-4456e1d80bbb","150":"instance--99275651-db0d-57ec-a13c-6e557a4b9c7c","180":"instance--cbaa25ac-4f14-51f0-9962-f76fe36e7cd6","210":"instance--1c4fda5b-4605-5040-a88a-48f1df4144aa","30":"instance--39743932-1858-5655-a859-b27c0902b87a","330":"instance--c116df79-3c10-5931-96ec-25b4174ae13a","60":"instance--75b926aa-d189-5cd6-bc7b-5a947c88de41","90":"instance--4931e63d-9e52-5183-bbd8-7db1814b0f21","branch:False":"instance--fc00a7ae-0a9a-58b7-b24a-5def4ea9feab","branch:True":"instance--e3424864-637f-5b96-b87c-a8dcc22d8b9e"},"id":"condition","instance":"attack-condition--3","properties":[["description","Once the ingestor completes, you will see three CSV files that can be uploaded into BloodHound, as shown in Figure 2:\n\ngroup_membership.csv\n\nlocal_admins.csv\n\nSessions.csv"]]},{"anchors":{"0":"instance--1a1159e3-7134-5cb2-b831-1c9e4cadc724","120":"instance--267651df-0a90-5013-a3f3-6a84f327fdce","150":"instance--ff657c73-da26-5719-b71e-26c6d439031b","180":"instance--57de1597-7c4d-5cea-858a-0c984a9a171c","210":"instance--4e82ed67-17c4-52f1-909c-1dcc5361a3a3","30":"instance--a8f9c850-7ea4-5848-8bf2-8fcc9e5d1187","330":"instance--b9c275ec-317e-5c35-ad9b-15ea68ddb80f","60":"instance--72f37cb0-dd26-5fa0-ac8f-323618da5271","90":"instance--834e4696-439e-5c16-8a92-b41255545c1d","branch:False":"instance--3a265f8f-b632-5d4a-b23f-b7db066758c0","branch:True":"instance--2dae2452-f4f4-5245-88fb-66b07135437e"},"id":"condition","instance":"attack-condition--4","properties":[["description","Now we can see there are two accounts that have local administrator access to our domain controllers that are not in the \u201cDomain Admins\u201d group and did not even show up in Figure 4. We just found two hidden administrator accounts that have similar access to a domain administrator account."]]},{"anchors":{"0":"instance--253917f6-0fb3-5fc5-bd71-946fe7eb5b45","120":"instance--3f50f35e-a337-5d55-a037-5b923804b373","150":"instance--e1655f18-961e-5a7c-8605-a43fa92fe621","180":"instance--c536c45c-6edd-5cb6-8ee3-046111b98062","210":"instance--42f3c144-a229-5f85-b5be-d7f7668d557c","240":"instance--691fbaf3-af2f-5133-81cc-3f20013aafe4","270":"instance--2eab6914-e10b-5f1c-99af-5beccbf5d65b","30":"instance--ec3d9f12-fac6-5bd8-b657-4395a88ea91a","300":"instance--c4feed2f-8968-5ca9-9b2c-7d6dc36ae967","330":"instance--076ff030-b45a-5691-bef4-3f176aa05896","60":"instance--eb064d35-3662-50f2-819a-ebf3749e0b27","90":"instance--209d1071-226d-51fe-96d2-a60e78b0f246"},"id":"asset","instance":"attack-asset--1","properties":[["name","geographically dispersed organization"],["description","This dynamic eventually allowed us to fully compromise a geographically dispersed organization."]]},{"anchors":{"0":"instance--cba0db2f-4c26-5332-99c5-b2aee8fd787f","120":"instance--d8fb103f-8665-5f80-9047-210dfff8d4c0","150":"instance--edc40449-4888-59a1-9397-f5c8d35412fc","180":"instance--4252ed4d-ac52-5ce9-b1de-22e62358c57f","210":"instance--ef2d806c-0b9d-5611-a51f-36bdd082998e","240":"instance--ec0c67c0-158e-5415-b08b-15c497764894","270":"instance--a848e595-3d48-563d-8a20-94fb272a5c7a","30":"instance--3c5974dd-03ad-5327-9c64-210b94c5a53b","300":"instance--276d1f29-b75a-59cc-9eed-4b08918a5156","330":"instance--890f4571-fa81-56df-b189-618233836d08","60":"instance--2dd9e3f9-0428-53d4-807b-4d5e12c46854","90":"instance--caf97c38-c923-57ff-b66b-316622e455c9"},"id":"user_account","instance":"user-account--1","properties":[["account_login","SAN maintenance service account"],["evidence",[["item-1",{"citation":"CrowdStrike blog","excerpt":"One was a service account that performed storage area network (SAN) maintenance and also had local administrative access to a large portion of the environment.","source":"https://www.crowdstrike.com/blog/hidden-administrative-accounts-bloodhound-to-the-rescue/","source_field":"normalized_text","source_object_id":null}]]],["display_name","SAN maintenance service account"]]},{"anchors":{"0":"instance--95ace8e2-1310-5403-8b48-1010c10cc43b","120":"instance--9aafc533-bb20-57cb-9e52-52981983b264","150":"instance--ccfbb165-f5d9-5632-9b88-dcc2db4b2192","180":"instance--02d70bde-5fbf-5fd3-a257-58b0e7ad1f8d","210":"instance--80b551c9-3423-592c-b247-c1bce1a2d4a0","240":"instance--fcb13753-f9ff-5660-97b5-d3d3e6abca35","270":"instance--2c60f578-3869-56a3-9140-82a84a64c058","30":"instance--76466e45-d973-5b09-8d29-f9135deedf8f","300":"instance--f6788d6f-8c16-5034-b37e-c3c16e45500b","330":"instance--506e257e-76fb-571a-89d3-639c3b04c65e","60":"instance--115ae440-c7b9-534a-847f-85378f7c295e","90":"instance--f6953769-2ccd-5d03-909c-0e46f1e6dfac"},"id":"user_account","instance":"user-account--2","properties":[["account_login","golden key"],["evidence",[["item-1",{"citation":"CrowdStrike blog","excerpt":"The other one was what we call the \u201cgolden key.\u201d It was a service account that had been created to pull security information from all the domain controllers.","source":"https://www.crowdstrike.com/blog/hidden-administrative-accounts-bloodhound-to-the-rescue/","source_field":"normalized_text","source_object_id":null}]]],["display_name","golden key service account"]]},{"anchors":{"0":"instance--2ae56b65-9e6c-58d1-8da0-e566ce202160","120":"instance--6de90b1f-9793-5225-b80e-fa9bacb5c80e","150":"instance--92b5966e-8564-5b3a-94ae-afeeb738b1aa","18