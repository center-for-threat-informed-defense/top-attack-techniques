db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Request KEXT load"],["description","When a request is made to load a KEXT that the user has not yet approved, the load request is denied and macOS presents the alert shown in ."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.006"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Present approval prompt"],["description","This prompts the user to approve the KEXT in System Preferences > Security & Privacy as shown in ."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1204"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Load approved KEXT"],["description","Once approved, the KEXT will immediately be loaded or added to the prelinked kernel cache, depending on what action was blocked. Subsequent requests to load the KEXT will proceed silently as on previous macOS versions."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.006"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Disable approval requirement with spctl"],["description","If your workflow is based on imaging, boot into Recovery OS and use the command. For detailed information about the command, run the command . This command can either disable the user approval requirement completely or specify a list of Team IDs whose KEXTs may be loaded without user approval. The command works in any installation environment, including Recovery OS and from NetBoot/NetInstall/NetRestore images."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a