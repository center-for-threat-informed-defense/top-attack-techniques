7","software--oracle-12c","instance--59b16efd-5d26-55f8-a572-90b1c5a8e566","instance--830c689e-30ee-5641-8291-70063c87886d","instance--e887ea68-e32b-55fb-b90f-218180540692","instance--76e7610c-2bb4-5acd-bbf0-d398e86a52ee","software--microsoft-sso","software--citrix-vpn","instance--cece9b1f-4145-5ea6-a80f-f7da8f42a7a4","software--gitlab","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--338a08d1-596c-5134-86e1-58bc27da7116","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--3d75b4ae-3541-5ff2-b4f5-0d67b8bb9252","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--be99ba49-e121-58a8-ba7b-dd3de316cfcf","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--c075f5c6-95e8-5553-8f7e-b432b96021c7","instance--3b404379-7d7e-5278-b499-6ac12ee4e90f","instance--3e0f78a3-bb54-55bd-8490-3453d5e06d04","instance--a37796a0-93b2-51bb-be4b-2a9a9e7e35e1","instance--cb7da505-6791-507a-9a93-f9914c292d1b","instance--f5161822-4fa1-5df5-9039-85523da39209","instance--77414a6f-10f0-5dbb-b428-351706ad11fd","instance--f9c9b265-fc34-5120-8a3d-f9bd8fbf0c0f","instance--b3aa1b20-0a98-5bee-9b24-afe8c9468e2a","instance--af305316-e051-5c13-9fdd-827984f09e8d","instance--aaed1ef6-6978-5a66-983b-51be56c74b70","instance--d190f90c-4784-50da-ad09-085edc636fbd","instance--2dee099b-44ab-5a0d-a084-13650856c2c4","instance--d9f04178-c400-591e-b2d2-796ef1c45472","instance--ca4529d8-d496-5664-863c-c2bb8a8ee910","instance--d0ad382e-c9e5-5bb3-bb01-0d18e49e89cc","instance--d97bae02-3a4e-5765-9c9d-648d30a6764a","instance--8988581d-7834-57f7-b63e-0ae83ae5f581","instance--6bb5d435-6891-5ad0-af02-3fc6ac93ad9e","instance--b151767c-8207-57d9-bfa1-5537a2502fe9","instance--2bc71083-5997-515c-8bfa-bbf5f6668e61","instance--c4c116ab-7996-5c6f-8987-3aebcdfa3cbf","instance--499f5dff-a3db-5bd9-ad30-daf4b4c74350","instance--0ce71439-3468-5955-96de-548341c524d0","instance--125a49c5-55e9-575a-a7cb-0a9af32ea0be","instance--d88af18e-08bc-5b56-8fc1-b12aa75a33c3","instance--8d97fc8e-b875-5491-8c32-0cc774a35856","instance--bc135b50-f401-5a7a-b4cd-4cd3c04a88e7","instance--81553cbc-d2a2-5ceb-bb38-69d029294666","instance--b994d420-e6fb-5842-9327-8f6b13a8fd26","instance--172251bb-8d4b-57ad-9eab-2b56c6031fcf","instance--a45bc42f-b8ea-563d-8770-aa88d9de07c5","instance--e966d095-f373-52d4-92eb-70ab98828692","instance--4d57f092-ff18-517a-bbc0-143fa124cf93","instance--c4d051fc-be4e-5b5b-a7ee-04b274ff0165","instance--94eafcd0-7b01-5372-ba4e-4a1285713140","instance--7fe0eeab-308f-5588-91a0-9a041fe0c2bd","instance--a253aa0c-4957-5d4d-bf27-4ec699e6a6a3","instance--80d5812c-afb0-5169-8e43-f40ea931cd68","instance--954ecee2-3dd8-517f-b77b-0559d17535ef","instance--2a230da0-5a23-5c61-811d-f0975c2adfba","instance--83b76fa3-e58d-504d-8ea4-1371bcf4563e","instance--11fc05bf-d483-58f9-a43f-1dbb203a336e","instance--a46a371f-7360-50b7-bcb7-16789d0b8d46","instance--0b524b99-8958-59f1-9f46-1f26c9a92aa6","instance--1d41da07-8e17-5389-8a04-11a33e22c31a","instance--e3b30938-9a32-5ffa-96d3-b47b25fe73c0","instance--95600ed5-3a6a-5d56-aba5-e56e76e5d4ce","instance--260cb9f3-cf97-5db0-8898-5d3d64cc6a80","instance--b5114a4e-d298-577c-83a5-5f30532e51b2","instance--35dbf6ed-6389-5158-bfec-7b7bf573c2c3","instance--0362e7b6-f58f-5eed-8728-4503fc561ad4","instance--b35bab71-9694-5e65-a75f-f9f9e029f74e","instance--7829022d-2b30-543f-9e6d-0520765dfb55","instance--da90b131-8415-511a-b831-98a79c31b278","instance--6d74d75c-1766-5953-92d6-c6af09be67e4","instance--3c202d02-aca2-5f6f-8026-f4790bcfee6b","instance--e107b0af-cc87-560f-9e6f-3d2cc013c99c"],"properties":[["name","ShinyHunters cloud application targeting and data extortion operations"],["description","EclecticIQ analysts assess with high confidence that ShinyHunters is expanding its operations by combining AI-enabled voice phishing, supply chain compromises, and leveraging malicious insiders, such as employees or contractors, who can provide direct access to enterprise networks."],["scope","campaign"],["author",[["name","EclecticIQ analysts"]]],["external_references",[["item-1",[["source_name","blog.eclecticiq.com"],["url","https://blog.eclecticiq.com/shinyhunters-calling-financially-motivated-data-extortion-group-targeting-enterprise-cloud-applications"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Acquire VoIP and AI voice services"],["description","ShinyHunters affiliates used VoIP based calling services including Twilio, Google Voice, and 3CX for vishing operations. The group also abused legitimate AI-powered voice call platforms such as Vapi and Bland to automate social engineering calls at scale."],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1583.006"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Configure AI vishing agents"],["description","ShinyHunters members abused Bland AI to power AI-driven social engineering agents that dynamically adjust their narratives and tactics in real time, tailoring responses to victim\u2019s reactions during phone calls. The built-in large language model (LLM) in Bland AI enables attackers to generate and design conversational pathways tailored to specific scenarios, ensuring the call remains convincing even if the victim responds outside the scripted scenario."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.004"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Automate press-one phishing templates"],["description","These services allow threat actors to place calls over Google Voice or other VoIP providers and lure victims into pressing \u201c1\u201d to trigger pre-configured phishing templates. Attackers design and upload the templates to Telegram bots. The templates can simulate machine-generated voices, capture credentials, and automate the authentication flow, significantly lowering the barrier to entry for vishing campaigns."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.004"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Vish Salesforce users"],["description","EclecticIQ analysts assess with high confidence that ShinyHunters orchestrated vishing operations to compromise Salesforce applications . Attackers impersonated IT staff and called corporate support desks, directing employees to the legitimate Salesforce app connection page. During these calls, victims were deceived into entering connection codes that authorized actor-controlled applications, often a modified version of the Salesforce Data Loader thereby granting attackers access to organizational accounts."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.004"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Use authorized Salesforce app access"],["description","During these calls, victims were deceived into entering connection codes that authorized actor-controlled applications, often a modified version of the Salesforce Data Loader thereby granting attackers access to organizational accounts."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1528"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Exfiltrate bulk data from Salesforce"],["description","Compromised Salesforce CRM (Customer Relationship Management) dashboards enabled bulk data exfiltration and lateral movement into Okta, Microsoft 365 and Amazon S3."],["confidence",0.0],["ttp",{"tactic":"TA0010","technique":"T1567.002"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Move laterally to cloud services"],["description","Compromised Salesforce CRM (Customer Relationship Management) dashboards enabled bulk data exfiltration and lateral movement into Okta, Microsoft 365 and Amazon S3."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1078"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Leak stolen data samples via LimeWire"],["description","In several data extortion campaigns, ShinyHunters used the LimeWire file-sharing service to leak samples of stolen data, amplifying pressure on victims to pay seven-digit extortion demands."],["confidence",0.0],["ttp",{"tactic":"TA0010","technique":"T1567.002"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Call customers through Omni-Channel"],["description","After gaining access, ShinyHunters used the victims Salesforce CRM dashboards to call their customers through the Omni-Channel feature , turning the trusted platform into a tool for vishing and data extortion."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1565"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Use ScreenConnect for initial access"],["description","The group achieves this objective through identity theft against high-privileged SSO users or by gaining initial access to data-rich systems via remote management tools (RMMs) such as ConnectWise ScreenConnect."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1133"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Impersonate Okta login pages"],["description","EclecticIQ analysts assess with high confidence that ShinyHunters has operated phishing infrastructure since early 2025. The group impersonated Okta SSO login pages to steal credentials from high-value sectors including investment banking, luxury retail, travel, U.S. payment processing, and major e-commerce."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.002"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Clone legitimate Okta authentication flow"],["description","EclecticIQ analysts observed that as part of ShinyHunters social engineering strategy, threat actors cloned the authentication flow and user interface of a legitimate Okta subdomain (trial-6857053.okta[.]com). They replicated the login form with target organization branding to create a convincing phishing page that mimicked official Okta environments."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1583.006"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Host phishing domain on pivoted infrastructure"],["description","One of the pivoted IP addresses, 196.251.83[.]162, was identified hosting the phishing domain BLESS-INVITE[.]COM. According to WHOIS records, the domain was created on 5 April 2025 and last updated on 4 July 2025, aligning with the likely operationalization of the infrastructure. The domain was registered through Tucows with privacy protection services provided by Njalla, a registrar frequently leveraged by threat actors to conceal ownership and hosting details."],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1583.003"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Obtain BrowserStack API keys"],["description","EclecticIQ analysts assess with high confidence that ShinyHunters obtained BrowserStack API keys created by engineering teams and used them to target enterprise development environments."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1528"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Target CI/CD workflows with stolen keys"],["description","BrowserStack\u2019s integration with CI/CD pipelines and collaboration platforms such as Jira, GitHub, Slack, and Azure DevOps amplifies the potential impact of API access theft. Even a single stolen key can extend attacker visibility from testing environments into broader engineering workflows, creating opportunities for supply chain compromise and enterprise-wide data breaches."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1195"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Exploit Oracle Access Manager vulnerability"],["description","According to data obtained from a public Telegram channel operated by the ShinyHunters team, the threat actor persona \u2018Yukari\u2019 exploited an Oracle Access Manager vulnerability (CVE-2021-35587). The attack targeted financial institutions and manufacturers."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1190"}]]},{"anchors":{"0":"instance--dbfe6415-cd2c-55f2-9509-06b6668ef23a","120":"instance--79ca45e2-afd7-51fa-9574-5085c7de4c84","150":"instance--39171cfe-3bf6-5200-b6f5-e97e3b047db7","180":"instance--8cda146b-7259-56b2-b337-56038a1f52d3","210":"instance--a662f8bf-2723-58c0-a1a8-9af9497cf428","240":"instance--a9b75b15-3be0-5e64-8132-40b87e7ae405","270":"instance--31896ecd-322b-5a41-bd1e-0b7a30b9d9d1","30":"instance--60868276-2726-597d-8f57-8aa7fc9c0738","300":"instance--4f5668fa-b6ef-57cc-93da-5cd1e1727a22","330":"instance--b022a562-9020-587c-a5be-97d254cc8f11","60":"instance--cf452b0f-192e-5357-ba8c-fbae1a6e4ae0","90":"instance--012cc6fc-0a37-5e6e-b9b7-07f3bcd2d02c"},"id":"action","instance":"attack-action--17","properties":[["name","Abuse hard-coded credential for database access"],["description","EclecticIQ analysts assess with high confidence that the threat actor gained access to the Oracle 12c (12.2.0.1.0) production database.  The actor abused a weak, hard-coded credential stored on the application server."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1078"}]]},{"anchors":{"0":"instance--a73f63ad-1c10-59c2-82aa-bef4ae8f64e0","120":"instance--62757838-a58e-5d41-b7e3-1ccc64e8cdbf","150":"instance--3462202b-a91d-5325-abfe-876a63049484","180":"instance--72959cd4-5e05-5d69-a145-8b6f35720646","210":"instance--d3b85082-8de6-5ffd-8abe-c9e1ec43f533","240":"instance--0a22ffab-8bbc-55b1-85ec-df74e4a120f6","270":"instance--548b3ba1-955f-5e04-b6e8-064cc259e7a6","30":"instance--6f0a37c5-db81-5459-92c1-bc8ab8cd1fd3","300":"instance--e81be898-f7c2-56a0-a705-d2aba8831f75","330":"instance--8f207ed6-cb63-551c-9a40-583fac14fe80","60":"instance--8b44546f-f8e4-5d12-b172-99f9507395eb","90":"instance--f61db455-1665-504d-85b4-5fd5d40fbcc2"},"id":"action","instance":"attack-action--18","properties":[["name","Run SQL queries with SQL*Plus"],["description","Once authenticated, the actor used SQL*Plus to run queries and exfiltrate data in some cases."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1213"}]]},{"anchors":{"0":"instance--223a73a7-07a6-5688-bc70-e7fbf2c8afd4","120":"instance--2184e59f-b6bd-5ca7-8254-3872e152a964","150":"instance--eed82efc-7573-5ccf-97d8-e3f88a2337bb","180":"instance--453ded0c-8246-59f2-a14f-beca9e751cd6","210":"instance--143e4619-312d-5cbc-acc5-efed5f6c0164","240":"instance--659cf4a8-ca80-5204-8b8d-3240f6f370da","270":"instance--2dac3e32-a8df-582e-845a-3a7b1d510c1d","30":"instance--6ab42faa-5ba5-5c44-b387-40b1d021e500","300":"instance--96e5ad82-e4af-5995-8b69-6df7d7ce2490","330":"instance--a960fdd4-4889-5426-a406-4761d11be5ab","60":"instance--42df375f-d3e2-5d47-9faa-324aecbbf064","90":"instance--51395417-94d2-5b5a-881c-7b6cc63ade4e"},"id":"action","instance":"attack-action--19","properties":[["name","Exfiltrate Oracle data"],["description","Once authenticated, the actor used SQL*Plus to run queries and exfiltrate data in some cases."],["confidence",0.0],["ttp",{"tactic":"TA0010","technique":"T1041"}]]},{"anchors":{"0":"instance--25dacfeb-3a3d-51fc-91b7-64ee405fe041","120":"instance--5a984174-ce49-510d-b6b6-d4f0e0ee332f","150":"instance--f2167f56-1cf9-5fea-a726-d003a591d391","180":"instance--70c47af3-1817-5ae2-9f6e-38421d85f808","210":"instance--cfd506cd-f673-5f4f-a5ff-5854ad8a39d5","240":"instance--b78e4cb3-2b2b-5706-8d59-d252dd134505","270":"instance--73410cfd-8533-5545-94b7-c06859fcd4a8","30":"instance--760fe684-ea1e-52a0-87e8-fa0bc5d62d70","300":"instance--fa30f213-64f3-55b5-85cd-9dbf46e0e8dc","330":"instance--0dbe5c9b-c2db-5139-a300-8054f3a8e205","60":"instance--a78137f8-a78e-563e-ad44-749594629166","90":"instance--626b6c26-479d-5895-a619-ee3dbb14136d"},"id":"action","instance":"attack-action--20","properties":[["name","Recruit insiders for cloud and VPN access"],["description","On August 31, 2025, the Telegram channel \u201cscattered LAPSUS$ hunters 4.0,\u201d operated by ShinyHunters, posted a recruitment message. The group recruited insiders at enterprise organizations who could provide access to Okta, Microsoft SSO, Citrix VPN, or Git version control solutions Github, Gitlab."],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1589"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","During these calls, victims were deceived into entering connection codes that authorized actor-controlled applications, often a modified version of the Salesforce Data Loader thereby granting attackers access to organizational accounts."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","Once authenticated, the actor used SQL*Plus to run queries and exfiltrate data in some cases."]]},{"anchors":{"0":"instance--36aad375-d405-5e3b-9a7d-4346c75c9f45","120":"instance--acc72955-e581-59b3-80b5-35fb047df4b8","150":"instance--d5d0ec7c-da1b-5d39-86e4-8de8792ab05d","180":"instance--047e7862-d9c4-5716-b778-899a86595b48","210":"instance--650a6d3c-5cb0-5f82-83ec-c5d828e2502b","240":"instance--3f08654d-fd5e-59cb-af47-8bbcee29de39","270":"instance--e175549d-38ff-5527-bdb8-de5e1a12f356","30":"instance--c6e60459-b005-50cd-9e68-66ef210b5456","300":"instance--f90b34f0-8620-5a56-9e11-4db2b889aac4","330":"instance--93872aee-cf81-52fa-aa93-f7a84a833dbd","60":"instance--5a877a06-3649-5bba-9461-5faee75ea842","90":"instance--68af6616-0e27-5395-b4ff-5d95b55a2405"},"id":"AND_operator","instance":"attack-operator--1","properties":[["operator","AND"]]},{"anchors":{"0":"instance--37f0fc71-c7f3-5bdc-b66f-0c091232d2c2","120":"instance--5e2c8743-7cfb-52a3-9fa3-44c0423e665b","150":"instance--abfdd858-89fb-5f6d-b9c0-c4aa0b11749d","180":"instance--31db81b0-15fe-59a2-a28f-5a1523b35687","210":"instance--f4b2713b-baa9-5824-80f3-4006a53e7209","240":"instance--f82cff5f-7bbe-5771-b740-80d7