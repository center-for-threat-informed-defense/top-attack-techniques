2"}]]},{"anchors":{"0":"instance--93ee4f51-8321-58fb-b05f-3a6fd3a6a8ab","120":"instance--02ee2d77-fc8c-55cc-8958-e3d0b5ead581","150":"instance--15aaf9f3-3996-5f9b-bee4-47f2963a0df4","180":"instance--1ae13e0a-be4e-5658-ba6d-c941c0d5cafb","210":"instance--87590098-5adb-5af7-aa75-039447d58b2b","240":"instance--87dee187-bf66-5b52-81e0-15b789ab6a7c","270":"instance--25c474c1-a795-5124-95ce-3e6163b067d2","30":"instance--ae371f09-8eae-53a7-a14c-34f9e72904fd","300":"instance--9ecc9c80-603d-5760-b2b6-f850dfd3eddf","330":"instance--b9543d3c-a7f9-50a6-b8a1-3fd4c6dddd56","60":"instance--cba1b44c-d7c9-5ebb-8433-b63b0b91427c","90":"instance--1c5f2ea2-c075-51ba-9f13-69b716c352cf"},"id":"action","instance":"attack-action--21","properties":[["name","Exfiltrate data to remote server"],["description","Data that was collected from the domain was exfiltrated to a remote server at:\n\n45.147.160.5:443"],["confidence",0.0],["ttp",{"tactic":"TA0010","technique":"T1048.002"}]]},{"anchors":{"0":"instance--da12a10e-e9d8-58e0-9dda-e871f0fcaf7c","120":"instance--6e98f91f-940c-5b7d-8e4e-950f2c88b044","150":"instance--02b3e90f-a9f8-5908-b936-c779b2c570d8","180":"instance--5c256240-99ff-5907-aca7-0f81639a7419","210":"instance--e42c995a-6770-583f-9a60-afcdf41d5501","240":"instance--eee0e52c-22be-5b9b-819e-097b65b643d8","270":"instance--d4973194-aaba-5ce5-99ba-7d7c8bca7b50","30":"instance--91b449e9-d343-56d1-9376-8a2655b8032b","300":"instance--23579e20-df5a-5dad-9088-26b612c3c5aa","330":"instance--2ed64056-576c-519d-b8c7-4e1f2c06b6e9","60":"instance--c59d1168-f011-5687-803d-27aa797d72e2","90":"instance--321449b3-3e1e-5b4b-aab6-507e5ad1c36c"},"id":"action","instance":"attack-action--22","properties":[["name","Create GPO to disable Windows Defender"],["description","Prior to executing the ransomware, the threat actors created a GPO to disable Windows Defender across all systems/OUs.\n\nThe GPO was named \u201cnew\u201d."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"ancho