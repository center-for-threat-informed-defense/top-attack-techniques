l","instance":"url--1","properties":[["value","Github"],["evidence",[["item-1",{"excerpt":"Once the user clicks a link in the news feed, the application will navigate away from the wallet interface and loads the external website (Github, in this case) inside the current window.","source":"https://medium.com/certik/vulnerability-in-electron-based-application-unintentionally-giving-malicious-code-room-to-run-e2e1447d01b8","source_field":"normalized_text"}]]],["display_name","Github"]]},{"anchors":{"0":"instance--7bca99b4-fc37-5b67-9da4-7aaaaca1937e","120":"instance--a653e288-958c-5a34-826a-c7ae2da3173f","150":"instance--9fb91ed2-00e9-50c3-8ceb-3f10b07b73bc","180":"instance--bf4d856a-43b2-58e9-a272-467b1a321907","210":"instance--10ca6953-dd7d-54b7-9406-bb40125e27e2","240":"instance--db0c8479-7e26-5d86-b4d9-d52f19ad3f45","270":"instance--3f9b75b2-1c8a-564a-8a7b-b898a27995dd","30":"instance--3663489e-5635-5e70-b0e5-70a502523b87","300":"instance--bdba1e6c-e0e6-5e31-a7d0-c53e76e3cb8b","330":"instance--163f5749-44cf-50b1-ba73-97edab024b3b","60":"instance--7d417c1a-591b-5278-821e-7d21ac26d33f","90":"instance--4d5c0684-fd37-55f3-860f-2e9735603afe"},"id":"software","instance":"software--2","properties":[["evidence",[["item-1",{"excerpt":"With set to true and Node.js enabled, arbitrary javascript execution can be escalated to remote code execution with the help of the \"child_process\" module.","source":"https://medium.com/certik/vulnerability-in-electron-based-application-unintentionally-giving-malicious-code-room-to-run-e2e1447d01b8","source_field":"normalized_text"}]]],["display_name","child_process"],["name","child_process"]]},{"anchors":{"0":"instance--8cf549a5-7e7d-51cf-9368-9b5e0744592a","120":"instance--06d4fda8-e0bf-574e-b3d8-a62c44712794","150":"instance--bb5815b3-6a43-5e3f-b9bc-9862b25fcfbb","180":"instance--f044d6bc-5582-5c4b-8062-d78469e24a48","210":"instance--e728313e-5605-515c-b37b-9ffb6e4816de","240":"instance--2e67ae43-8ff1-546b-b53a-2147995d4ec2","270":"instan