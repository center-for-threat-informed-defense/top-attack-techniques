{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","attack-action--13","attack-action--14","attack-action--15","instance--44a1b517-b933-5baa-b66b-a3f801b51b33","instance--1f03a786-2009-54ac-b415-a1469f839e5c","instance--1ff60202-b9c7-57cb-8ccd-13c76967574b","instance--941c95ac-8f84-5856-9af4-a3ace9f3f8fb","instance--74a72541-aeb1-5596-83aa-d7b76d1f436f","instance--1afb7442-5b33-57ff-81e0-e1a49467d6c8","instance--a2c86e69-bdad-5d80-93df-639af6e65656","instance--e64d0116-e010-5462-8f6f-90018ee2a92d","instance--963afd83-db68-5417-9cf5-a1200a5b5db6","instance--6f913fb6-2367-5e19-bbd2-8a7a72bf93e4","file--cmd","instance--c413c746-297a-5195-b1c0-8eb224fddcdc","instance--739936de-f152-52ae-a812-a95763cb7b00","instance--f06a9ec1-7d5a-541a-aad9-97477df9a11c","instance--f778c782-869e-58b0-86cd-d1c0c7ebde13","instance--5dfb7ef1-f77d-5b9f-8d41-2c2a25ed22a4","file--pfx","instance--7fd50bc5-703c-5325-98cb-ddf6cf85f16b","instance--412781fb-14fc-516d-a7f1-0e92650c716a","instance--95bf6ede-4d9f-5cab-8859-6f03ed51df0e","instance--395b9557-2fc1-5ee0-8dec-bac7aeddb901","instance--70cf1a68-b499-58cf-80a4-b1fb52180a75","instance--1d0c1e14-0919-5a88-8758-5759f82223e4","instance--11589697-f016-599c-aa9a-dba90659ccf0","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--be99ba49-e121-58a8-ba7b-dd3de316cfcf","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--c075f5c6-95e8-5553-8f7e-b432b96021c7","instance--3b404379-7d7e-5278-b499-6ac12ee4e90f","instance--3e0f78a3-bb54-55bd-8490-3453d5e06d04","instance--fdf6b048-37ce-53f9-b4ed-eda8e88826e8","instance--7e4db302-ed76-53ae-8050-b0d582867949","instance--e1dc9dc6-b72d-5fac-a085-54c2fadb2ebb","instance--fdfad33d-1417-57b7-b83c-b2f367d73bc1","instance--65acf6ba-beb8-51b3-bc85-c7e45c164b98","instance--7b517c30-2459-5592-b508-66f76703f080","instance--b8a09a98-2c8e-539d-9b20-16cbb809d113","instance--29d5068a-1c37-5719-bc56-5acf14bdb1ea","instance--0b463426-5b3b-53df-96ba-63d7eed777f1","instance--0bf96ea3-6eb2-5643-96e0-85b9f17367b3","instance--e2353115-6fa1-5d7c-a908-8054365bfb67","instance--26f1f0b7-f87b-54df-8469-0a95f48dc101","instance--c9e83b90-95ba-5fa0-9f54-a36f578642e7","instance--2bf5a923-310a-5f38-a910-312ee01ae89f","instance--dfda35e3-b113-50fc-a70d-c6db12746edf","instance--344b8dfa-0ec1-5cb0-a3c2-ed0b23778878","instance--eaa96d44-192c-5dc8-8e5a-dafc8b2db815","instance--30c4117c-0a34-5fc3-bd5a-dfc4ebb00840","instance--2527fec4-e77f-58a7-b7b2-dd824f97d8f9","instance--e574e55e-b2fa-5ce6-81b6-90c3924dbbe6","instance--62cf923a-ed68-5164-a055-4dce4a9ee35f","instance--395cc3df-23fe-52ec-9436-d630e5f0c881","instance--14c52232-fb1b-5294-b08f-b4e5f5f3cd4a","instance--1109942d-860e-572c-905b-eb3b6e736196"],"properties":[["name","Mimikatz credential theft and Kerberos abuse procedures"],["description","Procedural attacker behaviors described in the Mimikatz command reference, including LSASS credential dumping, ticket injection, DCSync, certificate export, event log tampering, SSP injection, Skeleton Key, SIDHistory abuse, and token impersonation."],["scope","incident"],["author",[["name","Sean Metcalf"]]],["external_references",[["item-1",[["source_name","adsecurity.org"],["url","https://adsecurity.org/?page_id=1821"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Enable debug privilege"],["description","\u2013 get debug rights (this or Local System rights is required for many Mimikatz commands). By default, the Administrators group has Debug rights. Debug still has to be \u201cactivated\u201d by running \u201cprivilege::debug\u201d."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1134.001"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Dump LSASS credentials"],["description","Dumps password data in LSASS for currently logged on (or recently logged on) accounts as well as services running under the context of user credentials."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1003.001"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Dump Kerberos tickets from LSASS"],["description","Lists all available Kerberos tickets for all recently authenticated users, including services running under the context of a user account and the local computer\u2019s AD computer account. Unlike kerberos::list, sekurlsa uses memory reading and is not subject to key export restrictions. sekurlsa can access tickets of others sessions (users).\n\n/export \u2013 optional \u2013 tickets are exported in .kirbi files. They start with user\u2019s LUID and group number (0 = TGS, 1 = client ticket(?) and 2 = TGT)"],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1558.001"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Pass the ticket"],["description","\u2013 pass the ticket After a , it can be copied to another system and passed into the current session effectively simulating a logon without any communication with the Domain Controller. No special rights required. Similar to SEKURLSA::PTH (Pass-The-Hash).\n\n/filename \u2013 the ticket\u2019s filename (can be multiple)\n\n/diretory \u2013 a directory path, all .kirbi files inside will be injected."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1550.003"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Pass the hash"],["description","\u2013 Pass-the-Hash and Over-Pass-the-Hash (aka pass the key).\n\n/user \u2013 the username you want to impersonate, keep in mind that Administrator is not the only name for this well-known account.\n\n/domain \u2013 the fully qualified domain name \u2013 without domain or in case of local user/admin, use computer or server name, workgroup or whatever.\n\n/rc4 or /ntlm \u2013 optional \u2013 the RC4 key / NTLM hash of the user\u2019s password.\n\n/run \u2013 optional \u2013 the command line to run \u2013 default is: cmd to have a shell."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1550.002"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","DCSync pull password data"],["description","A major feature added to Mimkatz in August 2015 is \u201cDCSync\u201d which effectively \u201cimpersonates\u201d a Domain Controller and requests account password data from the targeted Domain Controller.\n\nDiscovers Domain Controller in the specified domain name.\n\nRequests the Domain Controller replicate the user credentials via (leveraging )"],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1003.006"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Create golden ticket"],["description","The Mimikatz command to create a golden ticket is \u201ckerberos::golden\u201d\n\n/domain \u2013 the fully qualified domain name. In this example: \u201clab.adsecurity.org\u201d.\n\n/sid \u2013 the SID of the domain. In this example: \u201cS-1-5-21-1473643419-774954089-2222329127\u201d.\n\n/sids \u2013 Additional SIDs for accounts/groups in the AD forest with rights you want the ticket to spoof.\n\n/user \u2013 username to impersonate\n\n/krbtgt \u2013 NTLM password hash for the domain KDC service account (KRBTGT). Used to encrypt and sign the TGT.\n\n/ticket (optional) \u2013 provide a path and name for saving the Golden Ticket file to for later use or use /ptt to immediately inject the golden ticket into memory for use.\n\n/ptt \u2013 as an alternate to /ticket \u2013 use this to immediately inject the forged ticket into memory for use."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1558.001"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Create silver ticket"],["description","A Silver Ticket is a TGS (similar to TGT in format) using the target service account\u2019s (identified by SPN mapping) NTLM password hash to encrypt and sign. The Mimikatz command to create a silver ticket is \u201ckerberos::golden\u201d (yes, you run \u2018golden\u2019 to create silver tickets)."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1558.002"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Create trust ticket"],["description","Once the Active Directory Trust password hash is determined ( ), a trust ticket can be generated.\n\nForge the trust ticket which states the ticket holder is an Enterprise Admin in the AD Forest (leveraging SIDHistory, \u201csids\u201d, across trusts in Mimikatz, my \u201ccontribution\u201d to Mimikatz). This enables full administrative access from a child domain to the parent domain. Note that this account doesn\u2019t have to exist anywhere as it is effectively a Golden Ticket across the trust.\n\nThe Mimikatz command to create a trust ticket is \u201ckerberos::golden\u201d"],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1558.003"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Export non-exportable certificates"],["description","The CRYPTO Mimikatz module provides advanced capability to interface with Windows cryptographic functions ( ). Typical use is to export certificates that aren\u2019t marked as \u201cexportable.\u201d\n\n\u2013 list/export certificates\n\n/export \u2013 optional \u2013 export all certificates to files (public parts in DER, private parts in PFX files \u2013 password protected with: mimikatz)"],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1649"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Clear event logs stealthily"],["description","Note: Run privilege::debug then event::drop to patch the event log.  Then run Event::Clear to clear the event log without any log cleared event (1102) being logged."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1070.001"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Inject malicious SSP"],["description","\u2013 Inject a malicious Windows SSP to log locally authenticated credentials by patching LSASS in memory with new SSP \u2013 no reboot required (rebooting clears the memssp Mimikatz injects). This . Requires Administrator rights."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.005"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Inject Skeleton Key"],["description","\u2013 Inject Skeleton Key into LSASS process on Domain Controller. This enables all user authentication to the Skeleton Key patched DC to use a \u201cmaster password\u201d (aka Skeleton Keys) as well as their usual password."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1556.001"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Add SIDHistory"],["description","\u2013 Add to SIDHistory to user account. The first value is the target account and the second value is the account/group name(s) (or SID)."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1134.005"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Impersonate token"],["description","\u2013 impersonate a token. Used to elevate permissions to SYSTEM (default) or find a domain admin token on the box using the Windows API."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1134.001"}]]},{"anchors":{"0":"instance--16a42981-ac49-5687-9cfe-6c46323f9b2c","120":"instance--c856a882-084a-5887-ab25-4ea88664db72","150":"instance--cb166