dence",[["item-1",{"excerpt":"Upon gaining access to the machines connected to corporate and guest Wi-Fi networks, APT28 deployed Responder. Responder facilitates NetBIOS Name Service (NBT-NS) poisoning.","source":"https://web.archive.org/web/20171202185937/https:/www.fireeye.com/blog/threat-research/2017/08/apt28-targets-hospitality-sector.html"}]]],["display_name","Responder"],["name","Responder"]]},{"anchors":{"0":"instance--062ebbb9-4792-578c-bbc2-152c70c927a0","120":"instance--acfe391e-773b-5034-afe9-bde0f2c92604","150":"instance--14dbcc1d-194c-5464-b223-8ea5c1b405e3","180":"instance--a65227bd-f410-5ac6-bde3-4b87c536cbc1","210":"instance--c5c4f7d1-518a-5fc7-a86d-dcc13453d1a4","240":"instance--2053120d-fb72-5979-a4bd-de276ca6872c","270":"instance--6faa35ca-5504-59b3-badd-d8b0e73e10eb","30":"instance--be03116d-1931-5994-8eed-b7b609e53991","300":"instance--d206a3b4-2443-5424-aa08-24634dc34a9b","330":"instance--7029d14f-2b56-51c1-9f23-857e5e6c10aa","60":"instance--a52fb593-3ed8-5c30-876b-0027ad6aeabe","90":"instance--d816205d-76d7-50ff-98b0-f5bb04c1d62e"},"id":"network_traffic","instance":"network-traffic--1","properties":[["protocols",[["item-1","udp"]]],["dst_port",137],["evidence",[["item-1",{"excerpt":"This technique listens for NBT-NS (UDP/137) broadcasts from victim computers attempting to connect to network resources.","source":"https://web.archive.org/web/20171202185937/https:/www.fireeye.com/blog/threat-research/2017/08/apt28-targets-hospitality-sector.html"}]]],["display_name","NBT-NS (UDP/137)"]]},{"anchors":{"0":"instance--c2e84d8b-5164-58c2-9526-5d9d9d6f8872","120":"instance--af5c0c72-1f78-51b9-b888-1250a72e1fca","150":"instance--07b79917-15e4-5f09-a207-d6f6152473e0","180":"instance--d05c509a-2080-5c66-b004-314696535967","210":"instance--ec78c273-5dc9-521e-82ca-c99e22fd2dfd","240":"instance--09e6b23b-983e-5ca8-a8a9-931fc6216b82","270":"instance--9e22dc2c-a31a-5d2b-84c9-f5e2abf6350b","30":"instance--bd8dfcfd-57e3-5a3c-9235-52fb080a08dc","300":"instance-