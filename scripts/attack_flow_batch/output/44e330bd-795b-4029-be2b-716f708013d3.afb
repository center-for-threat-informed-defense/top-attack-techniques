{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-condition--1","attack-condition--2","attack-condition--3","email-message--1","instance--18acb1e8-0dbc-5fdc-aa7a-664a37ff2675","instance--d56a57e1-38ee-5115-bcad-e7817668513c","instance--b3fb9a46-4198-5d4c-b97e-8d46a5869af2","instance--acb605f3-8c48-56e9-bbf0-b21c54c1519f","instance--107fd804-fbec-5f69-8e9b-905fd6344cc9","domain-name--1","domain-name--2","software--1","network-traffic--1","url--1","software--2","vulnerability--1","instance--ad1f125b-7701-5e9d-b869-79f40471648d","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--a6618e5f-2d2d-55c4-9d60-5edfe63f3ef7","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--e2b88c1c-5dbc-5aad-8cab-841d4d0a85dd","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--c5209c5e-c2ea-5188-a8a1-ae2e556c4dd3","instance--56da8838-1109-5fce-9d89-7b3ec32d7010","instance--7cc46cbd-beb8-54eb-aef6-32656d039f20","instance--b4989f0a-5dbf-5174-8be8-70c1c05501ed","instance--f73cb290-6345-5dc5-af08-9677f9bb8434","instance--13a1d2ce-b971-5f8d-952e-3b059edcaebb","instance--87fa4a6b-4596-5860-918e-e16f74da32fa","instance--4174b963-9347-5fe4-94bd-81b81939df38","instance--9e41bc14-7da4-59c9-923f-256bded0dde5","instance--9d3ba593-9245-5d80-a367-0857d9bf59a0","instance--c4ad8a6c-ecf8-5157-be87-07b18e4ec32a","instance--ef46fe1a-0c86-5570-99ca-2a7266e9bd31","instance--c60a8365-dc47-55a4-aabc-ebb4f5c9470f","instance--024d4ff2-7160-57a6-83ff-4c14bc61cbeb","instance--d55f43fb-c072-5db8-a6a2-92c4d98c2ed5","instance--3b9eaf6a-f53c-5517-bfc2-7177d9865fad","instance--e906e0aa-6f2e-503e-93fd-4ed70d628975"],"properties":[["name","APT28 targets hospitality sector and travelers"],["description","FireEye has moderate confidence that a campaign targeting the hospitality sector is attributed to Russian actor . We believe this activity, which dates back to at least July 2017, was intended to target travelers to hotels throughout Europe and the Middle East."],["scope","campaign"],["author",[["name","FireEye"]]],["external_references",[["item-1",[["source_name","web.archive.org"],["url","https://web.archive.org/web/20171202185937/https:/www.fireeye.com/blog/threat-research/2017/08/apt28-targets-hospitality-sector.html"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Send spearphishing email with malicious document"],["description","FireEye has uncovered a malicious document sent in spear phishing emails to multiple companies in the hospitality industry, including hotels in at least seven European countries and one Middle Eastern country in early July."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.001"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Execute macro and install malware"],["description","Successful execution of the macro within the malicious document results in the installation of APT28\u2019s signature malware."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1204.002"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Decode dropper and deploy GAMEFISH"],["description","The malicious document \u2013 Hotel_Reservation_Form.doc (MD5: 9b10685b774a783eabfecdb6119a8aa3), as seen in Figure 1 \u2013 contains a macro that base64 decodes a dropper that then deploys APT28\u2019s signature GAMEFISH malware (MD5: 1421419d1be31f1f9ea60e8ed87277db), which uses mvband.net and mvtband.net as command and control (C2) domains."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1140"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Seek dual-homed Wi-Fi machines"],["description","Once inside the network of a hospitality company, APT28 sought out machines that controlled both guest and internal Wi-Fi networks."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1018"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Deploy Responder for NBT-NS poisoning"],["description","Upon gaining access to the machines connected to corporate and guest Wi-Fi networks, APT28 deployed Responder. Responder facilitates NetBIOS Name Service (NBT-NS) poisoning. This technique listens for NBT-NS (UDP/137) broadcasts from victim computers attempting to connect to network resources. Once received, Responder masquerades as the sought-out resource and causes the victim computer to send the username and hashed password to the attacker-controlled machine."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1557.001"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Steal usernames and hashed passwords"],["description","APT28 used this technique to steal usernames and hashed passwords that allowed escalation of privileges in the victim network."],["confidence",0.0],["ttp",{"tactic":"TA0043","technique":"T1589.001"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Gain hotel Wi-Fi credentials"],["description","in a separate incident that occurred in Fall 2016, APT28 gained initial access to a victim\u2019s network via credentials likely stolen from a hotel Wi-Fi network."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1078"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Log into victim machine with stolen credentials"],["description","Twelve hours after the victim initially connected to the publicly available Wi-Fi network, APT28 logged into the machine with stolen credentials."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1078"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Deploy tools access OWA and move laterally"],["description","After successfully accessing the machine, the attacker deployed tools on the machine, spread laterally through the victim's network, and accessed the victim's OWA account."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Spread laterally with EternalBlue and py2exe"],["description","To spread through the hospitality company\u2019s network, APT28 used a version of the EternalBlue SMB exploit. This was combined with the heavy use of py2exe to compile Python scripts."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1210"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","Successful execution of the macro within the malicious document results in the installation of APT28\u2019s signature malware."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","Upon gaining access to the machines connected to corporate and guest Wi-Fi networks, APT28 deployed Responder."]]},{"anchors":{"0":"instance--64fa8274-9976-53b9-811c-a0e7e805b799","120":"instance--ce384754-4013-5515-ac17-4456e1d80bbb","150":"instance--99275651-db0d-57ec-a13c-6e557a4b9c7c","180":"instance--cbaa25ac-4f14-51f0-9962-f76fe36e7cd6","210":"instance--1c4fda5b-4605-5040-a88a-48f1df4144aa","30":"instance--39743932-1858-5655-a859-b27c0902b87a","330":"instance--c116df79-3c10-5931-96ec-25b4174ae13a","60":"instance--75b926aa-d189-5cd6-bc7b-5a947c88de41","90":"instance--4931e63d-9e52-5183-bbd8-7db1814b0f21","branch:False":"instance--fc00a7ae-0a9a-58b7-b24a-5def4ea9feab","branch:True":"instance--e3424864-637f-5b96-b87c-a8dcc22d8b9e"},"id":"condition","instance":"attack-condition--3","properties":[["description","After successfully accessing the machine, the attacker deployed tools on the machine, spread laterally through the victim's network, and accessed the victim's OWA account."]]},{"anchors":{"0":"instance--20bbe9f2-ac00-5017-9562-e92ae507e48d","120":"instance--2e844599-4e31-5871-a7c7-04a9c6ce5691","150":"instance--af5a54f1-2b8c-545d-ab59-74cfcebc16f4","180":"instance--c5b59f65-14ce-5c4a-a55a-13ec896deba8","210":"instance--4eb49c2e-b94f-5fdb-a122-d3d8ef90a239","240":"instance--f44660ee-8226-5061-bd29-40feb73e9125","270":"instance--e53b4d9e-5807-50d1-8720-771760b10cc8","30":"instance--730673ac-abcd-57b3-beb5-b2a2dc74a310","300":"instance--1f38467e-7168-5f0b-afe0-9b6769dfade6","330":"instance--d12be42a-ab98-5684-af05-3cad546477bb","60":"instance--96b259a7-f838-5604-a32e-dff12cea472e","90":"instance--01fc9195-8db0-5e99-9765-45e395d2a35a"},"id":"email_message","instance":"email-message--1","properties":[["is_multipart","false"],["subject","spear phishing emails"],["value","spear phishing emails"],["evidence",[["item-1",{"excerpt":"FireEye has uncovered a malicious document sent in spear phishing emails to multiple companies in the hospitality industry, including hotels in at least seven European countries and one Middle Eastern country in early July.","source":"https://web.archive.org/web/20171202185937/https:/www.fireeye.com/blog/threat-research/2017/08/apt28-targets-hospitality-sector.html"}]]],["display_name","spear phishing emails"]]},{"anchors":{"0":"instance--966446be-8810-5356-b59f-0fa542f649e0","120":"instance--d627f90d-b311-51d2-8018-ddc3ada972d2","150":"instance--167b286f-0bb0-5556-a282-06b3c1621218","180":"instance--2c542980-a16f-56ef-96b2-b8a37d4c9b2d","210":"instance--de02d2f9-e485-58f0-bc40-20322adb8c9e","240":"instance--268eeff3-90d1-5563-9426-9dc35a323f19","270":"instance--a632aa58-7571-5928-a853-6bd3ce487da6","30":"instance--66bfa735-b067-502e-97fe-418a252cf681","300":"instance--84d0c576-a6a0-5de4-9c7c-07e621ba9d1a","330":"instance--3bb668e3-cfbf-5a7d-a824-756c43685146","60":"instance--0fe12e04-a9b6-555d-a0ae-186a4b89dd1c","90":"instance--78e248e8-9d94-551e-a785-9053492f05b7"},"id":"file","instance":"instance--18acb1e8-0dbc-5fdc-aa7a-664a37ff2675","properties":[["hashes",[["item-1",{"hash_type":"md5","hash_value":"9b10685b774a783eabfecdb6119a8aa3"}]]],["evidence",[["item-1",{"excerpt":"The malicious document \u2013 Hotel_Reservation_Form.doc (MD5: 9b10685b77