okes-copycat-fears/"]]],["item-4",[["source_name","www.greyhathacker.net"],["url","https://www.greyhathacker.net/?p=796"]]],["item-5",[["source_name","www.kernelmode.info/forum/viewtopic.php?f=16&t=3851#p28028"],["description","www.kernelmode.info/forum/viewtopic.php?f=16&t=3851#p28028"]]],["item-6",[["source_name","communities.cisco.com"],["url","https://communities.cisco.com/docs/DOC-69561"]]],["item-7",[["source_name","www.arbornetworks.com"],["url","https://www.arbornetworks.com/blog/asert/wp-content/uploads/2015/06/blog_h1n1.pdf"]]],["item-8",[["source_name","tools.ietf.org"],["url","https://tools.ietf.org/html/rfc4648#section-5"]]],["item-9",[["source_name","github.com"],["url","https://github.com/dptug/PasswordRecovery/blob/master/firePass.cpp"]]],["item-10",[["source_name","securityxploded[dot]com/iepasswordsecrets.php"],["description","securityxploded[dot]com/iepasswordsecrets.php"]]],["item-11",[["source_name","securityxploded[dot]com/outlookpasswordsecrets.php"],["description","securityxploded[dot]com/outlookpasswordsecrets.php"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Check process context"],["description","Execution flow is broken down into segments based on the name of the current executing process. A check is made by hashing the name of the current executing process and comparing\u00a0it against the value of 0x490A0972 (in this case being explorer.exe)."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1057"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Check OS version"],["description","From Explorer.exe call GetVersionEx to get the OSVERSIONINFOEX structure, verify dwMinorVersion is 1, and dwMajorVersion is 6 (Windows 7)"],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1082"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Check integrity and admin group"],["description","Open the current process token using OpenProcessToken and use GetSidSubAuthorityCount and GetSidSubAuthority to verify that the SID subauthority (current integrity level) is that of 0x2000, or\n\nAllocate and initialize an SID of S-1-5-32-544, which belongs to that of the built-in Administrators group and compare it to the token information of the current process (effectively verifying that the user executing is within the local Administrators group, one of the requirements for bypassing UAC)"],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1033"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Prepare hijacked DLL"],["description","Copy C:\\Windows\\System32\\dpx.dll to %APPDATA%, use MapViewOfFile to copy the file into memory, find the DllEntryPoint within the mapped file and copy the position independent loader code and packed code into dpx.dll:"],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1574.001"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Write hijack binaries with makecab and wusa"],["description","Use makecab.exe and wusa.exe to write required binaries for DLL hijacking to C:\\Windows\\System32\\Drivers (a secure location): cmd.exe /c makecab \u201cC:\\Windows\\System32\\wusa.exe\u201d \u201cC:\\Users\\Administrator\\AppData\\Roaming\\cabfile.cab\u201d\n\ncmd.exe /c C:\\windows\\system32\\wusa \u201cC:\\Users\\Administrator\\AppData\\Roaming\\cabfile.cab\u201d /extract:\u201dC:\\Windows\\Sytem32\\drivers\u201d\n\ncmd.exe /c makecab \u201cC:\\Users\\Administrator\\AppData\\Roaming\\dpx.dll\u201d \u201cC:\\Users\\Administrator\\AppData\\Roaming\\cabfile.cab\u201d\n\ncmd.exe /c C:\\windows\\system32\\wusa \u201cC:\\Users\\Administrator\\AppData\\Roaming\\cabfile.cab\u201d /extract:\u201dC:\\Windows\\Sytem32\\drivers\u201d"],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1574.001"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Execute hijacked wusa"],["description","Execute C:\\Windows\\System32\\Drivers\\wusa.exe which is a high integrity process (set to auto-elevate within its manifest), which loads and executes dpx.dll and bypasses UAC:"],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1548.002"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Stop security services"],["description","Service strings to be killed are encoded using a custom hashing algorithm. Using EnumServicesStatusA each service name is hashed and checked against a list of hashes. If a match is found it is passed off to be killed using \u201ccmd.exe /c net stop [Service Name]\u201d"],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1489"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Disable service startup"],["description","and is prevented from starting on boot by using \u201ccmd.exe /c sc config [Service Name] start= disabled\u201d"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Search Firefox login files"],["description","The login data file \u201clogins.json\u201d is searched for within all available profiles, i.e. \u201c%APPDATA%\\Mozilla\\Firefox\\Profiles\\*.*\\\u201d. Values corresponding to the keys \u201chostname\u201d (the hostname of the login in question), \u201cencryptedUsername\u201d (the encrypted username for the host in question), and \u201cencryptedPassword\u201d (encrypted password for the host in question) are parsed within said JSON blob(s)."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1555.003"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Decrypt Firefox credentials"],["description","Interestingly, the malware decrypts login data using PK11SDR_Decrypt function exported by nss3.dll shipped with Firefox. The function is dynamically resolved using the library hashing method described before being sent upstream:"],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1555.003"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Read IE IntelliForms data"],["description","Internet Explorer IntelliForms login data is extracted from the HKCU\\Software\\Microsoft\\Internet Explorer\\IntelliForms\\Storage2, the caveat being that IntelliForms data is encrypted using the URL of the website that the IntelliForm data corresponds to. Each URL is hashed using SHA1 to generate a sub-key name, within Storage2 key. The key value holds the encrypted IntelliForm data for the URL."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1555.003"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Enumerate URL cache to decrypt IE data"],["description","Since brute forcing URLs would be resource intensive, H1N1 enumerates the current internet cache using FindFirstUrlCacheEntryA for URLs, hashes them, and compares them to the key names in Storage2. If a match is found, then the URL is used to decrypt the data for exfiltration."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1555.003"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Enumerate Outlook profiles"],["description","Outlook profiles are enumerated via the registry at the following locations:\n\nHKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Windows Messaging Subsystem\\Profiles\\Outlook\n\nHKLM\\Software\\Microsoft\\Office\\15.0\\Outlook\\Profiles\\Outlook"],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1555.005"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Decrypt Outlook passwords"],["description","Once enumerated SMTP and POP3 e-mails, passwords, servers and ports are queried. CryptUnprotectData is then called on the resulting password data to be decrypted prior to exfiltration."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1555.005"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Format and encrypt collected data"],["description","Collected data is set into the following format prior to being encrypted with RC4:\n\nguid=[GUID]&os=[OS version integer]&bits=[Architecture]&pl=[Privilege Level]&spread=[Boolean whether this was a propagated binary]&browsers=url: %s,login: %s,password: %s\\r\\n&mails=email: %s,username: %s,password: %s,server: %s,port: %d\n\nThe \u2018browsers\u2019 parameter pertaining to Firefox and IntelliForms data, and the \u2018mail\u2019 section pertaining to the outlook data, respectively. The data is then encrypted with the hard-coded RC4 key"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1027"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Exfiltrate data via HTTP POST"],["description","and sent in a HTTP POST request to one of the aforementioned command and control servers."],["confidence",0.0],["ttp",{"tactic":"TA0010","technique":"T1041"}]]},{"anchors":{"0":"instance--dbfe6415-cd2c-55f2-9509-06b6668ef23a","120":"instance--79ca45e2-afd7-51fa-9574-5085c7de4c84","150":"instance--39171cfe-3bf6-5200-b6f5-e97e3b047db7","180":"instance--8cda146b-7259-56b2-b337-56038a1f52d3","210":"instance--a662f8bf-2723-58c0-a1a8-9af9497cf428","240":"instance--a9b75b15-3be0-5e64-8132-40b87e7ae405","270":"instance--31896ecd-322b-5a41-bd1e-0b7a30b9d9d1","30":"instance--60868276-2726-597d-8f57-8aa7fc9c0738","300":"instance--4f5668fa-b6ef-57cc-93da-5cd1e1727a22","330":"instance--b022a562-9020-587c-a5be-97d254cc8f11","60":"instance--cf452b0f-192e-5357-ba8c-fbae1a6e4ae0","90":"instance--012cc6fc-0a37-5e6e-b9b7-07f3bcd2d02c"},"id":"action","instance":"attack-action--17","properties":[["name","Receive loader commands"],["description","The command and control server will then provide loader\u00a0RC4 encrypted instructions once contacted in the following pipe delimited format:\n\nLINK|10|hxxp://allxbox.ru/about/pm.dll\n\nLINK|11|hxxp://allxbox.ru/about/inst1.exe"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--a73f63ad-1c10-59c2-82aa-bef4ae8f64e0","120":"instance--62757838-a58e-5d41-b7e3-1ccc64e8cdbf","150":"instance--3462202b-a91d-5325-abfe-876a63049484","180":"instance--72959cd4-5e05-5d69-a145-8b6f35720646","210":"instance--d3b85082-8de6-5ffd-8abe-c9e1ec43f533","240":"instance--0a22ffab-8bbc-55b1-85ec-df74e4a120f6","270":"instance--548b3ba1-955f-5e04-b6e8-064cc259e7a6","30":"instance--6f0a37c5-db81-5459-92c1-bc8ab8cd1fd3","300":"instance--e81be898-f7c2-56a0-a705-d2aba8831f75","330":"instance--8f207ed6-cb63-551c-9a40-583fac14fe80","60":"instance--8b44546f-f8e4-5d12-b172-99f9507395eb","90":"instance--f61db455-1665-504d-85b4-5fd5d40fbcc2"},"id":"action","instance":"attack-action--18","properties":[["name","Download and execute URL payload"],["description","As a previous write-up on H1N1 by Arbort Networks describes, the LINK command in this instance results in H1N1 downloading and executing a file from a remotely hosted URL using WinINet HTTP requests."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--223a73a7-07a6-5688-bc70-e7fbf2c8afd4","120":"instance--2184e59f-b6bd-5ca7-8254-3872e152a964","150":"instance--eed82efc-7573-5ccf-97d8-e3f88a2337bb","180":"instance--453ded0c-8246-59f2-a14f-beca9e751cd6","210":"instance--143e4619-312d-5cbc-acc5-efed5f6c0164","240":"instance--659cf4a8-ca80-5204-8b8d-3240f6f370da","270":"instance--2dac3e32-a8df-582e-845a-3a7b1d510c1d","30":"instance--6ab42faa-5ba5-5c44-b387-40b1d021e500","300":"instance--96e5ad82-e4af-5995-8b69-6df7d7ce2490","330":"instance--a960fdd4-4889-5426-a406-4761d11be5ab","60":"instance--42df375f-d3e2-5d47-9faa-324aecbbf064","90":"instance--51395417-94d2-5b5a-881c-7b6cc63ade4e"},"id":"action","instance":"attack-action--19","properties":[["name","Download and execute FILE payload"],["description","The loader\u00a0also has the functionality of downloading and executing a base64 encoded file contained in the response from the command and control server via the FILE command."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--25dacfeb-3a3d-51fc-91b7-64ee405fe041","120":"instance--5a984174-ce49-510d-b6b6-d4f0e0ee332f","150":"instance--f2167f56-1cf9-5fea-a726-d003a591d391","180":"instance--70c47af3-1817-5ae2-9f6e-38421d85f808","210":"instance--cfd506cd-f673-5f4f-a5ff-5854ad8a39d5","240":"instance--b78e4cb3-2b2b-5706-8d59-d252dd134505","270":"instance--73410cfd-8533-5545-94b7-c06859fcd4a8","30":"instance--760fe684-ea1e-52a0-87e8-fa0bc5d62d70","300":"instance--fa30f213-64f3-55b5-85cd-9dbf46e0e8dc","330":"instance--0dbe5c9b-c2db-5139-a300-8054f3a8e205","60":"instance--a78137f8-a78e-563e-ad44-749594629166","90":"instance--626b6c26-479d-5895-a619-ee3dbb14136d"},"id":"action","instance":"attack-action--20","properties":[["name","Delete Zone.Identifier ADS"],["description","They also highlight that H1N1 will delete the downloaded file\u2019s Zone.Identifier alternate data stream in order to avoid showing a warning dialogue to the user once the file is executed."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1070.004"}]]},{"anchors":{"0":"instance--93ee4f51-8321-58fb-b05f-3a6fd3a6a8ab","120":"instance--02ee2d77-fc8c-55cc-8958-e3d0b5ead581","150":"instance--15aaf9f3-3996-5f9b-bee4-47f2963a0df4","180":"instance--1ae13e0a-be4e-5658-ba6d-c941c0d5cafb","210":"instance--87590098-5adb-5af7-aa75-039447d58b2b","240":"instance--87dee187-bf66-5b52-81e0-15b789ab6a7c","270":"instance--25c474c1-a795-5124-95ce-3e6163b067d2","30":"instance--ae371f09-8eae-53a7-a14c-34f9e72904fd","300":"instance--9ecc9c80-603d-5760-b2b6-f850dfd3eddf","330":"instance--b9543d3c-a7f9-50a6-b8a1-3fd4c6dddd56","60":"instance--cba1b44c-d7c9-5ebb-8433-b63b0b91427c","90":"instance--1c5f2ea2-c075-51ba-9f13-69b716c352cf"},"id":"action","instance":"attack-action--21","properties":[["name","Delete shadow copies"],["description","\u2018vssadmin\u2019\u00a0command strings are de-obfuscated using the same mentioned method to be executed by the WinExec API to delete shadow copies:"],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1490"}]]},{"anchors":{"0":"instance--da12a10e-e9d8-58e0-9dda-e871f0fcaf7c","120":"instance--6e98f91f-940c-5b7d-8e4e-950f2c88b044","150":"instance--02b3e90f-a9f8-5908-b936-c779b2c570d8","180":"instance--5c256240-99ff-5907-aca7-0f81639a7419","210":"instance--e42c995a-6770-583f-9a60-afcdf41d5501","240":"instance--eee0e52c-22be-5b9b-819e-097b65b643d8","270":"instance--d4973194-aaba-5ce5-99ba-7d7c8bca7b50","30":"instance--91b449e9-d343-56d1-9376-8a2655b8032b","300":"instance--23579e20-df5a-5dad-9088-26b612c3c5aa","330":"instance--2ed64056-576c-519d-b8c7-4e1f2c06b6e9","60":"instance--c59d1168-f011-5687-803d-27aa797d72e2","90":"instance--321449b3-3e1e-5b4b-aab6-507e5ad1c36c"},"id":"action","instance":"attack-action--22","properties":[["name","Disable Windows recovery options"],["description","Windows recovery options are then disabled by de-obfuscating \u2018bcdedit\u2019 commands and are executed using WinExec as well:"],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1490"}]]},{"anchors":{"0":"instance--9f68185c-8d0f-5e34-b869-da9c17407e5d","120":"instance--99f65057-0748-5b22-b7a8-859b8cb9d46c","150":"instance--1c6c577b-3682-579f-9d80-c1a4c9632dd5","180":"instance--0372a821-a640-58c2-a8f9-f391b8fb0045","210":"instance--bd12903c-f92d-5416-a20f-eedd38d108f9","240":"instance--a221d4df-2c16-5e25-a121-f7cfbb303fb7","270":"instance--550d9be5-209a-50fa-99b8-4dfe7669b693","30":"instance--042db59c-d5d0-5002-ac74-85e947cc6579","300":"instance--2ce3cd55-fc34-5aac-8112-e6cc8fcd707a","330":"instance--55903f51-17c6-554e-8180-6f2511efa2b6","60":"instance--2b4af278-cf58-556d-9fa5-254ca76fcb98","90":"instance--a84c2c43-a2a5-5904-906d-da6a186887bd"},"id":"action","instance":"attack-action--23","properties":[["name","Identify removable and network drives"],["description","H1N1 has self-propagation/lateral movement functionality (which requires user interaction) via mapped/available network shares or mounted USB devices. It will first iterate through the available drives and enumerate whether they are of these types:"],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1120"}]]},{"anchors":{"0":"instance--08881caf-1468-53e2-baa3-c9da43e73b47","120":"instance--5344d679-b2e1-5528-bed5-6fe3fbc90036","150":"instance--f1a3ca80-d761-5917-981a-9d35e6a5161e","180":"instance--bb22e51a-29ce-531e-b80e-4a1d5343b453","210":"instance--380340c8-8f15-5075-a390-ac1b2706e43f","240":"instance--b8ca794c-8bea-5f4c-a746-ad3b31fd2d36","270":"instance--fb5c8b1f-7cc5-58a3-a457-0edfdefa168c","30":"instance--a124cc0a-728c-5b30-8b8b-2171584014e7","300":"instance--7d09cfe0-ac57-5093-a7ce-7c31042d3449","330":"instance--829e634f-5069-5370-8381-e0687a22b00e","60":"instance--0fbffc26-a516-5fcd-9fff-e9aee12c6467","90":"instance--96917b9c-4649-5345-82ac-b4e793881bfe"},"id":"action","instance":"attack-action--24","properties":[["name","Check propagation marker directory"],["description","Once a network or USB drive has been identified (in our testing environment we set up a test SMB share) it will first check if it has already performed propagation to this drive by de-obfuscating and checking for a mock recycling bin directory, e.g: \u201c\\$RECYCLE.BIN.{241D7C96-F8BF-4F85-B01F-E2B043341A4B}\u201d. If found it will not attempt to propagate."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1083"}]]},{"anchors":{"0":"instance--6e9515e3-2497-5444-80ce-9466679d2504","120":"instance--25d30ffe-4a4f-53ec-a34d-de6cc58a2fb0","150":"instance--43abd457-ad7e-5db6-b146-d159a2936c52","180":"instance--f22410a7-1bbd-5943-9121-cf9edb5a0991","210":"instance--4a2a2f86-5543-5514-866c-4d5f4f5bcb3b","240":"instance--f2011b06-5138-5056-a1f2-0a96e9738966","270":"instance--a9d1b1c1-44f0-5281-b6b0-9133e0a433dd","30":"instance--c9339355-ad0b-5e98-9f42-ef0c11d380dd","300":"instance--dec744bc-b6ae-5258-bcb1-83f01a7bb747","330":"instance--54f63fd7-f831-5401-a04f-600f5e780c31","60":"instance--1dd30294-3434-540a-8b5f-d8bc1e3de794","90":"instance--e414165a-d829-5c22-ab74-6aa5e50c83d3"},"id":"action","instance":"attack-action--25","properties":[["name","Count non-hidden folders"],["description","If it has not yet propagated, it will call a function that iterates over all files/directories within this drive using FindFirstFile and FindNextFile. If a directory is found it will query its attributes using GetFileAttributes, and if the returned attributes bit mask does not include FILE_ATTRIBUTE_HIDDEN (by performing a bitwise &) it will increment a count that is then returned. If this count is zero then the calling function will return."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1083"}]]},{"anchors":{"0":"instance--ce3f20b8-daf0-5682-a74a-dd9eb1251abb","120":"instance--08418575-7199-5323-8082-8e1d88a1ec11","150":"instance--15627176-59a5-5797-816e-a6cab3ea9da9","180":"instance--242a8d77-274b-5d18-ba35-771f6e0de836","210":"instance--d01bb126-419a-5d3b-a9cf-7b8df1d59112","240":"instance--0b76a14d-f362-5d5a-995f-2e318539789f","270":"instance--d534a23c-ea17-5a19-96f9-740e77b559a2","30":"instance--9b134899-2cf4-5fcd-9412-5363985ac68c","300":"instance--1bb6a59f-c750-5aca-a7c7-cecaf9c9f1f7","330":"instance--a346b253-e85b-53ff-8e33-33aaa8c928da","60":"instance--0c9baf75-2ba0-51ff-b084-c1044ff899fa","90":"instance--b86b5b84-3a18-51f2-b888-17161b8c5d47"},"id":"action","instance":"attack-action--26","properties":[["name","Create hidden recycle bin directory"],["description","Create the aforementioned recycling bin directory, and add FILE_ATTRIBUTE_HIDDEN to the directory\u2019s attributes"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1564.001"}]]},{"anchors":{"0":"instance--804d7975-bdc1-5371-a95e-4cff0aa0b8b1","120":"instance--aab4410b-5835-54c6-bc0f-d93b86440850","150":"instance--ad5c3f2a-3c32-5af5-9b9c-489a81eead21","180":"instance--3ff51605-dadf-546e-a273-07184c6549e2","210":"instance--9337c97e-ad0d-5d35-8b01-21c1e3f80296","240":"instance--49c4f7e6-8fe8-5919-bda8-039a2aaf3a61","270":"instance--4e395b92-9587-53cc-a957-cad25cc53df8","30":"instance--b917f3cb-7197-5ba7-8a3e-cbfda092d01a","300":"instance--ab650c26-b6f9-59ed-b26e-6f6ca03758dd","330":"instance--36c16e65-d9d7-519a-a8ae-a6dd521ddceb","60":"instance--0b7fc2fd-f6ca-532d-9f2b-ca34c65a881a","90":"instance--ff765750-9ba6-53a3-b366-8a863df1a603"},"id":"action","instance":"attack-action--27","properties":[["name","Choose propagated executable extension"],["description","Using the current drive\u2019s serial number from GetVolumeInformationW, read a 16-bit value from the resulting lpVolumeSerialNumber into AL, and based on this value decide what executable extension to use (pif, scr, exe, or cmd)"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1036"}]]},{"anchors":{"0":"instance--5788127e-30a2-5d63-8064-8a764c79ef88","120":"instance--50a9fb8c-a32c-508b-9ff8-6fbad48bdc18","150":"instance--fb5120ee-d53c-50d4-8806-fb538b7ace76","180":"instance--8c9e9207-faff-59a9-9ac0-4db98f799c06","210":"instance--17f4c1e8-e3de-51ca-a9b4-9407a08ef1f5","240":"instance--72709ae2-9e69-5094-89f4-3bb373306fff","270":"instance--4d10667a-8f14-5176-8d94-a90057c253eb","30":"instance--b7f4854d-0cc9-50b4-aae7-a9728bb18935","300":"instance--bb03752f-dd5c-5086-862e-11a1b554f970","330":"instance--ce6fbeb3-82f7-525d-94ba-6314c642da8e","60":"instance--5e319f8b-f917-5aca-9a32-bd424efd643f","90":"instance--923612bb-e746-52ea-b7f5-39eb0184150e"},"id":"action","instance":"attack-action--28","properties":[["name","Generate GUID filename"],["description","A GUID is generated to be used as the filename with the chosen extension"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1036"}]]},{"anchors":{"0":"instance--421e596f-663b-56b5-aacb-5c51f44887fb","120":"instance--54341936-f58d-5d7b-9140-0b8f37379212","150":"instance--6ca5d726-fab5-5c69-8490-e3c1002a1e49","180":"instance--00c7f913-8a5c-5e23-a21a-23f0b21c0795","210":"instance--c181f118-448c-5e8f-b83c-d03f6d177344","240":"instance--394b4c0e-56d4-5d48-8d37-2f9f3d5ea7f4","270":"instance--d6c97d2a-eacc-5edb-a7c6-1c3f45f4d771","30":"instance--35925ec4-d6e9-58b5-bd90-5e5a63a45b28","300":"instance--547b5bdf-80a3-54cc-b689-2eb517bfe68a","330":"instance--52fc9239-c76d-586d-b11b-ce234424de7d","60":"instance--ba71b506-6338-5b09-9d9e-61f0f5a2c6b4","90":"instance--a64014df-1f09-5b50-b208-7d398753c7cd"},"id":"action","instance":"attack-action--29","properties":[["name","Write hidden propagated binary"],["description","The packed file contents are read from disk into memory and written to this file within the created recycling bin directory while adding FILE_ATTRIBUTE_HIDDEN to its attributes"],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1091"}]]},{"anchors":{"0":"instance--0b4c0918-e86a-5085-87d7-f61b072e242c","120":"instance--12c9af38-e168-50fa-8765-64f02c0ebe95","150":"instance--c6746d99-565a-5e63-970e-a7aaa225ed30","180":"instance--e83416b9-e4c9-5e82-8828-e69fd027460e","210":"instance--de8a8abd-ceba-5797-84f1-54c1caa08458","240":"instance--72aee88b-434a-5ab5-8fd6-4eb52e953599","270":"instance--b36921b5-17c9-5a3f-a687-61f34c4b27cf","30":"instance--5ee548ea-d15e-5136-bc45-4995878b623e","300":"instance--992d0163-d34d-52e2-8eb5-14c76fe451e9","330":"instance--f718bcf2-a112-53c0-a88f-fa2d4cd342ef","60":"instance--35e08b82-20f6-565e-83cf-4b36a763a76d","90":"instance--ec521578-d320-599a-bd89-9ef7c991be84"},"id":"action","instance":"attack-action--30","properties":[["name","Hide folders by renaming to GUIDs"],["description","All folders within the given drive directory are renamed to generated GUIDs and have FILE_ATTRIBUTE_HIDDEN added to their attributes"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1564.001"}]]},{"anchors":{"0":"instance--a94ae3bc-0276-54b9-858c-5463a38e5047","120":"instance--c8d6dba9-53d0-57c4-a2b1-9e203db4f4f4","150":"instance--27d385ee-53a4-5736-aabb-f1a1ed9ea255","180":"instance--4bf51010-637b-5f51-949b-001523c77066","210":"instance--09f04932-2a27-5832-a8e8-4610dda06af9","240":"instance--4f2d72ae-6d69-580f-8b0c-d4ae9d4de12f","270":"instance--9d7a47f3-e008-5167-aa95-d2f3028a2af7","30":"instance--8c32dfe1-51e3-5996-9ff5-4bf429a7d2e0","300":"instance--337f3c1a-0d8e-5224-bfbb-439cf9210776","330":"instance--9572f38f-66c8-57e1-9e25-eb2bccc50821","60":"instance--58bd39dc-d43a-589a-ab2c-770fca3958be","90":"instance--e5f57729-eb8b-5eb8-aded-8719ebfc59de"},"id":"action","instance":"attack-action--31","properties":[["name","Replace folders with malicious LNK files"],["description","For each re-named folder, a file shortcut (.lnk) file is set in its place with the original folder name containing the following:\n\nC:\\Windows\\system32\\cmd.exe /C \u201c\u201d\u201c$RECYCLE.BIN.{[Generated GUID]}\\{[Generated GUID]}.pif\u201d && explorer \u201c{[GUID of renamed folder]}\u201d\u201d\n\nThis will execute the written packed binary when file shortcut is opened and run explorer to open the original folder with the renamed GUID to prevent the user from suspecting malice."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1023"}]]},{"anchors":{"0":"instance--f559716a-6c29-51f0-baf4-a78ada4c416f","120":"instance--3a99c30c-0974-5b88-947a-8d4d5018c15f","150":"instance--539cb708-7cef-5b47-9713-cf02a10dd28f","180":"instance--45b84d58-7b04-508c-95de-9c0a24c16baf","210":"instance--f378ed09-3ae8-59c3-8f51-7ee9f289ede2","240":"instance--dac8acc4-ae45-5a29-a802-f610aea4bb3d","270":"instance--d440b53c-203f-5d58-9232-58db096fec1b","30":"instance--5724a216-1fde-5009-a0b8-5e0e8304c406","300":"instance--4d4a2cda-784a-5b73-a4b1-9a347ad69d91","330":"instance--2645e09b-aa03-5922-95c7-83b80112d37b","60":"instance--f6e62445-6378-5cc6-9aa7-6e720e79c85c","90":"instance--50d2e1c9-6682-5564-bf02-588d6f5bd48a"},"id":"action","instance":"attack-action--32","properties":[["name","Enumerate unmounted network shares"],["description","The same steps will be taken for any available network shares that may not be mounted by enumerating those available using WNetOpenEnumW."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1135"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","When executing as Explorer.exe (where we left off in our unpacking adventure) it will attempt a UAC bypass, self-delete, kill security services, and self-propagate via network shares and USB drives."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","From Explorer.exe call GetVersionEx to get the OSVERSIONINFOEX structure, verify dwMinorVersion is 1, and dwMajorVersion is 6 (Windows 7)"]]},{"anchors":{"0":"instance--64fa8274-9976-53b9-811c-a0e7e805b799","120":"instance--ce384754-4013-5515-ac17-4456e1d80bbb","150":"instance--99275651-db0d-57ec-a13c-6e557a4b9c7c","180":"instance--cbaa25ac-4f14-51f0-9962-f76fe36e7cd6","210":"instance--1c4fda5b-4605-5040-a88a-48f1df4144aa","30":"instance--39743932-1858-5655-a859-b27c0902b87a","330":"instance--c116df79-3c10-5931-96ec-25b4174ae13a","60":"instance--75b926aa-d189-5cd6-bc7b-5a947c88de41","90":"instance--4931e63d-9e52-5183-bbd8-7db1814b0f21","branch:False":"instance--fc00a7ae-0a9a-58b7-b24a-5def4ea9feab","branch:True":"instance--e3424864-637f-5b96-b87c-a8dcc22d8b9e"},"id":"condition","instance":"attack-condition--3","properties":[["description","Allocate and initialize an SID of S-1-5-32-544, which belongs to that of the built-in Administrators group and compare it to the token information of the current process (effectively verifying that the user executing is within the local Administrators group, one of the requirements for bypassing UAC)"]]},{"anchors":{"0":"instance--1a1159e3-7134-5cb2-b831-1c9e4cadc724","120":"instance--267651df-0a90-5013-a3f3-6a84f327fdce","150":"instance--ff657c73-da26-5719-b71e-26c6d439031b","180":"instance--57de1597-7c4d-5cea-858a-0c984a9a171c","210":"instance--4e82ed67-17c4-52f1-909c-1dcc5361a3a3","30":"instance--a8f9c850-7ea4-5848-8bf2-8fcc9e5d1187","330":"instance--b9c275ec-317e-5c35-ad9b-15ea68ddb80f","60":"instance--72f37cb0-dd26-5fa0-ac8f-32361