{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","attack-action--13","attack-action--14","attack-action--15","attack-action--16","attack-action--17","attack-action--18","attack-action--19","attack-action--20","attack-action--21","attack-action--22","attack-action--23","attack-action--24","attack-condition--1","attack-condition--2","file--spotify-exe","file--onedrive-exe","file--whatsapp-exe","file--sun-javar-exe","file--dmcache-exe","regkey--run","software--re-loader","crypto-wallet--btc","software--google-docs","software--youtube","software--bol","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--be99ba49-e121-58a8-ba7b-dd3de316cfcf","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--c075f5c6-95e8-5553-8f7e-b432b96021c7","instance--3b404379-7d7e-5278-b499-6ac12ee4e90f","instance--3e0f78a3-bb54-55bd-8490-3453d5e06d04","instance--a37796a0-93b2-51bb-be4b-2a9a9e7e35e1","instance--cb7da505-6791-507a-9a93-f9914c292d1b","instance--f9e616ac-2310-573d-8995-336b82cf51af","instance--217d0ba2-9160-5126-bbd1-ef9c9efc2cf3","instance--f9c9b265-fc34-5120-8a3d-f9bd8fbf0c0f","instance--92ee8792-942a-5a8c-9c2e-9bc59b33f65a","instance--d10e3bf2-a50f-5852-a99e-152c31cdbbe9","instance--cf5c3394-01b3-5b53-a717-bc5ac6298594","instance--433e6d22-4900-50c8-b324-bafd52f1b824","instance--96daed8d-fe09-5054-a942-40bebac15947","instance--cf942809-6710-560c-af77-cd884a911d7f","instance--c05da312-9600-5b5f-8a57-9e6bba76e363","instance--84f6da99-512f-51c1-bdc6-57c7ea202140","instance--5a6c0d16-8da6-52c3-8779-d19e052faff9","instance--e30ba40d-2ca8-5841-8e95-d7cf05b3d319","instance--587bd354-439d-58b3-8608-71e0edd83b86","instance--0aa4a8b8-3e07-56c5-81a3-a3ce5bf0ce57","instance--87b33741-caba-5321-825b-61794999216a","instance--5cc46b5d-6ea5-5bf9-8d1b-f8988e96d5a0","instance--1cb7bb7c-b4bb-5fae-bbf3-836d65ca045a","instance--db50e350-d65f-56f2-ae38-e3ef39a8726c","instance--f2ece4f6-e4c7-5c4a-a975-6d7d0badc8c6"],"properties":[["name","Casbaneiro: Dangerous cooking with a secret ingredient"],["description","ESET Research\n\nCasbaneiro: Dangerous cooking with a secret ingredient"],["scope","campaign"],["author",[["name","ESET Research"]]],["external_references",[["item-1",[["source_name","www.welivesecurity.com"],["url","https://www.welivesecurity.com/2019/10/03/casbaneiro-trojan-dangerous-cooking/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Phishing email distribution"],["description","We believe that a malicious email is usually at the beginning of Casbaneiro distribution chains."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Download malicious archive"],["description","Instead of that, the installer:\n\ndownloads an archive containing: Casbaneiro masquerading as\n\nother legitimate DLLs"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Extract payload to AppData"],["description","extracts the content of the archive to"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.001"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Set Run key persistence"],["description","sets up persistence using\n\nWe have also encountered cases where the payload masquerades as OneDrive or WhatsApp. In those cases, the name of the folder is changed accordingly.\n\nFilenames\n\n%APPDATA%\\Spotify\\Spotify.exe\n\n%APPDATA%\\OneDrive\\OneDrive.exe\n\n%APPDATA%\\WhatsApp\\WhatsApp.exe\n\n%APPDATA%\\Sun\\Javar\\%RANDOM%\\%RANDOM%.exe\n\n%APPDATA%\\DMCache\\%RANDOM%\\%RANDOM%.exe\n\nRun key & values\n\nHKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run Spotify = %APPDATA%\\Spotify\\Spotify.exe\n\nOneDrive = %APPDATA%\\OneDrive\\OneDrive.exe\n\nWhatsApp = %APPDATA%\\WhatsApp\\WhatsApp.exe\n\n%Random% = %APPDATA%\\Sun\\Javar\\%RANDOM%\\%RANDOM%.exe\n\n%Random% = %APPDATA%\\DMCache\\%RANDOM%\\%RANDOM%.exe"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.001"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","MSI downloads and executes Casbaneiro"],["description","This campaign is very similar to the one described by enSilo; it uses an MSI installer with an embedded JavaScript downloader. Only this time, the installer comes bundled together with the Re\u2011Loader cracking tool allowing unofficial activation of Windows or Microsoft Office. When executed, Casbaneiro is secretly downloaded and executed first, followed by Re\u2011Loader."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1218.007"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Steal clipboard cryptocurrency wallets"],["description","Casbaneiro can also try to steal victim\u2019s cryptocurrency. It does so by monitoring the content of the clipboard and if the data seem to be a cryptocurrency wallet, it replaces them with the attacker\u2019s own."],["confidence",0.0],["ttp",{"tactic":"TA0009","technique":"T1115"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Collect host information"],["description","Casbaneiro collects the following information about its victims:\n\nList of installed antivirus products\n\nOS version\n\nUsername\n\nComputer name\n\nWhether any of the following software is installed: Diebold Warsaw GAS Tecnologia (an application to protect access to online banking)\n\nTrusteer\n\nSeveral Latin American banking applications"],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1082"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Capture screenshots"],["description","The backdoor capabilities of this malware are typical of Latin American banking trojans. It can take screenshots and send them to its C&C server"],["confidence",0.0],["ttp",{"tactic":"TA0009","technique":"T1113"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Simulate mouse and keyboard"],["description","simulate mouse and keyboard actions and capture keystrokes"],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1056.001"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Show fake pop-up windows"],["description","It uses the social engineering method described in the introduction to our where fake pop-up windows are displayed. These pop-ups try to persuade potential victims to enter sensitive information; if successful, that information is then stolen."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1056"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Download and install updates"],["description","download and install updates to itself"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Restrict access to websites"],["description","restrict access to various websites"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Download and execute executables"],["description","download and execute other executables"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Hide C2 in Google Docs"],["description","A more advanced method is to store the data somewhere online, in this case on Google Docs. One way Casbaneiro uses this method can be seen in Figure 12, where the document is full of junk text. The encrypted domain is hexadecimal encoded and then stored between \u201c!\u201d delimiters. The encryption used is that used for all other strings, and the port is hardcoded in the binary."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1102.003"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Hide C2 in crafted website metadata"],["description","In this approach, the operators set up a fake website (Figure 14) mimicking this showing the current time in Brazil. The real C&C domain is hidden inside the web page\u2019s metadata, as can be seen in Figure 15, and the port is hardcoded in the binary. We have encountered at least three such identical websites with different URLs."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1102.003"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Hide C2 in YouTube descriptions"],["description","Casbaneiro started to abuse YouTube to store its C&C server domains. We have identified two different accounts used for this by the threat actor \u2013 one focused on cooking recipes and the other one on soccer.\n\nSo where is the C&C server hidden? Each video on these channels contains a description. At the end of this description, there is a link to a bogus Facebook or Instagram URL (see Figure 17). The C&C server domain is stored in this link, using the same encryption scheme as in the previous case \u2013 the key is stored at the beginning of the encrypted data. The port is, once again, hardcoded in the binary."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1102.003"}]]},{"anchors":{"0":"instance--dbfe6415-cd2c-55f2-9509-06b6668ef23a","120":"instance--79ca45e2-afd7-51fa-9574-5085c7de4c84","150":"instance--39171cfe-3bf6-5200-b6f5-e97e3b047db7","180":"instance--8cda146b-7259-56b2-b337-56038a1f52d3","210":"instance--a662f8bf-2723-58c0-a1a8-9af9497cf428","240":"instance--a9b75b15-3be0-5e64-8132-40b87e7ae405","270":"instance--31896ecd-322b-5a41-bd1e-0b7a30b9d9d1","30":"instance--60868276-2726-597d-8f57-8aa7fc9c0738","300":"instance--4f5668fa-b6ef-57cc-93da-5cd1e1727a22","330":"instance--b022a562-9020-587c-a5be-97d254cc8f11","60":"instance--cf452b0f-192e-5357-ba8c-fbae1a6e4ae0","90":"instance--012cc6fc-0a37-5e6e-b9b7-07f3bcd2d02c"},"id":"action","instance":"attack-action--17","properties":[["name","Generate C2 from fake DNS entry"],["description","The general idea of this method is to register a domain and associate it with a fake IP address so that the real IP address can be derived from it. The algorithm uses three input values:\n\nA - a domain used to derive other domains\n\nA - a list of strings that will be used to derive other domains from the\n\nA - a number used to transform a fake IP address to the real one\n\nA different is used for C&C domain and port. We provide pseudocode in Figure 18. The basic logic of the algorithm is:\n\nGenerate a domain from the and resolve it to a\n\nAdd a to the to get the real IP address\n\nTo get the port, sum the octets of the real IP address and multiply by 7"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1568.003"}]]},{"anchors":{"0":"instance--a73f63ad-1c10-59c2-82aa-bef4ae8f64e0","120":"instance--62757838-a58e-5d41-b7e3-1ccc64e8cdbf","150":"instance--3462202b-a91d-5325-abfe-876a63049484","180":"instance--72959cd4-5e05-5d69-a145-8b6f35720646","210":"instance--d3b85082-8de6-5ffd-8abe-c9e1ec43f533","240":"instance--0a22ffab-8bbc-55b1-85ec-df74e4a120f6","270":"instance--548b3ba1-955f-5e04-b6e8-064cc259e7a6","30":"instance--6f0a37c5-db81-5459-92c1-bc8ab8cd1fd3","300":"instance--e81be898-f7c2-56a0-a705-d2aba8831f75","330":"instance--8f207ed6-cb63-551c-9a40-583fac14fe80","60":"instance--8b44546f-f8e4-5d12-b172-99f9507395eb","90":"instance--f61db455-1665-504d-85b4-5fd5d40fbcc2"},"id":"action","instance":"attack-action--18","properties":[["name","Download XML configuration"],["description","One way that this functionality is used is by downloading an XML document. Data stored in this document between the and labels are encrypted using the algorithm for remote data provided in Figure 8."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--223a73a7-07a6-5688-bc70-e7fbf2c8afd4","120":"instance--2184e59f-b6bd-5ca7-8254-3872e152a964","150":"instance--eed82efc-7573-5ccf-97d8-e3f88a2337bb","180":"instance--453ded0c-8246-59f2-a14f-beca9e751cd6","210":"instance--143e4619-312d-5cbc-acc5-efed5f6c0164","240":"instance--659cf4a8-ca80-5204-8b8d-3240f6f370da","270":"instance--2dac3e32-a8df-582e-845a-3a7b1d510c1d","30":"instance--6ab42faa-5ba5-5c44-b387-40b1d021e500","300":"instance--96e5ad82-e4af-5995-8b69-6df7d7ce2490","330":"instance--a960fdd4-4889-5426-a406-4761d11be5ab","60":"instance--42df375f-d3e2-5d47-9faa-324aecbbf064","90":"instance--51395417-94d2-5b5a-881c-7b6cc63ade4e"},"id":"action","instance":"attack-action--19","properties":[["name","Use XML to update C2 or payload URL"],["description","Once decrypted, the data may contain the following tags:\n\n\u2013 new C&C server domain\n\n\u2013 new C&C server port\n\n\u2013 a URL to use to download and execute a file"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--25dacfeb-3a3d-51fc-91b7-64ee405fe041","120":"instance--5a984174-ce49-510d-b6b6-d4f0e0ee332f","150":"instance--f2167f56-1cf9-5fea-a726-d003a591d391","180":"instance--70c47af3-1817-5ae2-9f6e-38421d85f808","210":"instance--cfd506cd-f673-5f4f-a5ff-5854ad8a39d5","240":"instance--b78e4cb3-2b2b-5706-8d59-d252dd134505","270":"instance--73410cfd-8533-5545-94b7-c06859fcd4a8","30":"instance--760fe684-ea1e-52a0-87e8-fa0bc5d62d70","300":"instance--fa30f213-64f3-55b5-85cd-9dbf46e0e8dc","330":"instance--0dbe5c9b-c2db-5139-a300-8054f3a8e205","60":"instance--a78137f8-a78e-563e-ad44-749594629166","90":"instance--626b6c26-479d-5895-a619-ee3dbb14136d"},"id":"action","instance":"attack-action--20","properties":[["name","Download special configuration file"],["description","In this method, a configuration file is downloaded (as shown in Figure 19). It consists of multiple lines, each one containing:\n\nAn ID of the buyer\n\nPayload archive filename\n\nMain URL where the archive is located\n\nBackup URL where the archive is located\n\nVersion (not used)\n\nA number (not used)\n\nDate (not used)"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--93ee4f51-8321-58fb-b05f-3a6fd3a6a8ab","120":"instance--02ee2d77-fc8c-55cc-8958-e3d0b5ead581","150":"instance--15aaf9f3-3996-5f9b-bee4-47f2963a0df4","180":"instance--1ae13e0a-be4e-5658-ba6d-c941c0d5cafb","210":"instance--87590098-5adb-5af7-aa75-039447d58b2b","240":"instance--87dee187-bf66-5b52-81e0-15b789ab6a7c","270":"instance--25c474c1-a795-5124-95ce-3e6163b067d2","30":"instance--ae371f09-8eae-53a7-a14c-34f9e72904fd","300":"instance--9ecc9c80-603d-5760-b2b6-f850dfd3eddf","330":"instance--b9543d3c-a7f9-50a6-b8a1-3fd4c6dddd56","60":"instance--cba1b44c-d7c9-5ebb-8433-b63b0b91427c","90":"instance--1c5f2ea2-c075-51ba-9f13-69b716c352cf"},"id":"action","instance":"attack-action--21","properties":[["name","Select buyer line and execute payload"],["description","Each Casbaneiro sample using this method has the buyer\u2019s ID hardcoded in its data. When it downloads such configuration file, it parses it and finds the line that is intended for the specific buyer\u2019s ID and downloads and executes the payload."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--da12a10e-e9d8-58e0-9dda-e871f0fcaf7c","120":"instance--6e98f91f-940c-5b7d-8e4e-950f2c88b044","150":"instance--02b3e90f-a9f8-5908-b936-c779b2c570d8","180":"instance--5c256240-99ff-5907-aca7-0f81639a7419","210":"instance--e42c995a-6770-583f-9a60-afcdf41d5501","240":"instance--eee0e52c-22be-5b9b-819e-097b65b643d8","270":"instance--d4973194-aaba-5ce5-99ba-7d7c8bca7b50","30":"instance--91b449e9-d343-56d1-9376-8a2655b8032b","300":"instance--23579e20-df5a-5dad-9088-26b612c3c5aa","330":"instance--2ed64056-576c-519d-b8c7-4e1f2c06b6e9","60":"instance--c59d1168-f011-5687-803d-27aa797d72e2","90":"instance--321449b3-3e1e-5b4b-aab6-507e5ad1c36c"},"id":"action","instance":"attack-action--22","properties":[["name","Register BOL email accounts"],["description","A tool written in C# automatically registers a large number of new email accounts using the Brasil Online (BOL) email platform and sends the credentials back to the attacker."],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1585"}]]},{"anchors":{"0":"instance--9f68185c-8d0f-5e34-b869-da9c17407e5d","120":"instance--99f65057-0748-5b22-b7a8-859b8cb9d46c","150":"instance--1c6c577b-3682-579f-9d80-c1a4c9632dd5","180":"instance--0372a821-a640-58c2-a8f9-f391b8fb0045","210":"instance--bd12903c-f92d-5416-a20f-eedd38d108f9","240":"instance--a221d4df-2c16-5e25-a121-f7cfbb303fb7","270":"instance--550d9be5-209a-50fa-99b8-4dfe7669b693","30":"instance--042db59c-d5d0-5002-ac74-85e947cc6579","300":"instance--2ce3cd55-fc34-5aac-8112-e6cc8fcd707a","330":"instance--55903f51-17c6-554e-8180-6f2511