{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-condition--1","attack-condition--2","user-account--1","instance--aaa15696-eba1-5630-abe7-6eeb65da1682","instance--cd8e2e12-554c-5e0b-9908-bf5d0aaae299","software--2","software--3","software--4","instance--75bd3552-9387-5001-9510-8bba3a3bc0c6","software--5","software--6","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--fe58d3c1-faa4-512f-a0c3-fa75b622e227","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--672b0bb2-5c1d-5df3-9126-38f7203f1a69","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--b879673b-0c82-5a65-8ee4-4f18f90200fb","instance--bf009eb2-0ae7-59c6-babb-b958537d42fc","instance--13c4b1d4-4cbf-5b4c-9e27-332c386dc838","instance--458b9052-de4d-5b30-bc79-d8e8797debaf","instance--399a759f-97f7-528c-90c7-de3363f46907","instance--497b1824-4717-52ce-8be1-bbece7dc77e6","instance--2c15d2a3-b722-5fc5-a814-f5df26ef48d5","instance--c30c76fd-9ea2-5690-adb6-09a7091654ed","instance--6298e0ca-8198-59e9-b0c0-9ae0e17c9601","instance--d44bbc06-16eb-59e7-ad26-f4789470a21b","instance--eb3f3482-e847-56b4-99c7-06c331d82ba7"],"properties":[["name","Best practices for the management account"],["description","Best practices for the management account"],["scope","incident"],["author",[["name","Unknown"]]],["external_references",[["item-1",[["source_name","docs.aws.amazon.com"],["url","https://docs.aws.amazon.com/organizations/latest/userguide/orgs_best-practices_mgmt-acct.html"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Restrict management account access"],["description","Therefore, you should restrict and limit access to the management\n            account only to those admin users who need rights to make changes to the organization."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1078"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Review access to root credentials"],["description","To make sure that you maintain access to the management account, periodically review\n            the personnel within your business who have access to the email address, password, MFA,\n            and phone number associated with it."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1078.004"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Use management account only for required tasks"],["description","We recommend that you use the management account and its users and roles for tasks\n            that must be performed only by that account. Store all of your AWS resources in other\n            AWS accounts in the organization and keep them out of the management account."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1078.004"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Limit resources and data in management account"],["description","Privileged operations can be performed within an organization\u2019s management account,\n            and SCPs do not apply to the management account. That's why you should limit the cloud\n            resources and data contained in the management account to only those that must be\n            managed in the management account."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1565.001"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Prevent member account departures and closures"],["description","We recommend that you attach an SCP at the\n            root of your organization that denies the and actions to prevent member accounts from\n            performing these actions without approval from the management account or a delegated\n            administrator."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1485"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Create and attach SCP manually"],["description","If you created your organization using the\n            AWS Command Line Interface (AWS CLI), AWS SDKs, or CloudFormation, or if your organization\n            was created before this date, you must create and attach this SCP manually."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1098"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Delegate responsibilities outside management account"],["description","Where possible, we recommend delegating responsibilities and services outside the\n            management account. Provide your teams with permissions in their own accounts to manage\n            the needs of the organization, without requiring access to the management account."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1078.004"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Register delegated administrators"],["description","In\n            addition, you can register multiple delegated administrators for services that support\n            this functionality such as AWS Service Catalog for sharing software across the organization, or\n            CloudFormation StackSets for authoring and deploying stacks."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1098"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","Add a monthly or quarterly review of this information to verify that only\n            the correct people have access."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","If you created your organization using the\n            AWS Command Line Interface (AWS CLI), AWS SDKs, or CloudFormation, or if your organization\n            was created before this date"]]},{"anchors":{"0":"instance--cba0db2f-4c26-5332-99c5-b2aee8fd787f","120":"instance--d8fb103f-8665-5f80-9047-210dfff8d4c0","150":"instance--edc40449-4888-59a1-9397-f5c8d35412fc","180":"instance--4252ed4d-ac52-5ce9-b1de-22e62358c57f","210":"instance--ef2d806c-0b9d-5611-a51f-36bdd082998e","240":"instance--ec0c67c0-158e-5415-b08b-15c497764894","270":"instance--a848e595-3d48-563d-8a20-94fb272a5c7a","30":"instance--3c5974dd-03ad-5327-9c64-210b94c5a53b","300":"instance--276d1f29-b75a-59cc-9eed-4b08918a5156","330":"instance--890f4571-fa81-56df-b189-618233836d08","60":"instance--2dd9e3f9-0428-53d4-807b-4d5e12c46854","90":"instance--caf97c38-c923-57ff-b66b-316622e455c9"},"id":"user_account","instance":"user-account--1","properties":[["user_id","admin users"],["account_type","aws"],["evidence",[["item-1",{"excerpt":"admin users","source":"https://docs.aws.amazon.com/organizations/latest/userguide/orgs_best-practices_mgmt-acct.html","source_field":"normalized_text"}]]],["display_name","admin users"]]},{"anchors":{"0":"instance--44017e40-a22e-5c15-8371-0cc40f8e021b","120":"instance--b5bee3b2-afef-55ae-bfe3-096433dc7190","150":"instance--105eecc1-d37b-5481-a8ed-af68ee6df042","180":"instance--c6838070-d9ed-5aa8-aa5a-cddd4e7b79f1","210":"instance--ad8ad715-ea7a-5c95-9eb1-b736611d87d3","240":"instance--7e4aaab1-2289-510b-ae52-e2d092bb1760","270":"instance--b624d5b0-593c-5b2b-b0d9-64e3d74dfd79","30":"instance--78b55443-0128-558f-acd7-fd092c68ac4b","300":"instance--784ad044-a