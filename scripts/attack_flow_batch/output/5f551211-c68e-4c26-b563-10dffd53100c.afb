-8685-08b6df9b34bd","120":"instance--a0b8bf42-8310-53d9-87f0-390378638ae9","150":"instance--ffafa2fa-6430-5714-9c5e-bbf977c9819b","180":"instance--10bf0e4d-ac4d-5742-b82b-398ef2467e2a","210":"instance--f2066b53-6fa4-5efa-8f61-dc81d3df5b0e","240":"instance--fbb6b151-c9f4-5cb6-b467-c563cc0c60d3","270":"instance--451ff5e8-5cc8-5d6c-b701-da17c04936f7","30":"instance--059bc992-da53-5d4b-ac82-60cfacc08e81","300":"instance--1d241382-a8ee-554a-aa3a-04366535b315","330":"instance--8a7078e9-787d-56b2-a734-f93cd76b3dc8","60":"instance--8aab1831-f6e3-582d-8f9b-3ad920a40e35","90":"instance--192458e5-76c8-5d8c-ab54-9ed8b36ef2bd"},"id":"software","instance":"software--1","properties":[["vendor","Bun"],["evidence",[["item-1",{"citation":null,"excerpt":"Mini Shai-Hulud is deployed as a 498 KB obfuscated script executed using the Bun JavaScript runtime.","source":"https://flashpoint.io/blog/mini-shai-hulud-worm-new-era-ci-cd-exploitation/","source_field":"normalized_text","source_object_id":null}]]],["display_name","Bun JavaScript runtime"],["name","Bun JavaScript runtime"]]},{"anchors":{"0":"instance--c2e84d8b-5164-58c2-9526-5d9d9d6f8872","120":"instance--af5c0c72-1f78-51b9-b888-1250a72e1fca","150":"instance--07b79917-15e4-5f09-a207-d6f6152473e0","180":"instance--d05c509a-2080-5c66-b004-314696535967","210":"instance--ec78c273-5dc9-521e-82ca-c99e22fd2dfd","240":"instance--09e6b23b-983e-5ca8-a8a9-931fc6216b82","270":"instance--9e22dc2c-a31a-5d2b-84c9-f5e2abf6350b","30":"instance--bd8dfcfd-57e3-5a3c-9235-52fb080a08dc","300":"instance--8e4c8523-3ca6-553d-8710-b2ebee87da5b","330":"instance--b9c09a1c-f198-5c14-a9ec-37102767f73c","60":"instance--ecbb9ccd-93ad-5523-92a7-2479833ce664","90":"instance--fb906e97-d671-55d7-ba8b-9eeb36dc827a"},"id":"url","instance":"url--1","properties":[["value","GitHub Git Data API"],["evidence",[["item-1",{"citation":null,"excerpt":"Exfiltration occurs across multiple channels: the Session Protocol network, the GitHub Git Data API using dynamically created Dune-themed repositories on victim accounts, HTTPS to the threat actor-controlled domain, and an api for GitHub Actions workflow exfiltration.","source":"https://flashpoint.io/blog/mini-shai-hulud-worm-new-era-ci-cd-exploitation/","source_field":"normalized_text","source_object_id":null}]]],["display_name","GitHub Git Data API"]]},{"anchors":{"0":"instance--a9b6bf69-00b4-5c1f-9308-ea3eabbae195","120":"instance--bf69e4e7-a42b-5266-a085-f5c89eff2e01","150":"instance--129201d5-d0e2-55c4-a742-a6d2708a4285","180":"instance--6596b240-c40b-5992-a598-3845c8d48349","210":"instance--352d8de9-0bc8-5224-ac68-9ab2e29c600f","240":"instance--c6c1ee1a-8f6e-5981-b389-26d22ddb6696","270":"instance--ab48b405-b4db-5dd3-9c7d-723796494904","30":"instance--cbe11622-6019-5494-96bb-8c94964fe3a5","300":"instance--06ff22b8-9023-5ced-8cda-c554ea0f8193","330":"instance--229d793b-e37f-5e47-b048-b8b9a71bb32a","60":"instance--091c94a6-1d98-5ddc-8596-c58b55006411","90":"instance--bf5b0a1e-b439-50d2-adc3-31f7823378d6"},"id":"software","instance":"instance--53b22440-80c4-5b33-9cf9-fa21d73c8028","properties":[["evidence",[["item-1",{"citation":null,"excerpt":"An installed daemon (kitty-monitor, deployed as a systemd service on Linux or a LaunchAgent on macOS) polls GitHub for commits containing the string \u201cfiredalazer,\u201d parses RSA-PSS-signed command payloads from matching commits, and executes them.","source":"https://flashpoint.io/blog/mini-shai-hulud-worm-new-era-ci-cd-exploitation/","source_field":"normalized_text","source_object_id":null}]]],["display_name","kitty-monitor"],["name","kitty-monitor"],["diagram_instance","instance--53b22440-80c4-5b33-9cf9-fa21d73c8028"]]},{"anchors":{"0":"instance--8cf549a5-7e7d-51cf-9368-9b5e0744592a","120":"instance--06d4fda8-e0bf-574e-b3d8-a62c44712794","150":"instance--bb5815b3-6a43-5e3f-b9bc-9862b25fcfbb","180":"instance--f044d6bc-5582-5c4b-8062-d78469e24a48","210":"instance--e728313e-5605-515c-b37b-9ffb6e4816de","240":"instance--2e67ae43-8ff1-546b-b53a-21