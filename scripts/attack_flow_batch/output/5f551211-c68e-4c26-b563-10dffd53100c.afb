-831c77d20464"]]},{"anchors":{"0":"instance--cba0db2f-4c26-5332-99c5-b2aee8fd787f","120":"instance--d8fb103f-8665-5f80-9047-210dfff8d4c0","150":"instance--edc40449-4888-59a1-9397-f5c8d35412fc","180":"instance--4252ed4d-ac52-5ce9-b1de-22e62358c57f","210":"instance--ef2d806c-0b9d-5611-a51f-36bdd082998e","240":"instance--ec0c67c0-158e-5415-b08b-15c497764894","270":"instance--a848e595-3d48-563d-8a20-94fb272a5c7a","30":"instance--3c5974dd-03ad-5327-9c64-210b94c5a53b","300":"instance--276d1f29-b75a-59cc-9eed-4b08918a5156","330":"instance--890f4571-fa81-56df-b189-618233836d08","60":"instance--2dd9e3f9-0428-53d4-807b-4d5e12c46854","90":"instance--caf97c38-c923-57ff-b66b-316622e455c9"},"id":"user_account","instance":"user-account--1","properties":[["user_id","IfYouRevokeThisTokenItWillWipeTheComputerOfTheOwner"],["account_type","GitHub personal access token"],["evidence",[["item-1",{"citation":null,"excerpt":"The worm then uses a persistence mechanism as a dead-man\u2019s switch: a GitHub personal access token named \u201cIfYouRevokeThisTokenItWillWipeTheComputerOfTheOwner\u201d is created on compromised developer machines.","source":"https://flashpoint.io/blog/mini-shai-hulud-worm-new-era-ci-cd-exploitation/","source_field":"normalized_text","source_object_id":null}]]],["display_name","IfYouRevokeThisTokenItWillWipeTheComputerOfTheOwner"]]},{"anchors":{"0":"instance--0c967d83-7bb6-5ef5-81e9-b518595f15b7","120":"instance--9ba9cb01-1c3b-5278-ac7c-b12e9b844005","150":"instance--5aa31a4b-01da-58ea-9b6c-0e44af202362","180":"instance--aa7250ce-1766-5c3d-84c7-5c289cb1a8d4","210":"instance--e8167736-55a6-5972-a5db-aaee1bfb0566","240":"instance--ba7e13c9-ed77-50cb-8cd1-bf0f3d63c6ae","270":"instance--dfd0620d-eec3-57be-8bb2-4d80e05f97dd","30":"instance--9b8bdd9b-3c75-5d8b-8ff5-2cc519b06b80","300":"instance--387f49c4-5c7f-53b8-97da-f8e4e098b3a8","330":"instance--58808537-8863-52ff-8a8c-7e227c12026b","60":"instance--ad7a85cf-cd1d-55cc-82e9-bbd277b6890d","90":"instance--c7966d43-14ba-50be-9f11-544060bb0ed3"},"id":"file","instance":"file--3","properties":[["path","Claude Code settings .json"],["evidence",[["item-1",{"citation":null,"excerpt":"The SafeDep analysis documents that the worm modifies Claude Code\u2019s settings .json to insert a SessionStart hook, enabling the worm to be reinstated with full LLM API privileges even if the infected npm packages are later removed, or the npm cache is cleared.","source":"https://flashpoint.io/blog/mini-shai-hulud-worm-new-era-ci-cd-exploitation/","source_field":"normalized_text","source_object_id":null}]]],["display_name","settings .json"],["name","settings .json"]]},{"anchors":{"0":"instance--53c7236f-50ea-5837-a270-a1e4ac2a9d6d","120":"instance--dfe74390-3284-5cd0-8f9d-7ee096b7bc4a","150":"instance--cc1296f8-9c5e-50b7-9b68-b200055594b2","180":"instance--9eae7d14-c6a5-5737-8d1c-afd3b9d3eca1","210":"instance--53c95793-9717-597e-bedb-6e8a3cefe637","240":"instance--1c51ce9f-f8bd-5ce7-b5e5-1ef332ba4dd0","270":"instance--eb137597-1af2-5346-8d02-0e0bcec6a2f5","30":"instance--82559b51-64e5-55ea-b470-3f15cbb5f0a5","300":"instance--77295314-230f-53f4-8775-c0db8e361522","330":"instance--d4ade385-9a16-521b-b0df-f03a41a70695","60":"instance--096c4113-0edb-5c5c-ace0-58388ede3cc6","90":"instance--9df10be3-7341-53c4-8a3b-d0fe677db42f"},"id":"software","instance":"software--3","properties":[["evidence",[["item-1",{"citation":null,"excerpt":"The SafeDep analysis documents that the worm modifies Claude Code\u2019s settings .json to insert a SessionStart hook, enabling the worm to be reinstated with full LLM API privileges even if the infected npm packages are later removed, or the npm cache is cleared.","source":"https://flashpoint.io/blog/mini-shai-hulud-worm-new-era-ci-cd-exploitation/","source_field":"normalized_text","source_object_id":null}]]],["display_name","Claude Code"],["name","Claude Code"]]},{"anchors":{"0":"instance--a3abc4c4-e067-5628-bbfa-aab019a74fab","120":"instance--18d78140-9ac1-524e-a358-b9def4f1cc4c","