4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Send political lure email"],["description","We would like to formally invite you to apply to be a member of the panel by responding to this email.\n\nYou should include your thoughts and opinions in response to the following article about what more David Cameron can be doing to help aid the Middle East.\n\nWe look forward to hearing back from you,\n\nHuman Rights: The Right to Fight"],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.001"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Deliver macro-enabled attachment"],["description","The information you requested is in the attached document.\n\nIn order to protect the content of the attachment we had to add macro enabled security.\n\nPlease enable macros in order to read the provided information about our organization.\n\nWe hope you will consider joining us. Thank you.\n\nWe look forward to hearing back from you,\n\nHuman Rights: The Right to Fight"],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.001"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Send password-protected download link"],["description","Please follow this link to download our organizational information.\n\nThe link has been password protected.  The password is: right2fight\n\nIn order to protect the content of the attachment we also had to add macro enabled security.\n\nPlease enable macros in order to read the provided information about our organization.\n\nWe hope you will consider joining us. Thank you.\n\nWe look forward to hearing back from you,\n\nHuman Rights: The Right to Fight\n\nhttps://cloud.openmailbox.org/index.php/s/ujDNWMmg8pdG3AL/authenticate\n\nright2fight.docm 80e8ef78b9e28015cde4205aaa65da97 f25466e4820404c817eaf75818b7177891735886 5a372b45285fe6f3df3ba277ee2de55d4a30fc8ef05de729cf464103632db40f"],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.002"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b