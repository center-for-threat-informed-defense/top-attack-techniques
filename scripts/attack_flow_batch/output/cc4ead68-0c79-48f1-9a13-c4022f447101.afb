{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-condition--1","software--1","software--2","software--3","software--4","software--5","instance--ad1f125b-7701-5e9d-b869-79f40471648d","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--56da8838-1109-5fce-9d89-7b3ec32d7010","instance--bb170793-a0b8-5a22-b9f9-5dff26468abb","instance--0e0aefbc-132c-5535-9d21-08a6439d6b20","instance--477f512f-9970-5e9c-b5e8-e08afc5b8c09","instance--b9dddad1-58ee-5919-ac4e-d08aed77b347","instance--0429e3db-b0a1-5eff-9efe-ec81dd7a094e"],"properties":[["name","WindowsLogon policy abuse flow"],["description","Policy CSP - WindowsLogon"],["scope","incident"],["author",[["name","Unknown"]]],["external_references",[["item-1",[["source_name","learn.microsoft.com"],["url","https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-windowslogon"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Enable automatic restart sign-on"],["description","If you don't configure this policy setting, it's enabled by default. When the policy is enabled, the user is automatically signed in and the session is automatically locked with all lock screen apps configured for that user after the device boots."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1078"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Configure restart sign-on mode"],["description","If you enable this policy setting, you can choose one of the following two options:\n\n\"Enabled if BitLocker is on and not suspended\" specifies that automatic sign-on and lock will only occur if BitLocker is active and not suspended during the reboot or shutdown.\n\n\"Always Enabled\" specifies that automatic sign-on will happen even if BitLocker is off or suspended during reboot or shutdown."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Enable MPR password notifications"],["description","If you enable this setting, winlogon sends MPR notifications containing the user's password in the authentication info."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1557"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Enumerate local users on domain-joined computers"],["description","If you enable this policy setting, Logon UI will enumerate all local users on domain-joined computers."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1087.001"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Override shell program"],["description","OverrideShellProgram policy allows IT admin to configure the shell program for Windows OS on a device. This policy has the highest precedence over other ways of configuring the shell program. The policy currently supports below options: 1. Not Configured: Default shell will be launched. 2. Apply Lightweight Shell: Lightweight shell doesn't have a user interface and helps the device to achieve better performance as the shell consumes limited resources over default shell. Lightweight shell contains a limited set of features which could be consumed by applications. This configuration can be useful if the device needs to have a continuous running user interface application which would consume features offered by Lightweight shell."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1546.015"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","After enabling this policy, you can configure its settings through the ConfigAutomaticRestartSignOn policy, which configures the mode of automatically signing in and locking the last interactive user after a restart or cold boot ."]]},{"anchors":{"0":"instance--905f37ff-524a-522a-8685-08b6df9b34bd","120":"instance--a0b8bf42-8310-53d9-87f0-390378638ae9","150":"instance--ffafa2fa-6430-5714-9c5e-bbf977c9819b","180":"instance--10bf0e4d-ac4d-5742-b82b-398ef2467e2a","210":"instance--f2066b53-6fa4-5efa-8f61-dc81d3df5b0e","240":"instance--fbb6b151-c9f4-5cb6-b467-c563cc0c60d3","270":"instance--451ff5e8-5cc8-5d6c-b701-da17c04936f7","30":"instance--059bc992-da53-5d4b-ac82-60cfacc08e81","300":"instance--1d241382-a8ee-554a-aa3a-04366535b315","330":"instance--8a7078e9-787d-56b2-a734-f93cd76b3dc8","60":"instance--8aab1831-f6e3-582d-8f9b-3ad920a40e35","90":"instance--192458e5-76c8-5d8c-ab54-9ed8b36ef2bd"},"id":"software","instance":"software--1","properties":[["vendor","Microsoft"],["evidence",[["item-1",{"excerpt":"\"Enabled if BitLocker is on and not suspended\" specifies that automatic sign-on and lock will only occur if BitLocker is active and not suspended during the reboot or shutdown.\n\n\"Always Enabled\" specifies that automatic sign-on will happen even if BitLocker is off or suspended during reboot or shutdown.","source":"https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-windowslogon"}]]],["display_name","BitLocker"],["name","BitLocker"]]},{"anchors":{"0":"instance--7bca99b4-fc37-5b67-9da4-7aaaaca1937e","120":"instance--a653e288-958c-5a34-826a-c7ae2da3173f","150":"instance--9fb91ed2-00e9-50c3-8ceb-3f10b07b73bc","180":"instance--bf4d856a-43b2-58e9-a272-467b1a321907","210":"instance--10ca6953-dd7d-54b7-9406-bb40125e27e2","240":"instance--db0c8479-7e26-5d86-b4d9-d52f19ad3f45","270":"instance--3f9b75b2-1c8a-564a-8a7b-b898a27995dd","30":"instance--3663489e-5635-5e70-b0e5-70a502523b87","300":"instance--bdba1e6c-e0e6-5e31-a7d0-c53e76e3cb8b","330":"instance--163f5749-44cf-50b1-ba73-97edab024b3b","60":"instance--7d417c1a-591b-5278-821e-7d21ac26d33f","90":"instance--4d5c0684-fd37-55f3-860f-2e9735603afe"},"id":"software","instance":"software--2","properties":[["evidence",[["item-1",{"excerpt":"If you enable this setting, winlogon sends MPR notifications containing the user's password in the authentication info.","source":"https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-windowslogon"}]]],["display_name","winlogon"],["name","winlogon"]]},{"anchors":{"0":"instance--53c7236f-50ea-5837-a270-a1e4ac2a9d6d","120":"instance--dfe74390-3284-5cd0-8f9d-7ee096b7bc4a","150":"instance--cc1296f8-9c5e-50b7-9b68-b200055594b2","180":"instance--9eae7d14-c6a5-5737-8d1c-afd3b9d3eca1","210":"instance--53c95793-9717-597e-bedb-6e8a3cefe637","240":"instance--1c51ce9f-f8bd-5ce7-b5e5-1ef332ba4dd0","270":"instance--eb137597-1af2-5346-8d02-0e0bcec6a2f5","30":"instance--82559b51-64e5-55ea-b470-3f15cbb5f0a5","300":"instance--77295314-230f-53f4-8775-c0db8e361522","330":"instance--d4ade385-9a16-521b-b0df-f03a41a70695","60":"instance--096c4113-0edb-5c5c-ace0-58388ede3cc6","90":"instance--9df10be3-7341-53c4-8a3b-d0fe677db42f"},"id":"software","instance":"software--3","properties":[["evidence",[["item-1",{"excerpt":"If you enable this policy setting, Logon UI will enumerate all local users on domain-joined computers.","source":"https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-windowslogon"}]]],["display_name","Logon UI"],["name","Logon UI"]]},{"anchors":{"0":"instance--ed268b8e-ae15-5307-9c74-c59bcb1720fa","120":"instance--334514cd-5319-5e74-a93f-0cb00858c2d8","150":"instance--717ddf64-eda1-5ef7-a0ed-5b2a3afa55d8","180":"instance--64d6ab30-a186-5c38-bc2f-2a6268e6a890","210":"instance--c526ef8a-6654-57eb-8d30-dc76669fe59b","240":"instance--d39a2ed7-e1e8-5740-8784-294f596f2645","270":"instance--0727ca9b-e57c-5659-8487-2c4d929af3cb","30":"instance--47afb308-461a-5288-a8da-23e324db046e","300":"instance--3be52c61-8f5f-5cd2-b041-ffa9b0d4b511","330":"instance--0cbe84a5-46fe-5b20-93b7-8e80eb3fc87b","60":"instance--4e4f2f34-7922-5624-bab5-c48861c43574","90":"instance--782fe341-7fed-508f-bba5-d5a092a90950"},"id":"software","instance":"software--4","properties":[["evidence",[["item-1",{"