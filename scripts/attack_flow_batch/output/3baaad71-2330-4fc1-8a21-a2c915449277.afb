:"TA0005","technique":"T1620"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Query LDAP via GUI"],["description","Ldap Sentinel provides a rich GUI interface to query various ldap queries to the Domain or a Forest. Whether you want to run SPN queries for a specific user or if you want to query large group objects, all can be done effortlessly using prebuilt queries."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1069.002"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Pivot over remote channels"],["description","Badger provides mulitple pivot options such as SMB, TCP, WMI, WinRM and managing remote services over RPC."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Execute in-memory modules"],["description","Use existing brute ratel modules or build your own using in-memory execute of C-Sharp, BOFs, Powershell Scripts or Reflective DLLs and automate the execution of the commands using the Click Script feature"],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1620"}]]},{"anchors":{"0":"instance--79135dd4-1ee4-5416-8f25-699a951afa80","120":"instance--3087ed8f-f52f-5bc8-8c62-f9ae3264725f","150":"instance--57ed80e6-51e6-50f7-aad0-39bb33df0261","180":"instance--c5faf3bc-2d22-54bc-898b-31882ba7c4a4","210":"instance--766332d8-d34d-5820-9442-c32dc1a417ad","240":"instance--bca47815-218d-563d-b96b-55ff17065443","270":"instance--7ff5ac74-4c1f-50b0-b02f-b897e172a434","30":"instance--cc8cae0a-dc95-5e3f-bdd0-23dd9cfca432","300":"instance--bdad0536-1d47-52b9-ab72-1c7a08158f20","330":"instance--16d7e8d9-53cf-5ae9-a219-2047733c1b5d","60":"instance--872a3352-ab12-5fc6-993d-6b22b7bc0454","90":"instance--e6a727e3-1e85-552c-b938-189e11fc5d41"},"id":"software","instance":"instance--763adce8-107c-58c1-9b65-18fefd501b17","properties":[["evidence",[["item-1",{"excerpt":"Badger's DNS over HTTPS provides usability of newly bought