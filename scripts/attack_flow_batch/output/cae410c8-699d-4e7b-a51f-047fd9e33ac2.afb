","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Connect to remote daemon using SSH context"],["description","The following example creates a to connect with a remote daemon on using SSH, and\nas the user on the remote machine:\n\nAfter creating the context, use to switch the CLI\nto use it, and to connect to the remote engine:"],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021.004"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Temporarily switch CLI with DOCKER_HOST over SSH"],["description","Alternatively, use the environment variable to temporarily switch\nthe CLI to connect to the remote host using SSH. This does not require\ncreating a context, and can be useful to create an ad-hoc connection with a different\nengine:"],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021.004"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Enable TLS socket with trusted CA"],["description","If you need Docker to be reachable through HTTP rather than SSH in a safe manner,\nyou can enable TLS (HTTPS) by specifying the flag and pointing Docker's flag to a trusted CA certificate.\n\nIn the daemon mode, it only allows connections from clients\nauthenticated by a certificate signed by that CA. In the client mode,\nit only connects to servers with a certificate signed by that CA."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1553"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Generate CA keys on daemon host"],["description","First, on the Docker daemon's host machine, generate CA private and public keys:"],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1587.003"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Create server key and CSR"],["description","Now that you have a CA, you can create a server key and certificate\nsigning request (CSR). Make sure that \"Common Name\" matches the hostname you use\nto connect to Docker:"],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1587.003"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Sign server public key with CA"],["description","Next, we're going to sign the public key with our CA:\n\nSince TLS connections can be made through IP address as well as DNS name, the IP addresses\nneed to be specified when creating the certificate. For example, to allow connections\nusing and :\n\nSet the Docker daemon key's extended usage attributes to be used only for\nserver authentication:\n\nNow, generate the signed certificate:"],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1587.003"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Create client key and CSR"],["description","For client authentication, create a client key and certificate signing\nrequest:\n\nFor simplicity of the next couple of steps, you may perform this\nstep on the Docker daemon's host machine as well.\n\nTo make the key suitable for client authentication, create a new extensions\nconfig file:\n\nNow, generate the signed certificate:"],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1587.003"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Remove CSRs and extension files"],["description","After generating and you can safely remove the\ntwo certificate signing requests and extensions config files:"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1070.004"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Restrict key and certificate file permissions"],["description","With a default of 022, your secret keys are and\nwritable for you and your group.\n\nTo protect your keys from accidental damage, remove their\nwrite permissions. To make them only readable by you, change file modes as follows:\n\nCertificates can be world-readable, but you might want to remove write access to\nprevent accidental damage:"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1222.002"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Configure daemon to require trusted client certificates"],["description","Now you can make the Docker daemon only accept connections from clients\nproviding a certificate trusted by your CA:"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1553"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Connect to Docker with client keys and trusted CA"],["description","To connect to Docker and validate its certificate, provide your client keys,\ncertificates and trusted CA:\n\nThis step should be run on your Docker client machine. As such, you\nneed to copy your CA certificate, your server certificate, and your client\ncertificate to that machine."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Run Docker over TLS on TCP 2376"],["description","Docker over TLS should run on TCP port 2376."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1571"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","Now you can make the Docker daemon only accept connections from clients\nproviding a certificate trusted by your CA:"]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"insta