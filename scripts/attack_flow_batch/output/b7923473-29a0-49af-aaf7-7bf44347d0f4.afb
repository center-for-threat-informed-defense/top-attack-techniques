7d-8bdd-c4a4ac417a74","210":"instance--699c5371-422d-591d-90ba-00b8fae4d856","240":"instance--c532271f-7ec8-5ec5-96cb-91a43d688897","270":"instance--c8fb282f-acfd-5bcc-b000-963d8af5787d","30":"instance--9086bf61-c8a3-5507-bee5-78a68aa935a6","300":"instance--c6ca7c8c-daa6-5801-b169-682828b20d26","330":"instance--62d3c4de-5ceb-5443-a990-1ffe6c7b7565","60":"instance--0bf90fe9-e9bb-5f07-8b93-60d9dc142b16","90":"instance--cac73787-c826-5e86-8bca-579238d278d4"},"id":"x509_certificate","instance":"x509-certificate--1","properties":[["subject","particular certificate"],["evidence",[["item-1",{"excerpt":"Venturing further down the cryptographic security route, you can create a rule that will allow any binary that is signed by a particular certificate to run.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","particular certificate"]]},{"anchors":{"0":"instance--5d75bd52-7042-544e-bc51-f93aa04416b4","120":"instance--94ec05b5-6cca-5241-a7af-eb864d0e061f","150":"instance--b8b2ee6d-0ddc-5181-a823-486ad8477993","180":"instance--4488a153-7ac6-5ce5-8f99-4ca294e8a104","210":"instance--5e36cac0-5006-5da4-8c73-cd2bbcdcd96f","240":"instance--684d6fd0-dc98-5ae9-be43-c692e3f5a7c2","270":"instance--d1d81626-0d55-5a6d-a8de-2ffba0f9d3cb","30":"instance--595bec2b-dc03-5c90-9e9b-d129c188a621","300":"instance--2e8ca19c-9c40-5aa9-b8e5-076324e6c6e6","330":"instance--6e229519-1f91-5cb6-9af2-7e1d6a7085f9","60":"instance--aa2574bd-48e1-5052-be21-d6b3782e094a","90":"instance--2d1f5818-779e-52cc-8ce6-37af078adbe0"},"id":"software","instance":"instance--cc97f7a0-2d44-5384-9615-43b014cfb526","properties":[["evidence",[["item-1",{"excerpt":"You simply specify what applications are allowed to run and then deploy the policy using Group Policy.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","Group Policy"],["name","Group Policy"],["diagram_instance","instance--cc97f7a0-2d44-5384-9615-43b014cfb526"]]},{"anchors":{"0":"instance--2c438413-b42f-56a3-9c72-85880d7749eb","120":"instance--e940f0e7-7ccb-5d69-a6d5-74587c840c9a","150":"instance--9200b964-6c75-5fe5-97c0-98a7b900c3de","180":"instance--152957c3-8538-52f9-bae6-a8a10f98b234","210":"instance--63ad4c8b-b923-51cc-aec2-a2510a7ae18e","240":"instance--1b9c55d9-4e52-5e2b-aa54-6a692ea623b9","270":"instance--6485a9a8-7f78-5737-a591-4254f4e07cef","30":"instance--13e56bcb-bf84-5594-a4f2-0500a2bf7bef","300":"instance--f76908ad-5369-52c0-8f5b-ad24faa9f313","330":"instance--514bd127-cefa-585f-a384-6ec240e44ec2","60":"instance--fe826b13-e63e-50d4-a437-e2b0b94da142","90":"instance--68150e2f-92d6-5f33-9cf4-5fd07778cf97"},"id":"directory","instance":"directory--1","properties":[["path","desktop"],["evidence",[["item-1",{"excerpt":"If you add a particular path rule, and this path allows users to write files there (to the desktop, for example), they would be able execute anything they want just by putting the executable in that folder.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","desktop"]]},{"anchors":{"0":"instance--3e66a567-5f6a-55f7-bf7d-c2b321c465a9","120":"instance--723c477a-612e-5e7e-abf6-92e3f839a0e4","150":"instance--d5db6df5-d592-52e6-bbe2-c2b204fd3f2e","180":"instance--d7d9e810-de60-5c28-9cdd-f46fa6fac092","210":"instance--78b33a09-4062-5f1b-8e0a-938bf8e943c4","240":"instance--5fc7788c-2e04-580d-81de-5c2b7dacc94f","270":"instance--c62d1543-dc41-5f2f-9d36-5ead3de62016","30":"instance--7b4f278c-c194-50e8-9a85-7e914f1d454f","300":"instance--bf78f6c5-df99-56cb-aecb-17157d5d408a","330":"instance--b993e222-e5fb-52f0-8beb-035a5c5a81a3","60":"instance--5bc53f6b-461d-53a7-8d43-45ba723876f3","90":"instance--c94e773c-3b0c-5d29-9aa2-f48fef02b68d"},"id":"file","instance":"file--2","properties":[["evidence",[["item-1",{"excerpt":"If you add a particular path rule, and this path allows users to write files there (to the desktop, for example), they would be able execute anything they want just by putting the executable in that folder.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","executable"],["name","executable"]]},{"anchors":{"0":"instance--0c967d83-7bb6-5ef5-81e9-b518595f15b7","120":"instance--9ba9cb01-1c3b-5278-ac7c-b12e9b844005","150":"instance--5aa31a4b-01da-58ea-9b6c-0e44af202362","180":"instance--aa7250ce-1766-5c3d-84c7-5c289cb1a8d4","210":"instance--e8167736-55a6-5972-a5db-aaee1bfb0566","240":"instance--ba7e13c9-ed77-50cb-8cd1-bf0f3d63c6ae","270":"instance--dfd0620d-eec3-57be-8bb2-4d80e05f97dd","30":"instance--9b8bdd9b-3c75-5d8b-8ff5-2cc519b06b80","300":"instance--387f49c4-5c7f-53b8-97da-f8e4e098b3a8","330":"instance--58808537-8863-52ff-8a8c-7e227c12026b","60":"instance--ad7a85cf-cd1d-55cc-82e9-bbd277b6890d","90":"instance--c7966d43-14ba-50be-9f11-544060bb0ed3"},"id":"file","instance":"file--3","properties":[["evidence",[["item-1",{"excerpt":"In cases such as a .txt file, calling ShellExecute on the file doesn't actually result in the file being executed\u2014technically, of course, the file is opened.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name",".txt file"],["name",".txt file"]]},{"anchors":{"0":"instance--7bca99b4-fc37-5b67-9da4-7aaaaca1937e","120":"instance--a653e288-958c-5a34-826a-c7ae2da3173f","150":"instance--9fb91ed2-00e9-50c3-8ceb-3f10b07b73bc","180":"instance--bf4d856a-43b2-58e9-a272-467b1a321907","210":"instance--10ca6953-dd7d-54b7-9406-bb40125e27e2","240":"instance--db0c8479-7e26-5d86-b4d9-d52f19ad3f45","270":"instance--3f9b75b2-1c8a-564a-8a7b-b898a27995dd","30":"instance--3663489e-5635-5e70-b0e5-70a502523b87","300":"instance--bdba1e6c-e0e6-5e31-a7d0-c53e76e3cb8b","330":"instance--163f5749-44cf-50b1-ba73-97edab024b3b","60":"instance--7d417c1a-591b-5278-821e-7d21ac26d33f","90":"instance--4d5c0684-fd37-55f3-860f-2e9735603afe"},"id":"software","instance":"software--2","properties":[["evidence",[["item-1",{"excerpt":"This functionality is disabled by default, but it can be enabled manually. To do this, navigate to the Software Restriction Policies node in gpedit.msc and double-click on Enforcement. After that, select the All software files radio button.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","gpedit.msc"],["name","gpedit.msc"]]},{"anchors":{"0":"instance--4397aaa8-1ba9-5078-bf13-6bf1580b5473","120":"instance--2a468a00-7694-5128-83fb-20109eb30bcd","150":"instance--1e77b055-69d7-5e26-ac7b-3ac27ce08905","180":"instance--068423ab-b79b-5a32-9346-906247f794ed","210":"instance--dae7b3c3-45ce-5410-81bc-15f3e9d45a50","240":"instance--82a1db88-fb88-5481-b296-9c22e64266e7","270":"instance--d82810b1-7b80-5d39-860a-c1960276394b","30":"instance--4773963d-8351-50c5-96d0-5cd9b94d9cd7","300":"instance--94f4bb6c-6879-53e8-8807-b9af2c2d5a59","330":"instance--ab0e2177-b90a-53d7-921b-4878f8ffcb8c","60":"instance--7c7b3b92-1e63-5375-ba61-c21b0b5b3992","90":"instance--2c5a51fd-7239-5de0-8528-bf315d208a9b"},"id":"software","instance":"instance--6f0bc520-6b82-5dfe-9bae-39b758621eba","properties":[["evidence",[["item-1",{"excerpt":"As we mentioned, software restriction policy is integrated with most script hosts in the system. This includes cmd, VBScript, Cscript, and JScript\u00ae.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","cmd"],["name","cmd"],["diagram_instance","instance--6f0bc520-6b82-5dfe-9bae-39b758621eba"]]},{"anchors":{"0":"instance--ed268b8e-ae15-5307-9c74-c59bcb1720fa","120":"instance--334514cd-5319-5e74-a93f-0cb00858c2d8","150":"instance--717ddf64-eda1-5ef7-a0ed-5b2a3afa55d8","180":"instance--64d6ab30-a186-5c38-bc2f-2a6268e6a890","210":"instance--c526ef8a-6654-57eb-8d30-dc76669fe59b","240":"instance--d39a2ed7-e1e8-5740-8784-294f596f26