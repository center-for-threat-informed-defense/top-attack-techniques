5-535e-ae74-b811130d7020","210":"instance--1abd523f-65e4-5a92-821b-d442e244a284","240":"instance--cf30f7e1-6793-56e5-9196-27e298ced598","270":"instance--59a4f59e-dc77-5431-a373-48a17a6adeb4","30":"instance--d784b3cd-1b3d-5a9d-a312-8adb92cd7361","300":"instance--04ef0f5e-257e-52f2-8117-5d128d673020","330":"instance--8c45e56c-d110-5272-8536-db6c718ec352","60":"instance--0b3f6654-f961-5ae4-b045-caa1c95db9e3","90":"instance--651c638d-7f1b-5f37-af3b-46d7e10f6fe3"},"id":"software","instance":"software--6","properties":[["evidence",[["item-1",{"excerpt":"As we mentioned, software restriction policy is integrated with most script hosts in the system. This includes cmd, VBScript, Cscript, and JScript\u00ae.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","JScript"],["name","JScript"]]},{"anchors":{"0":"instance--c9bd4a2f-0ac0-56ab-a8e7-48a608f2d8ca","120":"instance--9ecc56c6-194f-5bfb-8ad9-74c777cb4795","150":"instance--fba9f269-ad02-580b-8028-d540f97e6be9","180":"instance--0af4148f-04e2-5f0f-b69b-8bf6fa0ed15a","210":"instance--19c334f6-2f89-5a3b-b21e-3963d00f7342","240":"instance--02defdf7-af77-55db-b610-6dd0d647d4c2","270":"instance--77d9aa79-b3ef-5c94-bf2c-e8d1af15ce74","30":"instance--44e50aed-c079-5825-a4c4-e0586aacb29b","300":"instance--8a25faa4-4910-5651-b12e-e9aa5c640f48","330":"instance--c8eec95c-9f31-5f2f-ad49-0319bf6b38e4","60":"instance--18c75095-8848-5d1e-80aa-00ca076ce23f","90":"instance--341cf8f2-6543-5f84-bd7b-529f933fef2c"},"id":"software","instance":"software--7","properties":[["evidence",[["item-1",{"excerpt":"The SaferIdentifyLevel API determines whether a specified executable should be allowed to run by looking up the identification information in the relevant software restriction policies.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","SaferIdentifyLevel API"],["name","SaferIdentifyLevel API"]]},{"anchors":{"0":"instance--164d606a-aff9-53d6-a82f-bbc7c804787f","120":"instance--5f5e146c-417e-53dc-85bf-da8461419fea","150":"instance--d32b0649-d65f-5d93-98f7-c5e3e76a2b67","180":"instance--5eb1db56-fa19-5dec-96d5-4d6a2a5552c8","210":"instance--0113fa6b-2796-59e0-9a7b-ad2073fb2e05","240":"instance--89c7f6d5-8631-5bb2-949a-c9c7cef41dca","270":"instance--af967e85-93a4-5b2d-a144-22ad642a07ae","30":"instance--8f356932-0b36-5dc1-8623-1c156b08755e","300":"instance--79f07fc4-f1bf-5dbe-bd57-44211ef06b45","330":"instance--2a45dfa4-3f45-5957-9cc0-38e3f7c6f8d6","60":"instance--54c481cc-e335-512b-8aa8-948fe1fdd941","90":"instance--9ac79aa7-8668-54aa-b49f-32a243bf165a"},"id":"software","instance":"software--8","properties":[["evidence",[["item-1",{"excerpt":"Both UAC's token filtering functionality and software restriction policies' Normal User rules take advantage of an underlying API that implements the same behavior as the CreateRestrictedToken API.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","CreateRestrictedToken API"],["name","CreateRestrictedToken API"]]},{"anchors":{"0":"instance--a3abc4c4-e067-5628-bbfa-aab019a74fab","120":"instance--18d78140-9ac1-524e-a358-b9def4f1cc4c","150":"instance--1a943270-8871-5418-9f2d-141101e8d46b","180":"instance--f869e7d2-e970-538e-807d-ec8f535858f1","210":"instance--a901c219-97a5-5c10-b6b5-5b969b29ddda","240":"instance--042c3bfe-d235-50a0-93ab-2e3764d471bc","270":"instance--b969338c-9bb0-5c00-88a9-39222579c619","30":"instance--e8f5acbb-2766-5b4d-81f7-b477e71e2de5","300":"instance--c5af4ee8-b388-5c56-9a07-22944487ca6a","330":"instance--69209bd3-e9bf-533a-9834-bbf5f8fc23ba","60":"instance--87574dd4-9c7c-5acc-8fe1-e3e71a55e908","90":"instance--21e2d785-8014-56c7-b651-1e8d845c0cdf"},"id":"file","instance":"file--4","properties":[["evidence",[["item-1",{"excerpt":"To allow the minimum set of applications required to log on to Windows Vista, create a policy that allows logonui.exe and userinit.exe to run from %windir%\\system32.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","logonui.exe"],["name","logonui.exe"]]},{"anchors":{"0":"instance--254370ab-d4b7-522b-b72a-09735eaf2380","120":"instance--1eba87f5-a1eb-504e-b2a4-0901c2bea07f","150":"instance--191b7377-4e29-56e3-ae61-1dc45bf5836c","180":"instance--e070de52-bf05-5b19-a623-c42606011057","210":"instance--e5b7e3f8-5969-5f57-980e-77f9defc0137","240":"instance--c6a5c35b-b9fd-5142-a6d0-f67db22347ec","270":"instance--4472d2c0-bc33-567d-95f2-5d2ee2d0a031","30":"instance--43dcbe2a-dd71-5fd9-9013-33c2bf6e4cb5","300":"instance--49ac78f6-e6d9-5a91-90a7-ae5633fc29fd","330":"instance--5d4aaf9a-245c-54c5-93d0-cc9beedbbcc0","60":"instance--5b2116ae-b91b-5cc9-8b1f-ea1653b7e173","90":"instance--dc3d3c3d-d5ae-542d-885f-8f19097a6114"},"id":"file","instance":"file--5","properties":[["evidence",[["item-1",{"excerpt":"To allow the minimum set of applications required to log on to Windows Vista, create a policy that allows logonui.exe and userinit.exe to run from %windir%\\system32.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","userinit.exe"],["name","userinit.exe"]]},{"anchors":{"0":"instance--488ab463-adca-55d9-ac31-77812affef52","120":"instance--e96726b9-d5e0-537f-b97d-157ca5f0289e","150":"instance--251c4e5a-3f73-549b-817a-f6b523d2d183","180":"instance--06fc5f43-aedd-5177-9dcb-f280a824bf5f","210":"instance--ef3faca2-5445-5b2b-83cb-f516d99bd5a7","240":"instance--a248e617-91c8-507c-bf07-a53a874bf710","270":"instance--d3440e2b-f1b5-59f5-8940-99d77e630051","30":"instance--e692b541-b796-5743-abe2-7fd28e5d9cff","300":"instance--b7ba31ff-1ad0-5809-8561-08995203a4ce","330":"instance--c48da782-940f-5fd9-8ddc-fa07f61f7ce4","60":"instance--49a1e4e4-4629-525f-b19a-92cee869f84b","90":"instance--39deda79-2965-5e50-8262-264283e24301"},"id":"directory","instance":"directory--2","properties":[["path","%windir%\\system32"],["evidence",[["item-1",{"excerpt":"To allow the minimum set of applications required to log on to Windows Vista, create a policy that allows logonui.exe and userinit.exe to run from %windir%\\system32.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","%windir%\\system32"]]},{"anchors":{"0":"instance--827b4e4d-ace9-5338-bb32-ec49a466fdb3","120":"instance--2dcfbca9-9da7-53c4-9677-40543f706df2","150":"instance--253f4459-88c9-53d0-ba92-2f4efd3f57e1","180":"instance--22fbe7de-3c4c-5a9b-a35e-98109df5f659","210":"instance--d8f44b0b-78de-594a-a207-b64fd791544a","240":"instance--b42e7f45-eca0-500d-a94a-5a2abd7fc6cb","270":"instance--102cd0cd-6bc3-54d9-ba9b-294c80d09dce","30":"instance--84341f11-3858-5dce-9535-7869947667d3","300":"instance--26233343-e4b3-5cb1-8cea-b6cd28036b31","330":"instance--52fc3c97-437b-50c2-a146-3ecf58055b49","60":"instance--fe191619-63c2-581a-8b4d-60bb1a64a8ac","90":"instance--f64130ca-d5ea-5645-a62d-d3427382aec2"},"id":"file","instance":"file--6","properties":[["evidence",[["item-1",{"excerpt":"If you want the default Windows shell, you would also want to add %windir%\\explorer.exe.","source":"https://learn.microsoft.com/en-us/previous-versions/technet-magazine/cc510322(v=msdn.10)"}]]],["display_name","%windir%\\explorer.exe"],["name","%windir%\\explorer.exe"]]},{"anchors":{"0":"instance--0a25a0bb-bd90-5501-9777-e239428fa774","120":"instance--b6b5639a-a238-54a0-947e-c86be1a52c1c","150":"instance--7a43052a-4f31-54f1-b9a0-a74de46537dc","180":"instance--c111dd4f-5d55-5e54-bbb2-5d794da45ab6","210":"instance--f0f60639-8858-5f60-9b78-66655c9209fb","240":"instance--3efef198-6c28-5557-ba94-123aacce09c9","270":"instance--096e75f5-b043-5edf-bbea-39f220f5adf4","30":"instance--bf626a5e-fb64-5f7c-98d8-dc2036682b16","300":"instance--8be1b8a4-8226-5e23-9bb4-3d232ea7528f","330":"instance--deba7ac5-f7b7-55d6-bcda-e2c08e863231","60":"instance--cd306b6e-