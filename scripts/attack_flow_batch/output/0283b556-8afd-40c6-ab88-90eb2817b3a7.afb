{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","attack-action--13","attack-action--14","attack-action--15","attack-action--16","attack-action--17","attack-condition--1","attack-condition--2","software--vmware-vcenter-server","instance--0806c9e6-051c-5fbe-b594-574a37fbde0d","user-account--esx-admins-group","file--atieclxx-temp","process--atieclxx-temp","instance--8e22fa27-0e43-5a21-bb18-de960c775a36","instance--7cd284c5-7a8f-52b4-b0da-89edd1a23e0e","process--host-exe","ipv4-addr--1.1.1[.]1","instance--c0a81ff2-c7cf-5fda-b573-7be829fd4500","file--extension-blackbytent_h","file--rtcore64-sys","file--dbutil-2-3-sys","instance--35e08530-f5c0-5e28-8c43-1f1dce25d10f","file--gdrv-sys","windows-registry-key--am35w2ph-2","windows-registry-key--am35w2ph-2-security","instance--233d5677-af16-5177-863d-57bf2bd1d45a","process--netshareenumall-srvsvc","domain-name--msdl-microsoft-com","ipv4-addr--204.79.197[.]219","windows-registry-key--windows-defender","windows-registry-key--windows-defender-exclusions-extensions","file--taskmgr-exe","file--perfmon-exe","file--shutdown-exe","file--resmon-exe","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--338a08d1-596c-5134-86e1-58bc27da7116","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--6f2873af-fccf-5ba3-ac8a-94d7eb485432","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--be99ba49-e121-58a8-ba7b-dd3de316cfcf","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--c075f5c6-95e8-5553-8f7e-b432b96021c7","instance--3b404379-7d7e-5278-b499-6ac12ee4e90f","instance--3e0f78a3-bb54-55bd-8490-3453d5e06d04","instance--a37796a0-93b2-51bb-be4b-2a9a9e7e35e1","instance--cb7da505-6791-507a-9a93-f9914c292d1b","instance--b3aa1b20-0a98-5bee-9b24-afe8c9468e2a","instance--5ec67e94-f416-51dd-9822-ab000787efe6","instance--68f26080-9371-5523-99b6-33303cae95de","instance--130e595c-2972-51d8-8554-ad8663130e4b","instance--dce6a575-8792-5c31-9613-588bbddbbb9a","instance--5bab9d2c-e9e0-575e-b1fc-ba24de3e033a","instance--fae6c6f7-d861-5da7-b845-809af098a523","instance--8e6a28d6-76e0-56a9-9075-94e83faad343","instance--bd33efec-183a-5bf8-b592-db574384850a","instance--8edb9f08-27d8-501d-a04f-51d6b9a2e74b","instance--70db4519-bb6c-584d-a76a-0b7c8b527c5b","instance--f021f5b2-c15e-5004-8b95-1e5658fb0f39","instance--5b2f4ccc-5741-53da-b887-8d5816328c12","instance--2a13fa63-5245-563b-bf73-b174379a0eba","instance--069491c0-5728-577b-8965-31d5edcf7f4e","instance--97ca6fa0-5f10-5752-8968-b4b0eeee1967","instance--5e85c07c-a8e8-54cb-902a-8ca6d0cdab6e","instance--16062f21-7eea-56e4-be66-640e09166457","instance--eafaf315-2605-5869-b932-1d385c1b1b82","instance--1b183043-3a45-5f42-8208-ff287e05eb34","instance--13187e17-e887-5636-9bfb-25522633de62","instance--a84a303b-7e51-50ff-bc21-b885ff908a0f","instance--51740c8a-caf3-5c1e-b2f6-ffb0205bd380","instance--907321ca-d439-598a-a798-3a62cc229be5","instance--30a626c3-69a6-533b-b776-d7fc7b4c5ee3","instance--a0467c00-d0d4-58d5-a449-f825169bdfd3","instance--e29264e3-d258-540f-b10e-033139c7c97f","instance--681a9818-b107-5ed1-907f-c64f0f147c50","instance--cebba623-040c-51d1-8256-41f03a407861"],"properties":[["name","BlackByte blends tried-and-true tradecraft with newly disclosed vulnerabilities to support ongoing attacks"],["description","Talos IR observed BlackByte using valid credentials to access a victim VPN, compromise Domain Admin accounts, exploit VMware ESXi authentication bypass conditions through Active Directory changes, move laterally with SMB and RDP, tamper with defenses, and execute a self-propagating ransomware encryptor using BYOVD and built-in stolen credentials."],["scope","incident"],["author",[["name","Unknown"]]],["external_references",[["item-1",[["source_name","blog.talosintelligence.com"],["url","https://blog.talosintelligence.com/blackbyte-blends-tried-and-true-tradecraft-with-newly-disclosed-vulnerabilities-to-support-ongoing-attacks/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Access VPN with valid credentials"],["description","During Talos IR\u2019s investigation into a recent BlackByte ransomware attack, the threat actor gained initial access using valid credentials to access the victim organization\u2019s VPN."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1078.002"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Compromise Domain Admin accounts"],["description","After gaining initial access to the environment, the adversary managed to escalate privileges by compromising two Domain Admin-level accounts."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1078.002"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Access vCenter and create ESXi domain objects"],["description","One of these accounts was used to access the organization\u2019s VMware vCenter server and, shortly after, create Active Directory domain objects for individual VMware ESXi hypervisors, effectively joining those hosts to the domain."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1484"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Create ESX Admins accounts and group membership"],["description","The same account was then used to create and add several other accounts to an Active Directory group called \"ESX Admins.\""],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1136.002"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Access systems via SMB and RDP"],["description","The threat actor accessed other systems, directories and files within each victim environment using protocols such as Server Message Block (SMB) and Remote Desktop Protocol (RDP)."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021.002"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Execute atieclxx.exe from temp path"],["description","Talos IR also observed the execution of a file called \u201catieclxx.exe\u201d from the \u201cC:\\temp\\sys\\\u201d directory on one of the file servers. The legitimate version of \u201catieclxx.exe\u201d can normally be found in the \u201cC:\\Windows\\System32\u201d directory, where it supports system processes associated with AMD graphics cards. However, during the investigation of one BlackByte attack, \u201catieclxx.exe\u201d was executed from the \u201cC:\\temp\\sys\u201d directory with the command `atieclxx.exe P@$$w0rd123!!!`."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1036"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Tamper with defenses and change ESXi root password"],["description","Finally, the threat actor was observed tampering with security tool configurations via system registry modifications, manually uninstalling EDR from multiple key systems, and, in one investigation, changing the root password for the organization\u2019s ESXi hosts."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Execute host.exe encryptor as service"],["description","In recent cases, the BlackByte ransomware binary, \u201chost.exe,\u201d was executed from the same directory \u2013 \u201cC:\\Windows\u201d \u2013 across all victims investigated by Talos IR. The command syntax used by the adversary during each attack \u2013 `C:\\Windows\\host.exe -s [8-digit numeric string] svc` \u2013 and the behavior of the ransomware binary is consistent with previous analysis of the BlackByteNT binary by , , and others."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1569.002"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Spread via SMB and NTLM after service creation"],["description","Subsequent SMB and NTLM authentications were observed against reachable hosts after the ransomware service was created, resulting in multiple waves of encryption hours after the initial event."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021.002"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Self-delete host.exe"],["description","Upon successful execution, the ransomware binary executed the command `/c ping 1.1.1[.]1 -n 10 > Nul & fsutil file setZeroData offset=0 length=503808 c:\\windows\\host.exe & Del c:\\windows\\host.exe /F /Q` which, after a delay, zeroes the contents of the file and deletes itself."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1070.004"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Encrypt files with blackbytent_h extension"],["description","Most notably, encrypted files across all victims were rewritten with the file extension \u201cblackbytent_h\u201d"],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1486"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Drop vulnerable drivers"],["description","This newer version of the encryptor also drops four vulnerable drivers as part of BlackByte\u2019s usual Bring Your Own Vulnerable Driver (BYOVD) technique, which is an increase from the two or three drivers described in previous reports. The four drivers were dropped by the encryptor binary in all BlackByte attacks investigated by Talos IR, each with a similar naming convention \u2013 eight random alphanumeric characters followed by an underscore and an iterating number value."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1211"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Create and delete Terminator service registry keys"],["description","the ransomware binary created two service-related registry keys associated with that file during execution, then deleted them later in the execution process. Using the same fictitious string above, those registry keys would be:\n\n\u00b7\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0HKLM\\SYSTEM\\CONTROLSET001\\SERVICES\\AM35W2PH_2\n\n\u00b7\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0HKLM\\SYSTEM\\CONTROLSET001\\SERVICES\\AM35W2PH_2\\SECURITY"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1112"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Enumerate network shares with stolen credentials"],["description","During dynamic analysis of multiple BlackByte ransomware binaries, Talos found that the file attempted network share enumeration via the \u2018SRVSVC\u2019 named pipe\u2019s NetShareEnumAll function using specific user accounts associated with the victim."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1018"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Contact Microsoft symbol server"],["description","Communication with msdl.microsoft[.]com via IP address 204.79.197[.]219 early in the execution process. This site is associated with the Microsoft Public Symbol Server. BlackByte tools have long been observed downloading and saving debugging symbols directly from Microsoft."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Disable Defender and add exe exclusion"],["description","Disabling antivirus and anti-spyware protections via the HKLM\\SOFTWARE\\MICROSOFT\\WINDOWS DEFENDER registry key and adding the value \u201c*.exe\u201d to the HKLM\\SOFTWARE\\MICROSOFT\\WINDOWS DEFENDER\\EXCLUSIONS\\EXTENSIONS registry key."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"anchors":{"0":"instance--dbfe6415-cd2c-55f2-9509-06b6668ef23a","120":"instance--79ca45e2-afd7-51fa-9574-5085c7de4c84","150":"instance--39171cfe-3bf6-5200-b6f5-e97e3b047db7","180":"instance--8cda146b-7259-56b2-b337-56038a1f52d3","210":"instance--a662f8bf-2723-58c0-a1a8-9af9497cf428","240":"instance--a9b75b15-3be0-5e64-8132-40b87e7ae405","270":"instance--31896ecd-322b-5a41-bd1e-0b7a30b9d9d1","30":"instance--60868276-2726-597d-8f57-8aa7fc9c0738","300":"instance--4f5668fa-b6ef-57cc-93da-5cd1e1727a22","330":"instance--b022a562-9020-587c-a5be-97d254cc8f11","60":"instance--cf452b0f-192e-5357-ba8c-fbae1a6e4ae0","90":"instance--012cc6fc-0a37-5e6e-b9b7-07f3bcd2d02c"},"id":"action","instance":"attack-action--17","properties":[["name","Delete system binaries"],["description","Deletion of system binaries from the \u201cC:\\Windows\\System32\u201d directory, including \u201ctaskmgr.exe\u201d, \u201cperfmon.exe\u201d, \u201cshutdown.exe\u201d, and \u201cresmon.exe\u201d."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1070.004"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","Successful exploitation of this vulnerability grants members of a specific Active Directory group elevated privileges on an ESXi host, allowing for control over virtual machines (VMs), the ability to modify the host server\u2019s configuration, and access to system logs, diagnostics and performance monitoring tools."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","The \u201csvc\u201d parameter causes the ransomware to install itself as a service, which appeared to convert an infected system into an additional spreader as part of the ransomware\u2019s wormable behavior."]]},{"anchors":{"0":"instance--8897770c-0bef-5cf9-9006-82807accfbfb","120":"instance--a58d775b-6a68-57c8-8855-5e6893a45f18","150":"instance--4edb4140-aca0-51ed-81fb-a3f798097df3","180":"instance--83eb5e55-5788-5bd9-a0f0-664e46380388","210":"instance--c03d475c-54dd-5420-b3ad-545cdcaa57b0","240":"instance--db47b5c5-c324-5c38-ac5d-e2e81e6a47ea","270":"instance--4ad97fa8-b626-5d87-9554-0