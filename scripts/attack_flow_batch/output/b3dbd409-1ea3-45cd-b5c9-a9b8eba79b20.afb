12"},"id":"mutex","instance":"mutex--1","properties":[["evidence",[["item-1",{"citation":null,"excerpt":"Mutexes are used by both to verify that only one instance is running, although the mutexes used are dissimilarly named.","source":"https://www.welivesecurity.com/2021/06/10/backdoordiplomacy-upgrading-quarian-turian/","source_field":"normalized_text","source_object_id":null}]]],["display_name","Turian mutex"],["name","Turian mutex"]]},{"anchors":{"0":"instance--4e942bfd-4264-555c-8748-7eb2e999ff13","120":"instance--f044726d-ee55-52f4-88b4-fd39ff2b8e8d","150":"instance--14187d6c-2f13-51e8-bde1-91e065756a74","180":"instance--72fbf7a0-91d0-5e9f-b83b-7f5b189a8cef","210":"instance--e1937ddc-1102-52c0-9709-5f7600aba57e","240":"instance--a15e1468-8c2f-564d-98f3-27d39b4d492e","270":"instance--7f152962-47bb-5430-9fc9-64786b99deff","30":"instance--b1dba1f2-201d-5b13-abad-98f28b800a58","300":"instance--eeb12b43-767c-5026-84e8-5841c4408405","330":"instance--b6b5fa0e-b8a7-5ff5-a7fd-083a3cc69914","60":"instance--9f8b261a-13e3-5220-85ca-393ef17dce5a","90":"instance--83e60b13-a495-5805-8247-5fcabd32f71b"},"id":"process","instance":"process--1","properties":[["command_line","reaches out to the C&C using as its user-agent"],["evidence",[["item-1",{"citation":null,"excerpt":"forks off a child process which then begins the work of decrypting the C&C IP address and/or domain name then initiates a loop that reaches out to the C&C using as its user-agent","source":"https://www.welivesecurity.com/2021/06/10/backdoordiplomacy-upgrading-quarian-turian/","source_field":"normalized_text","source_object_id":null}]]],["display_name","child process"]]},{"anchors":{"0":"instance--3109421e-7eee-534a-94eb-83100394e052","120":"instance--77b0605c-a86f-5700-98ac-73fd1373bb56","150":"instance--3e7582be-99c6-5268-9f69-9fa72f90ea70","180":"instance--3df248ba-a39d-5572-bc65-50e9c112fad0","210":"instance--d44419e2-d63a-5b9c-a1d2-90b0aa8f7472","240":"instance--31fedfc4-2147-5036-97d9-fc91eaa1879e","270":"