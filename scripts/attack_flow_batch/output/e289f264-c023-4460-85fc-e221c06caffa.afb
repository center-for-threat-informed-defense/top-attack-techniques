{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-condition--1","instance--7427c8a0-91f9-5e70-ad72-6e5ce0c78723","instance--761ccde3-2250-5593-9329-cf176c78aff1","instance--d56a57e1-38ee-5115-bcad-e7817668513c","instance--acb605f3-8c48-56e9-bbf0-b21c54c1519f","instance--aaa15696-eba1-5630-abe7-6eeb65da1682","instance--35651ad7-74e3-5ba2-bff9-d25f075a3e4b","file--2","file--3","instance--becc7795-37fe-5653-834c-15b423ef23c9","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--fe58d3c1-faa4-512f-a0c3-fa75b622e227","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--b879673b-0c82-5a65-8ee4-4f18f90200fb","instance--0b5fe2f3-4def-599d-8bc0-81cfe68e30c5","instance--77eac446-2a0d-513a-8545-60472be63c55","instance--87fa4a6b-4596-5860-918e-e16f74da32fa","instance--9e41bc14-7da4-59c9-923f-256bded0dde5","instance--458b9052-de4d-5b30-bc79-d8e8797debaf","instance--77e5b927-a6a8-51b7-afbf-c8e2095e9bc8","instance--e96c07b8-8e9f-5ef9-bd75-6e2552f65929","instance--d0506b32-2e59-5b18-8a0f-da134e4d119f","instance--d67df2e3-f239-5084-b92d-d2446dc8f121"],"properties":[["name","Finding Passwords in SYSVOL & Exploiting Group Policy Preferences"],["description","One of these methods is mining SYSVOL for credential data."],["scope","incident"],["author",[["name","Sean Metcalf"]]],["external_references",[["item-1",[["source_name","adsecurity.org"],["url","https://adsecurity.org/?p=2288"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Read SYSVOL share"],["description","SYSVOL is the domain-wide share in Active Directory to which all authenticated users have read access. SYSVOL contains logon scripts, group policy data, and other domain-wide data which needs to be available anywhere there is a Domain Controller (since SYSVOL is automatically synchronized and shared among all Domain Controllers).\n\nAll domain Group Policies are stored here: \\\\<DOMAIN>\\SYSVOL\\<DOMAIN>\\Policies\\\\"],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1083"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Search SYSVOL for cpassword XML"],["description","Since authenticated users (any domain user or users in a trusted domain) have read access to SYSVOL, anyone in the domain can search the SYSVOL share for XML files containing \u201ccpassword\u201d which is the value that contains the AES encrypted password."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1083"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Decrypt GPP password"],["description","With access to this XML file, the attacker can use the AES private key to decrypt the GPP password. The PowerSploit function is most useful for Group Policy Preference exploitation."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1552.006"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Open policies and copy cpassword"],["description","Open Windows explorer and open the Policies folder in SYSVOL and search for *.xml. Open up the results with the names I listed in the post (groups.xml, scheduledtasks.xml, etc), and copy the cpassword value. This can be uploaded to the internet somewhere, emailed, etc. Then the PowerShell function I pasted in an earlier comment can be run anywhere. Furthermore, that PowerShell function will decrypt the cpassword attribute without loading any modules so it can be used anywhere."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1552.006"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","With access to this XML file, the attacker can use the AES private key to decrypt the GPP password."]]},{"anchors":{"0":"instance--207d85b0-c0b5-5454-9ef4-31af21ff6e9d","120":"instance--d2222b4b-1490-5306-9db0-b98f5eddd70a","150":"instance--755c38a3-f892-55c4-b500-ace708d3cbeb","180":"instance--78ea83c5-d543-5306-8c45-6f39baa7c7e0","210":"instance--13892a29-0b9e-5321-99df-ce736972d7cd","240":"instance--b6148a4d-7baf-533e-842d-659f0aee8bdc","270":"instance--3ab5afc2-86c2-521e-8140-d92680bb2edc","30":"instance--ac4ab379-c15f-53b6-8b86-708027abe38b","300":"instance--3ed76920-d9a0-5523-865a-d783bf02dd91","330":"instance--403520de-6583-52a2-96fc-14dc1387428c","60":"instance--2f44ce3d-9a8d-5c25-a787-0f113cf660a7","90":"instance--f71f0f00-6d35-5f69-a982-5597d9155070"},"id":"directory","instance":"instance--7427c8a0-91f9-5e70-ad72-6e5ce0c78723","properties":[["path","\\\\<DOMAIN>\\SYSVOL\\<DOMAIN>\\Policies\\"],["evidence",[["item-1",{"citation":null,"excerpt":"All domain Group Policies are stored here: \\\\<DOMAIN>\\SYSVOL\\<DOMAIN>\\Policies\\\\","source":"https://adsecurity.org/?p=2288","source_field":"normalized_text","source_object_id":null}]]],["display_name","\\\\<DOMAIN>\\SYSVOL\\<DOMAIN>\\Policies\\"],["diagram_instance","instance--7427c8a0-91f9-5e70-ad72-6e5ce0c78723"]]},{"anchors":{"0":"instance--f513981d-41d4-5aa6-b2c8-9814fe3394b0","120":"instance--c529fefe-c4be-581c-93d0-1cebc2d7195d","150":"instance--772b9a43-72aa-50c5-937a-379b73eb5ed9","180":"instance--ac97965f-bc43-5f92-9109-58bf0794997d","210":"instance--79f568fd-3622-58f3-87cf-b601ad1796cc","240":"instance--5e02a613-879f-5df2-a76d-29d6b3293616","270":"instance--2b658482-8c22-5024-8156-14ab6ff41394","30":"instance--b3e51feb-2650-5ba5-9661-b08cf863aec4","300":"instance--44acae44-0845-5e05-a916-acaf8513194b","330":"instance--7ea80f85-e328-5c0f-91b1-067518865f92","60":"instance--a231a889-dd86-5bad-9317-a1c8f43dda24","90":"instance--9a7e72da-fd15-5330-a264-547f0aeaa473"},"id":"directory","instance":"instance--761ccde3-2250-5593-9329-cf176c78aff1","properties":[["path","\\\\<DOMAIN>\\SYSVOL\\<DOMAIN>\\Policies\\"],["evidence",[["item-1",{"citation":null,"excerpt":"All domain Group Policies are stored here: \\\\<DOMAIN>\\SYSVOL\\<DOMAIN>\\Policies\\\\","source":"https://adsecurity.org/?p=2288","source_field":"normalized_text","source_object_id":null}]]],["display_name","\\\\<DOMAIN>\\SYSVOL\\<DOMAIN>\\Policies\\"],["diagram_instance","instance--761ccde3-2250-5593-9329-cf176c78aff1"]]},{"anchors":{"0":"instance--9d3732e0-6e41-58df-a166-a82c9fa488df","120":"instance--30317ce5-cfc5-50d1-a3c8-626102c5606c","150":"instance--0a43faa3-eca5-584d-981f-1d031b5c7587","180":"instance--14a50a23-b821-5196-9e88-e985725f5be7","210":"instance--0429bf2f-4e4e-507a-891f-166c1d6a4d6a","240":"instance--13f59d3c-85f9-5ee9-ad3f-a46956aab02e","270":"instance--152e6601-8358-5c97-81e9-56076898f2a4","30":"instance--602aa4b0-f277-5248-84c3-bef33d0498fa","300":"instance--8f8f2389-8eca-553d-865c-5aa9fb8c089e","330":"instan