posts/charming-kitten-christmas-gift/"}]]],["display_name","mail-newyorker[.]com"]]},{"anchors":{"0":"instance--3a58d8da-1395-5b7b-9e6e-fad0df39042b","120":"instance--dfb35d5b-5930-50a1-9843-5266ad5fe6e7","150":"instance--2e58163b-e559-5215-afc3-bd5434738a46","180":"instance--69a47287-8bcf-54a7-8ec4-91e4749ea0f0","210":"instance--b233f7a8-cc68-501f-8e74-1a01b6dbd231","240":"instance--f80c1fcd-036b-57f7-8757-c72b5f131fc1","270":"instance--fa1503ae-c70b-5700-9f5d-ef722b3b4b6e","30":"instance--e384ab4e-cbf7-5f70-bb0b-fabba2716f36","300":"instance--db99921a-458e-59ff-96fa-026694a86ef9","330":"instance--363d9fc3-f354-5d1c-ba95-7f7e72657c2b","60":"instance--2bcbc8a0-b99c-5a00-909e-de8134219099","90":"instance--f1b38c06-bfbe-5b93-be8b-044fbe3c3de8"},"id":"domain_name","instance":"domain-name--5","properties":[["value","news12[.]com[.]recover-session-service[.]site"],["evidence",[["item-1",{"excerpt":"For example, based on our initial findings, the hackers use domain names such as mail-newyorker[.]com, news12[.]com[.]recover-session-service[.]site with the intention of targeting \u201cThe New Yorker\u201d online magazine readers and \u201cNews 12 Networks\u201d TV channel staff and their audience.","source":"https://blog.certfa.com/posts/charming-kitten-christmas-gift/"}]]],["display_name","news12[.]com[.]recover-session-service[.]site"]]},{"anchors":{"0":"instance--9b9cb458-e6bf-57ba-84d4-e7df06026510","120":"instance--90f0880b-d258-51fe-93ce-37fd0f4958af","150":"instance--9be1b555-e378-51b0-b557-7c284edc64d1","180":"instance--3ab38b36-c18e-5f16-8393-ddd70a85bf0e","210":"instance--d0598b0e-e0c6-5b0c-b057-743b52bf043c","240":"instance--029fce02-7dd9-548a-93ce-f0c26ee6c218","270":"instance--2d24f409-593e-5dc9-8f0a-3a9ef6b60ba5","30":"instance--36609dba-dfb7-5d85-a66e-41c1b6320436","300":"instance--05342b45-d5a3-5c71-bb3f-45b12b0e46b9","330":"instance--4ccf1d64-71d3-5f3c-82bc-5ef65911e3af","60":"instance--203727e2-7e89-5090-b06b-713ada107d42","90":"instance--a50fccf3-0c0d-534