tocols",[["item-1","http"]]],["dst_port",8080],["extensions",{"request_method":"GET"}],["evidence",[["item-1",{"excerpt":"Once the .JS file is run, it makes HTTP GET requests over port 8080 to the command and control (C2) IP with what the MS-ISAC believes is identification data encrypted within an encoded cookie string.","source":"https://www.cisecurity.org/blog/emotet-changes-ttp-and-arrives-in-united-states/"}]]],["display_name","network_traffic"]]},{"anchors":{"0":"instance--11d519c3-9dab-5679-838e-ba1a3b04927e","120":"instance--55fd6a55-9dd6-5802-8ac7-7d9926b4d479","150":"instance--7fec55bd-e393-5c8e-8a45-ab5d20390ee0","180":"instance--2dbf393c-a4ec-57fa-92ea-3f942213cc14","210":"instance--3bc35874-ecb8-5cee-9c39-a47d46e0fb01","240":"instance--dee4c426-4252-5f9a-a366-e37238517fd9","270":"instance--eae4dc86-e691-5690-864d-3311bb3c174f","30":"instance--8c86073c-daf5-5f1e-822b-b4941a5aad83","300":"instance--1ae2db64-681a-5dfd-a119-8e96792233fd","330":"instance--b47874e2-bd0f-5213-9db9-be45c647aa07","60":"instance--f003ed45-9ee9-5fe6-9633-0a25169f9436","90":"instance--37cd2951-7a44-52d7-b37a-073d918e0bce"},"id":"ipv4_addr","instance":"instance--a99537dd-73d9-5787-a501-4cc7c8049042","properties":[["value","command and control (C2) IP"],["evidence",[["item-1",{"excerpt":"Once the .JS file is run, it makes HTTP GET requests over port 8080 to the command and control (C2) IP with what the MS-ISAC believes is identification data encrypted within an encoded cookie string.","source":"https://www.cisecurity.org/blog/emotet-changes-ttp-and-arrives-in-united-states/"}],["item-2",{"excerpt":"When the malware was successfully run, the remote IP address responded with a 404 error header and encrypted data.","source":"https://www.cisecurity.org/blog/emotet-changes-ttp-and-arrives-in-united-states/"}]]],["display_name","command and control (C2) IP"],["diagram_instance","instance--a99537dd-73d9-5787-a501-4cc7c8049042"]]},{"anchors":{"0":"instance--d364abd6-82f5-5f49-a040-aa1944ea07a