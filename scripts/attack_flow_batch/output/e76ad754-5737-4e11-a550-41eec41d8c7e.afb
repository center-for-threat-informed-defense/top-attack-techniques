{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","instance--de76b67a-16ff-51b2-8520-0b8411f66ca3","instance--6b86637a-4491-50fb-9839-e7e3e55c53dc","instance--53b8bcce-1f02-5272-8958-2d52476eab18","instance--60174972-2e05-5e55-96ea-443b03ccd5b1","instance--b062d071-0f1e-53ea-a567-f9f742bb7d3c","instance--9c9218eb-f4ef-5688-bae1-8832f0bf575e","instance--90f87dca-76ff-580f-bcb9-39a3ddd37d78","instance--b238e638-881f-5404-bd7c-5bb735b93d56","instance--8301cdba-e905-544c-8a6d-92fe624406fc","instance--f21c916b-ab21-505a-b43d-6e06199d2258","instance--5d3ebad1-222e-56ce-a044-be09de62739d","instance--e7d915dc-7b62-552c-bba8-11ef37c1fbd3","instance--f4844f98-e9ad-5776-b42f-77fcfd024015","software--clientless-sslvpn","instance--2853c940-91cd-5f7b-8947-07fd3979190e","instance--41990640-87ce-5f88-886c-232a5981a894","instance--3a0de259-edb1-52d6-b389-9ce88f346b44","url--portal-css-get","instance--248afd7b-52a0-5c62-8350-70c1e424c114","instance--43dbb7a5-5855-51c0-95eb-25bec9d62f9f","instance--b076ae35-fd26-5a92-a7ff-5d5ead962818","instance--6f104b5c-885d-5551-a33f-244b31c30263","instance--b3e744c3-d56f-589f-947a-8200ddeeeec2","url--config-auth-post","instance--05448a98-12d6-5d33-9e1a-a863f0e3df0e","file--device-configuration-text","instance--93a75dd4-72a9-572c-aecd-e25b18c4b9c7","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--353aa620-4c8a-5471-be46-d26f6b69742f","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--3aaedd0d-9fff-581d-be5f-4d397694adf4","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--0427812d-0c60-5e2f-97a9-8e44ffed9b93","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--28b5ea35-b250-5bcf-9e29-c8aa349009d2","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--048bde3a-ae79-5902-b1ae-a81e12509c33","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--2f5f12b9-232b-5150-b961-5d66845f48f5","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--5cd5881d-97c5-5e6f-9fe5-7b1dfb542b6e","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--18384a48-f4b7-512b-a7f7-f49b119d2d59","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--34798676-cc9b-59e0-be5f-23bc40752009","instance--be99ba49-e121-58a8-ba7b-dd3de316cfcf","instance--ee78d0fa-3fd9-55dc-a142-c7343707d3ce","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--dd8a24ad-b36a-5832-9b5d-4c4e6666ada2","instance--6e17be30-90e4-53bd-a580-4553745bea2e","instance--6b5051bd-b8fe-5779-9ee8-ad56a42604a5","instance--7d0d9775-e63b-50a7-9a90-050b223d6ac5","instance--86933a41-8d42-5949-bfd2-1f667c18a0d8","instance--b4151c4b-da00-501c-a500-a0928e7422d0","instance--779babdb-778f-5530-af61-41a632c9a43c","instance--38d0256c-e884-5267-b2c4-d8c2fcc120e2","instance--bedf8a0f-868e-5f56-b7fb-5e97af1ccedc","instance--6d77d4dc-d1ec-58e2-863f-419ef1912f66","instance--dcb5ba83-b09f-5f74-8707-ec4cacdc4afc","instance--45383c97-b6ce-5f77-8a75-ca8ee9cca1b5","instance--6ea31b9d-e61d-5687-9dbf-47fe8bf45575","instance--0c92753d-4913-5881-9393-e9e2ed1952c9","instance--3b2770af-b4a1-5fb2-8d64-4d433ecc06bd"],"properties":[["name","Cyber Activity Impacting CISCO ASA VPNs"],["description","Canadian, Australian, and UK agencies describe malicious cyber activity targeting Cisco ASA WebVPN services, including unauthorized access, remote code execution, persistence via LINE RUNNER and LINE DANCER, configuration theft, packet capture configuration, data exfiltration, syslog disabling, and AAA modification."],["scope","incident"],["author",[["name","Canadian Centre for Cyber Security (Cyber Centre)"]]],["external_references",[["item-1",[["source_name","www.cyber.gc.ca"],["url","https://www.cyber.gc.ca/en/news-events/cyber-activity-impacting-cisco-asa-vpns"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Establish unauthorized WebVPN access"],["description","These affected products have been compromised by malicious actors who successfully established unauthorized access through WebVPN sessions, commonly associated with Clientless SSLVPN services."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1133"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Transmit malicious WebVPN payloads for RCE"],["description","The authoring agencies performed analysis that showed malicious actors abusing WebVPN by transmitting malicious payloads resulting in unauthorized remote code execution on Cisco devices."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1190"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Configure packet capture sessions"],["description","These commands include, but are not limited to, the configuration of packet capture sessions on the devices to collect and exfiltrate data."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1040"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Deploy LINE RUNNER webshell"],["description","LINE RUNNER - a persistent webshell enabling malicious actors to upload and execute arbitrary Lua scripts."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1505.003"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Execute arbitrary Lua via HTTP GET"],["description","LINE RUNNER offers the ability to run arbitrary Lua code sent via HTTP GET requests to legitimate Cisco ASA WebVPN / AnyConnect URIs. E.g.:\n\nGET /+CSCOE+/portal.css?<aaa>=<token>&<bbb>=<lua_script>\n\nWhere:\n\n<aaa> is a randomized query parameter key name.\n\n<token> is a randomized value, checked by the webshell (i.e., auth)\n\n<bbb> is a randomized query parameter key name.\n\n<lua_script> is the URL Encoded Lua commands to execute."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.011"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Use randomized query parameters"],["description","The use of randomized query parameters prevents mass scanning of potentially impacted ASAs. It is assumed the values in the GET requests are victim specific, but this is yet to be confirmed."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1027"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Deploy LINE DANCER shellcode loader"],["description","LINE DANCER - an in-memory implant enabling malicious actors to upload and execute arbitrary shellcode payloads."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1546"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Process malicious payloads to run system commands"],["description","LINE DANCER is a persistent Lua-based shellcode loader, which is a component of a larger framework. This shellcode loader would process malicious payloads that execute system commands."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.004"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Submit base64 shellcode via POST"],["description","LINE DANCER offers the ability to run shellcode payloads -- these are base64-decoded and only run when prepended by a fixed 32-byte value, which differs between victims. Provided below is an example of HTTP POST requests to Cisco ASA WebVPN / AnyConnect URIs. E.g.:\n\nPOST /CSCOSSLC/config-auth HTTP/1.1\n\n\u2026\n\n<host-scan-reply>[base64-encoded payloads]</host-scan-reply>"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1055"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Generate text configuration for exfiltration"],["description","The malicious actors generated text versions of the device\u2019s configuration file so that it could be exfiltrated through web requests."],["confidence",0.0],["ttp",{"tactic":"TA0009","technique":"T1005"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Disable and enable syslog service"],["description","The malicious actors were able to control the enabling and disabling of the devices syslog service to obfuscate additional commands."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1562.001"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d