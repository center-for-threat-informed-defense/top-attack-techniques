{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-condition--1","directory--1","software--1","instance--ad1f125b-7701-5e9d-b869-79f40471648d","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--56da8838-1109-5fce-9d89-7b3ec32d7010","instance--7c658664-6d38-5a13-88bd-6c23e6130fdf","instance--c60a8365-dc47-55a4-aabc-ebb4f5c9470f"],"properties":[["name","CaddyWiper destructive workflow"],["description","Cisco Talos analysis of the CaddyWiper malware destructive workflow."],["scope","malware"],["author",[["name","Cisco Talos"]]],["external_references",[["item-1",[["source_name","blog.talosintelligence.com"],["url","https://blog.talosintelligence.com/2022/03/threat-advisory-caddywiper.html"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Check domain controller role"],["description","Before starting any file destruction, it checks to ensure that the machine is not a domain controller."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1016"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Destroy user files and mapped drives"],["description","If the system is not a domain controller, the wiper will destroy files on \"C:\\Users,\" followed by wiping of all files in the next drive letter until it reaches the \"Z\" drive. This means that the wiper will also attempt to wipe any network mapped drive attached to the system."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1485"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Take ownership and overwrite files with zeros"],["description","For the file destruction, it takes ownership of the files by modifying their ACL entries after it has obtained the ' '. A file found will then simply be overwritten with zeros.\n\nA file that is larger than 10,485,760 bytes  (0xA00000) in size will simply have the first 10,485,760 bytes overwritten with zeros."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1222.001"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Recursively wipe drives D through Z"],["description","The wiper will then move on to the next drive on the system beginning with the \"D\" drive. It will recursively gain rights to files on a drive and overwrite them with zeros. This is done for the next 23 drives alphabetically (through \"Z:\\\")."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1485"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Wipe physical drive layout and partition tables"],["description","On the second stage, the wiper attempts to set the drive layout of all the physical drives on the system numbered 9 to 0. This will wipe out all about the physical drive's partitions including MBR, GPT and partition entries.\n\nWiper recursively performing IOCTL_DISK_SET_DRIVE_LAYOUT_EX requests with a zeroed out buffer."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1561.001"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","If the machine is a domain controller, it stops execution."]]},{"anchors":{"0":"instance--2c438413-b42f-56a3-9c72-85880d7749eb","120":"instance--e940f0e7-7ccb-5d69-a6d5-74587c840c9a","150":"instance--9200b964-6c75-5fe5-97c0-98a7b900c3de","180":"instance--152957c3-8538-52f9-bae6-a8a10f98b234","210":"instance--63ad4c8b-b923-51cc-aec2-a2510a7ae18e","240":"instance--1b9c55d9-4e52-5e2b-aa54-6a692ea623b9","270":"instance--6485a9a8-7f78-5737-a591-4254f4e07cef","30":"instance--13e56bcb-bf84-5594-a4f2-0500a2bf7bef","300":"instance--f76908ad-5369-52c0-8f5b-ad24faa9f313","330":"instance--514bd127-cefa-585f-a384-6ec240e44ec2","60":"instance--fe826b13-e63e-50d4-a437-e2b0b94da142","90":"instance--68150e2f-92d6-5f33-9cf4-5fd07778cf97"},"id":"directory","instance":"directory--1","properties":[["path","C:\\Users"],["value","C:\\Users"],["evidence",[["item-1",{"excerpt":"If the system is not a domain controller, the wiper will destroy files on \"C:\\Users,\" followed by wiping of all files in the next drive letter until it reaches the \"Z\" drive.","source":"https://blog.talosintelligence.com/2022/03/threat-advisory-caddywiper.html","source_field":"normalized_text"}]]],["display_name","C:\\Users"]]},{"anchors":{"0":"instance--905f37ff-524a-522a-8685-08b6df9b34bd","120":"instance--a0b8bf42-8310-53d9-87f0-390378638ae9","150":"instance--ffafa2fa-6430-5714-9c5e-bbf977c9819b","180":"instance--10bf0e4d-ac4d-5742-b82b-398ef2467e2a","210":"instance--f2066b53-6fa4-5efa-8f61-dc81d3df5b0e","240":"instance--fbb6b151-c9f4-5cb6-b467-c563cc0c60d3","270":"instance--451ff5e8-5cc8-5d6c-b701-da17c04936f7","30":"instance--059bc992-da53-5d4b-ac82-60cfacc08e81","300":"instance--1d241382-a8ee-554a-aa3a-04366535b315","330":"instance--8a7078e9-787d-56b2-a734-f93cd76b3dc8","60":"instance--8aab1831-f6e3-582d-8f9b-3ad920a40e35","90":"instance--192458e5-76c8-5d8c-ab54-9ed8b36ef2bd"},"id":"software","instance":"software--1","properties":[["evidence",[["item-1",{"excerpt":"Wiper recursively performing IOCTL_DISK_SET_DRIVE_LAYOUT_EX requests with a zeroed out buffer.","source":"https://blog.talosintelligence.com/2022/03/threat-advisory-caddywiper.html","source_field":"normalized_text"}]]],["display_name","IOCTL_DISK_SET_DRIVE_LAYOUT_EX"],["name","IOCTL_DISK_SET_DRIVE_LAYOUT_EX"]]},{"id":"horizontal_anchor","instance":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","latches":[]},{"id":"horizontal_anchor","instance":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","latches":[]},{"id":"vertical_anchor","instance":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","latches":[]},{"id":"vertical_anchor","instance":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1","latches":[]},{"id":"vertical_anchor","instance":"instance--5850a8f4-8241-5e73-9bf0-dcd376