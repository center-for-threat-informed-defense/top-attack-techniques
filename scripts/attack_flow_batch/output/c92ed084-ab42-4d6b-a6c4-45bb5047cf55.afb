{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","attack-action--13","attack-action--14","attack-action--15","attack-action--16","attack-action--17","attack-action--18","attack-action--19","attack-condition--1","windows-registry-key--1","software--1","instance--1fa25a2c-eb73-5639-9fc1-fcc3c0b30784","file--1","software--2","file--2","file--3","instance--06b33416-41a0-537f-9fe8-6d032e7e7d29","file--4","instance--6c93dca3-34c7-598a-bd88-fe3bc58c4140","instance--c7d1c64c-050b-5eab-b12d-afe25d55cdf7","software--3","url--1","software--4","network-traffic--1","instance--2ff15679-7662-54c2-9b00-c0a2e45ae5f0","software--5","software--6","instance--809174df-e94b-54d6-9461-14e87a7af072","file--5","instance--c107e9d8-b59c-560d-9114-151399ff0627","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--be99ba49-e121-58a8-ba7b-dd3de316cfcf","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--c075f5c6-95e8-5553-8f7e-b432b96021c7","instance--3b404379-7d7e-5278-b499-6ac12ee4e90f","instance--3e0f78a3-bb54-55bd-8490-3453d5e06d04","instance--a37796a0-93b2-51bb-be4b-2a9a9e7e35e1","instance--d5e9bb4a-1b88-5a9d-a6ba-9c61f7ada55c","instance--f9e616ac-2310-573d-8995-336b82cf51af","instance--77414a6f-10f0-5dbb-b428-351706ad11fd","instance--7a7e601d-35d6-5ff6-a0af-4c1d76440697","instance--c823d543-b75f-54a9-aa05-7e7d419a4168