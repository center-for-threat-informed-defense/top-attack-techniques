-1",{"excerpt":"The files were put into an archive created using the rar.exe utility.","source":"https://www.bitdefender.com/blog/labs/luminousmoth-plugx-file-exfiltration-and-persistence-revisited"}]]],["display_name","rar.exe"],["name","rar.exe"]]},{"anchors":{"0":"instance--c2e84d8b-5164-58c2-9526-5d9d9d6f8872","120":"instance--af5c0c72-1f78-51b9-b888-1250a72e1fca","150":"instance--07b79917-15e4-5f09-a207-d6f6152473e0","180":"instance--d05c509a-2080-5c66-b004-314696535967","210":"instance--ec78c273-5dc9-521e-82ca-c99e22fd2dfd","240":"instance--09e6b23b-983e-5ca8-a8a9-931fc6216b82","270":"instance--9e22dc2c-a31a-5d2b-84c9-f5e2abf6350b","30":"instance--bd8dfcfd-57e3-5a3c-9235-52fb080a08dc","300":"instance--8e4c8523-3ca6-553d-8710-b2ebee87da5b","330":"instance--b9c09a1c-f198-5c14-a9ec-37102767f73c","60":"instance--ecbb9ccd-93ad-5523-92a7-2479833ce664","90":"instance--fb906e97-d671-55d7-ba8b-9eeb36dc827a"},"id":"url","instance":"url--1","properties":[["value","Google Drive upload endpoint"],["evidence",[["item-1",{"excerpt":"After analysis, we concluded that the sample uploads the files to Google Drive as it uses the endpoint to perform a simple upload.","source":"https://www.bitdefender.com/blog/labs/luminousmoth-plugx-file-exfiltration-and-persistence-revisited"}]]],["display_name","Google Drive upload endpoint"]]},{"anchors":{"0":"instance--ed268b8e-ae15-5307-9c74-c59bcb1720fa","120":"instance--334514cd-5319-5e74-a93f-0cb00858c2d8","150":"instance--717ddf64-eda1-5ef7-a0ed-5b2a3afa55d8","180":"instance--64d6ab30-a186-5c38-bc2f-2a6268e6a890","210":"instance--c526ef8a-6654-57eb-8d30-dc76669fe59b","240":"instance--d39a2ed7-e1e8-5740-8784-294f596f2645","270":"instance--0727ca9b-e57c-5659-8487-2c4d929af3cb","30":"instance--47afb308-461a-5288-a8da-23e324db046e","300":"instance--3be52c61-8f5f-5cd2-b041-ffa9b0d4b511","330":"instance--0cbe84a5-46fe-5b20-93b7-8e80eb3fc87b","60":"instance--4e4f2f34-7922-5624-bab5-c48861c43574","90":"instance--782fe341-7fed-508f-bba5-d5a092a90