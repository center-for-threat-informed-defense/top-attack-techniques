009","technique":"T1005"}]]},{"anchors":{"0":"instance--ce3f20b8-daf0-5682-a74a-dd9eb1251abb","120":"instance--08418575-7199-5323-8082-8e1d88a1ec11","150":"instance--15627176-59a5-5797-816e-a6cab3ea9da9","180":"instance--242a8d77-274b-5d18-ba35-771f6e0de836","210":"instance--d01bb126-419a-5d3b-a9cf-7b8df1d59112","240":"instance--0b76a14d-f362-5d5a-995f-2e318539789f","270":"instance--d534a23c-ea17-5a19-96f9-740e77b559a2","30":"instance--9b134899-2cf4-5fcd-9412-5363985ac68c","300":"instance--1bb6a59f-c750-5aca-a7c7-cecaf9c9f1f7","330":"instance--a346b253-e85b-53ff-8e33-33aaa8c928da","60":"instance--0c9baf75-2ba0-51ff-b084-c1044ff899fa","90":"instance--b86b5b84-3a18-51f2-b888-17161b8c5d47"},"id":"action","instance":"attack-action--26","properties":[["name","Clone domain controller VMs"],["description","CrowdStrike Services also found evidence that the adversary used their access to vCenter servers to clone domain controller VMs, likely in an attempt to collect sensitive data such as the Active Directory Domain Services database."],["confidence",0.0],["ttp",{"tactic":"TA0009","technique":"T1005"}]]},{"anchors":{"0":"instance--804d7975-bdc1-5371-a95e-4cff0aa0b8b1","120":"instance--aab4410b-5835-54c6-bc0f-d93b86440850","150":"instance--ad5c3f2a-3c32-5af5-9b9c-489a81eead21","180":"instance--3ff51605-dadf-546e-a273-07184c6549e2","210":"instance--9337c97e-ad0d-5d35-8b01-21c1e3f80296","240":"instance--49c4f7e6-8fe8-5919-bda8-039a2aaf3a61","270":"instance--4e395b92-9587-53cc-a957-cad25cc53df8","30":"instance--b917f3cb-7197-5ba7-8a3e-cbfda092d01a","300":"instance--ab650c26-b6f9-59ed-b26e-6f6ca03758dd","330":"instance--36c16e65-d9d7-519a-a8ae-a6dd521ddceb","60":"instance--0b7fc2fd-f6ca-532d-9f2b-ca34c65a881a","90":"instance--ff765750-9ba6-53a3-b366-8a863df1a603"},"id":"action","instance":"attack-action--27","properties":[["name","Reconnoiter Asia Pacific government entity"],["description","WARP PANDA likely used their access to one of the compromised networks to engage in rudimentary reconnaissance against an Asia Pacific government entity."],["confidence",0.0],["ttp",{"tactic":"TA0043","technique":"T1591"}]]},{"anchors":{"0":"instance--5788127e-30a2-5d63-8064-8a764c79ef88","120":"instance--50a9fb8c-a32c-508b-9ff8-6fbad48bdc18","150":"instance--fb5120ee-d53c-50d4-8806-fb538b7ace76","180":"instance--8c9e9207-faff-59a9-9ac0-4db98f799c06","210":"instance--17f4c1e8-e3de-51ca-a9b4-9407a08ef1f5","240":"instance--72709ae2-9e69-5094-89f4-3bb373306fff","270":"instance--4d10667a-8f14-5176-8d94-a90057c253eb","30":"instance--b7f4854d-0cc9-50b4-aae7-a9728bb18935","300":"instance--bb03752f-dd5c-5086-862e-11a1b554f970","330":"instance--ce6fbeb3-82f7-525d-94ba-6314c642da8e","60":"instance--5e319f8b-f917-5aca-9a32-bd424efd643f","90":"instance--923612bb-e746-52ea-b7f5-39eb0184150e"},"id":"action","instance":"attack-action--28","properties":[["name","Visit cybersecurity blogs and GitHub repository"],["description","They also connected to various cybersecurity blogs and a Mandarin-language GitHub repository."],["confidence",0.0],["ttp",{"tactic":"TA0043","technique":"T1593"}]]},{"anchors":{"0":"instance--421e596f-663b-56b5-aacb-5c51f44887fb","120":"instance--54341936-f58d-5d7b-9140-0b8f37379212","150":"instance--6ca5d726-fab5-5c69-8490-e3c1002a1e49","180":"instance--00c7f913-8a5c-5e23-a21a-23f0b21c0795","210":"instance--c181f118-448c-5e8f-b83c-d03f6d177344","240":"instance--394b4c0e-56d4-5d48-8d37-2f9f3d5ea7f4","270":"instance--d6c97d2a-eacc-5edb-a7c6-1c3f45f4d771","30":"instance--35925ec4-d6e9-58b5-bd90-5e5a63a45b28","300":"instance--547b5bdf-80a3-54cc-b689-2eb517bfe68a","330":"instance--52fc9239-c76d-586d-b11b-ce234424de7d","60":"instance--ba71b506-6338-5b09-9d9e-61f0f5a2c6b4","90":"instance--a64014df-1f09-5b50-b208-7d398753c7cd"},"id":"action","instance":"attack-action--29","properties":[["name","Access employee email accounts"],["description","Further, during at least one intrusion, the adversary specifically accessed email accounts of employees who work 