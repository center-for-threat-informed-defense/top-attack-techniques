1b","instance--f5161822-4fa1-5df5-9039-85523da39209","instance--77414a6f-10f0-5dbb-b428-351706ad11fd","instance--f9c9b265-fc34-5120-8a3d-f9bd8fbf0c0f","instance--92ee8792-942a-5a8c-9c2e-9bc59b33f65a","instance--d10e3bf2-a50f-5852-a99e-152c31cdbbe9","instance--cf5c3394-01b3-5b53-a717-bc5ac6298594","instance--3345d394-31f5-5c1e-ad3f-b0146f944331","instance--fb50a7d4-904c-5315-a7eb-e203e55230f8","instance--1871e873-c1ec-57fa-be71-be9bb4df8678","instance--14cfd234-c31e-588e-8568-67de9d5fdab5","instance--5edb8994-e296-52ca-acaf-2c59f41c9817","instance--af305316-e051-5c13-9fdd-827984f09e8d","instance--a16370d1-4f32-5492-80e2-1255980e5eb1","instance--e50a8fe1-abd4-5a55-955f-3ce62e4f786f","instance--223f646f-2049-59c0-9c41-1a6686da32dd","instance--03a46723-5271-5abc-85a3-2206cd087765","instance--d0f200db-7b2a-50a9-9430-330537193c08","instance--669e2d27-86a1-5407-b925-c3cfee206b81","instance--f8749702-9b9f-5b38-823c-d6fa4c80962d","instance--01314c3b-657d-5ac0-8538-cfd7538e62c9","instance--9c6a0153-19e8-5b98-9752-b3eba36be2a7","instance--7c309418-d384-5638-a0c9-76f97d159703","instance--e5a7e6ed-0d80-5f41-aa77-ac4e249b8325","instance--c71fe8f6-b49e-570c-8a02-f2815c4942b5","instance--886d86ad-b208-51ac-9b0c-9787e0fb0ba7","instance--c60a8365-dc47-55a4-aabc-ebb4f5c9470f","instance--3df441b6-1dcd-5d25-b855-b8e2d42eafa5","instance--7edcdb14-292d-57d2-bc9c-5479e17a3920","instance--7bea8aa9-57e0-5299-8ed8-cfe0dd60a23b","instance--c7c5802c-aee8-5af7-a11e-cf2ef7a5f0e8","instance--b85511ec-9b2e-5f42-ae91-ee6e2647c028","instance--beeba420-738d-5e9c-bd87-939aa9cb3119","instance--0b8bdbc8-7fa7-5a7d-9fcf-8f9fd1362303","instance--289a217c-019f-5b52-bd77-dccabe000122","instance--2b4fee8c-e3fe-5105-89f4-691c6e435094","instance--4ac716bd-ed25-541f-b7fc-138b9698d003","instance--e3c552fe-b6d6-56cc-b2b3-406ce0f4c758","instance--099d8ed6-5bec-534d-b03a-1da79e0c89c9","instance--2d91a4b8-f9af-5cab-84c4-937c2c945999","instance--8cb7b5b0-9070-5512-af02-83e631884616","instance--797f5f0c-1783-56b6-bb98-161cbc579521","instance--d32c8bbe-e6d3-529b-943b-9cb14e07033d","instance--a7468264-f6ac-586d-9258-63d635e2a374","instance--b8155d51-26d8-558c-bf64-2fa942ec194f"],"properties":[["name","Earth Preta spear-phishing campaign infection flow"],["description","We break down the cyberespionage activities of advanced persistent threat (APT) group Earth Preta, observed in large-scale attack deployments that began in March."],["scope","campaign"],["author",[["name","Nick Dai"]]],["external_references",[["item-1",[["source_name","www.trendmicro.com"],["url","https://www.trendmicro.com/en_us/research/22/k/earth-preta-spear-phishing-governments-worldwide.html"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Send spear-phishing emails"],["description","Earth Preta uses spear-phishing emails as its first step for intrusion. As aforementioned, some of the emails\u2019 subjects and contents discuss geopolitical topics, while others might contain sensational subjects. We observed that all the emails we analyzed had the Google Drive links embedded in them, which points to how users might be tricked into downloading the malicious archives."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.002"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Deliver malicious archives"],["description","The file types of the archives include compressed files such as .rar, .zip, and .jar, to name a few. Upon accessing the links, we learned that the archives contain the malware TONEINS, TONESHELL, and PUBLOAD malware families."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1204.002"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Abuse CC header to hide victims"],["description","Rather than add the victims\u2019 addresses to the email\u2019s \u201cTo\u201d header, the threat actors used fake emails. Meanwhile, the real victims' addresses were written in the \"CC\" header, likely to evade security analysis and slow down investigations."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1036"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Use compromised trusted senders"],["description","Moreover, we observed that some of the senders might be compromised email accounts from a specific organization. Victims might be convinced that these mails were sent from trusted partners, increasing the chances that recipients will select the malicious links."],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1586.002"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Sideload malicious DLL with legitimate executable"],["description","Inside the archive, the \" file is a lure document. The executable is a legitimate executable (originally named , which is the Adobe Licensing WF Helper). This executable will sideload the malicious and trigger the export function cef_api_hash."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1574.002"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Install PUBLOAD files in Public Pictures"],["description","When executed for the first time, the executable tries to install the malware by copying the .exe file and moving (detected by Trend Micro as Trojan.Win32.PUBLOAD) to <%PUBLIC%> Both .exe and .dll files will be renamed C:\\Users\\Public\\Pictures\\adobe_wf.exe and C:\\Users\\Public\\Pictures\\libcef.dll, respectively. Additionally, \" is renamed as 05-09-2022.docx and dropped to the Desktop."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1036.003"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Decompress archive via LNK and WinRAR"],["description","The threat actor utilizes the .lnk file to install the malicious files by decompressing the archive file with WinRAR. The full command line is as follows."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1204.001"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Sideload DLL and use schtasks"],["description","is masquerading as a normal executable; its original file name is . When it is executed, it sideloads and executes the main routine in its export function, CCefInterface::SubProcessMain. It also abuses schtasks for persistence."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1574.002"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Add registry run key"],["description","PUBLOAD creates a directory in < and drops all the malware, including the malicious DLL and the legitimate executable, into the directory. It then tries to establish persistence in one of the following ways:\n\n1.    Adding a registry run key"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.001"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Create scheduled task"],["description","PUBLOAD creates a directory in < and drops all the malware, including the malicious DLL and the legitimate executable, into the directory. It then tries to establish persistence in one of the following ways:\n\n2.    Creating a schedule task"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1053.005"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Invoke shellcode via callback APIs"],["description","PUBLOAD malware decrypts the shellcode in AES algorithm in memory. The shellcode is invoked by creating a thread or using different APIs. The APIs can accept an argument of a callback function, working as an alternative to trigger the shellcode. We observed several leveraged APIs including GrayStringW, EnumDateFormatsA, and LineDDA, and can be considered as a technique to bypass antivirus monitoring and detection."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1106"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Collect host identity for first beacon"],["description","The decrypted PUBLOAD shellcode collects the computer name and the username as the payload of the first beacon. The payload will then be encrypted with the predefined RC4 (Rivest Cipher 4) key."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1082"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Beacon with RC4 payload and magic header"],["description","After the encryption, the stager uses a specific byte sequence as its packet\u2019s header. It prepends the magic bytes \"17 03 03\" and the payload size before the encrypted data."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1071.001"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Execute downloaded payload from memory"],["description","The stager also checks if the response packet has the same magic header, \u201c17 03 03\u201d. If so, the downloaded payload in memory will be treated as a piece of shellcode and will be executed directly."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1620"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Copy TONEINS dropper files to Pictures"],["description","(detected by Trend Micro as Trojan.Win32.TONEINS) is an installer for the next-stage malware. It copies two files with names starting with in this case, and to <%USERPROFILE%\\Pictures>. Both files have fake file extensions and masquerade as the temporary files generated while opening Microsoft Office software."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1036"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Persist TONESHELL with schtasks"],["description","The installer establishes the persistence for TONESHELL backdoors by using the following command:"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1053.005"}]]},{"anchors":{"0":"instance--dbfe6415-cd2c-55f2-9509-06b6668ef23a","120":"instance--79ca45e2-afd7-51fa-9574-5085c7de4c84","150":"instance--39171cfe-3bf6-5200-b6f5-e97e3b047db7","180":"instance--8cda146b-7259-56b2-b337-56038a1f52d3","210":"instance--a662f8bf-2723-58c0-a1a8-9af9497cf428","240":"instance--a9b75b15-3be0-5e64-8132-40b87e7ae405","270":"instance--31896ecd-322b-5a41-bd1e-0b7a30b9d9d1","30":"instance--60868276-2726-597d-8f57-8aa7fc9c0738","300":"instance--4f5668fa-b6ef-57cc-93da-5cd1e1727a22","330":"instance--b022a562-9020-587c-a5be-97d254cc8f11","60":"instance--cf452b0f-192e-5357-ba8c-fbae1a6e4ae0","90":"instance--012cc6fc-0a37-5e6e-b9b7-07f3bcd2d02c"},"id":"action","instance":"attack-action--17","properties":[["name","Install sideload pair for TONESHELL"],["description","After persistence is established, TONESHELL then copies the legitimate executable and the malicious DLL to the folder, wherein both files have names that start with \u201c~\u201d in the lure archive. In this sample, is a legitimate executable used for DLL sideloading, and is the TONESHELL backdoor DLL to be installed."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1574.002"}]]},{"anchors":{"0":"instance--a73f63ad-1c10-59c2-82aa-bef4ae8f64e0","120":"instance--62757838-a58e-5d41-b7e3-1ccc64e8cdbf","150":"instance--3462202b-a91d-5325-abfe-876a63049484","180":"instance--72959cd4-5e05-5d69-a145-8b6f35720646","210":"instance--d3b85082-8de6-5ffd-8abe-c9e1ec43f533","240":"instance--0a22ffab-8bbc-55b1-85ec-df74e4a120f6","270":"instance--548b3ba1-955f-5e04-b6e8-064cc259e7a6","30":"instance--6f0a37c5-db81-5459-92c1-bc8ab8cd1fd3","300":"instance--e81be898-f7c2-56a0-a705-d2aba8831f75","330":"instance--8f207ed6-cb63-551c-9a40-583fac14fe80","60":"instance--8b44546f-f8e4-5d12-b172-99f9507395eb","90":"instance--f61db455-1665-504d-85b4-5fd5d40fbcc2"},"id":"action","instance":"attack-action--18","properties":[["name","Trigger code with custom exception handler"],["description","In order to make sure that the TONESHELL is installed correctly, Backdoor.Win32.TONESHELL first checks if the process path matches the expected one. If so, the malicious code could be triggered by the custom exception handler."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1036"}]]},{"anchors":{"0":"instance--223a73a7-07a6-5688-bc70-e7fbf2c8afd4","120":"instance--2184e59f-b6bd-5ca7-8254-3872e152a964","150":"instance--eed82efc-7573-5ccf-97d8-e3f88a2337bb","180":"instance--453ded0c-8246-59f2-a14f-beca9e751cd6","210":"instance--143e4619-312d-5cbc-acc5-efed5f6c0164","240":"instance--659cf4a8-ca80-5204-8b8d-3240f6f370da","270":"instance--2dac3e32-a8df-582e-845a-3a7b1d510c1d","30":"instance--6ab42faa-5ba5-5c44-b387-40b1d021e500","300":"instance--96e5ad82-e4af-5995-8b69-6df7d7ce2490","330":"instance--a960fdd4-4889-5426-a406-4761d11be5ab","60":"instance--42df375f-d3e2-5d47-9faa-324aecbbf064","90":"instance--51395417-94d2-5b5a-881c-7b6cc63ade4e"},"id":"action","instance":"attack-action--19","properties":[["name","Hide execution flow with exception handlers"],["description","Interestingly, the adversary hides the actual code flow with the implementation of custom exception handlers. Different exception handlers will be invoked based on the result of the process name check, continuing the malicious routine by triggering the exception with the call . After it is invoked, the C++ runtime will find the corresponding exception handler from the structure all the way down to the member in the structure, which contains the real malicious codes. In this sample, the exception handler is located at the offset 0x10005300. This technique not only hides the execution flow but also stops the execution of the analyst's debugger."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1027"}]]},{"anchors":{"0":"instance--25dacfeb-3a3d-51fc-91b7-64ee405fe041","120":"instance--5a984174-ce49-510d-b6b6-d4f0e0ee332f","150":"instance--f2167f56-1cf9-5fea-a726-d003a591d391","180":"instance--70c47af3-1817-5ae2-9f6e-38421d85f808","210":"instance--cfd506cd-f673-5f4f-a5ff-5854ad8a39d5","240":"instance--b78e4cb3-2b2b-5706-8d59-d252dd134505","270":"instance--73410cfd-8533-5545-94b7-c06859fcd4a8","30":"instance--760fe684-ea1e-52a0-87e8-fa0bc5d62d70","300":"instance--fa30f213-64f3-55b5-85cd-9dbf46e0e8dc","330":"instance--0dbe5c9b-c2db-5139-a300-8054f3a8e205","60":"instance--a78137f8-a78e-563e-ad44-749594629166","90":"instance--626b6c26-479d-5895-a619-ee3dbb14136d"},"id":"action","instance":"attack-action--20","properties":[["name","Delay execution until foreground window switches"],["description","Looking at more recent TONESHELL samples, we noticed that a new anti-sandbox technique is added compared to the earlier versions. The newer versions invoke the GetForegroundWindow API twice and check if there is any window switch. If the environment is a sandbox, both calls will get the same window handle because there is no human interaction involved in most sandboxes, resulting in the foreground window not changing. In addition, as an anti-sandbox and delayed execution technique, the malicious routine can only be triggered if the foreground window has already been switched for the fifth time."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1497.001"}]]},{"anchors":{"0":"instance--93ee4f51-8321-58fb-b05f-3a6fd3a6a8ab","120":"instance--02ee2d77-fc8c-55cc-8958-e3d0b5ead581","150":"instance--15aaf9f3-3996-5f9b-bee4-47f2963a0df4","180":"instance--1ae13e0a-be4e-5658-ba6d-c941c0d5cafb","210":"instance--87590098-5adb-5af7-aa75-039447d58b2b","240":"instance--87dee187-bf66-5b52-81e0-15b789ab6a7c","270":"instance--25c474c1-a795-5124-95ce-3e6163b067d2","30":"instance--ae371f09-8eae-53a7-a14c-34f9e72904fd","300":"instance--9ecc9c80-603d-5760-b2b6-f850dfd3eddf","330":"instance--b9543d3c-a7f9-50a6-b8a1-3fd4c6dddd56","60":"instance--cba1b44c-d7c9-5ebb-8433-b63b0b91427c","90":"instance--1c5f2ea2-c075-51ba-9f13-69b716c352cf"},"id":"action","instance":"attack-action--21","properties":[["name","Decode TONESHELL shellcode in memory"],["description","After the malicious exception handler is triggered, it starts to decode the next-stage TONESHELL shellcode. To decode the shellcode, it first decodes a 32-byte key in XOR operations with 0x7D, and the key will then be used to decode the shellcode body."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1140"}]]},{"anchors":{"0":"instance--da12a10e-e9d8-58e0-9dda-e871f0fcaf7c","120":"instance--6e98f91f-940c-5b7d-8e4e-950f2c88b044","150":"instance--02b3e90f-a9f8-5908-b936-c779b2c570d8","180":"instance--5c256240-99ff-5907-aca7-0f81639a7419","210":"instance--e42c995a-6770-583f-9a60-afcdf41d5501","240":"instance--eee0e52c-22be-5b9b-819e-097b65b643d8","270":"instance--d4973194-aaba-5ce5-99ba-7d7c8bca7b50","30":"instance--91b449e9-d343-56d1-9376-8a2655b8032b","300":"instance--23579e20-df5a-5dad-9088-26b612c3c5aa","330":"instance--2ed64056-576c-519d-b8c7-4e1f2c06b6e9","60":"instance--c59d1168-f011-5687-803d-27aa797d72e2","90":"instance--321449b3-3e1e-5b4b-aab6-507e5ad1c36c"},"id":"action","instance":"attack-action--22","properties":[["name","Generate victim ID"],["description","TONESHELL supports up to 10 C&C servers by design, but in all the samples we encountered only one C&C server was used. Before connecting to the C&C server, it generates a victim ID (the variable ) with the victim's volume serial and the computer name, or with a randomly generated GUID."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1082"}]]},{"anchors":{"0":"instance--9f68185c-8d0f-5e34-b869-da9c17407e5d","120":"instance--99f65057-0748-5b22-b7a8-859b8cb9d46c","150":"instance--1c6c577b-3682-579f-9d80-c1a4c9632dd5","180":"instance--0372a821-a640-58c2-a8f9-f391b8fb0045","210":"instance--bd12903c-f92d-5416-a20f-eedd38d108f9","240":"instance--a221d4df-2c16-5e25-a121-f7cfbb303fb7","270":"instance--550d9be5-209a-50fa-99b8-4dfe7669b693","30":"instance--042db59c-d5d0-5002-ac74-85e947cc6579","300":"instance--2ce3cd55-fc34-5aac-8112-e6cc8fcd707a","330":"instance--55903f51-17c6-554e-8180-6f2511efa2b6","60":"instance--2b4af278-cf58-556d-9fa5-254ca76fcb98","90":"instance--a84c2c43-a2a5-5904-906d-da6a186887bd"},"id":"action","instance":"attack-action--23","properties":[["name","Collect system and process data"],["description","In the first beacon, it collects the following data from the victim's machine and sends them to the C&C server:\n\nCurrent process ID\n\nVolume serial\n\nUsername\n\nComputer name\n\nProduct name\n\nOperating system bit\n\nProcesses list"],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1057"}]]},{"anchors":{"0":"instance--08881caf-1468-53e2-baa3-c9da43e73b47","120":"instance--5344d679-b2e1-5528-bed5-6fe3fbc90036","150":"instance--f1a3ca80-d761-5917-981a-9d35e6a5161e","180":"instance--bb22e51a-29ce-531e-b80e-4a1d5343b453","210":"instance--380340c8-8f15-5075-a390-ac1b2706e43f","240":"instance--b8ca794c-8bea-5f4c-a746-ad3b31fd2d36","270":"instance--fb5c8b1f-7cc5-58a3-a457-0edfdefa168c","30":"instance--a124cc0a-728c-5b30-8b8b-2171584014e7","300":"instance--7d09cfe0-ac57-5093-a7ce-7c31042d3449","330":"instance--829e634f-5069-5370-8381-e0687a22b00e","60":"instance--0fbffc26-a516-5fcd-9fff-e9aee12c6467","90":"instance--96917b9c-4649-5345-82ac-b4e793881bfe"},"id":"action","instance":"attack-action--24","properties":[["name","Communicate over raw TCP with RC4"],["description","TONESHELL communicates over raw TCP, with the request header and the response header starting with the specific magic byte sequence \"17 03 03\". Based on our research, this magic header is used in all TONESHELL TCP variants and the identified PUBLOAD malware. The payload in the packet will be encrypted in RC4 algorithm."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1095"}]]},{"anchors":{"0":"instance--6e9515e3-2497-5444-80ce-9466679d2504","120":"instance--25d30ffe-4a4f-53ec-a34d-de6cc58a2fb0","150":"instance--43abd457-ad7e-5db6-b146-d159a2936c52","180":"instance--f22410a7-1bbd-5943-9121-cf9edb5a0991","210":"instance--4a2a2f86-5543-5514-866c-4d5f4f5bcb3b","240":"instance--f2011b06-5138-5056-a1f2-0a96e9738966","270":"instance--a9d1b1c1-44f0-5281-b6b0-9133e0a433dd","30":"instance--c9339355-ad0b-5e98-9f42-ef0c11d380dd","300":"instance--dec744bc-b6ae-5258-bcb1-83f01a7bb747","330":"instance--54f63fd7-f831-5401-a04f-600f5e780c31","60":"instance--1dd30294-3434-540a-8b5f-d8bc1e3de794","90":"instance--e414165a-d829-5c22-ab74-6aa5e50c83d3"},"id":"action","instance":"attack-action--25","properties":[["name","Support file transfer execution and lateral movement"],["description","The backdoor supports various functions, including file upload, file download, file execution, and lateral movement."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1210"}]]},{"anchors":{"0":"instance--ce3f20b8-daf0-5682-a74a-dd9eb1251abb","120":"instance--08418575-7199-5323-8082-8e1d88a1ec11","150":"instance--15627176-59a5-5797-816e-a6cab3ea9da9","180":"instance--242a8d77-274b-5d18-ba35-771f6e0de836","210":"instance--d01bb126-419a-5d3b-a9cf-7b8df1d59112","240":"instance--0b76a14d-f362-5d5a-995f-2e318539789f","270":"instance--d534a23c-ea17-5a19-96f9-740e77b559a2","30":"instance--9b134899-2cf4-5fcd-9412-5363985ac68c","300":"instance--1bb6a59f-c750-5aca-a7c7-cecaf9c9f1f7","330":"instance--a346b253-e85b-53ff-8e33-33aaa8c928da","60":"instance--0c9baf75-2ba0-51ff-b084-c1044ff899fa","90":"instance--b86b5b84-3a18-51f2-b888-17161b8c5d47"},"id":"action","instance":"attack-action--26","properties":[["name","Use HTTP POST beacon variant"],["description","Our analysis showed it works similar to the two different variants, but the C&C protocol used is HTTP. It seems to be the earlier version of TONESHELL because the sample was uploaded in September 2021, and uses the POST method for the first beacon."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1071.001"}]]},{"anchors":{"0":"instance--804d7975-bdc1-5371-a95e-4cff0aa0b8b1","120":"instance--aab4410b-5835-54c6-bc0f-d93b86440850","150":"instance--ad5c3f2a-3c32-5af5-9b9c-489a81eead21","180":"instance--3ff51605-dadf-546e-a273-07184c6549e2","210":"instance--9337c97e-ad0d-5d35-8b01-21c1e3f80296","240":"instance--49c4f7e6-8fe8-5919-bda8-039a2aaf3a61","270":"instance--4e395b92-9587-53cc-a957-cad25cc53df8","30":"instance--b917f3cb-7197-5ba7-8a3e-cbfda092d01a","300":"instance--ab650c26-b6f9-59ed-b26e-6f6ca03758dd","330":"instance--36c16e65-d9d7-519a-a8ae-a6dd521ddceb","60":"instance--0b7fc2fd-f6ca-532d-9f2b-ca34c65a881a","90":"instance--ff765750-9ba6-53a3-b366-8a863df1a603"},"id":"action","instance":"attack-action--27","properties":[["name","Parse LNK metadata for C2 string"],["description","We used the tool to parse the shortcut files wherein we found the specific C&C string inside the metadata of the .lnk file. It seems that the actor used the C&C string as the folder name."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1027.013"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","The stager also checks if the response packet has the same magic header, \u201c17 03 03\u201d. If so, the downloaded payload in memory will be treated as a piece of shellcode and will be executed directly."]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","In order to make sure that the TONESHELL is installed correctly, Backdoor.Win32.TONESHELL first checks if the process path matches the expected one. If so, the malicious code could be triggered by the custom exception handler."]]},{"anchors":{"0":"instance--36aad375-d405-5e3b-9a7d-4346c75c9f45","120":"instance--acc72955-e581-59b3-80b5-35fb047df4b8","150":"instance--d5d0ec7c-da1b-5d39-86e4-8de8792ab05d","180":"instance--047e7862-d9c4-5716-b778-899a86595b48","210":"instance--650a6d3c-5cb0-5f82-83ec-c5d828e2502b","240":"instance--3f08654d-fd5e-59cb-af47-8bbcee29de39","270":"instance--e175549d-38ff-5527-bdb8-de5e1a12f356","30":"instance--c6e60459-b005-50cd-9e68-66ef210b5456","300":"instance--f90b34f0-8620-5a56-9e11-4db2b889aac4","330":"instance--93872aee-cf81-52fa-aa93-f7a84a833dbd","60":"instance--5a877a06-3649-5bba-9461-5faee75ea842","90":"instance--68af6616-0e27-5395-b4ff-5d95b55a2405"},"id":"OR_operator","instance":"attack-operator--1","properties":[["operator","OR"]]},{"anchors":{"0":"instance--8113e3b2-72b3-54a5-849a-17461de90329","120":"instance--7dbc17c8-0cb5-555f-a869-1bb53697b9e6","150":"instance--a1c28d64-2581-5f20-b665-c8276f615040","180":"instance--d0321cd4-0976-59bb-afcb-37c5fc7e6539","210":"instance--5f8136e1-df4d-5f80-b36e-abdc6a59b734","240":"instance--55949c39-6c41-5914-8d70-86867b82e947","270":"instance--674e8bb4-4ba1-5b7a-8d5f-3bdb0d4177c4","30":"instance--2eba8347-09fa-5ae7-896a-40ae64726a90","300":"instance--aaa84a40-eebd-56b7-b4a5-5134df1c3661","330":"instance--e689951a-9a2b-5294-8a03-1739e1d4c565","60":"instance--7ff87bcf-ac32-5f28-a82b-025378cea8fe","90":"instance--dd1c5f79-1848-5353-9ce5-8e7eef5355e2"},"id":"email_message","instance":"instance--8aca34c5-865f-57db-989b-288c58f57508","properties":[["is_multipart","false"],["subject","empty or same name as the malicious archive"],["value","spear-phishing email with embedded Google Drive links"],["evidence",[["item-1",{"excerpt":"We analyzed the contents of the emails and observed that a Google Drive link is used as a lure for victims. The email's subject might be empty or might have the same name as the malicious archive.","source":"https://www.trendmicro.com/en_us/research/22/k/earth-preta-spear-phishing-governments-worldwide.html","source_field":"normalized_text"}]]],["display_name","spear-phishing email with embedded Google Drive links"],["diagram_instance","instance--8aca34c5-865f-57db-989b-288c58f57508"]]},{"anchors":{"0":"instance--c2e84d8b-5164-58c2-9526-5d9d9d6f8872","120":"instance--af5c0c72-1f78-51b9-b888-1250a72e1fca","150":"instance--07b79917-15e4-5f09-a207-d6f6152473e0","180":"instance--d05c509a-2080-5c66-b004-314696535967","210":"instance--ec78c273-5dc9-521e-82ca-c99e22fd2dfd","240":"instance--09e6b23b-983e-5ca8-a8a9-931fc6216b82","270":"instance--9e22dc2c-a31a-5d2b-84c9-f5e2abf6350b","30":"instance--bd8dfcfd-57e3-5a3c-9235-52fb080a08dc","300":"instance--8e4c8523-3ca6-553d-8710-b2ebe