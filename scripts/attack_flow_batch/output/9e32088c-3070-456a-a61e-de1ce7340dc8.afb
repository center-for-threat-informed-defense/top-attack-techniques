{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","attack-action--13","attack-action--14","attack-action--15","attack-action--16","attack-action--17","attack-action--18","attack-action--19","attack-action--20","attack-action--21","attack-condition--1","attack-condition--2","attack-condition--3","attack-condition--4","attack-operator--1","instance--763adce8-107c-58c1-9b65-18fefd501b17","software--2","instance--7797ff9e-6685-5e18-adfb-c4d44716e06f","software--3","software--4","software--5","software--6","ipv4-addr--1","instance--ad1f125b-7701-5e9d-b869-79f40471648d","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--408fcf50-c66e-54f0-b4d4-69a7035e4a2c","instance--d10376f5-8e18-5fa1-93e0-8fa9e55f61b1","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--56b40d44-cc57-5e8b-b320-779a685089fd","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--be99ba49-e121-58a8-ba7b-dd3de316cfcf","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--c075f5c6-95e8-5553-8f7e-b432b96021c7","instance--dffaba49-2754-58f6-a1bf-b0400cce1d3b","instance--3e0f78a3-bb54-55bd-8490-3453d5e06d04","instance--a37796a0-93b2-51bb-be4b-2a9a9e7e35e1","instance--cb7da505-6791-507a-9a93-f9914c292d1b","instance--f9e616ac-2310-573d-8995-336b82cf51af","instance--473cf3d0-f63c-527e-8d8b-5e70328924e7","instance--f9c9b265-fc34-5120-8a3d-f9bd8fbf0c0f","instance--92ee8792-942a-5a8c-9c2e-9bc59b33f65a","instance--56da8838-1109-5fce-9d89-7b3ec32d7010","instance--88f25f85-b4d1-57cb-9c54-8afff5236c3b","instance--bd38b278-6c87-5734-8784-1403cc216532","instance--7118061f-3f91-5c60-ae9f-b9ce1c38cb78","instance--d110b130-8c28-