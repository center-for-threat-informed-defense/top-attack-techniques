{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","attack-action--13","attack-action--14","attack-action--15","attack-action--16","attack-action--17","attack-condition--1","file--ppsatv-doc","instance--b0545f07-0955-578a-9b02-5b0f9582d2d1","instance--65e2a5f0-6045-5967-9f7a-64935623d861","instance--d0b82d82-9e47-5b8b-9d22-bde0fb6c432f","instance--018aebce-46ff-557e-81fe-7a9282475565","instance--3b4fcb4d-f0c1-58ba-9c2b-bcd5654a6cb3","directory--temp-subfolder","instance--61f56ccd-0aa7-559d-920b-d423f39fe8aa","instance--925a02fb-ee88-5f57-8af3-f8e006fa8380","windows-registry-key--startup","instance--f7d60068-d486-50f2-b569-f155e1cdd4f0","instance--72271a67-207d-5c34-b896-e1c1ff8ceb61","instance--9d2753c5-97b9-5935-9b59-6b528ccdaa47","instance--dc93c6f5-7758-5c3a-8cb0-0c68dd14ceec","software--mscorjit-dll","software--clrjit-dll","instance--bf688d8f-2c53-562b-9fa3-107f87d5b4bf","instance--53250e47-3c32-5361-ae73-2af566204d83","instance--a85ed366-0002-58dc-acbd-f635e2538d8b","software--dotnet","email-message--smtp-subjects","email-message--passwords-recovered","network-traffic--smtp-587","email-address--zoho-account","domain-name--zoho","file--player-daemon","instance--ea73f49d-fb91-595f-9563-11b20df5ab40","instance--9c431538-4fd0-55ca-aed0-0165da5f1aeb","instance--ba584080-0c3d-5e01-9d7e-8b6d42a5c13a","instance--d9f43a84-9b3a-58c8-ac5a-5170bb96a942","instance--3536a568-610f-5570-bba9-6dfe97bc9c2e","instance--384798bd-a84b-5feb-8d38-7f9d0a087f11","instance--ed6039fe-678b-5ae9-9576-73e6ea35b0c8","instance--7e8c9301-c3f8-55e9-8894-e81f1b6203d9","instance--b6d82c28-0a68-5c6f-b058-c1e072f51852","instance--3622ace1-abf1-5f6e-a5de-a6f584dc1f66","instance--d7b0d86e-7a37-55a1-a793-a32a114ba4f3","instance--895aab9a-87c3-51d8-91f8-cc3f6dd1a5a5","instance--3bb881aa-a5ab-51ba-b53d-89d26964ce7d","instance--be99ba49-e121-58a8-ba7b-dd3de316cfcf","instance--57bd700a-faa2-5f72-95f2-2694bcea17c9","instance--c075f5c6-95e8-5553-8f7e-b432b96021c7","instance--3b404379-7d7e-5278-b499-6ac12ee4e90f","instance--3e0f78a3-bb54-55bd-8490-3453d5e06d04","instance--a37796a0-93b2-51bb-be4b-2a9a9e7e35e1","instance--cb7da505-6791-507a-9a93-f9914c292d1b","instance--1ab38c9d-8f20-58a2-96be-f667e7766879","instance--8d8ba569-63ad-51ac-88ac-c00c91b4a708","instance--57b238c0-ee9d-58d5-be45-ff6ecc48d411","instance--d9557e50-b805-580f-bfa5-b67d4a8aa583","instance--c4da7e73-8ab8-5ac0-9180-dda8a9c568c4","instance--4ffd4f11-be5f-5d19-9c73-d317323c24e3","instance--ea779a5c-b0db-51d9-875b-23e5e1be617f","instance--ed0b8bf4-adb0-5eef-ae9e-b5a58b044466","instance--34bb8ab8-16e7-57ef-a3c8-ee768d4c7a83","instance--15be6c9c-dc0c-550e-b22a-c899d9c1c100","instance--5e21e85e-0a5b-5968-859b-f9b8482c1f3b","instance--a234fe91-1c5d-5b8b-b566-88e9dd840b75","instance--9586c45d-9c88-5b3c-a49e-ea0f90e8f13a","instance--61147190-0030-5abb-917f-be2bfa0e3741","instance--65d980f4-d8be-537e-969e-de7012feeea0","instance--0b574a89-e5a5-5d51-a7c4-2bf6cfadc657","instance--91e42de8-e125-5293-a85f-ed5c1efb58e1","instance--62bb9c55-6cac-554f-aa4f-de12a4e8ea91","instance--b1edd360-6d1d-5e3b-8e17-ede92176414f","instance--e4b3ef4b-7604-5981-bd2d-28a08578c7bb","instance--209461b4-dd58-57d0-a805-20a67d45ac02","instance--1873e82c-82b5-57c2-baf6-46d808cb7dbc","instance--1354e165-4c2d-5af5-853d-7983b1dfab8a","instance--5a411abc-366a-5c97-9ee6-df47f0ac98d9","instance--d0efa2b5-599f-5ded-b079-73f1eb03f2f5","instance--c5a40a65-36c3-5c2f-8db7-f65b6ac4db98","instance--1ba7478f-1f36-513a-bf67-06081a620f4d","instance--d311edbd-153b-5dd7-a005-3ca51c964211","instance--ec2aad9b-a058-523c-8bd1-69a321826df6","instance--b818f23f-14a0-5ebe-8783-b1d9a27e3127","instance--796953c8-2790-5afe-85ed-89b1345f90e4"],"properties":[["name","Analysis of New Agent Tesla Spyware Variant"],["description","FortiGuard Labs captured a new malware sample that was spread via Microsoft Word documents and analyzed a new variant of the Agent Tesla spyware."],["scope","campaign"],["author",[["name","FortiGuard Labs Threat Research"]]],["external_references",[["item-1",[["source_name","www.fortinet.com"],["url","https://www.fortinet.com/blog/threat-research/analysis-of-new-agent-tesla-spyware-variant.html"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Deliver malicious Word document"],["description","This malware was spread via a Microsoft Word document that contained an embedded exe file."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.001"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Execute embedded executable"],["description","As you can see, it asks the victim to double click the blue icon to enable a \u201cclear view.\u201d Once clicked, it extracts an exe file from the embedded object into the system\u2019s temporary folder and runs it.  In this case, the exe file is called \u201cPOM.exe\u201d."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1204.002"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Drop installer payload files"],["description","When it runs, it drops two files: \u201cfilename.exe\u201d and \u201cfilename.vbs\u201d into the \u201c%temp%\\subfolder\u201d. It then exits the process after executing the file \u201cfilename.vbs\u201d."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1036"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Execute VBS script"],["description","It then exits the process after executing the file \u201cfilename.vbs\u201d."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.005"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Add startup registry entry"],["description","To make it run automatically when the system starts, it adds itself (runs filename.vbs) to the system registry as a startup program."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.001"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Run filename executable"],["description","It then runs \u201c%temp%\\filename.exe\u201d."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1204.002"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Process hollow child process"],["description","When \u201cfilename.exe\u201d starts, like most other malware it creates a suspended child process with the same name to protect itself. It then extracts a new PE file from its resource to overwrite the child process memory. Afterwards, it resumes the execution of the child process. This is when it executes the code of that new PE file, which is the main part of this malware."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1055.012"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Check profiling environment and JIT modules"],["description","It first checks to see if the environment value of \"Cor_Enable_Profiling\" is set to 1, and if the modules \"mscorjit.dll\" and \"clrjit.dll\" have been loaded (see figure 6). If one of these checks is true, it exits the process without doing anything."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1497.001"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Load encrypted resource"],["description","If the process doesn\u2019t exit, it loads a named resource. The resource name is \"__\", which is a string decrypted from a local variable.  Afterwards, by calling the API functions \u201cFindResource\u201d and \u201cLoadResource\u201d, it can read the resource data to the process memory. Figure 7 shows the \u201c__\u201d resource in CFF Explorer. For sure, the data is encrypted."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1027"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Decrypt and load .NET PE in memory"],["description","By decrypting the \u201c__\u201d data, we obtain another PE file, which is a .Net framework program. This is to be loaded into the child process memory. It reads sections of the .Net program into memory according to the PE file headers, imports APIs defined in the import table for .Net programs, relocates offset of the function \u201c_CorExeMain\u201d, as well as builds the .Net framework running environment by calling several APIs. Finally, it jumps to the entry point of the .Net program where it later jumps to \u201c_CorExeMain\u201d \u2013 which is the entry point of all .Net programs \u2013 to execute this .Net program."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1620"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Sleep 15 seconds"],["description","When the main function is called, it first pauses 15 seconds by calling \u201cThread::Sleep()\u201d function. This allows it to potentially bypass sandbox detection."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1497.003"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Collect victim data"],["description","As my analysis in the showed, Agent Tesla is a spyware. It monitors and collects the victim\u2019s keyboard inputs, system clipboard, screen shots of the victim\u2019s screen, as well as collects credentials of a variety of installed software. To do that it creates many different threads and timer functions in the main function."],["confidence",0.0],["ttp",{"tactic":"TA0009","technique":"T1056.001"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Exfiltrate data via SMTPS"],["description","However, the way of submitting data to the C&C server has changed. It used to use HTTP POST to send the collected data. In this variant, it uses SMTPS to send the collected data to the attacker\u2019s email box.\n\nBased on my analysis, the commands used in the SMTP method include \u201cPasswords Recovered\u201d, \u201cScreen Capture\u201d, and \u201cKeystrokes\u201d, etc.  The commands are identified within the email\u2019s \u201cSubject\u201d field."],["confidence",0.0],["ttp",{"tactic":"TA0010","technique":"T1020"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Send credentials over SSL SMTP port 587"],["description","Here\u2019s an example to show you how it sends the collected credential data to the attacker\u2019s email address. Figure 10 shows the email content that will be sent out with my PC information along with the collected credentials. It enables an SSL function and uses TCP port 587. The \u201cBody\u201d field is the collected data in HTML format. The \u201cSubject\u201d field contains the command \u201cPasswords Recovered\" which tells the recipient that this email contains credentials."],["confidence",0.0],["ttp",{"tactic":"TA0010","technique":"T1048.003"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Authenticate to Zoho SMTP account"],["description","The attacker registered a free zoho email account for this campaign to receive victims\u2019 credentials. Figure 11, below, shows the SMTP server and its login information. You can see the attacker\u2019s SMTP credential \u201cUserName\u201d and \u201cPassword\u201d as well as the SMTP server."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1585.002"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Drop and run daemon watchdog"],["description","It also drops a daemon program from the .Net program\u2019s resource named \u201cPlayer\u201d into the \u201c%temp%\u201d folder and run it up to protect \u201cfilename.exe\u201d from being killed."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1543"}]]},{"anchors":{"0":"instance--dbfe6415-cd2c-55f2-9509-06b6668ef23a","120":"instance--79ca45e2-afd7-51fa-9574-5085c7de4c84","150":"instance--39171cfe-3bf6-5200-b6f5-e97e3b047db7","180":"instance--8cda146b-7259-56b2-b337-56038a1f52d3","210":"instance--a662f8bf-2723-58c0-a1a8-9af9497cf428","240":"instance--a9b75b15-3be0-5e64-8132-40b87e7ae405","270":"instance--31896ecd-322b-5a41-bd1e-0b7a30b9d9d1","30":"instance--60868276-2726-597d-8f57-8aa7fc9c0738","300":"instance--4f5668fa-b6ef-57cc-93da-5cd1e1727a22","330":"instance--b022a562-9020-587c-a5be-97d254cc8f11","60":"instance--cf452b0f-192e-5357-ba8c-fbae1a6e4ae0","90":"instance--012cc6fc-0a37-5e6e-b9b7-07f3bcd2d02c"},"id":"action","instance":"attack-action--17","properties":[["name","Monitor and relaunch filename.exe"],["description","You can see that the main function receives a command line argument (for this sample, it\u2019s the full path to \u201cfilename.exe\u201d.) and saves it to a string variable called \u201cfilePath\u201d. It creates a thread, and in the thread function it checks to see if the file \u201cfilename.exe\u201d is running in each 900 millisecond. It runs it again whenever the \u201cfilename.exe\u201d is killed."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1543"}]]},{"anchors":{"0":"instance--35652c79-2c41-5d60-81ba-b5e47aa554bf","120":"instance--53906203-fffb-5af3-b112-44a9b4b49b8f","150":"instance--465fbc8a-7b4c-569f-be00-c0fbc137fcfc","180":"instance--a653c96b-3673-5dfa-968e-188fffe4cc04","210":"instance--6a344cf5-bd5c-52db-84f5-23c7701c7a5e","30":"instance--913561d1-b5f3-54d2-8272-159233dfde54","330":"instance--d59fe52d-c897-5f3a-919a-c2273cb8a8b3","60":"instance--f1fd6a3d-bb83-543d-a379-39d4632978f7","90":"instance--4cd6fce2-0d24-57f0-b161-12a867cd1100","branch:False":"instance--f7e897b3-3607-5ea5-8d15-5f83ba8a60da","branch:True":"instance--39b5ac19-b0dd-5674-a7d9-d75e659fe9ea"},"id":"condition","instance":"attack-condition--1","properties":[["description","If one of these checks is true, it exits the process without doing anything."]]},{"anchors":{"0":"instance--465e60f6-01b5-57d7-bd19-5bad491f2530","120":"instance--c0db63c2-7ef7-5fc1-95b7-87caf4469ba6","150":"instance--3d04eb3b-4cdb-562d-9e5b-10deb47215f6","180":"instance--c323fcf4-4be9-570d-ba4f-f7ec7b3d05da","210":"instance--fcafcfc1-957c-5727-9e44-22553db634b5","240":"instance--7a780331-9f16-50b6-af63-037c1e039028","270":"instance--3f182af1-6cab-5815-975c-36e15cef9bb1","30":"instance--1f7ff7d6-7675-5cc8-a3be-83a516e37500","300":"instance--921e7b14-a71d-5df6-8673-b3482e8e600d","330":"instance--d3416669-57a3-554b-81ec-4c6b00bbcf1e","60":"instance--ecb89f55-7d3c-5dad-8a30-7ab5a1c13415","90":"instance--31359a6c-e519-5840-b93e-57667d44483f"},"id":"file","instance":"file--ppsatv-doc","properties":[["value","PPSATV.doc"],["evidence",[["item-1",{"citation":null,"excerpt":"PPSATV.doc","source":"https://www.fortinet.com/blog/threat-research/analysis-of-new-agent-tesla-spyware-variant.html","source_field":"normalized_text","source_object_id":null}]]],["display_name","PPSATV.doc"],["name","PPSATV.doc"]]},{"anchors":{"0":"instance--7177d5cf-7520-5bac-bfb5-5c2551182570","120":"instance--6dd7a030-c3a5-5009-b3dc-3cfc64048404","150":"instance--4045afba-78a0-5733-b73a-4928ae91ff6e","180":"instance--5e2b84ae-c57c-5170-931d-ba72ffb377fc","210":"instance--7d19ca01-f989-5173-9cf6-ae3712f3121c","240":"instance--2405b097-b85e-5b96-9408-adfd7503154c","270":"instance--f2b3f27b-dedd-5eac-b232-17d665b2de4f","30":"instance--2b1de95e-a0e3-5d48-b42b-40aa330e13d3","300":"instance--36131277-7a89-506f-a426-252155c0d180","330":"instance--9681316c-b782-5c91-a327-d5d1f4d31450","60":"instance--7559d037-e71b-57d4-9c6c-f00757e16c45","90":"instance--940fd85b-89b4-5ebb-a181-8bb920bec54b"},"id":"file","instance":"instance--b0545f07-0955-578a-9b02-5b0f9582d2d1","properties":[["value","POM.exe"],["evidence",[["item-1",{"citation":null,"excerpt":"In this case, the exe file is called \u201cPOM.exe\u201d.","source":"https://www.fortinet.com/blog/threat-research/analysis-of-new-agent-tesla-spyware-variant.html","source_field":"normalized_text","source_object_id":null}]]],["display_name","POM.exe"],["name","POM.exe"],["diagram_instance","instance--b0545f07-0955-578a-9b02-5b0f9582d2d1"]]},{"anchors":{"0":"instance--6ab52065-9fe6-5202-8bce-cc257d095be1","120":"instance--c1d15471-656e-5282-9a87-cfac8cc26bd1","150":"instance--a090225a-a834-5fcf-b694-362bf4ec28ca","180":"instance--57643378-f88f-5f58-97ba-62bcf9b48425","210":"instance--34fe81f2-fbb2-5920-a4bf-f3acc266d3dd","240":"instance--522acf4d-096f-56e7-ae2d-3383ef84232a","270":"instance--2e68a1a9-b74f-5a4a-ad8e-bfdc584a27dd","30":"instance--f4c2655b-98d3-5e8a-a66d-e6a0f3f4019e","300":"instance--bb9d5bfe-3b0a-5f87-83aa-64b65b8c4b9c","330":"instance--cc68d477-3f3e-5894-b0ad-592df30e44a1","60":"instance--745aae86-31c8-5eac-8de3-a89adf9c8a35","90":"instance--4584ffa4-e54c-5f94-ae5d-09069cd45ef4"},"id":"file","instance":"instance--65e2a5f0-6045-5967-9f7a-64935623d861","properties":[["value","POM.exe"],["evidence",[["item-1",{"citation":null,"excerpt":"In this case, the exe file is called \u201cPOM.exe\u201d.","source":"https://www.fortinet.com/blog/threat-research/analysis-of-new-agent-tesla-spyware-variant.html","source_field":"normalized_text","source_object_id":null}]]],["display_name","POM.exe"],["name","POM.exe"],["diagram_instance","instance--65e2a5f0-6045-5967-9f7a-64935623d861"]]},{"anchors":{"0":"instance--