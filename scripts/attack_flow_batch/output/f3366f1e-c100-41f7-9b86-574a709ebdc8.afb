{"objects":[{"id":"flow","instance":"instance--b96dad5f-c519-5a1f-a718-912ca4a86c02","objects":["attack-action--1","attack-action--2","attack-action--3","attack-action--4","attack-action--5","attack-action--6","attack-action--7","attack-action--8","attack-action--9","attack-action--10","attack-action--11","attack-action--12","attack-action--13","attack-action--14","attack-action--15","attack-action--16","attack-action--17","attack-action--18","attack-action--19","attack-action--20","attack-action--21","attack-action--22","attack-action--23","attack-action--24","attack-condition--1","attack-condition--2","process--1","instance--763adce8-107c-58c1-9b65-18fefd501b17","software--2","software--3","software--4","instance--b6bb070e-244b-5581-9de9-7d0ad2d633c4","instance--85fedce6-a475-55f5-8b4b-d8b4e69eb146","instance--1f9b84ac-50a6-5485-9797-2121f911e877","software--8","software--9","instance--fb85315e-6361-54d5-b72b-1849240f70b6","instance--d8334a62-5473-57fe-a973-74573aba067b","instance--f0e0cc6c-c7c4-5c7e-a045-8b605a46e604","instance--d84e1fad-f370-54b9-846d-86fd10a683ee","instance--03cdae8a-6b0f-5382-aa19-da33bb330362","instance--bed1cea9-d37a-50ac-aa16-3b144c1555a4","software--13","software--14","instance--b85a5b73-7329-5adc-a6f8-5a0c32359e57","instance--65b34df8-14ef-56b1-8607-801fa3c677d0","instance--5b634e7b-737f-54ba-8d1a-710c5be5aacf","instance--a4e86a3d-310d-5ee2-9255-720c6d51de32","instance--cc97f7a0-2d44-5384-9615-43b014cfb526","software--16","instance--d21e6d65-89a8-5f5a-875b-789179131835","software--18","instance--a3cc7b28-36fe-56a7-a6bb-3b0666dc0f02","instance--d5b70913-6f8a-54f1-be53-de5c5f34cbd1","instance--1fe670f3-1738-589c-b80c-76511d719927","instance--12dd0f87-f740-53f8-bddf-48d1d59c82a1","instance--be55c1a1-f948-5d91-a2f9-66cdd1b05961","software--19","instance--01cabe52-896d-589d-bc29-7b8c30bed359","instance--b36d796d-68c0-53b2-b278-4cf596d4349d","windows-registry-key--1","software--21","software--22","windows-registry-key--2","instance--17297e7c-53