db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Phishing link delivery"],["description","Initial access via a phishing email that linked to a google docs page that enticed the user to download a report, which was\u00a0 a Bazar Loader executable file instead ."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1566.002"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","User executes Bazar Loader"],["description","Execution of the initial Bazar Loader malware relies on user interaction."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1204"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Bazar runs discovery commands"],["description","Discovery command run by Bazar:\n\nnet view /all\nnet view /all /domain\nnltest /domain_trusts /all_trusts\nnet localgroup \"administrator\"\nnet group \"domain admins\" /dom"],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","Deploy Cobalt Strike beacon"],["description","In this case, the time from initial Bazar execution to domain recon was 5 minutes, and deployment of\u00a0 Cobalt Strike beacons was within 10 minutes."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","AdFind domain discovery"],["description","Seven minutes later, after launching a Cobalt Strike beacon, AdFind was used\u2013 running the same discovery pattern seen in previous reporting. This was started via a bat script. It appears that the threat actors are now piping these commands into a batch file one at a time instead of dropping adf.bat to disk.\n\nAdFind.exe -f \"(objectcategory=person)\"\nAdFind.exe -f \"(objectcategory=computer)\"\nAdFind.exe -f \"(objectcategory=organizationalUnit)\"\nAdFind.exe -sc trustdmp\nAdFind.exe -subnets -f \"(objectCategory=subnet)\"\nAdFind.exe -f \"(objectcategory=group)\"\nAdFind.exe -gcb -sc trustdmp"],["confidence",0.0],["ttp",{"tactic":"TA0007","technique":"T1482"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Create scheduled task persistence"],["description","This time, unlike prior investigations, clear persistence was found setup on the beachhead host. Firefox.exe created these scheduled tasks as well as the run key.\n\n\"C:\\Windows\\System32\\schtasks.exe\" /CREATE /SC ONSTART /TN jf0c /TR \"'C:\\Users\\pagefilerpqy.exe'\" /f\n\"C:\\Windows\\System32\\schtasks.exe\" /CREATE /SC ONSTART /TN jf0c /TR \"'C:\\Users\\pagefilerpqy.exe'\" /f /RL HIGHEST\n\"C:\\Windows\\System32\\schtasks.exe\" /CREATE /SC ONCE /ST 17:21:58 /TN 9T6ukfi6 /TR \"'C:\\Users\\pagefilerpqy.exe'\" /f\n\"C:\\Windows\\System32\\schtasks.exe\" /CREATE /SC ONCE /ST 17:21:58 /TN 9T6ukfi6 /TR \"'C:\\Users\\pagefilerpqy.exe'\" /f /RL HIGHEST"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1053.005"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Add Run key persistence"],["description","REG ADD \"HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\" /V \\\"microsoft update\\\" /t REG_SZ /F /D \"SCHTASKS /run /tn 9T6ukfi6\""],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.001"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Establish additional C2"],["description","After establishing another C2 for an additional Cobalt Strike beacon, they employed the Zerologon exploit (CVE 2020-1472) and obtained domain admin level privileges."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1071"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Exploit Zerologon"],["description","The Zerologon vulnerability CVE 2020-1472 was again exploited to obtain domain admin level privileges."],["confidence",0.0],["ttp",{"tactic":"TA0004","technique":"T1068"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb82