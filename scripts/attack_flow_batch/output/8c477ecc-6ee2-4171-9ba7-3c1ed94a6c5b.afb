92-942a-5a8c-9c2e-9bc59b33f65a","instance--d10e3bf2-a50f-5852-a99e-152c31cdbbe9","instance--cf5c3394-01b3-5b53-a717-bc5ac6298594","instance--3345d394-31f5-5c1e-ad3f-b0146f944331","instance--fb50a7d4-904c-5315-a7eb-e203e55230f8","instance--1871e873-c1ec-57fa-be71-be9bb4df8678","instance--14cfd234-c31e-588e-8568-67de9d5fdab5","instance--17262e25-c7aa-5db2-94c4-d3ae661b1c3c","instance--0dfc5eeb-3b64-51bb-a90a-7dc67b331b1c","instance--200d92d6-c5fb-5838-9f46-a941881b6144","instance--1f167b5b-83f8-5819-918e-23a813ad1e5a","instance--90550158-df8d-54a0-8e0c-023b52e9c86b","instance--6097b45e-d9a9-51b8-a8e3-5855b983b01c","instance--bacf931e-1334-582e-a49e-a5844899dc3a","instance--a8f516f1-8368-5a60-830b-cce9cf3a2668","instance--17c79f5a-51b3-51d9-ba49-70236c21c7e9","instance--6f8f049d-7eec-5733-84c6-af6ec45e1153","instance--1d546fc8-141e-5223-8fe9-21cde8cefd80","instance--dd6d58be-c3e1-5baa-b287-b2a9ad0210fc","instance--21158100-3363-508f-b226-3fd76bb0dc2c","instance--b065668b-01fb-5b20-876c-96e5290621d3","instance--5b01a1b0-4171-50ed-b0f0-72a6745d1822","instance--78155793-104d-5c85-9ed9-ae62f03694c8"],"properties":[["name","LoudMiner bundled with pirated VST software"],["description","LoudMiner is an unusual case of a persistent cryptocurrency miner, distributed for macOS and Windows since August 2018. It uses virtualization software \u2013 QEMU on macOS and VirtualBox on Windows \u2013 to mine cryptocurrency on a virtual machine, making it cross platform. It comes bundled with pirated copies of software."],["scope","malware"],["author",[["name","ESET Research"]]],["external_references",[["item-1",[["source_name","www.welivesecurity.com"],["url","https://www.welivesecurity.com/2019/06/20/loudminer-mining-cracked-vst-software/"]]]]]]},{"anchors":{"0":"instance--ad592d05-6969-5b51-98a8-1ad9b6aab896","120":"instance--5850a8f4-8241-5e73-9bf0-dcd376cd5025","150":"instance--0da1498f-3beb-5916-a249-e0410a4a81e4","180":"instance--d3632784-7391-5a29-83e2-edab51db56c6","210":"instance--8bc47ca5-ca73-5a04-a9ea-918608f10871","240":"instance--6546eef6-c5ad-516e-a417-89916e651648","270":"instance--244e5a69-f465-564e-9d2c-93d4da44fc57","30":"instance--6a1fca3c-fdb6-536a-bbea-61ac2349a700","300":"instance--043a5b44-2864-5565-abce-1909204e5485","330":"instance--e10eb918-2b0b-56f4-9c82-f345ce21276c","60":"instance--33a99d1b-dad8-51f6-be74-e1614db9151b","90":"instance--380c79e9-b1eb-547c-bf01-a011db1201c1"},"id":"action","instance":"attack-action--1","properties":[["name","Host trojanized VST applications"],["description","At the time of writing, there are 137 VST-related applications (42 for Windows and 95 for macOS) available on a single WordPress-based website with a domain registered on 24 August, 2018. The first application \u2013 Kontakt Native Instruments 5.7 for Windows \u2013 was uploaded on the same day."],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1583.001"}]]},{"anchors":{"0":"instance--4f4d03a8-4502-5010-997b-9943e254395b","120":"instance--cefe62ac-5b6e-5ead-84fc-b4c632913a73","150":"instance--4d07a740-2467-5b95-ac8d-4a2ee8edd11e","180":"instance--1205f03c-a457-5a0b-87ef-3bbb7aac110f","210":"instance--96e7dc6a-9f86-5f69-8d45-a566303cd4c0","240":"instance--66237af6-bb19-5a51-9fa2-cbc4a96186f5","270":"instance--836dfd42-b475-50ca-9acf-4f11bd32b89f","30":"instance--efe92997-cc5c-538a-90bc-c09ffb1379f4","300":"instance--9c4a24ae-1426-5cb5-9d7c-792e6dd325b7","330":"instance--06c6a74a-ca7d-5703-88ea-a06a0933d21a","60":"instance--5e4f84e5-56b7-5b8f-9bc3-b4d59d371123","90":"instance--019deb6a-bab3-57db-9a53-11e3564bf7a4"},"id":"action","instance":"attack-action--2","properties":[["name","Host payloads on external servers"],["description","The applications themselves are not hosted on the WordPress-based site, but on 29 external servers, which can be found in the IoCs section."],["confidence",0.0],["ttp",{"tactic":"TA0042","technique":"T1583.005"}]]},{"anchors":{"0":"instance--0ce35aea-35a2-52ae-a67b-985306bdefe7","120":"instance--312639d5-e6d9-57b1-850d-28f0a1eac2f6","150":"instance--9551a25e-2558-512e-9894-dd64a8d662bf","180":"instance--403becce-e0ad-5dcd-bc14-7c00453907da","210":"instance--2305f501-2712-5ec6-9d4e-1371b011e937","240":"instance--cf1b8cf6-1cbd-5afb-b653-aa693889dab5","270":"instance--1d3dc59a-40a0-5670-aa3e-1304ff762003","30":"instance--77063d4f-503a-5e9b-b622-15aa2cc6a8e7","300":"instance--beaab67f-8a54-5982-8c5d-9d2ed2d42c9f","330":"instance--4d3274ff-ef14-5a53-99be-01575194a98e","60":"instance--4154a6bf-290b-5fce-a557-5dc0f3e700fb","90":"instance--2992bc0b-df57-54e5-a17b-03a964338c09"},"id":"action","instance":"attack-action--3","properties":[["name","Bundle virtualization software and Linux image"],["description","An application is bundled with virtualization software, a Linux image and additional files used to achieve persistence."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1027.006"}]]},{"anchors":{"0":"instance--0f6e4da7-a5f4-54d7-866f-3bc6e8bcb019","120":"instance--015254b5-0906-577e-b3e3-3899f837d118","150":"instance--f7af5b8c-330a-58d5-b0da-a3d5f0bc6ad0","180":"instance--9f27ab21-2382-567d-b022-74ad5a29bd08","210":"instance--d799eb0a-7600-5b1a-a298-c47a78ceae4b","240":"instance--911c2c52-5974-5e08-b0b6-a9084d57c6ee","270":"instance--286444b4-97a1-58cd-9ca3-cffa04a15351","30":"instance--92192c38-5143-50e0-8c39-a96ea86e32e2","300":"instance--82bb3de0-bea5-5651-a1de-583283258c6d","330":"instance--4f0945c8-f644-50ce-8796-fea52a29dda1","60":"instance--16c43a2d-7356-521d-a507-5922e2c3337b","90":"instance--abce5c62-339a-5ed5-a0b8-dd66136cfe2f"},"id":"action","instance":"attack-action--4","properties":[["name","User downloads and installs trojanized application"],["description","User downloads the application and follows attached instructions on how to install it."],["confidence",0.0],["ttp",{"tactic":"TA0001","technique":"T1659"}]]},{"anchors":{"0":"instance--a469636c-0cb2-50b9-92f9-644c8aa98197","120":"instance--d57b3a21-e910-5879-8148-40165cea451a","150":"instance--58250ef4-5bb4-5bf3-b33e-89493bbb395d","180":"instance--3e769cf2-c1e5-5d2e-81d4-892f48ce4d86","210":"instance--f6499e41-749c-5d7f-9346-96c08d0d5dfd","240":"instance--d9dcdfc8-5f42-546a-803a-0efcd5d4cf91","270":"instance--c9afd0f6-97ce-57b2-9d60-3557b6214809","30":"instance--75f82155-f5ff-5619-8bf8-aae22937cab0","300":"instance--25e2d26e-1b35-56bd-b9aa-096c2d3b0e3c","330":"instance--e0483688-da10-5376-8cf2-050bcc3b70f0","60":"instance--1293d9cc-16b2-5c67-a453-bd144aab133a","90":"instance--2b43cd52-10db-5b15-8ad5-c4b59496528b"},"id":"action","instance":"attack-action--5","properties":[["name","Install LoudMiner before VST software"],["description","LoudMiner is installed first, the actual VST software after."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1204.002"}]]},{"anchors":{"0":"instance--54fc1f38-f4e3-523e-b07c-73889b0d8df7","120":"instance--9cf45948-7040-5d7a-a1d5-3cb4db0c1af6","150":"instance--13bb13cc-e02b-51d2-8d7d-40e5613b6e5a","180":"instance--e33bc6ee-771e-54fe-a772-74dfdaad420d","210":"instance--286f51a3-8fc6-55ec-978e-8b05ebda3655","240":"instance--14659696-be77-5460-beb1-4b5eac126e43","270":"instance--f48ed1a6-2895-5cd2-9b1c-e30ac2bc8921","30":"instance--7b803e61-16ac-5720-92cd-8f2a456a52b7","300":"instance--76c24361-5143-5c43-8e4d-707c619e6038","330":"instance--f395cfc7-395a-5001-9552-a4fec6dbc53a","60":"instance--760885bb-9294-5a5b-93a2-a410e1ea4112","90":"instance--8e0d1a12-8611-598d-9a7d-40f2525e4781"},"id":"action","instance":"attack-action--6","properties":[["name","Hide malware and persist on reboot"],["description","LoudMiner hides itself and becomes persistent on reboot."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1564.001"}]]},{"anchors":{"0":"instance--7cccbcd0-a724-54fb-be4f-ac523d26f7d0","120":"instance--738e44b2-1357-5eb3-82bd-8a0ce8942b72","150":"instance--d31f4735-6339-5929-8d7c-d30863cf166f","180":"instance--2252393d-d801-5931-ad38-4b53374a9880","210":"instance--065b5ad5-023a-5336-b458-e9c9dcda2976","240":"instance--5ea0dd2b-5eac-51f8-855a-4cbcb801bc2d","270":"instance--bba66874-a069-56c6-bb95-967cb3cefc9e","30":"instance--6377c09d-ecb4-5567-a2f4-4dde56ff4f98","300":"instance--ede3430f-b16b-58ae-be71-1d1f1a194336","330":"instance--7772f482-8ee2-569a-b600-7528c065d4e0","60":"instance--98139a98-16b0-54fe-8c77-3473c1b520cd","90":"instance--5cb9cc95-e190-5a68-985d-0a94d39299e6"},"id":"action","instance":"attack-action--7","properties":[["name","Launch Linux virtual machine for mining"],["description","The Linux virtual machine is launched and the mining starts."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1496"}]]},{"anchors":{"0":"instance--5150f7cc-6f25-5eb3-a6fc-5099ced4caf4","120":"instance--64a408ce-c543-55d6-a9dd-206ce7cadbb2","150":"instance--1b71e413-cfd2-528c-8792-dc7dd1bb9938","180":"instance--aa12ce11-0165-52b6-b72d-e4d9070e9fbb","210":"instance--5d8b0f08-14bc-58f4-9316-b25a92dd09a6","240":"instance--34f96b84-9453-53f2-ae07-d28c04665e6c","270":"instance--415f1d54-1cd4-5ba7-8071-4aa99bc946ac","30":"instance--18834cac-b4c4-57b0-88ea-5a62fdb27cf9","300":"instance--de4f9957-1ac6-5782-86ea-f1a3b6a9ad13","330":"instance--8eff940b-86bb-556f-8c85-c7c47577b3ed","60":"instance--14a123fd-5626-5e69-8257-6dcd64c28ec0","90":"instance--02294ff1-7261-5db8-8e0d-b9e818922053"},"id":"action","instance":"attack-action--8","properties":[["name","Update miner from C2"],["description","Scripts inside the virtual machine can contact the C&C server to update the miner (configuration and binaries)."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--180f2983-9c1a-56f4-99d6-c990125f7baa","120":"instance--c7f65318-7600-57f4-a8ac-992357e695ff","150":"instance--95523e1a-0a1d-52ef-944c-23f9cbc50233","180":"instance--bc8eb48d-411d-5877-aa9b-966476b71207","210":"instance--4cc5026e-07f9-5327-9912-5d278a0a3321","240":"instance--d6a7d51d-39a4-5eb3-8831-f23437781b95","270":"instance--cac30e05-5f01-5b4f-b5c0-6b975297df2d","30":"instance--cb0751b0-c027-5895-a460-a72e48920c71","300":"instance--f41cdc1f-abb7-5ff7-81c2-bf2235a7faab","330":"instance--b114cbda-9ec8-5612-b2f8-93c36811cafb","60":"instance--f28e5296-2041-5fe9-992d-4c70d549191e","90":"instance--3ea39244-da0f-5435-8745-f2afa8b13872"},"id":"action","instance":"attack-action--9","properties":[["name","Copy QEMU dependencies and set permissions"],["description","We\u2019ve identified three macOS versions of this malware so far. All of them include dependencies needed to run QEMU in from which all files are copied over to and have appropriate permissions set along the way."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1574.002"}]]},{"anchors":{"0":"instance--db5fab04-54d4-5eec-a429-185861eb2719","120":"instance--985391bd-d017-5935-ab31-3b4b56331b02","150":"instance--092bb98d-fc30-5f69-b6b7-e3024f3ec65a","180":"instance--755129e6-612e-5b63-a780-1c886d98909b","210":"instance--431723d9-dd8c-5190-9dab-6f346173c044","240":"instance--5b9fb821-54fe-5f22-bba3-038263245910","270":"instance--3c6777cb-6430-544b-b31a-01b198524553","30":"instance--c070071b-a9a3-52fe-8956-a51744db200b","300":"instance--a9a4289c-d995-5783-9544-a8b45052eb56","330":"instance--344009cc-e024-5c68-9246-51e85e00d45c","60":"instance--86c77621-2c1d-59c3-b398-e62f4b48a3dd","90":"instance--67627b08-1913-5f3d-8318-52d3bda9c1c3"},"id":"action","instance":"attack-action--10","properties":[["name","Add launch daemon plist persistence"],["description","Persistence is achieved by adding plist files in with set to . They also have set to true ensuring the process will be restarted if stopped."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1543.001"}]]},{"anchors":{"0":"instance--6b7baffd-afaf-5472-9af2-a263119a77ef","120":"instance--83f38e63-e29a-53f4-99d9-927a195c453f","150":"instance--3e720145-b7a1-5bd6-8a7d-bb13519675d1","180":"instance--bdce060f-d96c-5b06-b8f4-1ab1527fd01d","210":"instance--a4feb251-e6e3-5680-a712-d59c92f73ccf","240":"instance--9a564ca6-b753-5b06-880c-b3aac25c1e73","270":"instance--76861a89-f006-5e0d-8c5b-ebdcb5e926dc","30":"instance--cf41e64d-4a4b-58d9-9962-72d278b2c489","300":"instance--ac1d6edd-482f-5f13-9348-b605afcc260c","330":"instance--ed78dfa1-f300-564f-b2cd-6c99552b9a68","60":"instance--979accb3-1b3e-5af4-9182-78392cbaf904","90":"instance--ae721c42-320e-5ea4-9c77-339a05b6e12f"},"id":"action","instance":"attack-action--11","properties":[["name","Monitor CPU and idle time to start or stop mining"],["description","The CPU monitor script can start and stop the mining by loading and unloading the daemon. If the process is running, the mining stops. Otherwise, it checks for how long the system has been idle in seconds:\n\nIf it\u2019s been longer than 2 minutes, it starts the mining. If it\u2019s been less than 2 minutes, it checks the total CPU usage:\n\ndivides that by the number of CPU cores:\n\nand if it\u2019s greater than 85%, it stops the mining."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1496"}]]},{"anchors":{"0":"instance--f1e35721-7ac2-54fe-bcf6-5456d2faeaa3","120":"instance--3ff6777e-fcba-5b31-bf0f-3ddf77f6030d","150":"instance--cc6192f9-21a5-5d1a-b954-6a52d989b82d","180":"instance--62a87260-0181-5f49-bc05-733216e4d822","210":"instance--2f2d05c5-8e60-5ac2-b7af-e03027d67957","240":"instance--79c1ec18-d792-5d3d-a7bc-d94fe8b124cf","270":"instance--a035d357-e930-5d33-ab8d-d0314092d036","30":"instance--3af551b8-f6ac-5f54-9f6d-403fecdc69eb","300":"instance--298b5d2a-bf93-51e9-b052-19ce36114a5d","330":"instance--c8ea0da0-a19a-5766-b0d1-8524844a59d1","60":"instance--a204f87d-ace7-5a9e-b3d1-13202bdc5c7b","90":"instance--fff4de11-3f84-52c8-bb77-192210612a62"},"id":"action","instance":"attack-action--12","properties":[["name","Delete miner installation files"],["description","After the installation is done, all miner-related installation files are deleted."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1070.004"}]]},{"anchors":{"0":"instance--cac05670-e90e-512c-99cc-c0adf909c3ef","120":"instance--43922820-ddd3-5742-a88d-49c20f8e3fd5","150":"instance--884271a6-8d7b-5c96-9ece-61be4126898b","180":"instance--373a94ef-653d-5c24-96f7-d0cf326d3aea","210":"instance--e58b782a-e75e-5141-bdf0-6d47dbed96bd","240":"instance--5960e46a-3307-5101-b96f-f1bae10e323d","270":"instance--a5ae1125-6ca5-54f1-b9d3-0091a0a38367","30":"instance--e7c521dd-fe09-528b-bb67-1ec53389b876","300":"instance--582e0864-cb5c-5de1-b6c0-e162ae91e8bc","330":"instance--3d5550f3-3e33-5d71-b71e-db2a0a957e5e","60":"instance--b83fc757-0bd4-5b63-a13e-e5b8ef5956d2","90":"instance--2a745819-837b-5585-a366-81a34117a6e5"},"id":"action","instance":"attack-action--13","properties":[["name","Launch miner daemons before installing software"],["description","After the dependencies are copied over, all miner-related daemons are launched and then the actual software is installed:"],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1543.001"}]]},{"anchors":{"0":"instance--2accaaf8-d071-542e-9a10-06866a96b394","120":"instance--75ef5b2f-7c71-566e-baf2-29f54ced8138","150":"instance--73017f0a-a5f3-5dca-b91c-a2d37bcfe21b","180":"instance--2f1b6e5f-d3b0-59e5-b3c8-6c1399d1ce2a","210":"instance--c7aedd91-3346-5b75-9e3a-842851881a25","240":"instance--2146989b-d8a2-53f0-8a1c-cd3d976227e9","270":"instance--1b0bbd91-fa2a-5897-96d0-9e5918961c9c","30":"instance--e6b73353-364e-5586-a07b-e1fdc92ad2d3","300":"instance--0fdc5473-d5b9-5fed-91a3-21958da6287b","330":"instance--fd1cd9e0-5761-5725-801f-bf88b65914e8","60":"instance--a58b8357-6abc-58d7-ad2b-bec48fffcd9b","90":"instance--e8daf33f-0240-5544-9f99-3be7ac96fc1d"},"id":"action","instance":"attack-action--14","properties":[["name","Remove version 1 miner if qemu process detected"],["description","Before installation, version 1 of the miner is removed along with executing the command:\n\nAs seen in the listing in Script 2, it only does so when it detects a running process."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1070.004"}]]},{"anchors":{"0":"instance--c80ca3ef-db0a-5372-968e-c17eb31a79ca","120":"instance--69989f45-927f-57be-92e5-5102fccd9f11","150":"instance--9b02c549-b183-5406-a100-249fb1868d16","180":"instance--c1d2a890-ed8d-5123-92d5-ceeaa937ee87","210":"instance--b785b7b9-02d5-5d04-be0c-0d02d4f85620","240":"instance--cde2d3fb-a23f-5188-9d7d-6c7f3cd3cebb","270":"instance--3fa59d94-25bb-5c51-af21-1a7c1fd91f66","30":"instance--fdd04191-1a03-5134-b88e-a55240471931","300":"instance--dddeb587-c160-5bdc-a385-f5d294f11e92","330":"instance--a13b6b46-2b8e-5660-b86f-03747a07fe24","60":"instance--d996db22-4d65-536a-83bf-a1db02b37136","90":"instance--258e2cac-1806-5147-8d61-a10d64a86e46"},"id":"action","instance":"attack-action--15","properties":[["name","Create temporary QEMU and monitor files"],["description","The following temporary files are created:\n\n- QEMU binary\n\n- launches the QEMU image with the QEMU binary\n\n- QEMU image\n\n- launches\n\n\u2013 CPU monitor script, little change from version 1\n\n- used to launch z3\n\n- generates random names"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1574.001"}]]},{"anchors":{"0":"instance--878d252f-de04-5857-ad0a-e8560794a9aa","120":"instance--bf65c103-2305-50be-8098-7718a8b010c5","150":"instance--348f71b8-78ee-5edf-accb-cd536c0db67d","180":"instance--e786d536-88e4-5ad4-8526-ae120c505f45","210":"instance--d3f3806c-3238-5b69-a0ca-334a1453e3dd","240":"instance--6dc42515-8e0a-5d8f-9dcb-cc6f0eb80f24","270":"instance--6a335c70-0c01-578c-9e01-614ace562750","30":"instance--c34e4c14-a710-535c-afd4-17d8ea759e88","300":"instance--60b19ce6-d4d3-5ce5-b2fe-3427fd0ea9a4","330":"instance--dea41a44-5c5a-520f-8975-25088fdd166c","60":"instance--e8f2f47b-1824-589b-af23-ab4291258936","90":"instance--67989025-38e3-56c8-b903-f474fc067511"},"id":"action","instance":"attack-action--16","properties":[["name","Randomize QEMU binaries plists and directories"],["description","After dependencies are copied over, the miner is installed. This time the names of QEMU binaries, plists and directories are randomized with the script. The miner installation creates two copies of . For each copy, the following happens:\n\nA directory with a random name is created in\n\nThe QEMU binary carries the same name as the directory and is copied into\n\n(see listing in Script 3) and are copied into this directory under their random names\n\nis copied with the name into\n\nfiles serve as templates. References to other scripts, binaries, plists, etc. in these files are replaced by their corresponding generated random name.\n\nA random name is also chosen for the CPU monitor ( ) shell script and its accompanying plist file. is copied into and the plist into under the name ."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1036.005"}]]},{"anchors":{"0":"instance--dbfe6415-cd2c-55f2-9509-06b6668ef23a","120":"instance--79ca45e2-afd7-51fa-9574-5085c7de4c84","150":"instance--39171cfe-3bf6-5200-b6f5-e97e3b047db7","180":"instance--8cda146b-7259-56b2-b337-56038a1f52d3","210":"instance--a662f8bf-2723-58c0-a1a8-9af9497cf428","240":"instance--a9b75b15-3be0-5e64-8132-40b87e7ae405","270":"instance--31896ecd-322b-5a41-bd1e-0b7a30b9d9d1","30":"instance--60868276-2726-597d-8f57-8aa7fc9c0738","300":"instance--4f5668fa-b6ef-57cc-93da-5cd1e1727a22","330":"instance--b022a562-9020-587c-a5be-97d254cc8f11","60":"instance--cf452b0f-192e-5357-ba8c-fbae1a6e4ae0","90":"instance--012cc6fc-0a37-5e6e-b9b7-07f3bcd2d02c"},"id":"action","instance":"attack-action--17","properties":[["name","Mount encrypted miner DMG"],["description","The miner files are in an encrypted DMG file, called , inside the application package. The DMG is mounted with the following command:"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1027.013"}]]},{"anchors":{"0":"instance--a73f63ad-1c10-59c2-82aa-bef4ae8f64e0","120":"instance--62757838-a58e-5d41-b7e3-1ccc64e8cdbf","150":"instance--3462202b-a91d-5325-abfe-876a63049484","180":"instance--72959cd4-5e05-5d69-a145-8b6f35720646","210":"instance--d3b85082-8de6-5ffd-8abe-c9e1ec43f533","240":"instance--0a22ffab-8bbc-55b1-85ec-df74e4a120f6","270":"instance--548b3ba1-955f-5e04-b6e8-064cc259e7a6","30":"instance--6f0a37c5-db81-5459-92c1-bc8ab8cd1fd3","300":"instance--e81be898-f7c2-56a0-a705-d2aba8831f75","330":"instance--8f207ed6-cb63-551c-9a40-583fac14fe80","60":"instance--8b44546f-f8e4-5d12-b172-99f9507395eb","90":"instance--f61db455-1665-504d-85b4-5fd5d40fbcc2"},"id":"action","instance":"attack-action--18","properties":[["name","Install miner package and software package"],["description","The miner DMG contains a single package: . This and the software package are then installed."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1204.002"}]]},{"anchors":{"0":"instance--223a73a7-07a6-5688-bc70-e7fbf2c8afd4","120":"instance--2184e59f-b6bd-5ca7-8254-3872e152a964","150":"instance--eed82efc-7573-5ccf-97d8-e3f88a2337bb","180":"instance--453ded0c-8246-59f2-a14f-beca9e751cd6","210":"instance--143e4619-312d-5cbc-acc5-efed5f6c0164","240":"instance--659cf4a8-ca80-5204-8b8d-3240f6f370da","270":"instance--2dac3e32-a8df-582e-845a-3a7b1d510c1d","30":"instance--6ab42faa-5ba5-5c44-b387-40b1d021e500","300":"instance--96e5ad82-e4af-5995-8b69-6df7d7ce2490","330":"instance--a960fdd4-4889-5426-a406-4761d11be5ab","60":"instance--42df375f-d3e2-5d47-9faa-324aecbbf064","90":"instance--51395417-94d2-5b5a-881c-7b6cc63ade4e"},"id":"action","instance":"attack-action--19","properties":[["name","Add obfuscated install scripts"],["description","The package contents of and from version 2 are more or less the same, but adds two obfuscated scripts \u2013 and - and obfuscates an existing script \u2013 :"],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1027"}]]},{"anchors":{"0":"instance--25dacfeb-3a3d-51fc-91b7-64ee405fe041","120":"instance--5a984174-ce49-510d-b6b6-d4f0e0ee332f","150":"instance--f2167f56-1cf9-5fea-a726-d003a591d391","180":"instance--70c47af3-1817-5ae2-9f6e-38421d85f808","210":"instance--cfd506cd-f673-5f4f-a5ff-5854ad8a39d5","240":"instance--b78e4cb3-2b2b-5706-8d59-d252dd134505","270":"instance--73410cfd-8533-5545-94b7-c06859fcd4a8","30":"instance--760fe684-ea1e-52a0-87e8-fa0bc5d62d70","300":"instance--fa30f213-64f3-55b5-85cd-9dbf46e0e8dc","330":"instance--0dbe5c9b-c2db-5139-a300-8054f3a8e205","60":"instance--a78137f8-a78e-563e-ad44-749594629166","90":"instance--626b6c26-479d-5895-a619-ee3dbb14136d"},"id":"action","instance":"attack-action--20","properties":[["name","Launch QEMU images via shell scripts on boot"],["description","All versions use multiple shell scripts to launch the images. The shell scripts are executed by plists on boot and are kept alive."],["confidence",0.0],["ttp",{"tactic":"TA0002","technique":"T1059.004"}]]},{"anchors":{"0":"instance--93ee4f51-8321-58fb-b05f-3a6fd3a6a8ab","120":"instance--02ee2d77-fc8c-55cc-8958-e3d0b5ead581","150":"instance--15aaf9f3-3996-5f9b-bee4-47f2963a0df4","180":"instance--1ae13e0a-be4e-5658-ba6d-c941c0d5cafb","210":"instance--87590098-5adb-5af7-aa75-039447d58b2b","240":"instance--87dee187-bf66-5b52-81e0-15b789ab6a7c","270":"instance--25c474c1-a795-5124-95ce-3e6163b067d2","30":"instance--ae371f09-8eae-53a7-a14c-34f9e72904fd","300":"instance--9ecc9c80-603d-5760-b2b6-f850dfd3eddf","330":"instance--b9543d3c-a7f9-50a6-b8a1-3fd4c6dddd56","60":"instance--cba1b44c-d7c9-5ebb-8433-b63b0b91427c","90":"instance--1c5f2ea2-c075-51ba-9f13-69b716c352cf"},"id":"action","instance":"attack-action--21","properties":[["name","Install hidden VirtualBox and hidden vm directory"],["description","VirtualBox is installed in its usual folder name ( ); however, the attributes of the directory are set to \u201chidden\u201d. Then the installer copies the Linux image and (a Windows service used to run a VirtualBox virtual machine as a service) into , which is also a hidden directory."],["confidence",0.0],["ttp",{"tactic":"TA0005","technique":"T1564.001"}]]},{"anchors":{"0":"instance--da12a10e-e9d8-58e0-9dda-e871f0fcaf7c","120":"instance--6e98f91f-940c-5b7d-8e4e-950f2c88b044","150":"instance--02b3e90f-a9f8-5908-b936-c779b2c570d8","180":"instance--5c256240-99ff-5907-aca7-0f81639a7419","210":"instance--e42c995a-6770-583f-9a60-afcdf41d5501","240":"instance--eee0e52c-22be-5b9b-819e-097b65b643d8","270":"instance--d4973194-aaba-5ce5-99ba-7d7c8bca7b50","30":"instance--91b449e9-d343-56d1-9376-8a2655b8032b","300":"instance--23579e20-df5a-5dad-9088-26b612c3c5aa","330":"instance--2ed64056-576c-519d-b8c7-4e1f2c06b6e9","60":"instance--c59d1168-f011-5687-803d-27aa797d72e2","90":"instance--321449b3-3e1e-5b4b-aab6-507e5ad1c36c"},"id":"action","instance":"attack-action--22","properties":[["name","Import Linux image and start VM service"],["description","Once the installation is complete, the installer runs a batch script compiled with (see the unpacked listing in Script 4) to import the Linux image and run to start the virtual machine as a service."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1543.003"}]]},{"anchors":{"0":"instance--9f68185c-8d0f-5e34-b869-da9c17407e5d","120":"instance--99f65057-0748-5b22-b7a8-859b8cb9d46c","150":"instance--1c6c577b-3682-579f-9d80-c1a4c9632dd5","180":"instance--0372a821-a640-58c2-a8f9-f391b8fb0045","210":"instance--bd12903c-f92d-5416-a20f-eedd38d108f9","240":"instance--a221d4df-2c16-5e25-a121-f7cfbb303fb7","270":"instance--550d9be5-209a-50fa-99b8-4dfe7669b693","30":"instance--042db59c-d5d0-5002-ac74-85e947cc6579","300":"instance--2ce3cd55-fc34-5aac-8112-e6cc8fcd707a","330":"instance--55903f51-17c6-554e-8180-6f2511efa2b6","60":"instance--2b4af278-cf58-556d-9fa5-254ca76fcb98","90":"instance--a84c2c43-a2a5-5904-906d-da6a186887bd"},"id":"action","instance":"attack-action--23","properties":[["name","Configure VM service to auto-launch at startup"],["description","Indeed, VboxVmService comes with a configuration file (see Script 5) in which it is possible to enable the option so the virtual machine is automatically launched at startup."],["confidence",0.0],["ttp",{"tactic":"TA0003","technique":"T1547.001"}]]},{"anchors":{"0":"instance--08881caf-1468-53e2-baa3-c9da43e73b47","120":"instance--5344d679-b2e1-5528-bed5-6fe3fbc90036","150":"instance--f1a3ca80-d761-5917-981a-9d35e6a5161e","180":"instance--bb22e51a-29ce-531e-b80e-4a1d5343b453","210":"instance--380340c8-8f15-5075-a390-ac1b2706e43f","240":"instance--b8ca794c-8bea-5f4c-a746-ad3b31fd2d36","270":"instance--fb5c8b1f-7cc5-58a3-a457-0edfdefa168c","30":"instance--a124cc0a-728c-5b30-8b8b-2171584014e7","300":"instance--7d09cfe0-ac57-5093-a7ce-7c31042d3449","330":"instance--829e634f-5069-5370-8381-e0687a22b00e","60":"instance--0fbffc26-a516-5fcd-9fff-e9aee12c6467","90":"instance--96917b9c-4649-5345-82ac-b4e793881bfe"},"id":"action","instance":"attack-action--24","properties":[["name","Run XMRig in Tiny Core Linux VM"],["description","The Linux image is Tiny Core Linux 9.0 configured to run XMRig, as well as some files and scripts to keep the miner updated continuously."],["confidence",0.0],["ttp",{"tactic":"TA0040","technique":"T1496"}]]},{"anchors":{"0":"instance--6e9515e3-2497-5444-80ce-9466679d2504","120":"instance--25d30ffe-4a4f-53ec-a34d-de6cc58a2fb0","150":"instance--43abd457-ad7e-5db6-b146-d159a2936c52","180":"instance--f22410a7-1bbd-5943-9121-cf9edb5a0991","210":"instance--4a2a2f86-5543-5514-866c-4d5f4f5bcb3b","240":"instance--f2011b06-5138-5056-a1f2-0a96e9738966","270":"instance--a9d1b1c1-44f0-5281-b6b0-9133e0a433dd","30":"instance--c9339355-ad0b-5e98-9f42-ef0c11d380dd","300":"instance--dec744bc-b6ae-5258-bcb1-83f01a7bb747","330":"instance--54f63fd7-f831-5401-a04f-600f5e780c31","60":"instance--1dd30294-3434-540a-8b5f-d8bc1e3de794","90":"instance--e414165a-d829-5c22-ab74-6aa5e50c83d3"},"id":"action","instance":"attack-action--25","properties":[["name","Use SSH key pair for SCP updates from C2"],["description","\u2013 the SSH pair key used to update the miner from the C&C server using SCP."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1071.004"}]]},{"anchors":{"0":"instance--ce3f20b8-daf0-5682-a74a-dd9eb1251abb","120":"instance--08418575-7199-5323-8082-8e1d88a1ec11","150":"instance--15627176-59a5-5797-816e-a6cab3ea9da9","180":"instance--242a8d77-274b-5d18-ba35-771f6e0de836","210":"instance--d01bb126-419a-5d3b-a9cf-7b8df1d59112","240":"instance--0b76a14d-f362-5d5a-995f-2e318539789f","270":"instance--d534a23c-ea17-5a19-96f9-740e77b559a2","30":"instance--9b134899-2cf4-5fcd-9412-5363985ac68c","300":"instance--1bb6a59f-c750-5aca-a7c7-cecaf9c9f1f7","330":"instance--a346b253-e85b-53ff-8e33-33aaa8c928da","60":"instance--0c9baf75-2ba0-51ff-b084-c1044ff899fa","90":"instance--b86b5b84-3a18-51f2-b888-17161b8c5d47"},"id":"action","instance":"attack-action--26","properties":[["name","Update miner files via SCP scripts"],["description","The update mechanism is performed via SCP (Secure File Copy) by three different scripts:\n\n- updates the configuration of the miner ( );\n\n- updates (see Script 9), ;\n\n- updates ;\n\nFrom what we have seen, the miner configuration is updated once every day."],["confidence",0.0],["ttp",{"tactic":"TA0011","technique":"T1105"}]]},{"anchors":{"0":"instance--804d7975-bdc1-5371-a95e-4cff0aa0b8b1","120":"instance--aab4410b-5835-54c6-bc0f-d93b86440850","150":"instance--ad5c3f2a-3c32-5af5-9b9c-489a81eead21","180":"instance--3ff51605-dadf-546e-a273-07184c6549e2","210":"instance--9337c97e-ad0d-5d35-8b01-21c1e3f80296","240":"instance--49c4f7e6-8fe8-5919-bda8-039a2aaf3a61","270":"instance--4e395b92-9587-53cc-a957-cad25cc53df8","30":"instance--b917f3cb-7197-5ba7-8a3e-cbfda092d01a","300":"instance--ab650c26-b6f9-59ed-b26e-6f6ca03758dd","330":"instance--36c16e65-d9d7-519a-a8ae-a6dd521ddceb","60":"instance--0b7fc2fd-f6ca-532d-9f2b-ca34c65a881a","90":"instance--ff765750-9ba6-53a3-b366-8a863df1a603"},"id":"action","instance":"attack-action--27","properties":[["name","Create host IP and date file and send to C2"],["description","In order to identify a particular mining session, a file containing the IP addr